@page
@model Facturacion.Frontend.Pages.Contabilidad.CuentasIntegracionModel
@{
    ViewData["Title"] = "Cuentas de Integración";
    ViewData["Breadcrumb"] = "Cuentas de Integración";
}

<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <h2><i class="fas fa-plug"></i> Cuentas de Integración</h2>
            <p class="text-muted mb-0">Mapeo de operaciones de módulos a cuentas contables</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-success" onclick="inicializarMapeos()">
                <i class="fas fa-seedling me-2"></i>Inicializar Mapeos
            </button>
            <button class="btn btn-primary" onclick="openCreateModal()">
                <i class="fas fa-plus me-2"></i>Nuevo Mapeo
            </button>
        </div>
    </div>
</div>

<div class="alert alert-info mb-4">
    <i class="fas fa-info-circle me-2"></i>
    <strong>Integración Automática:</strong> Configure las cuentas contables que se utilizarán automáticamente para las operaciones de cada módulo del sistema. Esto permite que las transacciones de Ventas, Compras, Inventario, etc., generen asientos contables automáticos.
</div>

<!-- Module Tabs -->
<ul class="nav nav-tabs mb-3" id="modulosTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="tab-VEN" data-bs-toggle="tab" data-bs-target="#modulo-VEN" type="button" role="tab">
            <i class="fas fa-shopping-cart me-2"></i>Ventas
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-COM" data-bs-toggle="tab" data-bs-target="#modulo-COM" type="button" role="tab">
            <i class="fas fa-shopping-bag me-2"></i>Compras
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-INV" data-bs-toggle="tab" data-bs-target="#modulo-INV" type="button" role="tab">
            <i class="fas fa-boxes me-2"></i>Inventario
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-CXC" data-bs-toggle="tab" data-bs-target="#modulo-CXC" type="button" role="tab">
            <i class="fas fa-file-invoice-dollar me-2"></i>Cuentas por Cobrar
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-CXP" data-bs-toggle="tab" data-bs-target="#modulo-CXP" type="button" role="tab">
            <i class="fas fa-file-invoice me-2"></i>Cuentas por Pagar
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-BAN" data-bs-toggle="tab" data-bs-target="#modulo-BAN" type="button" role="tab">
            <i class="fas fa-university me-2"></i>Bancos
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-NOM" data-bs-toggle="tab" data-bs-target="#modulo-NOM" type="button" role="tab">
            <i class="fas fa-users me-2"></i>Nómina
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-ACT" data-bs-toggle="tab" data-bs-target="#modulo-ACT" type="button" role="tab">
            <i class="fas fa-building me-2"></i>Activos Fijos
        </button>
    </li>
</ul>

<!-- Tab Content -->
<div class="tab-content" id="modulosTabContent">
    <!-- VEN - Ventas -->
    <div class="tab-pane fade show active" id="modulo-VEN" role="tabpanel">
        <div class="card shadow-custom">
            <div class="card-header bg-primary text-white">
                <i class="fas fa-shopping-cart me-2"></i>
                <strong>Mapeos de Ventas</strong>
            </div>
            <div class="card-body">
                <div id="mapeos-VEN-container"></div>
            </div>
        </div>
    </div>

    <!-- COM - Compras -->
    <div class="tab-pane fade" id="modulo-COM" role="tabpanel">
        <div class="card shadow-custom">
            <div class="card-header bg-success text-white">
                <i class="fas fa-shopping-bag me-2"></i>
                <strong>Mapeos de Compras</strong>
            </div>
            <div class="card-body">
                <div id="mapeos-COM-container"></div>
            </div>
        </div>
    </div>

    <!-- INV - Inventario -->
    <div class="tab-pane fade" id="modulo-INV" role="tabpanel">
        <div class="card shadow-custom">
            <div class="card-header bg-info text-white">
                <i class="fas fa-boxes me-2"></i>
                <strong>Mapeos de Inventario</strong>
            </div>
            <div class="card-body">
                <div id="mapeos-INV-container"></div>
            </div>
        </div>
    </div>

    <!-- CXC - Cuentas por Cobrar -->
    <div class="tab-pane fade" id="modulo-CXC" role="tabpanel">
        <div class="card shadow-custom">
            <div class="card-header bg-warning text-dark">
                <i class="fas fa-file-invoice-dollar me-2"></i>
                <strong>Mapeos de Cuentas por Cobrar</strong>
            </div>
            <div class="card-body">
                <div id="mapeos-CXC-container"></div>
            </div>
        </div>
    </div>

    <!-- CXP - Cuentas por Pagar -->
    <div class="tab-pane fade" id="modulo-CXP" role="tabpanel">
        <div class="card shadow-custom">
            <div class="card-header bg-danger text-white">
                <i class="fas fa-file-invoice me-2"></i>
                <strong>Mapeos de Cuentas por Pagar</strong>
            </div>
            <div class="card-body">
                <div id="mapeos-CXP-container"></div>
            </div>
        </div>
    </div>

    <!-- BAN - Bancos -->
    <div class="tab-pane fade" id="modulo-BAN" role="tabpanel">
        <div class="card shadow-custom">
            <div class="card-header bg-secondary text-white">
                <i class="fas fa-university me-2"></i>
                <strong>Mapeos de Bancos</strong>
            </div>
            <div class="card-body">
                <div id="mapeos-BAN-container"></div>
            </div>
        </div>
    </div>

    <!-- NOM - Nómina -->
    <div class="tab-pane fade" id="modulo-NOM" role="tabpanel">
        <div class="card shadow-custom">
            <div class="card-header bg-dark text-white">
                <i class="fas fa-users me-2"></i>
                <strong>Mapeos de Nómina</strong>
            </div>
            <div class="card-body">
                <div id="mapeos-NOM-container"></div>
            </div>
        </div>
    </div>

    <!-- ACT - Activos Fijos -->
    <div class="tab-pane fade" id="modulo-ACT" role="tabpanel">
        <div class="card shadow-custom">
            <div class="card-header" style="background-color: #6c757d; color: white;">
                <i class="fas fa-building me-2"></i>
                <strong>Mapeos de Activos Fijos</strong>
            </div>
            <div class="card-body">
                <div id="mapeos-ACT-container"></div>
            </div>
        </div>
    </div>
</div>

<!-- Modal for Create/Edit Mapping -->
<div class="modal fade" id="modalMapeo" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalMapeoTitle">
                    <i class="fas fa-plug me-2"></i>Nuevo Mapeo de Cuenta
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="formMapeo">
                <div class="modal-body">
                    <input type="hidden" id="MapeoId" name="Id">

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="MapeoModulo" class="form-label">
                                <i class="fas fa-cube me-1"></i>Módulo <span class="text-danger">*</span>
                            </label>
                            <select class="form-select" id="MapeoModulo" name="Modulo" required>
                                <option value="">Seleccione un módulo</option>
                                <option value="VEN">VEN - Ventas</option>
                                <option value="COM">COM - Compras</option>
                                <option value="INV">INV - Inventario</option>
                                <option value="CXC">CXC - Cuentas por Cobrar</option>
                                <option value="CXP">CXP - Cuentas por Pagar</option>
                                <option value="BAN">BAN - Bancos</option>
                                <option value="NOM">NOM - Nómina</option>
                                <option value="ACT">ACT - Activos Fijos</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="MapeoTipoOperacion" class="form-label">
                                <i class="fas fa-tasks me-1"></i>Tipo de Operación <span class="text-danger">*</span>
                            </label>
                            <select class="form-select" id="MapeoTipoOperacion" name="TipoOperacion" required>
                                <option value="">Seleccione primero un módulo</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label for="MapeoCuentaContableId" class="form-label">
                                <i class="fas fa-file-invoice me-1"></i>Cuenta Contable <span class="text-danger">*</span>
                            </label>
                            <select class="form-select" id="MapeoCuentaContableId" name="CuentaContableId" required>
                                <option value="">Seleccione una cuenta contable</option>
                            </select>
                            <div class="form-text">Solo se muestran cuentas que aceptan movimientos</div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="MapeoTipoMovimiento" class="form-label">
                                <i class="fas fa-exchange-alt me-1"></i>Tipo Movimiento <span class="text-danger">*</span>
                            </label>
                            <select class="form-select" id="MapeoTipoMovimiento" name="TipoMovimiento" required>
                                <option value="D">D - Debe</option>
                                <option value="H">H - Haber</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="MapeoDescripcion" class="form-label">
                            <i class="fas fa-comment me-1"></i>Descripcion (Opcional)
                        </label>
                        <textarea class="form-control" id="MapeoDescripcion" name="Descripcion" rows="2" placeholder="Descripcion adicional sobre este mapeo"></textarea>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="MapeoActivo" name="Activo" checked>
                        <label class="form-check-label" for="MapeoActivo">
                            <i class="fas fa-check-circle me-1"></i>Activo
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-2"></i>Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        let allMappings = [];
        let cuentasContables = [];
        let currentModulo = 'VEN';

        $(document).ready(function () {
            initializeSelect2();
            loadMappings();
            setupEventHandlers();
        });

        function initializeSelect2() {
            $('#MapeoCuentaContableId').select2({
                theme: 'bootstrap-5',
                dropdownParent: $('#modalMapeo'),
                placeholder: 'Buscar cuenta...',
                allowClear: true,
                width: '100%'
            });
        }

        function setupEventHandlers() {
            // Tab change handler
            $('button[data-bs-toggle="tab"]').on('shown.bs.tab', function (e) {
                const target = $(e.target).attr('data-bs-target');
                currentModulo = target.replace('#modulo-', '');
                renderMappingsForModule(currentModulo);
            });

            // Module change handler in form
            $('#MapeoModulo').on('change', function () {
                const modulo = $(this).val();
                if (modulo) {
                    loadTiposOperacion(modulo);
                } else {
                    $('#MapeoTipoOperacion').html('<option value="">Seleccione primero un módulo</option>');
                }
            });

            // Form submit handler
            $('#formMapeo').on('submit', function (e) {
                e.preventDefault();
                saveMapeo();
            });
        }

        function loadMappings() {
            $.ajax({
                url: '?handler=Lista',
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.success) {
                        allMappings = response.data || [];
                        renderMappingsForModule(currentModulo);
                    } else {
                        Swal.fire('Error', response.message || 'Error al cargar los mapeos', 'error');
                    }
                },
                error: function () {
                    Swal.fire('Error', 'Error al cargar los mapeos', 'error');
                }
            });
        }

        function renderMappingsForModule(modulo) {
            const moduleMappings = allMappings.filter(m => m.modulo === modulo);
            const container = $(`#mapeos-${modulo}-container`);

            if (moduleMappings.length === 0) {
                container.html(`
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        No hay mapeos configurados para este módulo.
                        <button class="btn btn-sm btn-primary ms-2" onclick="openCreateModalForModule('${modulo}')">
                            <i class="fas fa-plus me-1"></i>Agregar Mapeo
                        </button>
                    </div>
                `);
                return;
            }

            let html = '<div class="table-responsive"><table class="table table-hover table-striped">';
            html += '<thead class="table-light">';
            html += '<tr>';
            html += '<th style="width: 30%;">Tipo de Operación</th>';
            html += '<th style="width: 45%;">Cuenta Contable</th>';
            html += '<th style="width: 10%;" class="text-center">Estado</th>';
            html += '<th style="width: 15%;" class="text-center">Acciones</th>';
            html += '</tr>';
            html += '</thead><tbody>';

            moduleMappings.forEach(mapeo => {
                const estadoBadge = mapeo.activo
                    ? '<span class="badge bg-success">Activo</span>'
                    : '<span class="badge bg-secondary">Inactivo</span>';

                const cuentaInfo = mapeo.cuentaCodigo
                    ? `${mapeo.cuentaCodigo} - ${mapeo.cuentaNombre}`
                    : '<span class="text-danger"><i class="fas fa-exclamation-triangle"></i> Sin cuenta asignada</span>';

                html += '<tr>';
                html += `<td><strong>${mapeo.tipoOperacion}</strong>`;
                if (mapeo.descripcionOperacion) {
                    html += `<br><small class="text-muted">${mapeo.descripcionOperacion}</small>`;
                }
                html += '</td>';
                html += `<td>${cuentaInfo}</td>`;
                html += `<td class="text-center">${estadoBadge}</td>`;
                html += `<td class="text-center">
                    <button class="btn btn-sm btn-info" onclick="editMapeo('${mapeo.id}')" title="Editar">
                        <i class="fas fa-edit"></i>
                    </button>
                    <button class="btn btn-sm btn-danger" onclick="deleteMapeo('${mapeo.id}')" title="Eliminar">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>`;
                html += '</tr>';
            });

            html += '</tbody></table></div>';
            container.html(html);
        }

        function openCreateModal() {
            $('#formMapeo')[0].reset();
            $('#MapeoId').val('');
            $('#MapeoModulo').val(currentModulo).trigger('change');
            $('#MapeoActivo').prop('checked', true);
            $('#modalMapeoTitle').html('<i class="fas fa-plug me-2"></i>Nuevo Mapeo de Cuenta');

            loadCuentasContables();
            loadTiposOperacion(currentModulo);

            $('#modalMapeo').modal('show');
        }

        function openCreateModalForModule(modulo) {
            currentModulo = modulo;
            openCreateModal();
        }

        function editMapeo(id) {
            $.ajax({
                url: '?handler=Detalle&id=' + id,
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.success) {
                        const mapeo = response.data;

                        $('#MapeoId').val(mapeo.id);
                        $('#MapeoModulo').val(mapeo.modulo);
                        $('#MapeoTipoMovimiento').val(mapeo.tipoMovimiento || 'D');
                        $('#MapeoDescripcion').val(mapeo.descripcion || mapeo.descripcionOperacion || '');
                        $('#MapeoActivo').prop('checked', mapeo.activo);
                        $('#modalMapeoTitle').html('<i class="fas fa-edit me-2"></i>Editar Mapeo de Cuenta');

                        loadTiposOperacion(mapeo.modulo, function() {
                            $('#MapeoTipoOperacion').val(mapeo.tipoOperacion);
                        });

                        loadCuentasContables(function() {
                            $('#MapeoCuentaContableId').val(mapeo.cuentaContableId).trigger('change');
                        });

                        $('#modalMapeo').modal('show');
                    } else {
                        Swal.fire('Error', response.message, 'error');
                    }
                }
            });
        }

        function saveMapeo() {
            const mapeoId = $('#MapeoId').val();
            const tipoOperacion = $('#MapeoTipoOperacion').val();
            const mapeo = {
                id: mapeoId || '00000000-0000-0000-0000-000000000000',
                modulo: $('#MapeoModulo').val(),
                tipoOperacion: tipoOperacion,
                conceptoContable: tipoOperacion,
                tipoMovimiento: $('#MapeoTipoMovimiento').val() || 'D',
                descripcion: $('#MapeoDescripcion').val() || null,
                cuentaContableId: $('#MapeoCuentaContableId').val(),
                activo: $('#MapeoActivo').is(':checked')
            };

            const handler = mapeoId ? 'Actualizar' : 'Crear';

            $.ajax({
                url: '?handler=' + handler,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(mapeo),
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.success) {
                        Swal.fire('Éxito', response.message, 'success');
                        $('#modalMapeo').modal('hide');
                        loadMappings();
                    } else {
                        Swal.fire('Error', response.message, 'error');
                    }
                },
                error: function () {
                    Swal.fire('Error', 'Ocurrió un error al guardar el mapeo', 'error');
                }
            });
        }

        function deleteMapeo(id) {
            Swal.fire({
                title: '¿Está seguro?',
                text: "Esta acción eliminará el mapeo de cuenta",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '?handler=Eliminar&id=' + id,
                        type: 'POST',
                        headers: {
                            "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire('Eliminado', response.message, 'success');
                                loadMappings();
                            } else {
                                Swal.fire('Error', response.message, 'error');
                            }
                        }
                    });
                }
            });
        }

        function loadCuentasContables(callback) {
            $.ajax({
                url: '?handler=CuentasContables',
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.success) {
                        cuentasContables = response.data || [];

                        $('#MapeoCuentaContableId').empty().append('<option value="">Seleccione una cuenta</option>');
                        cuentasContables.forEach(cuenta => {
                            $('#MapeoCuentaContableId').append(new Option(cuenta.text, cuenta.id, false, false));
                        });

                        if (callback) callback();
                    }
                }
            });
        }

        function loadTiposOperacion(modulo, callback) {
            $.ajax({
                url: '?handler=TiposOperacion&modulo=' + modulo,
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.success) {
                        const tipos = response.data || [];

                        $('#MapeoTipoOperacion').empty().append('<option value="">Seleccione tipo de operación</option>');
                        tipos.forEach(tipo => {
                            $('#MapeoTipoOperacion').append(new Option(tipo.nombre, tipo.codigo, false, false));
                        });

                        if (callback) callback();
                    }
                }
            });
        }

        function inicializarMapeos() {
            Swal.fire({
                title: '¿Inicializar mapeos?',
                html: 'Se crearán los mapeos predeterminados para todos los módulos.<br><br><strong>Nota:</strong> Deberá asignar las cuentas contables manualmente.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Sí, inicializar',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#6c757d'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '?handler=Seed',
                        type: 'POST',
                        headers: {
                            "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire('Éxito', response.message, 'success');
                                loadMappings();
                            } else {
                                Swal.fire('Error', response.message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Error', 'Ocurrió un error al inicializar los mapeos', 'error');
                        }
                    });
                }
            });
        }
    </script>
}
