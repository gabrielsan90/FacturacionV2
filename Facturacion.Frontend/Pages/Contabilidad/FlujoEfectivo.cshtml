@page
@model Facturacion.Frontend.Pages.Contabilidad.FlujoEfectivoModel
@{
    ViewData["Title"] = "Flujo de Efectivo";
}

<style>
    .flujo-section { border-left: 4px solid; padding: 0.75rem 1rem; margin-bottom: 0.75rem; border-radius: 4px; }
    .flujo-section.operacion { border-left-color: #0d6efd; background: #e8f0fe; }
    .flujo-section.inversion { border-left-color: #fd7e14; background: #fff3e0; }
    .flujo-section.financiamiento { border-left-color: #6f42c1; background: #f3e8ff; }
    .flujo-line { display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px solid #eee; font-size: 0.9rem; }
    .flujo-line .monto.positive { color: #198754; }
    .flujo-line .monto.negative { color: #dc3545; }
    .flujo-total { font-weight: 700; font-size: 1rem; border-top: 2px solid #333; padding-top: 0.5rem; margin-top: 0.5rem; display: flex; justify-content: space-between; }
    .saldo-card { border-radius: 8px; padding: 1rem; text-align: center; border: 2px solid; }
    .saldo-card .value { font-size: 1.5rem; font-weight: 700; }
    .saldo-card.inicio { border-color: #6c757d; background: #f8f9fa; }
    .saldo-card.variacion { border-color: #0d6efd; background: #e8f0fe; }
    .saldo-card.final { border-color: #198754; background: #e8f5e9; }
    .arrow-connector { display: flex; align-items: center; justify-content: center; font-size: 1.5rem; color: #6c757d; }
    @@media print { .no-print { display: none !important; } }
</style>

<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <div>
        <h4 class="mb-0"><i class="fas fa-money-bill-wave me-2"></i>Estado de Flujo de Efectivo</h4>
        <small class="text-muted">Método directo — Movimientos en cuentas de caja y bancos</small>
    </div>
</div>

<div class="card mb-3 no-print">
    <div class="card-body py-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label mb-1">Fecha Desde</label>
                <input type="date" id="fechaDesde" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label mb-1">Fecha Hasta</label>
                <input type="date" id="fechaHasta" class="form-control form-control-sm" />
            </div>
            <div class="col-md-8 text-end">
                <button class="btn btn-primary btn-sm" onclick="generarReporte()"><i class="fas fa-play me-1"></i>Generar</button>
                <button class="btn btn-secondary btn-sm" onclick="window.print()"><i class="fas fa-print me-1"></i>Imprimir</button>
            </div>
        </div>
    </div>
</div>

<!-- Saldo Cards -->
<div class="row g-2 mb-3" id="saldoCards" style="display:none;">
    <div class="col-md-3">
        <div class="saldo-card inicio">
            <small class="text-muted">Saldo Inicial Efectivo</small>
            <div class="value" id="valSaldoInicial">0.00</div>
        </div>
    </div>
    <div class="col-md-1 arrow-connector"><i class="fas fa-plus"></i></div>
    <div class="col-md-4">
        <div class="saldo-card variacion">
            <small class="text-muted">Variación Neta</small>
            <div class="value" id="valVariacion">0.00</div>
        </div>
    </div>
    <div class="col-md-1 arrow-connector"><i class="fas fa-equals"></i></div>
    <div class="col-md-3">
        <div class="saldo-card final">
            <small class="text-muted">Saldo Final Efectivo</small>
            <div class="value text-success" id="valSaldoFinal">0.00</div>
        </div>
    </div>
</div>

<div id="reportContent" style="display:none;">
    <div class="card">
        <div class="card-body">
            <div class="flujo-section operacion">
                <h5><i class="fas fa-industry me-1"></i>Actividades de Operación</h5>
                <div id="listaOperacion"></div>
                <div class="flujo-total">
                    <span>Flujo Neto de Operación</span>
                    <span id="totalOperacion">0.00</span>
                </div>
            </div>

            <div class="flujo-section inversion">
                <h5><i class="fas fa-building me-1"></i>Actividades de Inversión</h5>
                <div id="listaInversion"></div>
                <div class="flujo-total">
                    <span>Flujo Neto de Inversión</span>
                    <span id="totalInversion">0.00</span>
                </div>
            </div>

            <div class="flujo-section financiamiento">
                <h5><i class="fas fa-hand-holding-usd me-1"></i>Actividades de Financiamiento</h5>
                <div id="listaFinanciamiento"></div>
                <div class="flujo-total">
                    <span>Flujo Neto de Financiamiento</span>
                    <span id="totalFinanciamiento">0.00</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="emptyState" class="text-center text-muted py-5">
    <i class="fas fa-money-bill-wave fa-3x mb-3"></i>
    <p>Seleccione las fechas y haga clic en Generar</p>
</div>

@section Scripts {
<script>
    const fmt = n => new Intl.NumberFormat('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);

    $(function () {
        const hoy = new Date();
        $('#fechaDesde').val(new Date(hoy.getFullYear(), hoy.getMonth(), 1).toISOString().split('T')[0]);
        $('#fechaHasta').val(hoy.toISOString().split('T')[0]);
    });

    function generarReporte() {
        const fechaDesde = $('#fechaDesde').val();
        const fechaHasta = $('#fechaHasta').val();
        if (!fechaDesde || !fechaHasta) { showError('Seleccione ambas fechas.'); return; }

        $('#emptyState').hide();

        $.ajax({
            url: `?handler=Generar&fechaDesde=${fechaDesde}&fechaHasta=${fechaHasta}`,
            type: 'GET',
            success: function (data) { renderReport(data); },
            error: function (xhr) { handleAjaxError(xhr); }
        });
    }

    function renderLines(lineas, containerId) {
        let html = '';
        if (!lineas || lineas.length === 0) {
            html = '<div class="text-muted py-2" style="font-size:0.85rem;">Sin movimientos en este período</div>';
        } else {
            lineas.forEach(l => {
                const cls = l.monto >= 0 ? 'positive' : 'negative';
                const prefix = l.monto >= 0 ? '+' : '';
                html += `<div class="flujo-line">
                    <span>${l.concepto}</span>
                    <span class="monto ${cls}">${prefix}${fmt(l.monto)}</span>
                </div>`;
            });
        }
        $(`#${containerId}`).html(html);
    }

    function renderReport(data) {
        renderLines(data.actividadesOperacion?.lineas, 'listaOperacion');
        renderLines(data.actividadesInversion?.lineas, 'listaInversion');
        renderLines(data.actividadesFinanciamiento?.lineas, 'listaFinanciamiento');

        const fmtTotal = (val, id) => {
            const el = $(`#${id}`);
            el.text(fmt(val));
            el.css('color', val >= 0 ? '#198754' : '#dc3545');
        };

        fmtTotal(data.actividadesOperacion?.total || 0, 'totalOperacion');
        fmtTotal(data.actividadesInversion?.total || 0, 'totalInversion');
        fmtTotal(data.actividadesFinanciamiento?.total || 0, 'totalFinanciamiento');

        $('#valSaldoInicial').text(fmt(data.saldoInicialEfectivo || 0));
        $('#valVariacion').text(fmt(data.variacionNeta || 0));
        $('#valVariacion').css('color', (data.variacionNeta || 0) >= 0 ? '#198754' : '#dc3545');
        $('#valSaldoFinal').text(fmt(data.saldoFinalEfectivo || 0));

        $('#reportContent').show();
        $('#saldoCards').show();
    }
</script>
}
