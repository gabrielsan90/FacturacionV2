@page
@model Facturacion.Frontend.Pages.Contabilidad.EstadoResultadosModel
@{
    ViewData["Title"] = "Estado de Resultados";
}

<style>
    .er-section { border-left: 4px solid; padding: 0.75rem 1rem; margin-bottom: 0.75rem; border-radius: 4px; }
    .er-section.ingresos { border-left-color: #198754; background: #e8f5e9; }
    .er-section.costos { border-left-color: #fd7e14; background: #fff3e0; }
    .er-section.gastos { border-left-color: #dc3545; background: #fde8e8; }
    .er-line { display: flex; justify-content: space-between; padding: 0.2rem 0; border-bottom: 1px solid #eee; font-size: 0.9rem; }
    .er-line.nivel-1 { font-weight: 700; }
    .er-line.nivel-2 { font-weight: 600; padding-left: 1rem; }
    .er-line.nivel-3 { padding-left: 2rem; }
    .er-line.nivel-4 { padding-left: 3rem; color: #555; }
    .er-total { font-weight: 700; font-size: 1rem; border-top: 2px solid #333; padding-top: 0.5rem; margin-top: 0.5rem; display: flex; justify-content: space-between; }
    .result-card { border-radius: 8px; padding: 1rem; text-align: center; border: 2px solid; }
    .result-card .label { font-size: 0.85rem; text-transform: uppercase; }
    .result-card .value { font-size: 1.5rem; font-weight: 700; }
    .result-card.positive { border-color: #198754; background: #e8f5e9; }
    .result-card.negative { border-color: #dc3545; background: #fde8e8; }
    @@media print { .no-print { display: none !important; } }
</style>

<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <div>
        <h4 class="mb-0"><i class="fas fa-chart-line me-2"></i>Estado de Resultados</h4>
        <small class="text-muted">Ingresos, costos y gastos del período</small>
    </div>
</div>

<div class="card mb-3 no-print">
    <div class="card-body py-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label mb-1">Fecha Desde</label>
                <input type="date" id="fechaDesde" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label mb-1">Fecha Hasta</label>
                <input type="date" id="fechaHasta" class="form-control form-control-sm" />
            </div>
            <div class="col-md-8 text-end">
                <button class="btn btn-primary btn-sm" onclick="generarReporte()"><i class="fas fa-play me-1"></i>Generar</button>
                <button class="btn btn-success btn-sm" onclick="exportarExcel()" id="btnExcel" disabled><i class="fas fa-file-excel me-1"></i>Excel</button>
                <button class="btn btn-secondary btn-sm" onclick="window.print()"><i class="fas fa-print me-1"></i>Imprimir</button>
            </div>
        </div>
    </div>
</div>

<!-- Result Summary Cards -->
<div class="row g-2 mb-3" id="resultCards" style="display:none;">
    <div class="col-md-3">
        <div class="result-card positive">
            <div class="label">Total Ingresos</div>
            <div class="value text-success" id="valIngresos">0.00</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="result-card negative">
            <div class="label">Utilidad Bruta</div>
            <div class="value" id="valUtilidadBruta">0.00</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="result-card negative">
            <div class="label">Total Gastos</div>
            <div class="value text-danger" id="valGastos">0.00</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="result-card" id="cardUtilidadNeta">
            <div class="label">Utilidad Neta</div>
            <div class="value" id="valUtilidadNeta">0.00</div>
        </div>
    </div>
</div>

<div id="reportContent" style="display:none;">
    <div class="card">
        <div class="card-body">
            <div class="er-section ingresos">
                <h5><i class="fas fa-plus-circle me-1"></i>INGRESOS</h5>
                <div id="listaIngresos"></div>
                <div class="er-total">
                    <span>Total Ingresos</span>
                    <span id="totalIngresos">0.00</span>
                </div>
            </div>

            <div class="er-section costos">
                <h5><i class="fas fa-minus-circle me-1"></i>COSTO DE VENTAS</h5>
                <div id="listaCostos"></div>
                <div class="er-total">
                    <span>Total Costo de Ventas</span>
                    <span id="totalCostos">0.00</span>
                </div>
            </div>

            <div class="er-total" style="font-size:1.1rem; margin: 1rem 0; padding: 0.75rem; background: #fff3cd; border-radius: 4px;">
                <span><i class="fas fa-arrow-right me-1"></i>UTILIDAD BRUTA</span>
                <span id="utilidadBruta">0.00</span>
            </div>

            <div class="er-section gastos">
                <h5><i class="fas fa-minus-circle me-1"></i>GASTOS DE OPERACIÓN</h5>
                <div id="listaGastos"></div>
                <div class="er-total">
                    <span>Total Gastos</span>
                    <span id="totalGastos">0.00</span>
                </div>
            </div>

            <div class="er-total" style="font-size:1.2rem; margin-top: 1rem; padding: 0.75rem; border-radius: 4px;" id="lineaUtilidadNeta">
                <span><i class="fas fa-flag-checkered me-1"></i>UTILIDAD NETA DEL PERÍODO</span>
                <span id="utilidadNeta">0.00</span>
            </div>
        </div>
    </div>
</div>

<div id="emptyState" class="text-center text-muted py-5">
    <i class="fas fa-chart-line fa-3x mb-3"></i>
    <p>Seleccione las fechas y haga clic en Generar</p>
</div>

@section Scripts {
<script>
    const fmt = n => new Intl.NumberFormat('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);

    $(function () {
        const hoy = new Date();
        $('#fechaDesde').val(new Date(hoy.getFullYear(), hoy.getMonth(), 1).toISOString().split('T')[0]);
        $('#fechaHasta').val(hoy.toISOString().split('T')[0]);
    });

    function generarReporte() {
        const fechaDesde = $('#fechaDesde').val();
        const fechaHasta = $('#fechaHasta').val();
        if (!fechaDesde || !fechaHasta) { showError('Seleccione ambas fechas.'); return; }

        $('#emptyState').hide();
        $.ajax({
            url: `?handler=Generar&fechaDesde=${fechaDesde}&fechaHasta=${fechaHasta}`,
            type: 'GET',
            success: function (data) { renderReport(data); },
            error: function (xhr) { handleAjaxError(xhr); }
        });
    }

    function renderLines(cuentas, containerId) {
        let html = '';
        if (cuentas) {
            cuentas.forEach(c => {
                html += `<div class="er-line nivel-${c.nivel}">
                    <span>${c.codigo} ${c.nombre}</span>
                    <span>${fmt(c.saldo)}</span>
                </div>`;
            });
        }
        $(`#${containerId}`).html(html);
    }

    function renderReport(data) {
        renderLines(data.ingresos?.cuentas, 'listaIngresos');
        renderLines(data.costosVentas?.cuentas, 'listaCostos');
        renderLines(data.gastos?.cuentas, 'listaGastos');

        $('#totalIngresos').text(fmt(data.totalIngresos));
        $('#totalCostos').text(fmt(data.totalCostosVentas));
        $('#utilidadBruta').text(fmt(data.utilidadBruta));
        $('#totalGastos').text(fmt(data.totalGastos));
        $('#utilidadNeta').text(fmt(data.utilidadNeta));

        $('#valIngresos').text(fmt(data.totalIngresos));
        $('#valUtilidadBruta').text(fmt(data.utilidadBruta));
        $('#valGastos').text(fmt(data.totalGastos));
        $('#valUtilidadNeta').text(fmt(data.utilidadNeta));

        const isPositive = data.utilidadNeta >= 0;
        $('#cardUtilidadNeta').removeClass('positive negative').addClass(isPositive ? 'positive' : 'negative');
        $('#valUtilidadNeta').removeClass('text-success text-danger').addClass(isPositive ? 'text-success' : 'text-danger');
        $('#lineaUtilidadNeta').css('background', isPositive ? '#e8f5e9' : '#fde8e8');

        $('#reportContent').show();
        $('#resultCards').show();
        $('#btnExcel').prop('disabled', false);
    }

    function exportarExcel() {
        window.location.href = `?handler=ExportarExcel&fechaDesde=${$('#fechaDesde').val()}&fechaHasta=${$('#fechaHasta').val()}`;
    }
</script>
}
