@page
@model Facturacion.Frontend.Pages.Contabilidad.PlanCuentasModel
@{
    ViewData["Title"] = "Plan de Cuentas";
    ViewData["Breadcrumb"] = "Plan de Cuentas";
}

<style>
    .tree-table { width: 100%; border-collapse: collapse; }
    .tree-table thead th { background: #f8f9fa; border-bottom: 2px solid #dee2e6; padding: 10px 12px; font-size: 0.85rem; text-transform: uppercase; color: #6c757d; letter-spacing: 0.5px; }
    .tree-table tbody tr { border-bottom: 1px solid #eee; transition: background-color 0.15s; }
    .tree-table tbody tr:hover { background-color: #f0f4ff; }
    .tree-table tbody td { padding: 7px 12px; vertical-align: middle; font-size: 0.875rem; }
    .tree-table .tree-cell { white-space: nowrap; }
    .tree-toggle { display: inline-flex; align-items: center; justify-content: center; width: 20px; height: 20px; cursor: pointer; color: #6c757d; transition: transform 0.2s; border: none; background: none; padding: 0; margin-right: 4px; }
    .tree-toggle:hover { color: #0d6efd; }
    .tree-toggle.expanded i { transform: rotate(90deg); }
    .tree-toggle-placeholder { display: inline-block; width: 24px; }
    .tree-level-1 td:first-child { font-weight: 700; font-size: 0.9rem; }
    .tree-level-1 { background-color: #f0f4ff; }
    .tree-level-2 td:first-child { font-weight: 600; }
    .tree-level-2 { background-color: #f8f9fc; }
    .tree-level-3 td:first-child { font-weight: 500; }
    .tree-level-4 { color: #555; }
    .tree-codigo { font-family: 'SFMono-Regular', Consolas, monospace; margin-right: 8px; }
    .tree-nombre { color: #333; }
    .tree-search { max-width: 250px; }
</style>

<!-- Page Header -->
<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <h2><i class="fas fa-sitemap"></i> Plan de Cuentas</h2>
            <p class="mb-0">Gestión del catálogo de cuentas contables</p>
        </div>
        <div class="btn-group">
            <button class="btn btn-info" onclick="descargarPlantilla()" title="Descargar plantilla Excel">
                <i class="fas fa-file-excel me-2"></i>Plantilla Excel
            </button>
            <button class="btn btn-warning" onclick="cargarExcel()" title="Importar cuentas desde Excel">
                <i class="fas fa-upload me-2"></i>Importar Excel
            </button>
            <button class="btn btn-success" onclick="generarPlanDefecto()" title="Generar plan de cuentas estándar CR">
                <i class="fas fa-magic me-2"></i>Generar Plan CR
            </button>
            <button class="btn btn-primary" onclick="openCreateModal()">
                <i class="fas fa-plus me-2"></i>Nueva Cuenta
            </button>
        </div>
    </div>
</div>

<!-- Input file oculto para Excel -->
<input type="file" id="fileExcel" accept=".xlsx,.xls" style="display:none" onchange="procesarExcel(this)">

<!-- Filters Card -->
<div class="card shadow-custom mb-4">
    <div class="card-body py-3">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label small mb-1">Tipo de Cuenta</label>
                <select class="form-select form-select-sm" id="filtroTipo" onchange="filtrarTabla()">
                    <option value="">Todos</option>
                    <option value="ACT">Activo</option>
                    <option value="PAS">Pasivo</option>
                    <option value="CAP">Capital</option>
                    <option value="ING">Ingreso</option>
                    <option value="GAS">Gasto</option>
                    <option value="COS">Costo</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Nivel</label>
                <select class="form-select form-select-sm" id="filtroNivel" onchange="filtrarTabla()">
                    <option value="">Todos</option>
                    <option value="1">Grupo</option>
                    <option value="2">Subgrupo</option>
                    <option value="3">Cuenta</option>
                    <option value="4">Subcuenta</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Estado</label>
                <select class="form-select form-select-sm" id="filtroActivo" onchange="filtrarTabla()">
                    <option value="1">Activas</option>
                    <option value="0">Inactivas</option>
                    <option value="">Todas</option>
                </select>
            </div>
            <div class="col-md-3">
                <button class="btn btn-outline-secondary btn-sm" onclick="limpiarFiltros()">
                    <i class="fas fa-eraser me-1"></i>Limpiar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Table Card -->
<div class="card shadow-custom">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center">
            <i class="fas fa-sitemap me-2 text-primary"></i>
            <strong>Catálogo de Cuentas</strong>
            <span class="badge bg-secondary ms-2" id="badgeTotal">0</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <input type="text" class="form-control form-control-sm tree-search" id="txtBuscar"
                   placeholder="Buscar cuenta..." oninput="filtrarTabla()">
            <div class="btn-group btn-group-sm">
                <button type="button" class="btn btn-outline-success" onclick="expandAll()" title="Expandir todo">
                    <i class="fas fa-expand-alt"></i>
                </button>
                <button type="button" class="btn btn-outline-secondary" onclick="collapseAll()" title="Colapsar todo">
                    <i class="fas fa-compress-alt"></i>
                </button>
                <button type="button" class="btn btn-outline-primary" onclick="exportarExcel()" title="Exportar a Excel">
                    <i class="fas fa-file-excel"></i>
                </button>
                <button type="button" class="btn btn-outline-primary" onclick="refrescarTabla()" title="Refrescar">
                    <i class="fas fa-sync-alt"></i>
                </button>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div id="tableLoader" class="text-center py-5">
            <div class="spinner-modern mx-auto"></div>
            <p class="text-muted mt-3">Cargando cuentas...</p>
        </div>

        <div class="table-responsive" id="tableContainer" style="display:none;">
            <table class="tree-table" id="tableCuentas">
                <thead>
                    <tr>
                        <th>Cuenta</th>
                        <th style="width:100px;">Tipo</th>
                        <th style="width:100px;">Naturaleza</th>
                        <th style="width:100px;" class="text-center">Acepta Mov.</th>
                        <th style="width:90px;">Estado</th>
                        <th style="width:100px;">Acciones</th>
                    </tr>
                </thead>
                <tbody id="treeBody"></tbody>
            </table>
        </div>

        <div id="emptyState" class="empty-state" style="display:none;">
            <div class="empty-state-icon">
                <i class="fas fa-sitemap"></i>
            </div>
            <h3 class="empty-state-title">No hay cuentas registradas</h3>
            <p class="empty-state-description">Comienza creando el plan de cuentas</p>
            <button class="btn btn-primary" onclick="openCreateModal()">
                <i class="fas fa-plus me-2"></i>Crear Primera Cuenta
            </button>
        </div>
    </div>
</div>

<!-- Modal Create/Edit -->
<div class="modal fade" id="modalCuenta" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitle">Nueva Cuenta</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="formCuenta">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="Cuenta_Id" />

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Código <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="Cuenta_Codigo" maxlength="20" required
                                   placeholder="Ej: 1.1.01.001">
                            <div class="form-text">Código jerárquico único</div>
                        </div>
                        <div class="col-md-8 mb-3">
                            <label class="form-label">Nombre <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="Cuenta_Nombre" maxlength="200" required>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Tipo de Cuenta <span class="text-danger">*</span></label>
                            <select class="form-select" id="Cuenta_TipoCuenta" required>
                                <option value="">Seleccione...</option>
                                <option value="ACT">Activo</option>
                                <option value="PAS">Pasivo</option>
                                <option value="CAP">Capital</option>
                                <option value="ING">Ingreso</option>
                                <option value="GAS">Gasto</option>
                                <option value="COS">Costo</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Naturaleza <span class="text-danger">*</span></label>
                            <select class="form-select" id="Cuenta_Naturaleza" required>
                                <option value="">Seleccione...</option>
                                <option value="D">Deudora</option>
                                <option value="A">Acreedora</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Cuenta Padre</label>
                            <select class="form-select" id="Cuenta_CuentaPadreId">
                                <option value="">-- Ninguna (Cuenta Raíz) --</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 mb-3">
                            <label class="form-label">Descripción</label>
                            <textarea class="form-control" id="Cuenta_Descripcion" rows="2" maxlength="500"></textarea>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="Cuenta_AceptaMovimientos" checked>
                                <label class="form-check-label" for="Cuenta_AceptaMovimientos">Acepta Movimientos</label>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="Cuenta_RequiereCentroCosto">
                                <label class="form-check-label" for="Cuenta_RequiereCentroCosto">Requiere Centro de Costo</label>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="Cuenta_Activo" checked>
                                <label class="form-check-label" for="Cuenta_Activo">Activa</label>
                            </div>
                        </div>
                    </div>

                    <div class="row" id="rowSaldoInicial" style="display:none;">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Saldo Inicial</label>
                            <input type="number" class="form-control" id="Cuenta_SaldoInicial" step="0.01" value="0">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" id="btnGuardar">
                        <i class="fas fa-save me-2"></i>Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal para resultado de importación -->
<div class="modal fade" id="modalResultadoImportacion" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fas fa-file-excel me-2"></i>Resultado de Importación</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="resultadoImportacion"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let cuentasData = [];
    let childrenMap = {};
    let expandedNodes = new Set();
    const modal = new bootstrap.Modal(document.getElementById('modalCuenta'));

    const tipoBadges = {
        'ACT': '<span class="badge bg-primary">Activo</span>',
        'PAS': '<span class="badge bg-danger">Pasivo</span>',
        'CAP': '<span class="badge bg-success">Capital</span>',
        'ING': '<span class="badge bg-info">Ingreso</span>',
        'GAS': '<span class="badge bg-warning text-dark">Gasto</span>',
        'COS': '<span class="badge bg-secondary">Costo</span>'
    };

    $(document).ready(function() {
        cargarDatos();

        $('#formCuenta').on('submit', function(e) {
            e.preventDefault();
            guardarCuenta();
        });

        $('#Cuenta_TipoCuenta').on('change', function() {
            const tipo = $(this).val();
            if (['ACT', 'GAS', 'COS'].includes(tipo)) {
                $('#Cuenta_Naturaleza').val('D');
            } else if (['PAS', 'CAP', 'ING'].includes(tipo)) {
                $('#Cuenta_Naturaleza').val('A');
            }
        });
    });

    // ========== TREE RENDERING ==========

    function buildTree() {
        childrenMap = {};
        cuentasData.forEach(c => {
            const parentId = c.cuentaPadreId || '__root__';
            if (!childrenMap[parentId]) childrenMap[parentId] = [];
            childrenMap[parentId].push(c);
        });
    }

    function getFilterValues() {
        return {
            tipo: $('#filtroTipo').val(),
            nivel: $('#filtroNivel').val(),
            activo: $('#filtroActivo').val(),
            texto: ($('#txtBuscar').val() || '').toLowerCase().trim()
        };
    }

    function cuentaMatchesFilter(c, filters) {
        if (filters.tipo && c.tipoCuenta !== filters.tipo) return false;
        if (filters.nivel && c.nivel !== parseInt(filters.nivel)) return false;
        if (filters.activo !== '' && filters.activo !== undefined) {
            const isActivo = filters.activo === '1';
            if (c.activo !== isActivo) return false;
        }
        if (filters.texto) {
            const searchStr = ((c.codigo || '') + ' ' + (c.nombre || '')).toLowerCase();
            if (!searchStr.includes(filters.texto)) return false;
        }
        return true;
    }

    // Check if a node or any of its descendants matches the filter
    function nodeOrDescendantMatches(nodeId, filters) {
        const node = cuentasData.find(c => c.id === nodeId);
        if (node && cuentaMatchesFilter(node, filters)) return true;
        const children = childrenMap[nodeId] || [];
        return children.some(child => nodeOrDescendantMatches(child.id, filters));
    }

    function hasActiveFilters(filters) {
        return filters.tipo || filters.nivel || filters.activo !== '1' || filters.texto;
    }

    function renderTree() {
        buildTree();
        const tbody = document.getElementById('treeBody');
        tbody.innerHTML = '';

        const filters = getFilterValues();
        const isFiltered = hasActiveFilters(filters);
        const roots = childrenMap['__root__'] || [];
        let visibleCount = 0;

        function renderNode(cuenta, depth) {
            const children = childrenMap[cuenta.id] || [];
            const hasChildren = children.length > 0;

            // When filtering, skip nodes that don't match AND have no matching descendants
            if (isFiltered && !nodeOrDescendantMatches(cuenta.id, filters)) return;

            const selfMatches = cuentaMatchesFilter(cuenta, filters);
            visibleCount++;

            const tr = document.createElement('tr');
            tr.dataset.id = cuenta.id;
            tr.dataset.parentId = cuenta.cuentaPadreId || '';
            tr.dataset.level = cuenta.nivel;
            tr.className = `tree-level-${cuenta.nivel}`;

            // Determine visibility: root nodes always visible; children visible if parent expanded or if filtered
            const isRoot = !cuenta.cuentaPadreId;
            if (!isRoot && !isFiltered) {
                tr.style.display = expandedNodes.has(cuenta.cuentaPadreId) ? '' : 'none';
            }

            // When filtered, auto-expand to show matching nodes
            if (isFiltered && hasChildren) {
                expandedNodes.add(cuenta.id);
            }

            const indent = depth * 28;
            const isExpanded = expandedNodes.has(cuenta.id);

            let toggleHtml;
            if (hasChildren) {
                toggleHtml = `<button class="tree-toggle ${isExpanded ? 'expanded' : ''}" onclick="toggleNode('${cuenta.id}', event)"><i class="fas fa-chevron-right"></i></button>`;
            } else {
                toggleHtml = '<span class="tree-toggle-placeholder"></span>';
            }

            const opacityClass = selfMatches || !isFiltered ? '' : ' opacity-50';

            tr.innerHTML = `
                <td class="tree-cell">
                    <span style="padding-left:${indent}px; display:inline-flex; align-items:center;" class="${opacityClass}">
                        ${toggleHtml}
                        <span class="tree-codigo">${escapeHtml(cuenta.codigo)}</span>
                        <span class="tree-nombre">${escapeHtml(cuenta.nombre)}</span>
                    </span>
                </td>
                <td>${tipoBadges[cuenta.tipoCuenta] || cuenta.tipoCuenta}</td>
                <td>${cuenta.naturaleza === 'D' ? 'Deudora' : 'Acreedora'}</td>
                <td class="text-center">${cuenta.aceptaMovimientos
                    ? '<i class="fas fa-check text-success"></i>'
                    : '<i class="fas fa-times text-muted"></i>'}</td>
                <td>${cuenta.activo
                    ? '<span class="badge bg-success">Activa</span>'
                    : '<span class="badge bg-secondary">Inactiva</span>'}</td>
                <td>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-primary" onclick="editarCuenta('${cuenta.id}')" title="Editar">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button class="btn btn-outline-danger" onclick="eliminarCuenta('${cuenta.id}')" title="Eliminar">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </td>
            `;
            tbody.appendChild(tr);

            children.forEach(child => renderNode(child, depth + 1));
        }

        roots.forEach(root => renderNode(root, 0));
        $('#badgeTotal').text(visibleCount);

        if (visibleCount === 0 && cuentasData.length > 0) {
            $('#tableContainer').show();
            $('#emptyState').hide();
        }
    }

    function escapeHtml(str) {
        if (!str) return '';
        const div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
    }

    function toggleNode(id, event) {
        if (event) event.stopPropagation();

        if (expandedNodes.has(id)) {
            // Collapse: remove from expanded and recursively collapse descendants
            collapseNodeAndDescendants(id);
        } else {
            expandedNodes.add(id);
        }
        updateTreeVisibility();
    }

    function collapseNodeAndDescendants(id) {
        expandedNodes.delete(id);
        const children = childrenMap[id] || [];
        children.forEach(child => collapseNodeAndDescendants(child.id));
    }

    function updateTreeVisibility() {
        const tbody = document.getElementById('treeBody');
        const rows = tbody.querySelectorAll('tr');
        const filters = getFilterValues();
        const isFiltered = hasActiveFilters(filters);

        rows.forEach(row => {
            const parentId = row.dataset.parentId;
            const id = row.dataset.id;

            if (!parentId) {
                // Root node — always visible
                row.style.display = '';
            } else if (isFiltered) {
                // When filtering, all rendered rows stay visible
                row.style.display = '';
            } else {
                // Check if all ancestors are expanded
                row.style.display = isAncestorChainExpanded(parentId) ? '' : 'none';
            }

            // Update toggle icon
            const toggle = row.querySelector('.tree-toggle');
            if (toggle) {
                if (expandedNodes.has(id)) {
                    toggle.classList.add('expanded');
                } else {
                    toggle.classList.remove('expanded');
                }
            }
        });
    }

    function isAncestorChainExpanded(parentId) {
        if (!parentId) return true;
        if (!expandedNodes.has(parentId)) return false;
        const parent = cuentasData.find(c => c.id === parentId);
        if (!parent) return true;
        return isAncestorChainExpanded(parent.cuentaPadreId);
    }

    function expandAll() {
        cuentasData.forEach(c => {
            if ((childrenMap[c.id] || []).length > 0) {
                expandedNodes.add(c.id);
            }
        });
        updateTreeVisibility();
    }

    function collapseAll() {
        expandedNodes.clear();
        updateTreeVisibility();
    }

    // ========== DATA LOADING ==========

    function cargarDatos() {
        $.ajax({
            url: '?handler=Data',
            type: 'GET',
            headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
            success: function(response) {
                $('#tableLoader').hide();
                if (response && response.length > 0) {
                    cuentasData = response;
                    // Sort by codigo to ensure tree order
                    cuentasData.sort((a, b) => (a.codigo || '').localeCompare(b.codigo || ''));
                    renderTree();
                    $('#tableContainer').show();
                    $('#emptyState').hide();
                    cargarCuentasPadre();
                } else {
                    cuentasData = [];
                    $('#tableContainer').hide();
                    $('#emptyState').show();
                }
            },
            error: function(xhr) {
                $('#tableLoader').hide();
                Swal.fire('Error', 'No se pudieron cargar las cuentas.', 'error');
            }
        });
    }

    function cargarCuentasPadre() {
        const select = $('#Cuenta_CuentaPadreId');
        select.find('option:not(:first)').remove();
        const cuentasValidas = cuentasData.filter(c => c.nivel < 4);
        cuentasValidas.forEach(c => {
            select.append(`<option value="${c.id}">${c.codigo} - ${c.nombre}</option>`);
        });
    }

    function filtrarTabla() {
        renderTree();
    }

    function limpiarFiltros() {
        $('#filtroTipo').val('');
        $('#filtroNivel').val('');
        $('#filtroActivo').val('1');
        $('#txtBuscar').val('');
        expandedNodes.clear();
        renderTree();
    }

    // ========== CRUD ==========

    function openCreateModal() {
        $('#modalTitle').text('Nueva Cuenta');
        $('#formCuenta')[0].reset();
        $('#Cuenta_Id').val('');
        $('#Cuenta_AceptaMovimientos').prop('checked', true);
        $('#Cuenta_Activo').prop('checked', true);
        $('#rowSaldoInicial').hide();
        modal.show();
    }

    function editarCuenta(id) {
        const cuenta = cuentasData.find(c => c.id === id);
        if (!cuenta) return;

        $('#modalTitle').text('Editar Cuenta');
        $('#Cuenta_Id').val(cuenta.id);
        $('#Cuenta_Codigo').val(cuenta.codigo);
        $('#Cuenta_Nombre').val(cuenta.nombre);
        $('#Cuenta_TipoCuenta').val(cuenta.tipoCuenta);
        $('#Cuenta_Naturaleza').val(cuenta.naturaleza);
        $('#Cuenta_CuentaPadreId').val(cuenta.cuentaPadreId || '');
        $('#Cuenta_Descripcion').val(cuenta.descripcion || '');
        $('#Cuenta_AceptaMovimientos').prop('checked', cuenta.aceptaMovimientos);
        $('#Cuenta_RequiereCentroCosto').prop('checked', cuenta.requiereCentroCosto);
        $('#Cuenta_Activo').prop('checked', cuenta.activo);
        $('#Cuenta_SaldoInicial').val(cuenta.saldoInicial || 0);
        $('#rowSaldoInicial').show();

        modal.show();
    }

    function guardarCuenta() {
        const id = $('#Cuenta_Id').val();
        const cuenta = {
            id: id || '00000000-0000-0000-0000-000000000000',
            codigo: $('#Cuenta_Codigo').val().trim(),
            nombre: $('#Cuenta_Nombre').val().trim(),
            tipoCuenta: $('#Cuenta_TipoCuenta').val(),
            naturaleza: $('#Cuenta_Naturaleza').val(),
            cuentaPadreId: $('#Cuenta_CuentaPadreId').val() || null,
            descripcion: $('#Cuenta_Descripcion').val().trim() || null,
            aceptaMovimientos: $('#Cuenta_AceptaMovimientos').is(':checked'),
            requiereCentroCosto: $('#Cuenta_RequiereCentroCosto').is(':checked'),
            activo: $('#Cuenta_Activo').is(':checked'),
            saldoInicial: parseFloat($('#Cuenta_SaldoInicial').val()) || 0
        };

        $('#btnGuardar').prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Guardando...');

        $.ajax({
            url: '?handler=Save',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(cuenta),
            headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
            success: function(response) {
                modal.hide();
                Swal.fire({
                    icon: 'success',
                    title: id ? 'Cuenta actualizada' : 'Cuenta creada',
                    showConfirmButton: false,
                    timer: 1500
                });
                cargarDatos();
            },
            error: function(xhr) {
                const msg = xhr.responseText || 'Error al guardar la cuenta.';
                Swal.fire('Error', msg, 'error');
            },
            complete: function() {
                $('#btnGuardar').prop('disabled', false).html('<i class="fas fa-save me-2"></i>Guardar');
            }
        });
    }

    function eliminarCuenta(id) {
        const cuenta = cuentasData.find(c => c.id === id);
        if (!cuenta) return;

        Swal.fire({
            title: '¿Eliminar cuenta?',
            html: `Se eliminará la cuenta: <strong>${cuenta.codigo} - ${cuenta.nombre}</strong>`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Sí, eliminar',
            cancelButtonText: 'Cancelar'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '?handler=Delete',
                    type: 'POST',
                    data: { id: id },
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    success: function() {
                        Swal.fire({
                            icon: 'success',
                            title: 'Cuenta eliminada',
                            showConfirmButton: false,
                            timer: 1500
                        });
                        cargarDatos();
                    },
                    error: function(xhr) {
                        Swal.fire('Error', xhr.responseText || 'No se pudo eliminar la cuenta.', 'error');
                    }
                });
            }
        });
    }

    function refrescarTabla() {
        cargarDatos();
    }

    function exportarExcel() {
        window.location.href = '?handler=DescargarPlantilla';
    }

    // ========== FUNCIONES DE EXCEL E IMPORTACIÓN ==========

    function descargarPlantilla() {
        window.location.href = '?handler=DescargarPlantilla';
    }

    function cargarExcel() {
        $('#fileExcel').click();
    }

    function procesarExcel(input) {
        if (input.files && input.files[0]) {
            var file = input.files[0];

            var ext = file.name.split('.').pop().toLowerCase();
            if (ext !== 'xlsx' && ext !== 'xls') {
                Swal.fire('Error', 'Solo se permiten archivos Excel (.xlsx o .xls)', 'error');
                input.value = '';
                return;
            }

            Swal.fire({
                title: 'Importando...',
                text: 'Por favor espere mientras se procesan las cuentas',
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            var formData = new FormData();
            formData.append('file', file);

            $.ajax({
                url: '?handler=ImportarExcel',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    Swal.close();

                    var html = '';
                    if (response.success) {
                        html += '<div class="alert alert-success"><i class="fas fa-check-circle me-2"></i>' + response.message + '</div>';
                    } else {
                        html += '<div class="alert alert-warning"><i class="fas fa-exclamation-circle me-2"></i>' + response.message + '</div>';
                    }

                    html += '<div class="row text-center mb-3">';
                    html += '<div class="col-md-4"><div class="card bg-success text-white"><div class="card-body py-3"><h4 class="mb-0">' + (response.insertados || 0) + '</h4><small>Insertados</small></div></div></div>';
                    html += '<div class="col-md-4"><div class="card bg-warning"><div class="card-body py-3"><h4 class="mb-0">' + (response.actualizados || 0) + '</h4><small>Actualizados</small></div></div></div>';
                    html += '<div class="col-md-4"><div class="card bg-danger text-white"><div class="card-body py-3"><h4 class="mb-0">' + (response.errores || 0) + '</h4><small>Errores</small></div></div></div>';
                    html += '</div>';

                    if (response.detalleErrores && response.detalleErrores.length > 0) {
                        html += '<h6 class="mt-3"><i class="fas fa-exclamation-triangle me-2 text-danger"></i>Detalle de Errores:</h6>';
                        html += '<div class="table-responsive"><table class="table table-sm table-bordered">';
                        html += '<thead class="table-light"><tr><th>Fila</th><th>Código</th><th>Error</th></tr></thead><tbody>';
                        response.detalleErrores.forEach(function(e) {
                            html += '<tr><td>' + e.fila + '</td><td>' + (e.codigo || '-') + '</td><td class="text-danger">' + e.mensaje + '</td></tr>';
                        });
                        html += '</tbody></table></div>';
                    }

                    $('#resultadoImportacion').html(html);
                    new bootstrap.Modal('#modalResultadoImportacion').show();

                    cargarDatos();
                },
                error: function(xhr) {
                    Swal.fire('Error', 'Error al procesar el archivo Excel', 'error');
                }
            });

            input.value = '';
        }
    }

    function generarPlanDefecto() {
        Swal.fire({
            title: 'Generar Plan de Cuentas',
            html: '<p>Se generará el plan de cuentas estándar para Costa Rica.</p>' +
                  '<p><strong>Nota:</strong> Solo funciona si no existen cuentas en el sistema.</p>' +
                  '<p>¿Desea continuar?</p>',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Sí, generar',
            cancelButtonText: 'Cancelar',
            confirmButtonColor: '#198754'
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({
                    title: 'Generando...',
                    text: 'Por favor espere mientras se genera el plan de cuentas',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                $.ajax({
                    url: '?handler=GenerarPlanDefecto',
                    type: 'POST',
                    headers: {
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Plan Generado',
                                html: '<p>' + response.message + '</p>' +
                                      '<p><strong>Total cuentas creadas:</strong> ' + response.total + '</p>'
                            });
                            cargarDatos();
                        } else {
                            Swal.fire('Atención', response.message, 'warning');
                        }
                    },
                    error: function(xhr) {
                        var errorMsg = 'Error al generar el plan de cuentas';
                        if (xhr.responseText) {
                            errorMsg = xhr.responseText;
                        }
                        Swal.fire('Error', errorMsg, 'error');
                    }
                });
            }
        });
    }
</script>
}
