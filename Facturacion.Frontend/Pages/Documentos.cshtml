@page
@model Facturacion.Frontend.Pages.DocumentosModel
@{
    ViewData["Title"] = "Documentos Electrónicos - Hacienda v4.4";
}

<form method="post">
    @Html.AntiForgeryToken()
</form>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2><i class="fas fa-file-invoice"></i> Documentos Electrónicos</h2>
                <div class="btn-group">
                    <button class="btn btn-primary" onclick="openCreateModal('FacturaElectronica')">
                        <i class="fas fa-plus"></i> Factura Electrónica (FE)
                    </button>
                    <button class="btn btn-info" onclick="openCreateModal('TiqueteElectronico')">
                        <i class="fas fa-plus"></i> Tiquete Electrónico (TE)
                    </button>
                    <button class="btn btn-warning" onclick="openCreateModal('NotaDebitoElectronica')">
                        <i class="fas fa-plus"></i> Nota Débito (ND)
                    </button>
                    <button class="btn btn-success" onclick="openCreateModal('NotaCreditoElectronica')">
                        <i class="fas fa-plus"></i> Nota Crédito (NC)
                    </button>
                    <button class="btn btn-secondary" onclick="openCreateModal('FacturaElectronicaExportacion')">
                        <i class="fas fa-plus"></i> Factura Exportación (FEE)
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-filter"></i> Filtros
                        <button class="btn btn-sm btn-link float-end" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFilters">
                            <i class="fas fa-chevron-down"></i>
                        </button>
                    </h5>
                </div>
                <div class="collapse show" id="collapseFilters">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label for="filtroFechaInicio" class="form-label">Fecha Inicio</label>
                                    <input type="date" class="form-control" id="filtroFechaInicio" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label for="filtroFechaFin" class="form-label">Fecha Fin</label>
                                    <input type="date" class="form-control" id="filtroFechaFin" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label for="filtroTipoDocumento" class="form-label">Tipo Documento</label>
                                    <select class="form-select" id="filtroTipoDocumento">
                                        <option value="">Todos</option>
                                        <option value="1">FE - Factura Electrónica</option>
                                        <option value="2">ND - Nota Débito</option>
                                        <option value="3">NC - Nota Crédito</option>
                                        <option value="4">TE - Tiquete Electrónico</option>
                                        <option value="8">FCC - Factura Compra</option>
                                        <option value="9">FEE - Factura Exportación</option>
                                        <option value="7">CCE - Comprobante Compra</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label for="filtroEstado" class="form-label">Estado</label>
                                    <select class="form-select" id="filtroEstado">
                                        <option value="">Todos</option>
                                        <option value="1">Borrador</option>
                                        <option value="2">Pendiente</option>
                                        <option value="3">Procesando</option>
                                        <option value="4">Aceptado</option>
                                        <option value="5">Rechazado</option>
                                        <option value="6">Contingencia</option>
                                        <option value="7">Anulado</option>
                                        <option value="8">Error</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-2">
                                <div class="mb-3">
                                    <label for="filtroAmbiente" class="form-label">Ambiente</label>
                                    <select class="form-select" id="filtroAmbiente">
                                        <option value="">Todos</option>
                                        <option value="1">Pruebas (Sandbox)</option>
                                        <option value="2">Producción</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="mb-3">
                                    <label for="filtroSucursal" class="form-label">Sucursal</label>
                                    <select class="form-select" id="filtroSucursal">
                                        <option value="">Todas</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="mb-3">
                                    <label for="filtroTerminal" class="form-label">Terminal</label>
                                    <select class="form-select" id="filtroTerminal">
                                        <option value="">Todas</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label for="filtroCliente" class="form-label">Cliente</label>
                                    <input type="text" class="form-control" id="filtroCliente" placeholder="Buscar por nombre de cliente..." />
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="mb-3">
                                    <label class="form-label">&nbsp;</label>
                                    <div>
                                        <button class="btn btn-primary w-100 mb-2" onclick="aplicarFiltros()">
                                            <i class="fas fa-search"></i> Filtrar
                                        </button>
                                        <button class="btn btn-secondary w-100 mb-2" onclick="limpiarFiltros()">
                                            <i class="fas fa-eraser"></i> Limpiar
                                        </button>
                                        <button class="btn btn-outline-danger w-100" onclick="verDiagnostico()">
                                            <i class="fas fa-stethoscope"></i> Diagnóstico BD
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Documents Table -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="tableDocumentos" class="table table-striped table-hover table-bordered" style="width:100%">
                            <thead class="table-dark">
                                <tr>
                                    <th>Ambiente</th>
                                    <th>Tipo</th>
                                    <th>Consecutivo</th>
                                    <th>Clave</th>
                                    <th>Cliente/Receptor</th>
                                    <th>Fecha Emisión</th>
                                    <th>Fecha Creación</th>
                                    <th>Total Venta</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal for Create Document -->
<div class="modal fade" id="modalDocumento" tabindex="-1" aria-labelledby="modalDocumentoLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalDocumentoLabel">
                    <i class="fas fa-file-invoice"></i> <span id="modalTitle">Nuevo Documento</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formDocumento">
                <div class="modal-body">
                    <input type="hidden" id="Documento_TipoDocumento" />

                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i> <strong>Nota:</strong> Los detalles del documento (líneas, impuestos, descuentos) se agregarán en la página de edición después de crear el documento.
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="Documento_SucursalId" class="form-label">Sucursal <span class="text-danger">*</span></label>
                                <select class="form-select" id="Documento_SucursalId" required>
                                    <option value="">Seleccione...</option>
                                </select>
                                <div class="invalid-feedback">Seleccione una sucursal.</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="Documento_TerminalId" class="form-label">Terminal <span class="text-danger">*</span></label>
                                <select class="form-select" id="Documento_TerminalId" required>
                                    <option value="">Seleccione...</option>
                                </select>
                                <div class="invalid-feedback">Seleccione una terminal.</div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label for="Documento_ClienteId" class="form-label">Cliente <span class="text-danger">*</span></label>
                                <select class="form-select select2" id="Documento_ClienteId" required>
                                    <option value="">Seleccione...</option>
                                </select>
                                <div class="invalid-feedback">Seleccione un cliente.</div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="Documento_CondicionVenta" class="form-label">Condición Venta <span class="text-danger">*</span></label>
                                <select class="form-select" id="Documento_CondicionVenta" required>
                                    <option value="">Seleccione...</option>
                                    <option value="01">01 - Contado</option>
                                    <option value="02">02 - Crédito</option>
                                    <option value="03">03 - Consignación</option>
                                    <option value="04">04 - Apartado</option>
                                    <option value="05">05 - Arrendamiento con opción de compra</option>
                                    <option value="06">06 - Arrendamiento en función financiera</option>
                                    <option value="07">07 - Cobro a favor de un tercero</option>
                                    <option value="08">08 - Servicios prestados al Estado a crédito</option>
                                    <option value="09">09 - Pago del servicios prestado al Estado</option>
                                    <option value="10">10 - Mercancía no nacionalizada</option>
                                    <option value="99">99 - Otros</option>
                                </select>
                                <div class="invalid-feedback">Seleccione una condición de venta.</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="Documento_MedioPago" class="form-label">Medio Pago <span class="text-danger">*</span></label>
                                <select class="form-select" id="Documento_MedioPago" required>
                                    <option value="">Seleccione...</option>
                                    <option value="01">01 - Efectivo</option>
                                    <option value="02">02 - Tarjeta</option>
                                    <option value="03">03 - Cheque</option>
                                    <option value="04">04 - Transferencia</option>
                                    <option value="05">05 - Recaudado por terceros</option>
                                    <option value="06">06 - SINPE Móvil</option>
                                    <option value="99">99 - Otros</option>
                                </select>
                                <div class="invalid-feedback">Seleccione un medio de pago.</div>
                            </div>
                        </div>
                    </div>

                    <div class="row" id="divPlazoCreditoDias" style="display:none;">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="Documento_PlazoCreditoDias" class="form-label">Plazo Crédito (días)</label>
                                <input type="number" class="form-control" id="Documento_PlazoCreditoDias" min="1" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label for="Documento_Observaciones" class="form-label">Observaciones</label>
                                <textarea class="form-control" id="Documento_Observaciones" rows="2" maxlength="1000"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Crear Documento
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal for Hacienda Response -->
<div class="modal fade" id="modalRespuestaHacienda" tabindex="-1" aria-labelledby="modalRespuestaHaciendaLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalRespuestaHaciendaLabel">
                    <i class="fas fa-file-code"></i> Información de Hacienda
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Información General -->
                <div class="card mb-3">
                    <div class="card-header bg-light">
                        <i class="fas fa-info-circle"></i> <strong>Información del Documento</strong>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>Consecutivo:</strong> <span id="respHacienda_consecutivo">-</span></p>
                                <p><strong>Clave:</strong> <small id="respHacienda_clave" class="text-muted">-</small></p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>Estado:</strong> <span id="respHacienda_estado">-</span></p>
                                <p><strong>Fecha Emisión:</strong> <span id="respHacienda_fechaEmision">-</span></p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Fechas de Hacienda -->
                <div class="card mb-3">
                    <div class="card-header bg-light">
                        <i class="fas fa-clock"></i> <strong>Fechas de Comunicación con Hacienda</strong>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>Fecha Envío:</strong> <span id="respHacienda_fechaEnvio">-</span></p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>Fecha Respuesta:</strong> <span id="respHacienda_fechaRespuesta">-</span></p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Mensaje/Errores de Hacienda -->
                <div class="card mb-3" id="respHacienda_mensajeCard">
                    <div class="card-header" id="respHacienda_mensajeHeader">
                        <i class="fas fa-comment-alt"></i> <strong>Mensaje de Hacienda</strong>
                    </div>
                    <div class="card-body">
                        <div id="respHacienda_mensaje" class="alert mb-0">
                            Sin mensaje
                        </div>
                    </div>
                </div>

                <!-- Mensajes Estructurados (errores detallados) -->
                <div class="card mb-3" id="respHacienda_mensajesEstructuradosCard" style="display: none;">
                    <div class="card-header bg-warning">
                        <i class="fas fa-list"></i> <strong>Detalle de Mensajes/Errores</strong>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-sm table-striped mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 80px;">Código</th>
                                    <th style="width: 80px;">Tipo</th>
                                    <th>Mensaje</th>
                                    <th>Detalle</th>
                                </tr>
                            </thead>
                            <tbody id="respHacienda_mensajesEstructuradosBody">
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- XML de Respuesta -->
                <div class="card" id="respHacienda_xmlCard" style="display: none;">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <span><i class="fas fa-code"></i> <strong>XML de Respuesta de Hacienda</strong></span>
                        <button type="button" class="btn btn-sm btn-secondary" onclick="copyXmlToClipboard()">
                            <i class="fas fa-copy"></i> Copiar XML
                        </button>
                    </div>
                    <div class="card-body p-0">
                        <pre id="xmlRespuestaContent" style="max-height: 400px; overflow-y: auto; background-color: #f8f9fa; padding: 15px; margin: 0; border-radius: 0 0 5px 5px;"><code class="language-xml"></code></pre>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal for Diagnóstico BD -->
<div class="modal fade" id="modalDiagnostico" tabindex="-1" aria-labelledby="modalDiagnosticoLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="modalDiagnosticoLabel">
                    <i class="fas fa-stethoscope"></i> Diagnóstico de Documentos en BD
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="diagnosticoLoading" class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="mt-2">Consultando base de datos...</p>
                </div>
                <div id="diagnosticoContent" style="display:none;">
                    <!-- Resumen -->
                    <div class="row mb-4">
                        <div class="col-md-4">
                            <div class="card bg-primary text-white">
                                <div class="card-body text-center">
                                    <h3 id="diagTotalDocumentos">0</h3>
                                    <p class="mb-0">Total Documentos</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-success text-white">
                                <div class="card-body text-center">
                                    <h3 id="diagDocumentosActivos">0</h3>
                                    <p class="mb-0">Activos (IsDeleted=false)</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-secondary text-white">
                                <div class="card-body text-center">
                                    <h3 id="diagDocumentosEliminados">0</h3>
                                    <p class="mb-0">Eliminados (IsDeleted=true)</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Por Estado -->
                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <strong><i class="fas fa-chart-pie"></i> Documentos por Estado</strong>
                        </div>
                        <div class="card-body">
                            <div id="diagPorEstado" class="d-flex flex-wrap gap-2"></div>
                        </div>
                    </div>

                    <!-- Tabla de documentos -->
                    <div class="card">
                        <div class="card-header bg-light">
                            <strong><i class="fas fa-list"></i> Últimos 20 Documentos (incluye eliminados)</strong>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-sm table-striped table-bordered">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>Consecutivo</th>
                                            <th>Tipo</th>
                                            <th>Estado</th>
                                            <th>Mensaje Hacienda</th>
                                            <th>IsDeleted</th>
                                            <th>Fecha Emisión</th>
                                        </tr>
                                    </thead>
                                    <tbody id="diagTablaDocumentos"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal for Email -->
<div class="modal fade" id="modalEnviarCorreo" tabindex="-1" aria-labelledby="modalEnviarCorreoLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="modalEnviarCorreoLabel">
                    <i class="fas fa-envelope"></i> Enviar Documento por Correo
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formEnviarCorreo">
                <div class="modal-body">
                    <input type="hidden" id="Email_DocumentoId" />

                    <div class="mb-3">
                        <label for="Email_Para" class="form-label">Para <span class="text-danger">*</span></label>
                        <input type="email" class="form-control" id="Email_Para" required placeholder="correo@ejemplo.com" />
                        <div class="form-text">Email principal del cliente</div>
                    </div>

                    <div class="mb-3">
                        <label for="Email_CC" class="form-label">CC (Copia)</label>
                        <input type="text" class="form-control" id="Email_CC" placeholder="correo1@ejemplo.com, correo2@ejemplo.com" />
                        <div class="form-text">Emails separados por coma</div>
                    </div>

                    <div class="mb-3">
                        <label for="Email_CCO" class="form-label">CCO (Copia Oculta)</label>
                        <input type="text" class="form-control" id="Email_CCO" placeholder="correo1@ejemplo.com, correo2@ejemplo.com" />
                        <div class="form-text">Emails separados por coma</div>
                    </div>

                    <div class="mb-3">
                        <label for="Email_Asunto" class="form-label">Asunto <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="Email_Asunto" required maxlength="200" />
                    </div>

                    <div class="mb-3">
                        <label for="Email_Mensaje" class="form-label">Mensaje <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="Email_Mensaje" rows="5" required maxlength="1000"></textarea>
                        <div class="form-text">Mensaje que acompañará el documento electrónico</div>
                    </div>

                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i> Se adjuntarán automáticamente los archivos XML y PDF del documento.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-info">
                        <i class="fas fa-paper-plane"></i> Enviar Correo
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- DataTables -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>

    <!-- Select2 -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <script>
        const empresaId = '@Model.EmpresaId';
        let table;
        let sucursales = [];
        let terminales = [];

        $(document).ready(function () {
            // Initialize date filters to last 30 days
            const today = new Date();
            const thirtyDaysAgo = new Date(today.getTime() - (30 * 24 * 60 * 60 * 1000));
            $('#filtroFechaInicio').val(thirtyDaysAgo.toISOString().split('T')[0]);
            $('#filtroFechaFin').val(today.toISOString().split('T')[0]);

            loadDataTable();
            loadSucursales();
            loadTerminales();

            // Initialize Select2
            $('#Documento_ClienteId').select2({
                theme: 'bootstrap-5',
                dropdownParent: $('#modalDocumento'),
                placeholder: 'Buscar cliente...',
                ajax: {
                    url: `?handler=Clientes&empresaId=${empresaId}`,
                    headers: {
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    },
                    dataType: 'json',
                    delay: 250,
                    processResults: function (data) {
                        return {
                            results: data.map(function (item) {
                                return {
                                    id: item.id,
                                    text: `${item.numeroIdentificacion} - ${item.nombre}`
                                };
                            })
                        };
                    },
                    cache: true
                }
            });

            // Form validation
            $('#formDocumento').on('submit', function (e) {
                e.preventDefault();
                if (this.checkValidity()) {
                    crearDocumento();
                } else {
                    $(this).addClass('was-validated');
                }
            });

            // Show/hide plazo credito when condicion venta changes
            $('#Documento_CondicionVenta').on('change', function () {
                if ($(this).val() === '02') {
                    $('#divPlazoCreditoDias').show();
                    $('#Documento_PlazoCreditoDias').prop('required', true);
                } else {
                    $('#divPlazoCreditoDias').hide();
                    $('#Documento_PlazoCreditoDias').prop('required', false);
                }
            });

            // Load terminals when sucursal changes
            $('#Documento_SucursalId').on('change', function () {
                loadTerminalesBySucursal($(this).val());
            });
        });

        function loadDataTable() {
            table = $('#tableDocumentos').DataTable({
                ajax: {
                    url: buildFilterUrl(),
                    type: 'GET',
                    headers: {
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    },
                    dataSrc: 'data',
                    error: function(xhr, error, code) {
                        console.error('DataTables Ajax Error:', {
                            status: xhr.status,
                            statusText: xhr.statusText,
                            error: error,
                            code: code,
                            responseText: xhr.responseText
                        });

                        let message = 'Error al cargar los documentos.';

                        if (xhr.status === 401) {
                            message = 'Su sesión ha expirado. Por favor, inicie sesión nuevamente.';
                            Swal.fire({
                                title: 'Sesión Expirada',
                                text: message,
                                icon: 'warning',
                                confirmButtonText: 'Ir a Login'
                            }).then(() => {
                                window.location.href = '/Auth/Login';
                            });
                        } else if (xhr.status === 500) {
                            message = 'Error interno del servidor. Por favor, contacte al administrador.';
                            Swal.fire('Error del Servidor', message, 'error');
                        } else if (xhr.status === 0) {
                            message = 'No se puede conectar con el servidor. Verifique su conexión a internet.';
                            Swal.fire('Error de Conexión', message, 'error');
                        } else {
                            try {
                                const response = JSON.parse(xhr.responseText);
                                message = response.error || response.message || message;
                            } catch (e) {
                                message = xhr.statusText || message;
                            }
                            Swal.fire('Error', message, 'error');
                        }
                    }
                },
                columns: [
                    {
                        data: 'ambiente',
                        render: function (data) {
                            return getAmbienteBadge(data);
                        }
                    },
                    {
                        data: 'tipoDocumento',
                        render: function (data) {
                            return getTipoDocumentoBadge(data);
                        }
                    },
                    { data: 'numeroConsecutivo' },
                    {
                        data: 'clave',
                        render: function (data) {
                            if (!data || data.length < 20) return data;
                            return data.substring(0, 10) + '...' + data.substring(data.length - 10);
                        }
                    },
                    {
                        data: 'receptorNombre',
                        defaultContent: '-'
                    },
                    {
                        data: 'fechaEmision',
                        render: function (data) {
                            return new Date(data).toLocaleString('es-CR', {
                                year: 'numeric',
                                month: '2-digit',
                                day: '2-digit',
                                hour: '2-digit',
                                minute: '2-digit'
                            });
                        }
                    },
                    {
                        data: 'fechaCreacion',
                        render: function (data) {
                            return new Date(data).toLocaleString('es-CR', {
                                year: 'numeric',
                                month: '2-digit',
                                day: '2-digit',
                                hour: '2-digit',
                                minute: '2-digit'
                            });
                        }
                    },
                    {
                        data: 'totalVenta',
                        render: function (data) {
                            return '₡' + parseFloat(data).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,');
                        }
                    },
                    {
                        data: 'estado',
                        render: function (data, type, row) {
                            let badge = getEstadoBadge(data);
                            // Si tiene mensaje de Hacienda, agregarlo como información adicional
                            if (row.mensajeHacienda) {
                                const msgClass = (data === 'Rechazado' || data === 'Error') ? 'text-danger' : 'text-muted';
                                const icon = (data === 'Rechazado') ? '<i class="fas fa-exclamation-circle text-danger"></i>' : '<i class="fas fa-info-circle text-info"></i>';
                                badge += `<br><small class="${msgClass}" title="${escapeHtml(row.mensajeHacienda)}">${icon} ${truncateText(row.mensajeHacienda, 40)}</small>`;
                            }
                            return badge;
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        render: function (data, type, row) {
                            const isBorrador = row.estado === "Borrador";
                            const isPendienteOrBorrador = row.estado === "Borrador" || row.estado === "Pendiente";
                            const isAceptadoOrRechazado = row.estado === "Aceptado" || row.estado === "Rechazado";
                            const isProcesando = row.estado === "Procesando";
                            const isError = row.estado === "Error";
                            const hasRespuestaHacienda = row.xmlRespuestaHacienda != null && row.xmlRespuestaHacienda.length > 0;
                            const hasBeenSent = row.fechaEnvioHacienda != null;

                            let buttons = `
                                <button class="btn btn-sm btn-info" onclick="viewDocumento('${row.id}')" title="Ver">
                                    <i class="fas fa-eye"></i>
                                </button>
                            `;

                            if (isBorrador) {
                                buttons += `
                                    <button class="btn btn-sm btn-warning" onclick="editDocumento('${row.id}')" title="Editar">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn btn-sm btn-danger" onclick="deleteDocumento('${row.id}', '${row.numeroConsecutivo}')" title="Eliminar">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                `;
                            }

                            buttons += `
                                <button class="btn btn-sm btn-secondary" onclick="downloadPDF('${row.id}')" title="Descargar PDF">
                                    <i class="fas fa-file-pdf"></i>
                                </button>
                            `;

                            if (isPendienteOrBorrador) {
                                buttons += `
                                    <button class="btn btn-sm btn-success" onclick="sendToHacienda('${row.id}')" title="Enviar a Hacienda">
                                        <i class="fas fa-paper-plane"></i>
                                    </button>
                                `;
                            }

                            // Reintentar envío (solo para documentos con error)
                            if (isError) {
                                buttons += `
                                    <button class="btn btn-sm btn-warning" onclick="reintentarEnvio('${row.id}')" title="Reintentar envío a Hacienda">
                                        <i class="fas fa-redo"></i> Reintentar
                                    </button>
                                `;
                            }

                            // Consultar Estado en Hacienda (solo para documentos en Procesando)
                            if (isProcesando) {
                                buttons += `
                                    <button class="btn btn-sm btn-info" onclick="consultarEstadoHacienda('${row.id}')" title="Consultar Estado en Hacienda">
                                        <i class="fas fa-sync-alt"></i> Consultar
                                    </button>
                                `;
                            }

                            // Ver Respuesta de Hacienda (disponible para todos los documentos)
                            buttons += `
                                <button class="btn btn-sm btn-primary" onclick="verRespuestaHacienda('${row.id}')" title="Ver Respuesta de Hacienda">
                                    <i class="fas fa-file-code"></i>
                                </button>
                            `;

                            // Descargar ZIP (si fue enviado a Hacienda o tiene respuesta - incluye rechazados)
                            if (hasBeenSent || hasRespuestaHacienda) {
                                buttons += `
                                    <button class="btn btn-sm btn-dark" onclick="downloadZIP('${row.id}')" title="Descargar ZIP (XML + Respuesta Hacienda)">
                                        <i class="fas fa-file-archive"></i>
                                    </button>
                                `;
                            }

                            // Reenviar a Hacienda (solo si NO ha sido enviado o está pendiente/borrador)
                            if (isPendienteOrBorrador && !hasBeenSent) {
                                buttons += `
                                    <button class="btn btn-sm btn-warning" onclick="reenviarHacienda('${row.id}')" title="Reenviar a Hacienda">
                                        <i class="fas fa-redo"></i>
                                    </button>
                                `;
                            }

                            // Enviar por Correo (siempre disponible si tiene cliente)
                            if (row.clienteId) {
                                buttons += `
                                    <button class="btn btn-sm btn-info" onclick="openEmailModal('${row.id}', '${row.numeroConsecutivo}', '${row.clienteId}')" title="Enviar por Correo">
                                        <i class="fas fa-envelope"></i>
                                    </button>
                                `;
                            }

                            return buttons;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json'
                },
                pageLength: 25,
                order: [[6, 'desc']] // Order by fecha creación descending (más recientes primero)
            });
        }

        function buildFilterUrl() {
            let url = `?handler=Data&empresaId=${empresaId}`;

            const fechaInicio = $('#filtroFechaInicio').val();
            const fechaFin = $('#filtroFechaFin').val();
            const tipoDocumento = $('#filtroTipoDocumento').val();
            const estado = $('#filtroEstado').val();
            const sucursalId = $('#filtroSucursal').val();
            const terminalId = $('#filtroTerminal').val();
            const ambiente = $('#filtroAmbiente').val();

            if (fechaInicio) url += `&fechaInicio=${fechaInicio}`;
            if (fechaFin) url += `&fechaFin=${fechaFin}`;
            if (tipoDocumento) url += `&tipoDocumento=${tipoDocumento}`;
            if (estado) url += `&estado=${estado}`;
            if (sucursalId) url += `&sucursalId=${sucursalId}`;
            if (terminalId) url += `&terminalId=${terminalId}`;
            if (ambiente) url += `&ambiente=${ambiente}`;

            return url;
        }

        function aplicarFiltros() {
            // Actualizar la URL con los nuevos filtros y recargar
            table.ajax.url(buildFilterUrl()).load();
        }

        function limpiarFiltros() {
            $('#filtroFechaInicio').val('');
            $('#filtroFechaFin').val('');
            $('#filtroTipoDocumento').val('');
            $('#filtroEstado').val('');
            $('#filtroSucursal').val('');
            $('#filtroTerminal').val('');
            $('#filtroCliente').val('');
            $('#filtroAmbiente').val('');
            // Actualizar la URL sin filtros y recargar
            table.ajax.url(buildFilterUrl()).load();
        }

        function loadSucursales() {
            $.ajax({
                url: `?handler=Sucursales&empresaId=${empresaId}`,
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (data) {
                    sucursales = data;
                    const select = $('#Documento_SucursalId');
                    const filterSelect = $('#filtroSucursal');

                    select.empty().append('<option value="">Seleccione...</option>');
                    filterSelect.empty().append('<option value="">Todas</option>');

                    data.forEach(function (item) {
                        select.append(`<option value="${item.id}">${item.nombre}</option>`);
                        filterSelect.append(`<option value="${item.id}">${item.nombre}</option>`);
                    });
                }
            });
        }

        function loadTerminales() {
            $.ajax({
                url: `?handler=Terminales&empresaId=${empresaId}`,
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (data) {
                    terminales = data;
                    const filterSelect = $('#filtroTerminal');
                    filterSelect.empty().append('<option value="">Todas</option>');
                    data.forEach(function (item) {
                        filterSelect.append(`<option value="${item.id}">${item.codigo} - ${item.descripcion}</option>`);
                    });
                }
            });
        }

        function loadTerminalesBySucursal(sucursalId) {
            const select = $('#Documento_TerminalId');
            select.empty().append('<option value="">Seleccione...</option>');

            if (!sucursalId) return;

            const filteredTerminales = terminales.filter(t => t.sucursalId === sucursalId);
            filteredTerminales.forEach(function (item) {
                select.append(`<option value="${item.id}">${item.codigo} - ${item.descripcion}</option>`);
            });
        }

        function getAmbienteBadge(ambiente) {
            const badges = {
                'Pruebas': '<span class="badge bg-warning text-dark"><i class="fas fa-flask"></i> Pruebas</span>',
                'Produccion': '<span class="badge bg-success"><i class="fas fa-check-circle"></i> Producción</span>'
            };
            return badges[ambiente] || `<span class="badge bg-secondary">${ambiente}</span>`;
        }

        function getTipoDocumentoBadge(tipo) {
            const badges = {
                'FacturaElectronica': '<span class="badge bg-primary">FE</span>',
                'NotaDebitoElectronica': '<span class="badge bg-warning">ND</span>',
                'NotaCreditoElectronica': '<span class="badge bg-success">NC</span>',
                'TiqueteElectronico': '<span class="badge bg-info">TE</span>',
                'NotaDebitoElectronicaCompra': '<span class="badge bg-secondary">NDC</span>',
                'NotaCreditoElectronicaCompra': '<span class="badge bg-dark">NCC</span>',
                'ComprobanteCompraElectronico': '<span class="badge bg-light text-dark">CCE</span>',
                'FacturaElectronicaCompra': '<span class="badge bg-primary">FEC</span>',
                'FacturaElectronicaExportacion': '<span class="badge bg-danger">FEE</span>',
                'ReciboElectronicoPago': '<span class="badge bg-success">REP</span>'
            };
            return badges[tipo] || tipo;
        }

        function getEstadoBadge(estado) {
            const badges = {
                'Borrador': '<span class="badge bg-secondary">Borrador</span>',
                'Pendiente': '<span class="badge bg-warning text-dark">Pendiente</span>',
                'Procesando': '<span class="badge bg-info">Procesando</span>',
                'Aceptado': '<span class="badge bg-success">Aceptado</span>',
                'Rechazado': '<span class="badge bg-danger">Rechazado</span>',
                'Contingencia': '<span class="badge" style="background-color: orange;">Contingencia</span>',
                'Anulado': '<span class="badge bg-dark">Anulado</span>',
                'Error': '<span class="badge bg-danger"><i class="fas fa-exclamation-triangle"></i> Error</span>'
            };
            return badges[estado] || estado;
        }

        function openCreateModal(tipoDocumento) {
            const tipos = {
                'FacturaElectronica': { id: 1, nombre: 'Factura Electrónica (FE)' },
                'TiqueteElectronico': { id: 4, nombre: 'Tiquete Electrónico (TE)' },
                'NotaDebitoElectronica': { id: 2, nombre: 'Nota Débito (ND)' },
                'NotaCreditoElectronica': { id: 3, nombre: 'Nota Crédito (NC)' },
                'FacturaElectronicaExportacion': { id: 9, nombre: 'Factura Exportación (FEE)' }
            };

            const tipo = tipos[tipoDocumento];
            $('#modalTitle').text(`Nuevo ${tipo.nombre}`);
            $('#formDocumento')[0].reset();
            $('#formDocumento').removeClass('was-validated');
            $('#Documento_TipoDocumento').val(tipo.id);
            $('#divPlazoCreditoDias').hide();

            // Reset Select2
            $('#Documento_ClienteId').val(null).trigger('change');

            $('#modalDocumento').modal('show');
        }

        function crearDocumento() {
            const tipoDocumento = parseInt($('#Documento_TipoDocumento').val());
            const documento = {
                tipoDocumento: tipoDocumento,
                empresaId: empresaId,
                sucursalId: $('#Documento_SucursalId').val(),
                terminalId: $('#Documento_TerminalId').val(),
                clienteId: $('#Documento_ClienteId').val(),
                condicionVenta: $('#Documento_CondicionVenta').val(),
                medioPago: $('#Documento_MedioPago').val(),
                plazoCreditoDias: $('#Documento_PlazoCreditoDias').val() ? parseInt($('#Documento_PlazoCreditoDias').val()) : null,
                observaciones: $('#Documento_Observaciones').val() || null
            };

            $.ajax({
                url: '?handler=Create',
                type: 'POST',
                contentType: 'application/json',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                data: JSON.stringify(documento),
                success: function (response) {
                    if (response.success) {
                        Swal.fire({
                            title: 'Éxito',
                            text: 'Documento creado en estado Borrador. Ahora puede agregar los detalles.',
                            icon: 'success',
                            confirmButtonText: 'Ir a Editar'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                window.location.href = `/EditarDocumento?id=${response.data.id}`;
                            } else {
                                $('#modalDocumento').modal('hide');
                                table.ajax.reload();
                            }
                        });
                    } else {
                        Swal.fire('Error', response.message, 'error');
                    }
                },
                error: function (xhr) {
                    const message = xhr.responseJSON?.message || xhr.responseText || 'Ocurrió un error al crear el documento.';
                    Swal.fire('Error', message, 'error');
                }
            });
        }

        function viewDocumento(id) {
            window.location.href = `/DocumentoDetalle?id=${id}`;
        }

        function editDocumento(id) {
            window.location.href = `/Facturacion?documentoId=${id}`;
        }

        function deleteDocumento(id, consecutivo) {
            Swal.fire({
                title: '¿Está seguro?',
                text: `¿Desea eliminar el documento "${consecutivo}"? Esta acción no se puede revertir.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: `?handler=Delete&id=${id}`,
                        type: 'POST',
                        headers: {
                            "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire('Eliminado', response.message, 'success');
                                table.ajax.reload();
                            } else {
                                Swal.fire('Error', response.message, 'error');
                            }
                        },
                        error: function (xhr) {
                            const message = xhr.responseJSON?.message || xhr.responseText || 'Ocurrió un error al eliminar el documento.';
                            Swal.fire('Error', message, 'error');
                        }
                    });
                }
            });
        }

        function downloadPDF(id) {
            // Directly navigate to the PDF handler which will return the file
            window.location.href = `?handler=Pdf&id=${id}`;
        }

        function downloadXML(id) {
            // Directly navigate to the XML handler which will return the file
            window.location.href = `?handler=Xml&id=${id}`;
        }

        function sendToHacienda(id) {
            Swal.fire({
                title: '¿Está seguro?',
                text: 'Se enviará el documento a Hacienda para su procesamiento.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, enviar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: `?handler=SendToHacienda&id=${id}`,
                        type: 'POST',
                        headers: {
                            "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire('Enviado', response.message, 'success');
                                table.ajax.reload();
                            } else {
                                Swal.fire('Error', response.message, 'error');
                            }
                        },
                        error: function (xhr) {
                            const message = xhr.responseJSON?.message || xhr.responseText || 'Ocurrió un error al enviar el documento.';
                            Swal.fire('Error', message, 'error');
                        }
                    });
                }
            });
        }

        // Ver Respuesta de Hacienda
        function verRespuestaHacienda(id) {
            $.ajax({
                url: `?handler=RespuestaHacienda&id=${id}`,
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.success) {
                        const data = response.data;

                        // Información general
                        $('#respHacienda_consecutivo').text(data.numeroConsecutivo || '-');
                        $('#respHacienda_clave').text(data.clave || '-');
                        $('#respHacienda_estado').html(getEstadoBadge(data.estado));
                        $('#respHacienda_fechaEmision').text(data.fechaEmision ? new Date(data.fechaEmision).toLocaleString() : '-');

                        // Fechas de Hacienda
                        $('#respHacienda_fechaEnvio').text(data.fechaEnvioHacienda ? new Date(data.fechaEnvioHacienda).toLocaleString() : 'No enviado');
                        $('#respHacienda_fechaRespuesta').text(data.fechaRespuestaHacienda ? new Date(data.fechaRespuestaHacienda).toLocaleString() : 'Sin respuesta');

                        // Mensaje de Hacienda (errores/información)
                        const mensajeDiv = $('#respHacienda_mensaje');
                        const mensajeHeader = $('#respHacienda_mensajeHeader');
                        if (data.mensajeHacienda) {
                            mensajeDiv.text(data.mensajeHacienda);

                            // Colorear según estado
                            if (data.estado === 'Rechazado') {
                                mensajeDiv.removeClass('alert-info alert-success alert-warning').addClass('alert-danger');
                                mensajeHeader.removeClass('bg-light bg-success bg-warning').addClass('bg-danger text-white');
                            } else if (data.estado === 'Error') {
                                mensajeDiv.removeClass('alert-info alert-success alert-danger').addClass('alert-warning');
                                mensajeHeader.removeClass('bg-light bg-success bg-danger').addClass('bg-warning');
                            } else if (data.estado === 'Aceptado') {
                                mensajeDiv.removeClass('alert-info alert-danger alert-warning').addClass('alert-success');
                                mensajeHeader.removeClass('bg-light bg-danger bg-warning').addClass('bg-success text-white');
                            } else {
                                mensajeDiv.removeClass('alert-success alert-danger alert-warning').addClass('alert-info');
                                mensajeHeader.removeClass('bg-success bg-danger bg-warning text-white').addClass('bg-light');
                            }
                        } else {
                            mensajeDiv.text('Sin mensaje de Hacienda');
                            mensajeDiv.removeClass('alert-success alert-danger alert-warning').addClass('alert-info');
                            mensajeHeader.removeClass('bg-success bg-danger bg-warning text-white').addClass('bg-light');
                        }

                        // Mensajes Estructurados (errores detallados)
                        if (data.tieneMensajesEstructurados && data.mensajesEstructurados) {
                            const tbody = $('#respHacienda_mensajesEstructuradosBody');
                            tbody.empty();

                            data.mensajesEstructurados.forEach(msg => {
                                const tipoClass = msg.tipo === 'error' ? 'text-danger fw-bold' :
                                                  msg.tipo === 'advertencia' ? 'text-warning' : 'text-info';
                                const tipoIcon = msg.tipo === 'error' ? '<i class="fas fa-times-circle text-danger"></i>' :
                                                 msg.tipo === 'advertencia' ? '<i class="fas fa-exclamation-triangle text-warning"></i>' :
                                                 '<i class="fas fa-info-circle text-info"></i>';

                                tbody.append(`
                                    <tr>
                                        <td><code>${escapeHtml(msg.codigo || '-')}</code></td>
                                        <td class="${tipoClass}">${tipoIcon} ${escapeHtml(msg.tipo || '-')}</td>
                                        <td>${escapeHtml(msg.mensaje || '-')}</td>
                                        <td><small class="text-muted">${escapeHtml(msg.detalle || '-')}</small></td>
                                    </tr>
                                `);
                            });

                            $('#respHacienda_mensajesEstructuradosCard').show();
                        } else {
                            $('#respHacienda_mensajesEstructuradosCard').hide();
                        }

                        // XML de Respuesta
                        if (data.tieneRespuestaXml && data.xmlRespuestaHacienda) {
                            const formattedXml = formatXml(data.xmlRespuestaHacienda);
                            $('#xmlRespuestaContent code').text(formattedXml);
                            $('#respHacienda_xmlCard').show();
                        } else {
                            $('#respHacienda_xmlCard').hide();
                        }

                        $('#modalRespuestaHacienda').modal('show');
                    } else {
                        Swal.fire('Error', response.message, 'error');
                    }
                },
                error: function (xhr) {
                    const message = xhr.responseJSON?.message || xhr.responseText || 'Ocurrió un error al obtener la respuesta de Hacienda.';
                    Swal.fire('Error', message, 'error');
                }
            });
        }

        // Diagnóstico de documentos en BD
        function verDiagnostico() {
            // Mostrar modal con loading
            $('#diagnosticoLoading').show();
            $('#diagnosticoContent').hide();
            $('#modalDiagnostico').modal('show');

            $.ajax({
                url: `?handler=Diagnostico&empresaId=${empresaId}`,
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    $('#diagnosticoLoading').hide();
                    $('#diagnosticoContent').show();

                    if (response.success) {
                        const data = response.data;

                        // Actualizar resumen
                        $('#diagTotalDocumentos').text(data.totalDocumentos);
                        $('#diagDocumentosActivos').text(data.documentosActivos);
                        $('#diagDocumentosEliminados').text(data.documentosEliminados);

                        // Actualizar por estado
                        let estadosHtml = '';
                        const estadoColors = {
                            'Borrador': 'secondary',
                            'Pendiente': 'warning',
                            'Procesando': 'info',
                            'Aceptado': 'success',
                            'Rechazado': 'danger',
                            'Contingencia': 'dark',
                            'Anulado': 'secondary',
                            'Error': 'danger'
                        };
                        data.porEstado.forEach(function(item) {
                            const color = estadoColors[item.estado] || 'primary';
                            estadosHtml += `<span class="badge bg-${color} fs-6 p-2">${item.estado}: ${item.cantidad}</span>`;
                        });
                        $('#diagPorEstado').html(estadosHtml);

                        // Actualizar tabla de documentos
                        let tablaHtml = '';
                        data.documentos.forEach(function(doc) {
                            const estadoColor = estadoColors[doc.estado] || 'primary';
                            const deletedBadge = doc.isDeleted
                                ? '<span class="badge bg-danger">Sí</span>'
                                : '<span class="badge bg-success">No</span>';
                            const mensaje = doc.mensajeHacienda
                                ? `<small class="text-muted">${doc.mensajeHacienda.substring(0, 100)}${doc.mensajeHacienda.length > 100 ? '...' : ''}</small>`
                                : '-';
                            const fecha = doc.fechaEmision ? new Date(doc.fechaEmision).toLocaleString() : '-';

                            tablaHtml += `
                                <tr class="${doc.isDeleted ? 'table-secondary' : ''}">
                                    <td><small>${doc.numeroConsecutivo || '-'}</small></td>
                                    <td><small>${doc.tipoDocumento}</small></td>
                                    <td><span class="badge bg-${estadoColor}">${doc.estado}</span></td>
                                    <td>${mensaje}</td>
                                    <td class="text-center">${deletedBadge}</td>
                                    <td><small>${fecha}</small></td>
                                </tr>
                            `;
                        });
                        $('#diagTablaDocumentos').html(tablaHtml || '<tr><td colspan="6" class="text-center">No hay documentos</td></tr>');

                    } else {
                        Swal.fire('Error', response.message || 'Error al obtener diagnóstico', 'error');
                    }
                },
                error: function (xhr) {
                    $('#diagnosticoLoading').hide();
                    const message = xhr.responseJSON?.message || xhr.responseText || 'Ocurrió un error al obtener el diagnóstico.';
                    Swal.fire('Error', message, 'error');
                    $('#modalDiagnostico').modal('hide');
                }
            });
        }

        // Format XML with indentation
        function formatXml(xml) {
            const PADDING = ' '.repeat(2);
            const reg = /(>)(<)(\/*)/g;
            let pad = 0;

            xml = xml.replace(reg, '$1\r\n$2$3');

            return xml.split('\r\n').map((node, index) => {
                let indent = 0;
                if (node.match(/.+<\/\w[^>]*>$/)) {
                    indent = 0;
                } else if (node.match(/^<\/\w/) && pad > 0) {
                    pad -= 1;
                } else if (node.match(/^<\w[^>]*[^\/]>.*$/)) {
                    indent = 1;
                } else {
                    indent = 0;
                }

                pad += indent;

                return PADDING.repeat(pad - indent) + node;
            }).join('\r\n');
        }

        // Copy XML to clipboard
        function copyXmlToClipboard() {
            const xmlContent = $('#xmlRespuestaContent code').text();
            navigator.clipboard.writeText(xmlContent).then(function() {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: 'XML copiado al portapapeles',
                    showConfirmButton: false,
                    timer: 2000
                });
            }, function() {
                Swal.fire('Error', 'No se pudo copiar el XML al portapapeles', 'error');
            });
        }

        // Download ZIP file
        function downloadZIP(id) {
            window.location.href = `?handler=DownloadZip&id=${id}`;
        }

        // Reenviar a Hacienda
        function reenviarHacienda(id) {
            Swal.fire({
                title: '¿Está seguro?',
                text: 'Se reenviará el documento a Hacienda para su procesamiento.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#ffc107',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, reenviar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: `?handler=ReenviarHacienda&id=${id}`,
                        type: 'POST',
                        headers: {
                            "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire('Reenviado', response.message, 'success');
                                table.ajax.reload();
                            } else {
                                Swal.fire('Error', response.message, 'error');
                            }
                        },
                        error: function (xhr) {
                            const message = xhr.responseJSON?.message || xhr.responseText || 'Ocurrió un error al reenviar el documento.';
                            Swal.fire('Error', message, 'error');
                        }
                    });
                }
            });
        }

        // Reintentar envío de documento con error
        function reintentarEnvio(id) {
            Swal.fire({
                title: 'Reintentar envío',
                text: 'El documento tuvo un error técnico. ¿Desea reintentar el envío a Hacienda?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ffc107',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="fas fa-redo"></i> Sí, reintentar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Procesando...',
                        text: 'Reintentando envío a Hacienda',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });

                    $.ajax({
                        url: `?handler=ReintentarEnvio&id=${id}`,
                        type: 'POST',
                        headers: {
                            "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (response) {
                            Swal.close();
                            if (response.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Enviado',
                                    text: response.message,
                                    timer: 3000
                                });
                                table.ajax.reload();
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: response.message,
                                    footer: '<small>El sistema reintentará automáticamente en unos minutos.</small>'
                                });
                                table.ajax.reload();
                            }
                        },
                        error: function (xhr) {
                            Swal.close();
                            const message = xhr.responseJSON?.message || xhr.responseText || 'Ocurrió un error al reintentar el envío.';
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: message,
                                footer: '<small>El sistema reintentará automáticamente en unos minutos.</small>'
                            });
                        }
                    });
                }
            });
        }

        // Consultar Estado en Hacienda (forzar consulta manual)
        function consultarEstadoHacienda(id) {
            Swal.fire({
                title: 'Consultando estado...',
                text: 'Obteniendo estado del documento en Hacienda',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            $.ajax({
                url: `?handler=ConsultarEstado&id=${id}`,
                type: 'POST',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    Swal.close();
                    if (response.success) {
                        let icon = 'info';
                        let title = 'Estado Actual';

                        // Determinar icono según estado
                        if (response.estado === 'aceptado' || response.estado === 'Aceptado') {
                            icon = 'success';
                            title = '¡Documento Aceptado!';
                        } else if (response.estado === 'rechazado' || response.estado === 'Rechazado') {
                            icon = 'error';
                            title = 'Documento Rechazado';
                        } else if (response.estado === 'procesando' || response.estado === 'Procesando') {
                            icon = 'warning';
                            title = 'Documento en Proceso';
                        }

                        Swal.fire({
                            icon: icon,
                            title: title,
                            html: `<div class="text-start">
                                <p><strong>Estado:</strong> ${response.estado || 'Sin información'}</p>
                                <p><strong>Mensaje:</strong> ${response.mensaje || 'Sin mensaje'}</p>
                                ${response.detalle ? `<p><strong>Detalle:</strong> <small class="text-muted">${response.detalle}</small></p>` : ''}
                            </div>`,
                            footer: '<small>El estado se actualizó en la base de datos.</small>'
                        });
                        table.ajax.reload();
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error al consultar',
                            text: response.mensaje || response.message || 'No se pudo consultar el estado',
                            footer: '<small>El sistema reintentará automáticamente en unos minutos.</small>'
                        });
                    }
                },
                error: function (xhr) {
                    Swal.close();
                    const message = xhr.responseJSON?.message || xhr.responseText || 'Ocurrió un error al consultar el estado.';
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: message,
                        footer: '<small>Verifique la conexión con Hacienda.</small>'
                    });
                }
            });
        }

        // Open Email Modal
        function openEmailModal(documentoId, consecutivo, clienteId) {
            // Reset form
            $('#formEnviarCorreo')[0].reset();
            $('#formEnviarCorreo').removeClass('was-validated');

            // Set documento ID
            $('#Email_DocumentoId').val(documentoId);

            // Set default subject
            $('#Email_Asunto').val(`Documento Electrónico ${consecutivo}`);

            // Set default message
            const defaultMessage = `Estimado cliente,\n\nAdjunto encontrará el documento electrónico ${consecutivo}.\n\nEste documento ha sido generado y enviado a Hacienda de acuerdo con la normativa vigente.\n\nSaludos cordiales.`;
            $('#Email_Mensaje').val(defaultMessage);

            // Load client emails
            if (clienteId) {
                $.ajax({
                    url: `?handler=ClienteEmails&clienteId=${clienteId}`,
                    type: 'GET',
                    headers: {
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        if (response.success && response.data) {
                            // Try to get email from different possible property names
                            const email = response.data.email || response.data.correoElectronico || response.data.receptorEmails || '';
                            if (email) {
                                // If multiple emails, get the first one
                                const firstEmail = email.split(',')[0].trim();
                                $('#Email_Para').val(firstEmail);
                            }
                        }
                    }
                });
            }

            // Show modal
            $('#modalEnviarCorreo').modal('show');
        }

        // Función para escapar HTML y evitar XSS
        function escapeHtml(text) {
            if (!text) return '';
            const map = {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            };
            return text.replace(/[&<>"']/g, function(m) { return map[m]; });
        }

        // Función para truncar texto
        function truncateText(text, maxLength) {
            if (!text) return '';
            if (text.length <= maxLength) return text;
            return text.substring(0, maxLength) + '...';
        }

        // Submit email form
        $('#formEnviarCorreo').on('submit', function (e) {
            e.preventDefault();

            if (!this.checkValidity()) {
                $(this).addClass('was-validated');
                return;
            }

            const emailData = {
                documentoId: $('#Email_DocumentoId').val(),
                para: $('#Email_Para').val(),
                cc: $('#Email_CC').val() || null,
                cco: $('#Email_CCO').val() || null,
                asunto: $('#Email_Asunto').val(),
                mensaje: $('#Email_Mensaje').val()
            };

            $.ajax({
                url: '?handler=EnviarCorreo',
                type: 'POST',
                contentType: 'application/json',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                data: JSON.stringify(emailData),
                success: function (response) {
                    if (response.success) {
                        Swal.fire('Enviado', response.message, 'success');
                        $('#modalEnviarCorreo').modal('hide');
                    } else {
                        Swal.fire('Error', response.message, 'error');
                    }
                },
                error: function (xhr) {
                    const message = xhr.responseJSON?.message || xhr.responseText || 'Ocurrió un error al enviar el correo.';
                    Swal.fire('Error', message, 'error');
                }
            });
        });
    </script>
}
