@page
@model Facturacion.Frontend.Pages.CategoriasModel
@{
    ViewData["Title"] = "Categorías";
    ViewData["Breadcrumb"] = "Categorías";
}

@Html.AntiForgeryToken()

<!-- Page Header -->
<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h2><i class="fas fa-tags"></i> Categorías de Productos</h2>
            <p class="mb-0">Organiza tus productos en categorías para mejor gestión</p>
        </div>
        <button class="btn btn-primary" onclick="openCreateModal()">
            <i class="fas fa-plus me-2"></i>Nueva Categoría
        </button>
    </div>
</div>

<div class="card shadow-custom">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <strong>Listado de Categorías</strong>
                <span class="badge bg-secondary ms-2" id="badgeTotalCategorias">0</span>
            </div>
        </div>
    </div>
    <div class="card-body">
        <!-- Loading State -->
        <div id="tableCategoriasLoader" class="text-center py-5">
            <div class="spinner-modern mx-auto"></div>
            <p class="text-muted mt-3">Cargando categorías...</p>
        </div>

        <!-- Table Container -->
        <div id="tableCategoriasContainer" style="display: none;">
            <table id="tableCategorias" class="table table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Estado</th>
                        <th style="width: 120px;">Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <!-- Empty State -->
        <div id="emptyStateCategorias" class="empty-state" style="display: none;">
            <div class="empty-state-icon">
                <i class="fas fa-tags"></i>
            </div>
            <h3 class="empty-state-title">No hay categorías registradas</h3>
            <p class="empty-state-description">Crea categorías para organizar tus productos</p>
            <button class="btn btn-primary" onclick="openCreateModal()">
                <i class="fas fa-plus me-2"></i>Crear Primera Categoría
            </button>
        </div>
    </div>
</div>

<!-- Modal Create/Edit -->
<div class="modal fade" id="modalCategoria" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">
                    <i class="fas fa-tags me-2 text-primary"></i>Nueva Categoría
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="formCategoria">
                <div class="modal-body">
                    <input type="hidden" id="Categoria_Id" value="0" />

                    <div class="mb-3">
                        <label class="form-label">Nombre <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="Categoria_Nombre" maxlength="100" required />
                        <div class="invalid-feedback">El nombre es obligatorio.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Descripción</label>
                        <textarea class="form-control" id="Categoria_Descripcion" rows="3" maxlength="300"></textarea>
                        <small class="text-muted">Descripción opcional de la categoría.</small>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="Categoria_Activa" checked />
                        <label class="form-check-label" for="Categoria_Activa">
                            Categoría Activa
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-1"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let table;

    $(document).ready(function() {
        loadDataTable();
        setupFormSubmit();
    });

    function loadDataTable() {
        table = initDataTable('#tableCategorias', {
            ajax: {
                url: '?handler=Data',
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                dataSrc: function(json) {
                    // Hide loader
                    $('#tableCategoriasLoader').hide();

                    // Get data array
                    const data = json.data || json || [];

                    // Update badge count
                    $('#badgeTotalCategorias').text(data.length);

                    // Show appropriate state
                    if (data.length > 0) {
                        $('#tableCategoriasContainer').show();
                        $('#emptyStateCategorias').hide();
                    } else {
                        $('#tableCategoriasContainer').hide();
                        $('#emptyStateCategorias').show();
                    }

                    return data;
                },
                error: function(xhr, error, code) {
                    $('#tableCategoriasLoader').hide();
                    $('#tableCategoriasContainer').hide();
                    $('#emptyStateCategorias').show();
                    $('#badgeTotalCategorias').text('0');
                    console.error('Error loading categorias:', error);
                    handleAjaxError(xhr);
                }
            },
            columns: [
                { data: 'id', visible: false },
                { data: 'nombre' },
                {
                    data: 'descripcion',
                    render: function(data) {
                        return data || '<span class="text-muted">-</span>';
                    }
                },
                {
                    data: 'activo',
                    render: function(data) {
                        return data
                            ? '<span class="badge bg-success">Activa</span>'
                            : '<span class="badge bg-secondary">Inactiva</span>';
                    }
                },
                {
                    data: 'id',
                    orderable: false,
                    render: function(data, type, row) {
                        return `
                            <button class="btn btn-sm btn-info" onclick="edit('${data}')" title="Editar">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-sm btn-danger" onclick="deleteRecord('${data}', '${row.nombre}')" title="Eliminar">
                                <i class="fas fa-trash"></i>
                            </button>
                        `;
                    }
                }
            ],
            order: [[1, 'asc']]
        });
    }

    function setupFormSubmit() {
        $('#formCategoria').on('submit', function(e) {
            e.preventDefault();
            if (this.checkValidity()) {
                save();
            } else {
                $(this).addClass('was-validated');
            }
        });
    }

    function openCreateModal() {
        $('#formCategoria')[0].reset();
        $('#formCategoria').removeClass('was-validated');
        $('#Categoria_Id').val('0');
        $('#Categoria_Activa').prop('checked', true);
        $('#modalTitle').text('Nueva Categoría');
        $('#modalCategoria').modal('show');
    }

    function edit(id) {
        $.ajax({
            url: '?handler=Details&id=' + id,
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(data) {
                if (data && !data.error) {
                    $('#Categoria_Id').val(data.id);
                    $('#Categoria_Nombre').val(data.nombre);
                    $('#Categoria_Descripcion').val(data.descripcion || '');
                    $('#Categoria_Activa').prop('checked', data.activo);
                    $('#modalTitle').text('Editar Categoría');
                    $('#formCategoria').removeClass('was-validated');
                    $('#modalCategoria').modal('show');
                } else {
                    showError('Error al cargar la categoría');
                }
            },
            error: function(xhr) {
                handleAjaxError(xhr);
            }
        });
    }

    function save() {
        const data = {
            id: $('#Categoria_Id').val() || '00000000-0000-0000-0000-000000000000',
            nombre: $('#Categoria_Nombre').val(),
            descripcion: $('#Categoria_Descripcion').val() || null,
            activo: $('#Categoria_Activa').is(':checked')
        };

        $.ajax({
            url: '?handler=Save',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(data),
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success) {
                    showSuccess(response.message);
                    $('#modalCategoria').modal('hide');
                    table.ajax.reload();
                } else {
                    showError(response.message || 'Error al guardar la categoría');
                }
            },
            error: function(xhr) {
                handleAjaxError(xhr);
            }
        });
    }

    function deleteRecord(id, nombre) {
        confirmDelete(`¿Está seguro de eliminar la categoría "${nombre}"?`, function() {
            $.ajax({
                url: '?handler=Delete&id=' + id,
                type: 'POST',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        showSuccess(response.message);
                        table.ajax.reload();
                    } else {
                        showError(response.message || 'Error al eliminar la categoría');
                    }
                },
                error: function(xhr) {
                    handleAjaxError(xhr);
                }
            });
        });
    }
</script>
}
