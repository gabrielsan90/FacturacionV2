@page
@model Facturacion.Frontend.Pages.ReporteDocumentosEmitidosModel
@{
    ViewData["Title"] = "Reporte: Documentos Emitidos";
    ViewData["Breadcrumb"] = "Reporte: Documentos Emitidos";
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">
            <i class="fas fa-file-export me-2"></i>Reporte: Documentos Emitidos
        </h5>
    </div>
    <div class="card-body">
        <!-- Filters -->
        <div class="row mb-4">
            <div class="col-md-3">
                <label class="form-label">Fecha Inicio</label>
                <input type="date" class="form-control" id="fechaInicio" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Fecha Fin</label>
                <input type="date" class="form-control" id="fechaFin" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Tipo Documento</label>
                <select class="form-select" id="tipoDocumento">
                    <option value="">Todos</option>
                    <option value="01">Factura Electrónica</option>
                    <option value="02">Nota de Débito</option>
                    <option value="03">Nota de Crédito</option>
                    <option value="04">Tiquete Electrónico</option>
                    <option value="09">Factura de Compra</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-primary me-2" onclick="filtrar()">
                    <i class="fas fa-filter me-1"></i> Filtrar
                </button>
                <button class="btn btn-outline-secondary" onclick="limpiarFiltros()">
                    <i class="fas fa-eraser me-1"></i> Limpiar
                </button>
            </div>
        </div>

        <!-- Summary Cards -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card bg-primary text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-0">Total Documentos</h6>
                                <h4 class="mb-0" id="totalDocumentos">0</h4>
                            </div>
                            <i class="fas fa-file-alt fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-success text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-0">Aceptados</h6>
                                <h4 class="mb-0" id="totalAceptados">0</h4>
                            </div>
                            <i class="fas fa-check-circle fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-warning text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-0">Pendientes</h6>
                                <h4 class="mb-0" id="totalPendientes">0</h4>
                            </div>
                            <i class="fas fa-clock fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-info text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-0">Total Monto</h6>
                                <h4 class="mb-0" id="totalMonto">₡0.00</h4>
                            </div>
                            <i class="fas fa-dollar-sign fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Export Buttons -->
        <div class="mb-3">
            <button class="btn btn-success btn-sm" onclick="exportarExcel()">
                <i class="fas fa-file-excel me-1"></i> Exportar a Excel
            </button>
            <button class="btn btn-danger btn-sm" onclick="exportarPDF()">
                <i class="fas fa-file-pdf me-1"></i> Exportar a PDF
            </button>
        </div>

        <!-- DataTable -->
        <table id="tableReporte" class="table table-hover">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Tipo</th>
                    <th>Número</th>
                    <th>Cliente</th>
                    <th>Monto</th>
                    <th>Estado</th>
                    <th>Clave</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    let table;

    $(document).ready(function() {
        // Set default dates (last 30 days)
        const hoy = new Date();
        const hace30Dias = new Date();
        hace30Dias.setDate(hace30Dias.getDate() - 30);

        $('#fechaFin').val(hoy.toISOString().split('T')[0]);
        $('#fechaInicio').val(hace30Dias.toISOString().split('T')[0]);

        loadDataTable();
        cargarResumen();
    });

    function loadDataTable() {
        const fechaInicio = $('#fechaInicio').val();
        const fechaFin = $('#fechaFin').val();
        const tipoDocumento = $('#tipoDocumento').val();

        table = initDataTable('#tableReporte', {
            ajax: {
                url: `?handler=Data&fechaInicio=${fechaInicio}&fechaFin=${fechaFin}&tipoDocumento=${tipoDocumento}`,
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                dataSrc: 'data'
            },
            columns: [
                {
                    data: 'fecha',
                    render: function(data) {
                        return moment(data).format('DD/MM/YYYY HH:mm');
                    }
                },
                { data: 'tipoDocumento' },
                { data: 'numero' },
                { data: 'clienteNombre' },
                {
                    data: 'total',
                    render: function(data) {
                        return formatCurrency(data);
                    }
                },
                {
                    data: 'estado',
                    render: function(data) {
                        if (data === 'Aceptado') return '<span class="badge bg-success">Aceptado</span>';
                        if (data === 'Rechazado') return '<span class="badge bg-danger">Rechazado</span>';
                        return '<span class="badge bg-warning">Pendiente</span>';
                    }
                },
                {
                    data: 'clave',
                    render: function(data) {
                        return data ? data.substring(0, 20) + '...' : '-';
                    }
                }
            ],
            order: [[0, 'desc']],
            buttons: ['excel', 'pdf']
        });
    }

    function filtrar() {
        if (table) {
            table.destroy();
        }
        loadDataTable();
        cargarResumen();
    }

    function limpiarFiltros() {
        $('#fechaInicio').val('');
        $('#fechaFin').val('');
        $('#tipoDocumento').val('');
        filtrar();
    }

    function cargarResumen() {
        const fechaInicio = $('#fechaInicio').val();
        const fechaFin = $('#fechaFin').val();
        const tipoDocumento = $('#tipoDocumento').val();

        $.ajax({
            url: `?handler=Resumen&fechaInicio=${fechaInicio}&fechaFin=${fechaFin}&tipoDocumento=${tipoDocumento}`,
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(data) {
                $('#totalDocumentos').text(data.totalDocumentos);
                $('#totalAceptados').text(data.totalAceptados);
                $('#totalPendientes').text(data.totalPendientes);
                $('#totalMonto').text(formatCurrency(data.totalMonto));
            }
        });
    }

    function exportarExcel() {
        table.button('.buttons-excel').trigger();
    }

    function exportarPDF() {
        table.button('.buttons-pdf').trigger();
    }
</script>
}
