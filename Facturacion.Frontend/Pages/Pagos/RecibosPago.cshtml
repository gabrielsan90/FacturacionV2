            },
            success: function(data) {
                terminales = data;
            },
            error: function(xhr) {
                console.error('Error loading terminales:', xhr);
            }
        });
    }

    function loadTerminalesBySucursal(sucursalId) {
        const select = $('#REP_TerminalId');
        select.empty().append('<option value="">Seleccione...</option>');

        if (!sucursalId) return;

        const sucursalIdLower = sucursalId.toLowerCase();
        const filteredTerminales = terminales.filter(t =>
            t.sucursalId && t.sucursalId.toLowerCase() === sucursalIdLower
        );

        filteredTerminales.forEach(function(item) {
            select.append(`<option value="${item.id}">${item.codigo} - ${item.nombre || item.descripcion}</option>`);
        });

        // Auto-select if only one
        if (filteredTerminales.length === 1) {
            select.val(filteredTerminales[0].id);
        }
    }

    function formatCurrency(amount, currency) {
        const symbol = currency === 'USD' ? '$' : '₡';
        return `${symbol} ${parseFloat(amount).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    }

    function getEstadoBadge(estado) {
        const estados = {
            'Aceptado': '<span class="badge bg-success">Aceptado</span>',
            'Procesando': '<span class="badge bg-warning">Procesando</span>',
            'Rechazado': '<span class="badge bg-danger">Rechazado</span>',
            'Pendiente': '<span class="badge bg-secondary">Pendiente</span>'
        };
        return estados[estado] || estado;
    }
</script>
}
