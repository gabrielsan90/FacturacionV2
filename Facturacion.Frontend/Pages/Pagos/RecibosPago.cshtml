    // Open modal for MULTIPLE documents (from selection button)
    function openGenerarREPMultiModal() {
        const checked = $('#tablePendientes .doc-check:checked');

        if (checked.length === 0) {
            Swal.fire('Advertencia', 'Seleccione al menos un documento', 'warning');
            return;
        }

        // Validate all belong to same client
        let clienteId = null;
        let moneda = null;
        let valid = true;

        documentosSeleccionados = [];

        checked.each(function() {
            const $cb = $(this);
            const docClienteId = $cb.data('cliente-id');
            const docMoneda = $cb.data('moneda');

            if (clienteId === null) {
                clienteId = docClienteId;
                moneda = docMoneda;
            } else if (docClienteId && docClienteId !== clienteId) {
                valid = false;
                return false; // break
            } else if (docMoneda !== moneda) {
                valid = false;
                Swal.fire('Error', 'Todos los documentos seleccionados deben tener la misma moneda', 'error');
                return false;
            }

            documentosSeleccionados.push({
                documentoId: $cb.val(),
                consecutivo: $cb.data('consecutivo'),
                cliente: $cb.data('cliente'),
                totalVenta: parseFloat($cb.data('total')),
                saldoPendiente: parseFloat($cb.data('saldo')),
                moneda: docMoneda
            });
        });

        if (!valid) {
            if (clienteId !== null) {
                Swal.fire('Error', 'Todos los documentos seleccionados deben ser del mismo cliente', 'error');
            }
            return;
        }

        openREPModal();
    }

    // Common modal opener
    function openREPModal() {
        // Reset form
        $('#formGenerarREP')[0].reset();
        $('#formGenerarREP').removeClass('was-validated');

        // Build documents table
        const tbody = $('#documentosREPBody');
        tbody.empty();

        let totalSaldo = 0;
        const moneda = documentosSeleccionados[0]?.moneda || 'CRC';
        const simbolo = moneda === 'USD' ? '$' : moneda === 'EUR' ? '€' : '₡';
        $('#REP_MonedaSymbol').text(simbolo);

        documentosSeleccionados.forEach((doc, idx) => {
            totalSaldo += doc.saldoPendiente;
            tbody.append(`
                <tr data-doc-id="${doc.documentoId}">
                    <td>${doc.consecutivo}</td>
                    <td>${doc.cliente}</td>
                    <td class="text-end">${formatCurrency(doc.totalVenta, doc.moneda)}</td>
                    <td class="text-end">${formatCurrency(doc.saldoPendiente, doc.moneda)}</td>
                    <td>
                        <input type="number" class="form-control form-control-sm monto-aplicar"
                               data-doc-id="${doc.documentoId}" data-saldo="${doc.saldoPendiente}"
                               value="${doc.saldoPendiente.toFixed(2)}" min="0.01"
                               max="${doc.saldoPendiente.toFixed(2)}" step="0.01" required />
                    </td>
                    <td>
                        ${documentosSeleccionados.length > 1
                            ? `<button type="button" class="btn btn-sm btn-outline-danger" onclick="removeDocFromREP('${doc.documentoId}')" title="Quitar"><i class="fas fa-times"></i></button>`
                            : ''}
                    </td>
                </tr>
            `);
        });

        // Update total
        recalcularTotalREP();

        // Attach change events for monto inputs
        tbody.find('.monto-aplicar').on('input', function() {
            const max = parseFloat($(this).data('saldo'));
            let val = parseFloat($(this).val()) || 0;
            if (val > max) {
                $(this).val(max.toFixed(2));
            }
            recalcularTotalREP();
        });

        // Reset medios de pago with total amount
        resetMediosPago(totalSaldo);

        // Attach change events for medio de pago montos (reverse sync)
        $(document).off('input.medioPago').on('input.medioPago', '.medio-pago-monto', function() {
            sincronizarDesdemediosPago();
        });

        // Set default date
        const today = new Date().toISOString().split('T')[0];
        $('#REP_FechaPago').val(today);

        // Show modal
        new bootstrap.Modal(document.getElementById('modalGenerarREP')).show();
    }

    function removeDocFromREP(documentoId) {
        documentosSeleccionados = documentosSeleccionados.filter(d => d.documentoId !== documentoId);
        $(`#documentosREPBody tr[data-doc-id="${documentoId}"]`).remove();
        recalcularTotalREP();

        if (documentosSeleccionados.length === 0) {
            bootstrap.Modal.getInstance(document.getElementById('modalGenerarREP')).hide();
        }
    }

    function recalcularTotalREP() {
        let total = 0;
        $('#documentosREPBody .monto-aplicar').each(function() {
            total += parseFloat($(this).val()) || 0;
        });

        const moneda = documentosSeleccionados[0]?.moneda || 'CRC';
        $('#REP_TotalPago').text(formatCurrency(total, moneda));
        $('#REP_MontoPagado').val(total.toFixed(2));

        // Update first medio pago amount
        $('.medio-pago-monto').first().val(total.toFixed(2));
    }

    // Reverse sync: when user changes medio de pago amounts, adjust monto-aplicar
    function sincronizarDesdemediosPago() {
        let sumaMedios = 0;
        $('.medio-pago-monto').each(function() {
            sumaMedios += parseFloat($(this).val()) || 0;
        });

        const montoInputs = $('#documentosREPBody .monto-aplicar');

        // Single document: set monto-aplicar = sumaMedios (capped at saldo)
        if (montoInputs.length === 1) {
            const input = montoInputs.first();
            const saldo = parseFloat(input.data('saldo'));
            const nuevoMonto = Math.min(sumaMedios, saldo);
            input.val(nuevoMonto > 0 ? nuevoMonto.toFixed(2) : '');
        } else {
            // Multiple documents: distribute proportionally, capped per saldo
            let restante = sumaMedios;
            montoInputs.each(function() {
                const saldo = parseFloat($(this).data('saldo'));
                const aplicar = Math.min(restante, saldo);
                $(this).val(aplicar > 0 ? aplicar.toFixed(2) : '0.00');
                restante -= aplicar;
            });
        }

        // Update total display (without triggering medio-pago sync back)
        let total = 0;
        montoInputs.each(function() {
            total += parseFloat($(this).val()) || 0;
        });
        const moneda = documentosSeleccionados[0]?.moneda || 'CRC';
        $('#REP_TotalPago').text(formatCurrency(total, moneda));
        $('#REP_MontoPagado').val(total.toFixed(2));
    }

