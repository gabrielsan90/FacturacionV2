    async function generarREP() {
        try {
            // Validar sucursal y terminal
            const terminalId = $('#REP_TerminalId').val();
            const sucursalId = $('#REP_SucursalId').val();

            if (!sucursalId) {
                Swal.fire('Validación', 'Seleccione una sucursal', 'warning');
                return;
            }
            if (!terminalId) {
                Swal.fire('Validación', 'Seleccione una terminal', 'warning');
                return;
            }

            // Recolectar documentos y montos
            const documentos = [];
            $('#documentosREPBody .monto-aplicar').each(function() {
                const docId = $(this).data('doc-id');
                const monto = parseFloat($(this).val()) || 0;
                if (docId && monto > 0) {
                    documentos.push({
                        documentoId: docId,
                        montoAplicado: monto
                    });
                }
            });

            if (documentos.length === 0) {
                Swal.fire('Error', 'No hay documentos para pagar', 'error');
                return;
            }

            // Recolectar medios de pago
            const mediosPago = [];
            $('.medio-pago-item').each(function() {
                const codigo = $(this).find('.medio-pago-select').val();
                const monto = parseFloat($(this).find('.medio-pago-monto').val());
                const referencia = $(this).find('.medio-pago-ref').val();

                if (codigo && monto > 0) {
                    mediosPago.push({
                        codigoMedioPago: codigo,
                        monto: monto,
                        numeroReferencia: referencia || null
                    });
                }
            });

            if (mediosPago.length === 0) {
                Swal.fire('Error', 'Debe agregar al menos un medio de pago', 'error');
                return;
            }

            // Validar suma de medios de pago
            const montoPagado = parseFloat($('#REP_MontoPagado').val());
            const sumaMedios = mediosPago.reduce((sum, m) => sum + m.monto, 0);
            const moneda = documentosSeleccionados[0]?.moneda || 'CRC';

            if (Math.abs(sumaMedios - montoPagado) > 0.01) {
                Swal.fire('Error',
                    `La suma de los medios de pago (${formatCurrency(sumaMedios, moneda)}) no coincide con el monto a pagar (${formatCurrency(montoPagado, moneda)})`,
                    'error');
                return;
            }

            // Preparar datos del REP multi-factura
            const repData = {
                documentos: documentos,
                fechaPago: $('#REP_FechaPago').val(),
                moneda: moneda,
                tipoCambio: documentosSeleccionados[0]?.tipoCambio || null,
                observaciones: $('#REP_Observaciones').val() || null,
                mediosPago: mediosPago
            };

            // Mostrar loading
            Swal.fire({
                title: 'Generando REP...',
                html: `Generando REP para ${documentos.length} factura(s)...<br>Generando XML, firmando y enviando a Hacienda...`,
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            // Enviar a la API (multi-document endpoint)
            const response = await fetch(`?handler=GenerarREPMulti&empresaId=${empresaId}&terminalId=${terminalId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                body: JSON.stringify(repData)
            });

            const result = await response.json();

            if (result.exitoso) {
                const esPagoFinal = result.saldoPendiente <= 0;
                Swal.fire({
                    icon: esPagoFinal ? 'success' : 'info',
                    title: esPagoFinal ? 'Documento Completamente Pagado' : 'Pago Parcial Registrado',
                    html: `
                        <p>${result.mensaje}</p>
                        <p><strong>Clave REP:</strong> <small>${result.claveREP}</small></p>
                        <p><strong>Monto Pagado:</strong> ${formatCurrency(result.montoPagado, moneda)}</p>
                        ${esPagoFinal
                            ? '<p class="text-success fw-bold">Saldo: 0.00 - Completamente pagado</p>'
                            : `<p><strong>Saldo Restante:</strong> <span class="text-warning">${formatCurrency(result.saldoPendiente, moneda)}</span></p>`
                        }
                    `,
                    confirmButtonText: 'Aceptar'
                });

                // Cerrar modal y recargar tablas
                bootstrap.Modal.getInstance(document.getElementById('modalGenerarREP')).hide();
                tablePendientes.ajax.reload();
                tableRecibos.ajax.reload();
                loadEstadisticas();
                // Uncheck all
                $('#checkAll').prop('checked', false);
                updateSelectionCount();
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error al Generar REP',
                    html: `
                        <p>${result.mensaje}</p>
                        ${result.errores && result.errores.length > 0 ?
                            '<ul class="text-start">' + result.errores.map(e => '<li>' + e + '</li>').join('') + '</ul>'
                            : ''}
                    `
                });
            }
        } catch (error) {
            console.error('Error:', error);
            Swal.fire('Error', 'Ocurrió un error al generar el REP: ' + error.message, 'error');
        }
    }

