@page
@model Facturacion.Frontend.Pages.Ventas.CotizacionesModel
@{
    ViewData["Title"] = "Cotizaciones";
    ViewData["Breadcrumb"] = "Cotizaciones";
}

<!-- Page Header -->
<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <h2><i class="fas fa-file-invoice-dollar"></i> Cotizaciones</h2>
            <p class="mb-0">Gestión de cotizaciones y propuestas de venta</p>
        </div>
        <button class="btn btn-primary" onclick="openCreateModal()" aria-label="Crear nueva cotización">
            <i class="fas fa-plus me-2"></i>Nueva Cotización
        </button>
    </div>
</div>

<!-- Filter Card -->
<div class="card shadow-custom mb-3">
    <div class="card-body">
        <div class="row align-items-end">
            <div class="col-md-3">
                <label class="form-label">Filtrar por Estado</label>
                <select class="form-select" id="filtroEstado" onchange="aplicarFiltro()">
                    <option value="TODAS">Todas</option>
                    <option value="BOR">Borrador</option>
                    <option value="ENV">Enviada</option>
                    <option value="APR">Aprobada</option>
                    <option value="REC">Rechazada</option>
                    <option value="CON">Convertida</option>
                    <option value="VEN">Vencida</option>
                </select>
            </div>
            <div class="col-md-9 text-end">
                <button type="button" class="btn btn-outline-primary" onclick="exportarExcel()" title="Exportar a Excel">
                    <i class="fas fa-file-excel me-2"></i>Exportar
                </button>
                <button type="button" class="btn btn-outline-primary" onclick="refrescarTabla()" title="Refrescar tabla">
                    <i class="fas fa-sync-alt me-2"></i>Refrescar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Cotizaciones Table Card -->
<div class="card shadow-custom">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <i class="fas fa-table me-2 text-primary"></i>
            <strong>Listado de Cotizaciones</strong>
            <span class="badge bg-secondary ms-2" id="badgeTotalCotizaciones">0</span>
        </div>
    </div>
    <div class="card-body">
        <!-- Loading State -->
        <div id="tableCotizacionesLoader" class="text-center py-5">
            <div class="spinner-modern mx-auto"></div>
            <p class="text-muted mt-3">Cargando cotizaciones...</p>
        </div>

        <!-- Table -->
        <div class="table-responsive" id="tableCotizacionesContainer" style="display:none;">
            <table id="tableCotizaciones" class="table table-hover">
                <thead>
                    <tr>
                        <th>Número</th>
                        <th>Fecha</th>
                        <th>Cliente</th>
                        <th>Vencimiento</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th style="width: 180px;">Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <!-- Empty State -->
        <div id="emptyStateCotizaciones" class="empty-state" style="display:none;">
            <div class="empty-state-icon">
                <i class="fas fa-file-invoice-dollar"></i>
            </div>
            <h3 class="empty-state-title">No hay cotizaciones registradas</h3>
            <p class="empty-state-description">Comienza creando tu primera cotización</p>
            <button class="btn btn-primary" onclick="openCreateModal()">
                <i class="fas fa-plus me-2"></i>Crear Primera Cotización
            </button>
        </div>
    </div>
</div>

<!-- Modal Create/Edit -->
<div class="modal fade" id="modalCotizacion" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitle">Nueva Cotización</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="formCotizacion" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="Cotizacion_Id" value="00000000-0000-0000-0000-000000000000" />
                    <input type="hidden" id="Cotizacion_EmpresaId" value="@Model.EmpresaId" />

                    <!-- Header Information -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Cliente <span class="text-danger">*</span></label>
                            <select class="form-select" id="Cotizacion_ClienteId" required>
                                <option value="">Seleccione un cliente...</option>
                            </select>
                            <div class="invalid-feedback">Seleccione un cliente.</div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Fecha <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="Cotizacion_Fecha" required />
                            <div class="invalid-feedback">La fecha es obligatoria.</div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Vencimiento <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="Cotizacion_FechaVencimiento" required />
                            <div class="invalid-feedback">La fecha de vencimiento es obligatoria.</div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Condici&oacute;n Venta <span class="text-danger">*</span></label>
                            <select class="form-select" id="Cotizacion_CondicionVenta" required>
                                <option value="01" selected>01 - Contado</option>
                                <option value="02">02 - Cr&eacute;dito</option>
                                <option value="03">03 - Consignaci&oacute;n</option>
                                <option value="04">04 - Apartado</option>
                                <option value="05">05 - Arrendamiento con opci&oacute;n de compra</option>
                                <option value="06">06 - Arrendamiento en funci&oacute;n financiera</option>
                                <option value="99">99 - Otros</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Medio Pago <span class="text-danger">*</span></label>
                            <select class="form-select" id="Cotizacion_MedioPago" required>
                                <option value="01" selected>01 - Efectivo</option>
                                <option value="02">02 - Tarjeta</option>
                                <option value="03">03 - Cheque</option>
                                <option value="04">04 - Transferencia / dep&oacute;sito bancario</option>
                                <option value="05">05 - Recaudado por terceros</option>
                                <option value="06">06 - SINPE M&oacute;vil</option>
                                <option value="99">99 - Otros</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3" id="divPlazoCreditoDias" style="display: none;">
                            <label class="form-label">Plazo Cr&eacute;dito (d&iacute;as)</label>
                            <input type="number" class="form-control" id="Cotizacion_PlazoCreditoDias" min="1" placeholder="30" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Moneda <span class="text-danger">*</span></label>
                            <select class="form-select" id="Cotizacion_Moneda" required>
                                <option value="CRC" selected>CRC - Col&oacute;n</option>
                                <option value="USD">USD - D&oacute;lar</option>
                                <option value="EUR">EUR - Euro</option>
                            </select>
                        </div>
                        <div class="col-md-3 mb-3" id="divTipoCambio" style="display: none;">
                            <label class="form-label">Tipo de Cambio <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="Cotizacion_TipoCambio" step="0.01" min="0.01" value="1.00" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Notas</label>
                            <textarea class="form-control" id="Cotizacion_Notas" rows="1" maxlength="500" placeholder="Observaciones adicionales"></textarea>
                        </div>
                    </div>

                    <hr />

                    <!-- Line Items Section -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="text-primary mb-0"><i class="fas fa-list me-2"></i>Detalles de la Cotización</h6>
                        <button type="button" class="btn btn-sm btn-success" onclick="agregarDetalle()">
                            <i class="fas fa-plus me-1"></i>Agregar Producto
                        </button>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-sm table-bordered" id="tableDetalles">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 28%;">Producto</th>
                                    <th style="width: 10%;">Cantidad</th>
                                    <th style="width: 13%;">Precio Unit.</th>
                                    <th style="width: 10%;">Desc %</th>
                                    <th style="width: 14%;">IVA</th>
                                    <th style="width: 13%;">Subtotal</th>
                                    <th style="width: 12%;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="detallesBody">
                                <!-- Rows added dynamically -->
                            </tbody>
                        </table>
                    </div>

                    <!-- Empty state for details -->
                    <div id="emptyDetalles" class="text-center py-4 text-muted">
                        <i class="fas fa-box-open fa-3x mb-3"></i>
                        <p>No hay productos agregados. Haga clic en "Agregar Producto" para comenzar.</p>
                    </div>

                    <hr />

                    <!-- Totals Section -->
                    <div class="row">
                        <div class="col-md-6">
                            <!-- Space for notes or additional info -->
                        </div>
                        <div class="col-md-6">
                            <table class="table table-sm">
                                <tr>
                                    <td class="text-end"><strong>Subtotal:</strong></td>
                                    <td class="text-end" style="width: 150px;" id="displaySubtotal">&#x20A1;0.00</td>
                                </tr>
                                <tr>
                                    <td class="text-end"><strong>Descuento Total:</strong></td>
                                    <td class="text-end" id="displayDescuento">&#x20A1;0.00</td>
                                </tr>
                                <tr>
                                    <td class="text-end"><strong>Impuestos:</strong></td>
                                    <td class="text-end" id="displayImpuestos">&#x20A1;0.00</td>
                                </tr>
                                <tr class="table-primary">
                                    <td class="text-end"><strong>TOTAL:</strong></td>
                                    <td class="text-end"><strong id="displayTotal">&#x20A1;0.00</strong></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>Guardar Cotización
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Ver Cotización (Read-only) -->
<div class="modal fade" id="modalVerCotizacion" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fas fa-eye me-2"></i>Ver Cotización</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="verCotizacionBody">
                <!-- Content loaded dynamically -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let table;
    let detalleCounter = 0;
    let productosData = [];
    let clientesData = [];

    $(document).ready(function () {
        loadDataTable();
        setupFormSubmit();
        loadClientes();
        loadProductos();
        setDefaultDates();
        setupHeaderFieldHandlers();
    });

    function formatLocalDate(date) {
        const y = date.getFullYear();
        const m = String(date.getMonth() + 1).padStart(2, '0');
        const d = String(date.getDate()).padStart(2, '0');
        return `${y}-${m}-${d}`;
    }

    function setDefaultDates() {
        const today = new Date();
        const nextMonth = new Date(today.getFullYear(), today.getMonth() + 1, today.getDate());

        $('#Cotizacion_Fecha').val(formatLocalDate(today));
        $('#Cotizacion_FechaVencimiento').val(formatLocalDate(nextMonth));
    }

    function simboloMoneda() {
        const m = $('#Cotizacion_Moneda').val();
        return m === 'USD' ? '$' : m === 'EUR' ? '€' : '₡';
    }

    function setupHeaderFieldHandlers() {
        // CondicionVenta change: show/hide PlazoCreditoDias
        $('#Cotizacion_CondicionVenta').on('change', function () {
            const isCredito = $(this).val() === '02';
            $('#divPlazoCreditoDias').toggle(isCredito);
            if (!isCredito) $('#Cotizacion_PlazoCreditoDias').val('');
        });

        // Moneda change: show/hide TipoCambio, recalculate currency symbols
        $('#Cotizacion_Moneda').on('change', function () {
            const moneda = $(this).val();
            const isCRC = moneda === 'CRC';
            $('#divTipoCambio').toggle(!isCRC);
            if (isCRC) $('#Cotizacion_TipoCambio').val('1.00');
            calcularTotales();
        });
    }

    function loadDataTable() {
        const estadoFiltro = $('#filtroEstado').val() || 'TODAS';

        table = $('#tableCotizaciones').DataTable({
            ajax: {
                url: '?handler=Data&estado=' + estadoFiltro,
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                dataSrc: 'data'
            },
            columns: [
                { data: 'numero' },
                {
                    data: 'fechaEmision',
                    render: function (data) {
                        if (!data) return '';
                        return new Date(data).toLocaleDateString('es-CR', {day: '2-digit', month: '2-digit', year: 'numeric'});
                    }
                },
                {
                    data: 'cliente',
                    render: function (data) {
                        return data ? data.nombre : '';
                    }
                },
                {
                    data: 'fechaVencimiento',
                    render: function (data) {
                        if (!data) return '';
                        const fecha = new Date(data);
                        const hoy = new Date();
                        const diferencia = Math.ceil((fecha - hoy) / (1000 * 60 * 60 * 24));

                        let clase = '';
                        if (diferencia < 0) clase = 'text-danger';
                        else if (diferencia <= 7) clase = 'text-warning';

                        return `<span class="${clase}">${fecha.toLocaleDateString('es-CR', {day: '2-digit', month: '2-digit', year: 'numeric'})}</span>`;
                    }
                },
                {
                    data: 'total',
                    render: function (data, type, row) {
                        var m = (row.moneda || '').toString();
                        var sm = (m === 'USD' || m === '2') ? '$' : (m === 'EUR' || m === '3') ? '€' : '₡';
                        return sm + parseFloat(data || 0).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                    }
                },
                {
                    data: 'estado',
                    render: function (data) {
                        const estados = {
                            'BOR': { text: 'Borrador', class: 'secondary' },
                            'ENV': { text: 'Enviada', class: 'info' },
                            'APR': { text: 'Aprobada', class: 'success' },
                            'REC': { text: 'Rechazada', class: 'danger' },
                            'CON': { text: 'Convertida', class: 'primary' },
                            'VEN': { text: 'Vencida', class: 'dark' },
                            'Borrador': { text: 'Borrador', class: 'secondary' },
                            'Enviada': { text: 'Enviada', class: 'info' },
                            'Aprobada': { text: 'Aprobada', class: 'success' },
                            'Rechazada': { text: 'Rechazada', class: 'danger' },
                            'Convertida': { text: 'Convertida', class: 'primary' },
                            'Vencida': { text: 'Vencida', class: 'dark' }
                        };
                        const estado = estados[data] || { text: data, class: 'secondary' };
                        return `<span class="badge bg-${estado.class}">${estado.text}</span>`;
                    }
                },
                {
                    data: null,
                    orderable: false,
                    render: function (data, type, row) {
                        let buttons = `<button class="btn btn-sm btn-info" onclick="ver('${row.id}')" title="Ver">
                            <i class="fa fa-eye"></i>
                        </button> `;

                        buttons += `<button class="btn btn-sm btn-outline-danger" onclick="verPDF('${row.id}')" title="Ver PDF">
                            <i class="fa fa-file-pdf"></i>
                        </button> `;
                        buttons += `<button class="btn btn-sm btn-secondary" onclick="descargarPDF('${row.id}')" title="Descargar PDF">
                            <i class="fa fa-download"></i>
                        </button> `;

                        const est = row.estado;
                        const esBorrador = est === 'BOR' || est === 'Borrador';
                        const esEnviada = est === 'ENV' || est === 'Enviada';
                        const esAprobada = est === 'APR' || est === 'Aprobada';
                        const esRechazada = est === 'REC' || est === 'Rechazada';

                        // Edit button - only for drafts
                        if (esBorrador) {
                            buttons += `<button class="btn btn-sm btn-warning" onclick="edit('${row.id}')" title="Editar">
                                <i class="fa fa-edit"></i>
                            </button> `;
                        }

                        // Send button - for drafts
                        if (esBorrador) {
                            buttons += `<button class="btn btn-sm btn-primary" onclick="enviar('${row.id}')" title="Enviar">
                                <i class="fa fa-paper-plane"></i>
                            </button> `;
                        }

                        // Approve/Reject buttons - for sent quotations
                        if (esEnviada) {
                            buttons += `<button class="btn btn-sm btn-success" onclick="aprobar('${row.id}')" title="Aprobar">
                                <i class="fa fa-check"></i>
                            </button> `;
                            buttons += `<button class="btn btn-sm btn-danger" onclick="rechazar('${row.id}')" title="Rechazar">
                                <i class="fa fa-times"></i>
                            </button> `;
                        }

                        // Convert button - for approved quotations
                        if (esAprobada) {
                            buttons += `<button class="btn btn-sm btn-success" onclick="convertir('${row.id}')" title="Convertir a Factura">
                                <i class="fa fa-file-invoice"></i>
                            </button> `;
                        }

                        // Delete button - only for drafts and rejected
                        if (esBorrador || esRechazada) {
                            buttons += `<button class="btn btn-sm btn-danger" onclick="deleteRecord('${row.id}')" title="Eliminar">
                                <i class="fa fa-trash"></i>
                            </button>`;
                        }

                        return buttons;
                    }
                }
            ],
            language: {
                url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'
            },
            responsive: true,
            order: [[1, 'desc']],
            pageLength: 25,
            drawCallback: function (settings) {
                var api = this.api();
                var recordsTotal = api.page.info().recordsTotal;

                $('#badgeTotalCotizaciones').text(recordsTotal);
                $('#tableCotizacionesLoader').hide();

                if (recordsTotal === 0) {
                    $('#tableCotizacionesContainer').hide();
                    $('#emptyStateCotizaciones').show();
                } else {
                    $('#tableCotizacionesContainer').show();
                    $('#emptyStateCotizaciones').hide();
                }
            }
        });
    }

    function aplicarFiltro() {
        table.destroy();
        loadDataTable();
    }

    function loadClientes() {
        $.ajax({
            url: '?handler=Clientes',
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function (data) {
                clientesData = data;
                const select = $('#Cotizacion_ClienteId');
                select.empty().append('<option value="">Seleccione un cliente...</option>');

                if (data && data.length > 0) {
                    data.forEach(function (cliente) {
                        select.append(`<option value="${cliente.id}">${cliente.nombre}</option>`);
                    });
                }
            }
        });
    }

    function loadProductos() {
        $.ajax({
            url: '?handler=Productos',
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function (data) {
                productosData = data;
            }
        });
    }

    function setupFormSubmit() {
        $('#formCotizacion').on('submit', function (e) {
            e.preventDefault();
            save();
        });
    }

    function openCreateModal() {
        $('#formCotizacion')[0].reset();
        $('#Cotizacion_Id').val('00000000-0000-0000-0000-000000000000');
        $('#Cotizacion_EmpresaId').val('@Model.EmpresaId');
        $('#modalTitle').text('Nueva Cotización');
        $('#detallesBody').empty();
        detalleCounter = 0;
        toggleEmptyDetalles();

        // Reset new header fields
        $('#Cotizacion_CondicionVenta').val('01');
        $('#Cotizacion_MedioPago').val('01');
        $('#Cotizacion_Moneda').val('CRC').trigger('change');
        $('#Cotizacion_TipoCambio').val('1.00');
        $('#Cotizacion_PlazoCreditoDias').val('');
        $('#divPlazoCreditoDias').hide();
        $('#divTipoCambio').hide();

        calcularTotales();
        setDefaultDates();
        $('#modalCotizacion').modal('show');
    }

    function verPDF(id) {
        const pdfUrl = `?handler=Pdf&id=${id}&download=false`;
        const newWindow = window.open(pdfUrl, '_blank');
        if (!newWindow) {
            Swal.fire({
                icon: 'warning',
                title: 'Ventana bloqueada',
                text: 'El navegador bloqueó la ventana emergente. Habilite ventanas emergentes para este sitio.',
                confirmButtonText: 'Entendido'
            });
        }
    }

    function descargarPDF(id) {
        Swal.fire({
            title: 'Generando PDF...',
            text: 'Por favor espere mientras se genera la cotización.',
            allowOutsideClick: false,
            didOpen: () => { Swal.showLoading(); }
        });
        window.location.href = `?handler=Pdf&id=${id}&download=true`;
        setTimeout(() => Swal.close(), 2000);
    }

    function ver(id) {
        $.ajax({
            url: '?handler=Details&id=' + id,
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function (response) {
                if (response.success) {
                    mostrarCotizacion(response.data);
                } else {
                    Swal.fire('Error', response.message, 'error');
                }
            }
        });
    }

    function mostrarCotizacion(data) {
        const condVentaMap = { '01': 'Contado', '02': 'Crédito', '03': 'Consignación', '04': 'Apartado', '05': 'Arrendamiento opción compra', '06': 'Arrendamiento financiero', '99': 'Otros' };
        const medioPagoMap = { '01': 'Efectivo', '02': 'Tarjeta', '03': 'Cheque', '04': 'Transferencia', '05': 'Recaudado terceros', '06': 'SINPE Móvil', '99': 'Otros' };
        const moneda = data.moneda || 'CRC';
        const sm = moneda === 'USD' ? '$' : moneda === 'EUR' ? '€' : '₡';

        let html = `
            <div class="row mb-3">
                <div class="col-md-6">
                    <h6>Número: <strong>${data.numero || 'N/A'}</strong></h6>
                    <p><strong>Cliente:</strong> ${data.cliente?.nombre || 'N/A'}</p>
                    <p><strong>Fecha:</strong> ${data.fechaEmision ? new Date(data.fechaEmision).toLocaleDateString('es-CR', {day: '2-digit', month: '2-digit', year: 'numeric'}) : 'N/A'}</p>
                    <p><strong>Vencimiento:</strong> ${data.fechaVencimiento ? new Date(data.fechaVencimiento).toLocaleDateString('es-CR', {day: '2-digit', month: '2-digit', year: 'numeric'}) : 'N/A'}</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Condición Venta:</strong> ${data.condicionVenta ? data.condicionVenta + ' - ' + (condVentaMap[data.condicionVenta] || '') : 'N/A'}</p>
                    <p><strong>Medio Pago:</strong> ${data.medioPago ? data.medioPago + ' - ' + (medioPagoMap[data.medioPago] || '') : 'N/A'}</p>
                    <p><strong>Moneda:</strong> ${moneda}${data.tipoCambio && moneda !== 'CRC' ? ' (TC: ' + data.tipoCambio + ')' : ''}</p>
                    <p><strong>Notas:</strong> ${data.notas || 'N/A'}</p>
                    <p><strong>Estado:</strong> <span class="badge bg-info">${data.estadoDescripcion || data.estado}</span></p>
                </div>
            </div>
            <hr />
            <h6>Detalles</h6>
            <table class="table table-sm table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Precio Unit.</th>
                        <th>Desc %</th>
                        <th>IVA</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>`;

        if (data.detalles && data.detalles.length > 0) {
            data.detalles.forEach(function (detalle) {
                const tarifa = detalle.tarifaIVA != null ? detalle.tarifaIVA : 13;
                html += `<tr>
                    <td>${detalle.producto?.nombre || detalle.descripcion || 'N/A'}</td>
                    <td>${detalle.cantidad}</td>
                    <td>${sm}${parseFloat(detalle.precioUnitario || 0).toLocaleString('es-CR', { minimumFractionDigits: 2 })}</td>
                    <td>${detalle.porcentajeDescuento || detalle.descuento || 0}%</td>
                    <td>${tarifa}%</td>
                    <td>${sm}${parseFloat(detalle.totalLinea || detalle.subtotal || 0).toLocaleString('es-CR', { minimumFractionDigits: 2 })}</td>
                </tr>`;
            });
        } else {
            html += '<tr><td colspan="6" class="text-center">No hay detalles</td></tr>';
        }

        html += `</tbody>
            </table>
            <div class="text-end mt-3">
                <h5>Total: <strong>${sm}${parseFloat(data.total || 0).toLocaleString('es-CR', { minimumFractionDigits: 2 })}</strong></h5>
            </div>`;

        $('#verCotizacionBody').html(html);
        $('#modalVerCotizacion').modal('show');
    }

    function edit(id) {
        $.ajax({
            url: '?handler=Details&id=' + id,
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function (response) {
                if (response.success) {
                    const data = response.data;
                    $('#Cotizacion_Id').val(data.id);
                    $('#Cotizacion_EmpresaId').val(data.empresaId);
                    $('#Cotizacion_ClienteId').val(data.clienteId);
                    $('#Cotizacion_Fecha').val(data.fechaEmision ? data.fechaEmision.split('T')[0] : '');
                    $('#Cotizacion_FechaVencimiento').val(data.fechaVencimiento ? data.fechaVencimiento.split('T')[0] : '');
                    $('#Cotizacion_CondicionVenta').val(data.condicionVenta || '01');
                    $('#Cotizacion_MedioPago').val(data.medioPago || '01');
                    $('#Cotizacion_Moneda').val(data.moneda || 'CRC').trigger('change');
                    $('#Cotizacion_TipoCambio').val(data.tipoCambio || 1);
                    $('#Cotizacion_PlazoCreditoDias').val(data.plazoCreditoDias || '');
                    $('#Cotizacion_CondicionVenta').trigger('change'); // Show/hide plazo
                    $('#Cotizacion_Notas').val(data.notas || '');

                    // Load details
                    $('#detallesBody').empty();
                    detalleCounter = 0;

                    if (data.detalles && data.detalles.length > 0) {
                        data.detalles.forEach(function (detalle) {
                            agregarDetalleConDatos(detalle);
                        });
                    }

                    toggleEmptyDetalles();
                    calcularTotales();

                    $('#modalTitle').text('Editar Cotización');
                    $('#modalCotizacion').modal('show');
                } else {
                    Swal.fire('Error', response.message, 'error');
                }
            }
        });
    }

    function agregarDetalle() {
        const id = detalleCounter++;
        const html = `
            <tr id="detalle_${id}">
                <td>
                    <select class="form-select form-select-sm producto-select" data-id="${id}" required>
                        <option value="">Seleccione...</option>
                        ${productosData.map(p => `<option value="${p.id}" data-precio="${p.precioVenta || 0}" data-iva="${p.codigoTarifaIVA || '08'}" data-tarifa="${p.tarifaIVA != null ? p.tarifaIVA : 13}">${p.nombre}</option>`).join('')}
                    </select>
                </td>
                <td>
                    <input type="number" class="form-control form-control-sm cantidad-input" data-id="${id}"
                           min="0.001" step="0.001" value="1" required />
                </td>
                <td>
                    <input type="number" class="form-control form-control-sm precio-input" data-id="${id}"
                           min="0" step="0.01" value="0" required />
                </td>
                <td>
                    <input type="number" class="form-control form-control-sm descuento-input" data-id="${id}"
                           min="0" max="100" step="0.01" value="0" />
                </td>
                <td>
                    <select class="form-select form-select-sm iva-select" data-id="${id}">
                        <option value="01" data-tarifa="0">No sujeto</option>
                        <option value="02" data-tarifa="0">Exento</option>
                        <option value="03" data-tarifa="1">1%</option>
                        <option value="04" data-tarifa="2">2%</option>
                        <option value="05" data-tarifa="4">4%</option>
                        <option value="08" data-tarifa="13" selected>13%</option>
                    </select>
                </td>
                <td>
                    <input type="text" class="form-control form-control-sm subtotal-display" data-id="${id}"
                           readonly value="${simboloMoneda()}0.00" />
                </td>
                <td>
                    <button type="button" class="btn btn-sm btn-danger" onclick="eliminarDetalle(${id})">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>
        `;

        $('#detallesBody').append(html);
        toggleEmptyDetalles();

        // Attach event handlers
        $(`select.producto-select[data-id="${id}"]`).on('change', function () {
            const sel = $(this).find(':selected');
            const precio = sel.data('precio') || 0;
            $(`input.precio-input[data-id="${id}"]`).val(precio);
            // Set IVA from product data
            const ivaCode = sel.data('iva') || '08';
            const ivaTarifa = sel.data('tarifa');
            if (ivaCode) {
                $(`select.iva-select[data-id="${id}"]`).val(ivaCode);
            }
            calcularSubtotal(id);
        });

        $(`input.cantidad-input[data-id="${id}"], input.precio-input[data-id="${id}"], input.descuento-input[data-id="${id}"]`)
            .on('input', function () {
                calcularSubtotal(id);
            });

        $(`select.iva-select[data-id="${id}"]`).on('change', function () {
            calcularSubtotal(id);
        });
    }

    function agregarDetalleConDatos(detalle) {
        const id = detalleCounter++;
        const ivaCode = detalle.codigoTarifaIVA || '08';
        const html = `
            <tr id="detalle_${id}">
                <td>
                    <select class="form-select form-select-sm producto-select" data-id="${id}" required>
                        <option value="">Seleccione...</option>
                        ${productosData.map(p => `<option value="${p.id}" data-precio="${p.precioVenta || 0}" data-iva="${p.codigoTarifaIVA || '08'}" data-tarifa="${p.tarifaIVA != null ? p.tarifaIVA : 13}" ${p.id === detalle.productoId ? 'selected' : ''}>${p.nombre}</option>`).join('')}
                    </select>
                </td>
                <td>
                    <input type="number" class="form-control form-control-sm cantidad-input" data-id="${id}"
                           min="0.001" step="0.001" value="${detalle.cantidad || 1}" required />
                </td>
                <td>
                    <input type="number" class="form-control form-control-sm precio-input" data-id="${id}"
                           min="0" step="0.01" value="${detalle.precioUnitario || 0}" required />
                </td>
                <td>
                    <input type="number" class="form-control form-control-sm descuento-input" data-id="${id}"
                           min="0" max="100" step="0.01" value="${detalle.porcentajeDescuento || detalle.descuento || 0}" />
                </td>
                <td>
                    <select class="form-select form-select-sm iva-select" data-id="${id}">
                        <option value="01" data-tarifa="0" ${ivaCode === '01' ? 'selected' : ''}>No sujeto</option>
                        <option value="02" data-tarifa="0" ${ivaCode === '02' ? 'selected' : ''}>Exento</option>
                        <option value="03" data-tarifa="1" ${ivaCode === '03' ? 'selected' : ''}>1%</option>
                        <option value="04" data-tarifa="2" ${ivaCode === '04' ? 'selected' : ''}>2%</option>
                        <option value="05" data-tarifa="4" ${ivaCode === '05' ? 'selected' : ''}>4%</option>
                        <option value="08" data-tarifa="13" ${ivaCode === '08' || !ivaCode ? 'selected' : ''}>13%</option>
                    </select>
                </td>
                <td>
                    <input type="text" class="form-control form-control-sm subtotal-display" data-id="${id}"
                           readonly value="${simboloMoneda()}0.00" />
                </td>
                <td>
                    <button type="button" class="btn btn-sm btn-danger" onclick="eliminarDetalle(${id})">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>
        `;

        $('#detallesBody').append(html);

        // Attach event handlers
        $(`select.producto-select[data-id="${id}"]`).on('change', function () {
            const sel = $(this).find(':selected');
            const precio = sel.data('precio') || 0;
            $(`input.precio-input[data-id="${id}"]`).val(precio);
            const ivaCode = sel.data('iva') || '08';
            if (ivaCode) {
                $(`select.iva-select[data-id="${id}"]`).val(ivaCode);
            }
            calcularSubtotal(id);
        });

        $(`input.cantidad-input[data-id="${id}"], input.precio-input[data-id="${id}"], input.descuento-input[data-id="${id}"]`)
            .on('input', function () {
                calcularSubtotal(id);
            });

        $(`select.iva-select[data-id="${id}"]`).on('change', function () {
            calcularSubtotal(id);
        });

        calcularSubtotal(id);
    }

    function eliminarDetalle(id) {
        $(`#detalle_${id}`).remove();
        toggleEmptyDetalles();
        calcularTotales();
    }

    function toggleEmptyDetalles() {
        if ($('#detallesBody tr').length === 0) {
            $('#emptyDetalles').show();
            $('#tableDetalles').hide();
        } else {
            $('#emptyDetalles').hide();
            $('#tableDetalles').show();
        }
    }

    function calcularSubtotal(id) {
        const cantidad = parseFloat($(`input.cantidad-input[data-id="${id}"]`).val()) || 0;
        const precio = parseFloat($(`input.precio-input[data-id="${id}"]`).val()) || 0;
        const descuento = parseFloat($(`input.descuento-input[data-id="${id}"]`).val()) || 0;
        const tarifaIVA = parseFloat($(`select.iva-select[data-id="${id}"] :selected`).data('tarifa')) || 0;

        const subtotalBruto = cantidad * precio;
        const montoDescuento = subtotalBruto * (descuento / 100);
        const subtotalNeto = subtotalBruto - montoDescuento;
        const montoIVA = subtotalNeto * (tarifaIVA / 100);
        const totalLinea = subtotalNeto + montoIVA;

        $(`input.subtotal-display[data-id="${id}"]`).val(simboloMoneda() + totalLinea.toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));

        calcularTotales();
    }

    function calcularTotales() {
        let subtotal = 0;
        let descuentoTotal = 0;
        let impuestosTotal = 0;

        $('#detallesBody tr').each(function () {
            const id = $(this).find('.cantidad-input').data('id');
            const cantidad = parseFloat($(`input.cantidad-input[data-id="${id}"]`).val()) || 0;
            const precio = parseFloat($(`input.precio-input[data-id="${id}"]`).val()) || 0;
            const descuento = parseFloat($(`input.descuento-input[data-id="${id}"]`).val()) || 0;
            const tarifaIVA = parseFloat($(`select.iva-select[data-id="${id}"] :selected`).data('tarifa')) || 0;

            const subtotalBruto = cantidad * precio;
            const montoDescuento = subtotalBruto * (descuento / 100);
            const subtotalNeto = subtotalBruto - montoDescuento;
            const montoIVA = subtotalNeto * (tarifaIVA / 100);

            subtotal += subtotalBruto;
            descuentoTotal += montoDescuento;
            impuestosTotal += montoIVA;
        });

        const total = subtotal - descuentoTotal + impuestosTotal;
        const sm = simboloMoneda();

        $('#displaySubtotal').text(sm + subtotal.toLocaleString('es-CR', { minimumFractionDigits: 2 }));
        $('#displayDescuento').text(sm + descuentoTotal.toLocaleString('es-CR', { minimumFractionDigits: 2 }));
        $('#displayImpuestos').text(sm + impuestosTotal.toLocaleString('es-CR', { minimumFractionDigits: 2 }));
        $('#displayTotal').text(sm + total.toLocaleString('es-CR', { minimumFractionDigits: 2 }));
    }

    function save() {
        // Validate form
        if (!$('#formCotizacion')[0].checkValidity()) {
            $('#formCotizacion')[0].reportValidity();
            return;
        }

        // Validate details
        if ($('#detallesBody tr').length === 0) {
            Swal.fire('Error', 'Debe agregar al menos un producto', 'error');
            return;
        }

        // Build detalles array
        const detalles = [];
        let lineaNum = 0;
        let hasError = false;
        $('#detallesBody tr').each(function () {
            const id = $(this).find('.cantidad-input').data('id');
            const productoSelect = $(`select.producto-select[data-id="${id}"]`);
            const productoId = productoSelect.val();
            const productoNombre = productoSelect.find(':selected').text() || 'Producto';
            const cantidad = parseFloat($(`input.cantidad-input[data-id="${id}"]`).val()) || 0;
            const precio = parseFloat($(`input.precio-input[data-id="${id}"]`).val()) || 0;
            const descuento = parseFloat($(`input.descuento-input[data-id="${id}"]`).val()) || 0;

            const ivaSelect = $(`select.iva-select[data-id="${id}"]`);
            const codigoTarifaIVA = ivaSelect.val();
            const tarifaIVA = parseFloat(ivaSelect.find(':selected').data('tarifa')) || 0;

            if (!productoId) {
                Swal.fire('Error', 'Todos los productos deben estar seleccionados', 'error');
                hasError = true;
                return false;
            }

            lineaNum++;
            const montoTotal = cantidad * precio;
            const montoDescuento = montoTotal * (descuento / 100);
            const subTotal = montoTotal - montoDescuento;
            const montoIVA = subTotal * (tarifaIVA / 100);
            const totalLinea = subTotal + montoIVA;

            detalles.push({
                productoId: productoId,
                descripcion: productoNombre.trim(),
                numeroLinea: lineaNum,
                cantidad: cantidad,
                precioUnitario: precio,
                montoTotal: montoTotal,
                montoDescuento: montoDescuento,
                porcentajeDescuento: descuento,
                subTotal: subTotal,
                codigoTarifaIVA: codigoTarifaIVA,
                tarifaIVA: tarifaIVA,
                montoIVA: montoIVA,
                totalImpuestos: montoIVA,
                totalLinea: totalLinea
            });
        });

        if (hasError) return;

        if (detalles.length === 0) {
            return;
        }

        // Calculate totals
        let subtotal = 0;
        let descuentoTotal = 0;
        let impuestosTotal = 0;
        detalles.forEach(d => {
            subtotal += d.montoTotal;
            descuentoTotal += d.montoDescuento;
            impuestosTotal += d.montoIVA;
        });
        const total = subtotal - descuentoTotal + impuestosTotal;

        const cotizacion = {
            id: $('#Cotizacion_Id').val(),
            empresaId: $('#Cotizacion_EmpresaId').val(),
            clienteId: $('#Cotizacion_ClienteId').val(),
            fecha: $('#Cotizacion_Fecha').val(),
            fechaVencimiento: $('#Cotizacion_FechaVencimiento').val(),
            condicionVenta: $('#Cotizacion_CondicionVenta').val(),
            medioPago: $('#Cotizacion_MedioPago').val(),
            moneda: $('#Cotizacion_Moneda').val(),
            tipoCambio: parseFloat($('#Cotizacion_TipoCambio').val()) || 1,
            plazoCreditoDias: parseInt($('#Cotizacion_PlazoCreditoDias').val()) || null,
            notas: $('#Cotizacion_Notas').val(),
            subtotal: subtotal,
            descuentoTotal: descuentoTotal,
            impuestos: impuestosTotal,
            total: total,
            estado: 'BOR', // Always save as draft
            detalles: detalles
        };

        $.ajax({
            url: '?handler=Save',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(cotizacion),
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function (response) {
                if (response.success) {
                    Swal.fire('Éxito', response.message, 'success');
                    $('#modalCotizacion').modal('hide');
                    table.ajax.reload();
                } else {
                    Swal.fire('Error', response.message, 'error');
                }
            },
            error: function () {
                Swal.fire('Error', 'Ocurrió un error al procesar la solicitud', 'error');
            }
        });
    }

