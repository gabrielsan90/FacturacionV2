@page
@model Facturacion.Frontend.Pages.CxP.CuentasPorPagarModel
@{
    ViewData["Title"] = "Cuentas por Pagar";
    ViewData["Breadcrumb"] = "Cuentas por Pagar";
}

<!-- Summary Cards -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card shadow-custom border-0 bg-gradient-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-white-50 mb-1">Total Pendiente</h6>
                        <h3 class="mb-0" id="cardTotalPendiente">₡0.00</h3>
                    </div>
                    <div class="summary-icon">
                        <i class="fas fa-file-invoice-dollar fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-custom border-0 bg-gradient-danger text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-white-50 mb-1">Total Vencido</h6>
                        <h3 class="mb-0" id="cardTotalVencido">₡0.00</h3>
                    </div>
                    <div class="summary-icon">
                        <i class="fas fa-exclamation-triangle fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-custom border-0 bg-gradient-success text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-white-50 mb-1">Pagos del Mes</h6>
                        <h3 class="mb-0" id="cardPagosDelMes">₡0.00</h3>
                    </div>
                    <div class="summary-icon">
                        <i class="fas fa-check-circle fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Page Header -->
<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h2><i class="fas fa-money-bill-wave"></i> Cuentas por Pagar</h2>
            <p class="mb-0">Gestión de facturas de proveedores y pagos</p>
        </div>
        <button class="btn btn-primary" onclick="openCreateModal()">
            <i class="fas fa-plus me-2"></i>Nueva Cuenta por Pagar
        </button>
    </div>
</div>

<div class="card shadow-custom">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <strong>Cuentas por Pagar</strong>
                <span class="badge bg-secondary ms-2" id="badgeTotalCuentas">0</span>
            </div>
        </div>
    </div>
    <div class="card-body">
        <!-- Filters -->
        <div class="row mb-3">
            <div class="col-md-3">
                <label class="form-label">Estado</label>
                <select class="form-select" id="filterEstado">
                    <option value="">Todos</option>
                    <option value="PEN">Pendiente</option>
                    <option value="PAR">Parcial</option>
                    <option value="PAG">Pagada</option>
                    <option value="VEN">Vencida</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Proveedor</label>
                <select class="form-select" id="filterProveedor">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Desde</label>
                <input type="date" class="form-control" id="filterFechaDesde" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Hasta</label>
                <input type="date" class="form-control" id="filterFechaHasta" />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="filterVencido" />
                    <label class="form-check-label" for="filterVencido">
                        Solo Vencidos
                    </label>
                </div>
            </div>
        </div>

        <!-- Loading State -->
        <div id="tableCuentasLoader" class="text-center py-5">
            <div class="spinner-modern mx-auto"></div>
            <p class="text-muted mt-3">Cargando cuentas por pagar...</p>
        </div>

        <!-- Table Container -->
        <div id="tableCuentasContainer" style="display: none;">
            <table id="tableCuentas" class="table table-hover">
                <thead>
                    <tr>
                        <th>Núm. Factura</th>
                        <th>Proveedor</th>
                        <th>Fecha Factura</th>
                        <th>Vencimiento</th>
                        <th>Monto Original</th>
                        <th>Saldo</th>
                        <th>Estado</th>
                        <th style="width: 180px;">Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <!-- Empty State -->
        <div id="emptyStateCuentas" class="empty-state" style="display: none;">
            <div class="empty-state-icon">
                <i class="fas fa-money-bill-wave"></i>
            </div>
            <h3 class="empty-state-title">No hay cuentas por pagar registradas</h3>
            <p class="empty-state-description">Comienza registrando la primera factura de proveedor</p>
            <button class="btn btn-primary" onclick="openCreateModal()">
                <i class="fas fa-plus me-2"></i>Crear Primera Cuenta por Pagar
            </button>
        </div>
    </div>
</div>

<!-- Modal Create/Edit -->
<div class="modal fade" id="modalCuenta" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">
                    <i class="fas fa-file-invoice me-2 text-primary"></i>Nueva Cuenta por Pagar
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="formCuenta">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="Cuenta_Id" value="00000000-0000-0000-0000-000000000000" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Proveedor <span class="text-danger">*</span></label>
                            <select class="form-select" id="Cuenta_ProveedorId" required>
                                <option value="">Seleccione...</option>
                                @foreach (var proveedor in Model.Proveedores)
                                {
                                    <option value="@proveedor.Value">@proveedor.Text</option>
                                }
                            </select>
                            <div class="invalid-feedback">Seleccione un proveedor.</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Número Factura <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="Cuenta_NumeroFactura" maxlength="50" required />
                            <div class="invalid-feedback">El número de factura es obligatorio.</div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Fecha Factura <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="Cuenta_FechaFactura" required />
                            <div class="invalid-feedback">La fecha es obligatoria.</div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Fecha Vencimiento <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="Cuenta_FechaVencimiento" required />
                            <div class="invalid-feedback">La fecha es obligatoria.</div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Monto <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="Cuenta_MontoOriginal" step="0.01" min="0" required />
                            <div class="invalid-feedback">El monto es obligatorio.</div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Moneda</label>
                            <select class="form-select" id="Cuenta_Moneda">
                                <option value="CRC">CRC - Colones</option>
                                <option value="USD">USD - Dólares</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Tipo de Cambio</label>
                            <input type="number" class="form-control" id="Cuenta_TipoCambio" step="0.0001" value="1" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Observaciones</label>
                            <textarea class="form-control" id="Cuenta_Observaciones" rows="2" maxlength="500"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-1"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Pagar -->
<div class="modal fade" id="modalPagar" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-money-bill-wave me-2 text-success"></i>Registrar Pago
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="formPagar">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="Pago_CuentaId" />

                    <div class="alert alert-info">
                        <strong>Factura:</strong> <span id="infoPagoNumFactura"></span><br />
                        <strong>Proveedor:</strong> <span id="infoPagoProveedor"></span><br />
                        <strong>Saldo Pendiente:</strong> <span id="infoPagoSaldo" class="text-danger fw-bold"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Monto a Pagar <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="Pago_Monto" step="0.01" min="0.01" required />
                        <div class="invalid-feedback">El monto es obligatorio.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Fecha de Pago <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="Pago_FechaPago" required />
                        <div class="invalid-feedback">La fecha es obligatoria.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Método de Pago <span class="text-danger">*</span></label>
                        <select class="form-select" id="Pago_MetodoPago" required>
                            <option value="">Seleccione...</option>
                            <option value="TRA">Transferencia</option>
                            <option value="CHE">Cheque</option>
                            <option value="EFE">Efectivo</option>
                            <option value="DEP">Depósito</option>
                            <option value="TAR">Tarjeta</option>
                        </select>
                        <div class="invalid-feedback">Seleccione un método.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Cuenta Bancaria</label>
                        <select class="form-select" id="Pago_CuentaBancariaId">
                            <option value="">Seleccione...</option>
                            @foreach (var cuenta in Model.CuentasBancarias)
                            {
                                <option value="@cuenta.Value">@cuenta.Text</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Número de Referencia</label>
                        <input type="text" class="form-control" id="Pago_NumeroReferencia" maxlength="100" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Notas</label>
                        <textarea class="form-control" id="Pago_Notas" rows="2" maxlength="500"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-1"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-check me-1"></i> Registrar Pago
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let table;
    let cuentasPorPagar = [];

    $(document).ready(function() {
        loadDataTable();
        setupFormSubmit();
        setupFilterHandlers();
        setDefaultDates();
        loadSummaryCards();
    });

    function setDefaultDates() {
        const today = new Date().toISOString().split('T')[0];
        $('#Cuenta_FechaFactura').val(today);
        $('#Cuenta_FechaVencimiento').val(today);
        $('#Pago_FechaPago').val(today);
    }

    function loadDataTable() {
        table = initDataTable('#tableCuentas', {
            ajax: {
                url: '?handler=Data',
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                dataSrc: function(json) {
                    $('#tableCuentasLoader').hide();

                    cuentasPorPagar = json.data || json || [];
                    $('#badgeTotalCuentas').text(cuentasPorPagar.length);

                    if (cuentasPorPagar.length > 0) {
                        $('#tableCuentasContainer').show();
                        $('#emptyStateCuentas').hide();
                    } else {
                        $('#tableCuentasContainer').hide();
                        $('#emptyStateCuentas').show();
                    }

                    return applyFilters(cuentasPorPagar);
                },
                error: function(xhr, error, code) {
                    $('#tableCuentasLoader').hide();
                    $('#tableCuentasContainer').hide();
                    $('#emptyStateCuentas').show();
                    $('#badgeTotalCuentas').text('0');
                    console.error('Error loading cuentas:', error);
                }
            },
            columns: [
                { data: 'numeroFactura' },
                {
                    data: 'proveedorNombre',
                    render: function(data) {
                        return data ? data : '<span class="text-muted">-</span>';
                    }
                },
                {
                    data: 'fechaFactura',
                    render: function(data) {
                        return formatDate(data);
                    }
                },
                {
                    data: 'fechaVencimiento',
                    render: function(data, type, row) {
                        const formatted = formatDate(data);
                        const isVencida = row.estaVencida;
                        if (isVencida) {
                            return `<span class="text-danger fw-bold">${formatted}</span>`;
                        }
                        return formatted;
                    }
                },
                {
                    data: 'montoOriginal',
                    render: function(data) {
                        return formatCurrency(data);
                    }
                },
                {
                    data: 'montoSaldo',
                    render: function(data, type, row) {
                        const formatted = formatCurrency(data);
                        if (row.estaVencida && data > 0) {
                            return `<span class="text-danger fw-bold">${formatted}</span>`;
                        }
                        return formatted;
                    }
                },
                {
                    data: 'estado',
                    render: function(data, type, row) {
                        const badges = {
                            'PEN': '<span class="badge bg-warning">Pendiente</span>',
                            'PAR': '<span class="badge bg-info">Parcial</span>',
                            'PAG': '<span class="badge bg-success">Pagada</span>',
                            'VEN': '<span class="badge bg-danger">Vencida</span>'
                        };
                        return badges[data] || data;
                    }
                },
                {
                    data: 'id',
                    orderable: false,
                    render: function(data, type, row) {
                        let buttons = `
                            <button class="btn btn-sm btn-info" onclick="edit('${data}')" title="Editar">
                                <i class="fas fa-edit"></i>
                            </button>
                        `;

                        if (row.estado !== 'PAG') {
                            buttons += `
                                <button class="btn btn-sm btn-success" onclick="openPagarModal('${data}')" title="Pagar">
                                    <i class="fas fa-money-bill-wave"></i>
                                </button>
                            `;
                        }

                        buttons += `
                            <button class="btn btn-sm btn-primary" onclick="verEstadoCuenta('${row.proveedorId}')" title="Estado de Cuenta">
                                <i class="fas fa-file-alt"></i>
                            </button>
                            <button class="btn btn-sm btn-danger" onclick="deleteRecord('${data}')" title="Eliminar">
                                <i class="fas fa-trash"></i>
                            </button>
                        `;
                        return buttons;
                    }
                }
            ],
            order: [[2, 'desc']]
        });
    }

    function setupFilterHandlers() {
        $('#filterEstado, #filterProveedor, #filterVencido').on('change', function() {
            table.ajax.reload();
        });

        $('#filterFechaDesde, #filterFechaHasta').on('change', function() {
            table.ajax.reload();
        });
    }

    function applyFilters(data) {
        let filtered = data;

        const estado = $('#filterEstado').val();
        if (estado) {
            filtered = filtered.filter(c => c.estado === estado);
        }

        const proveedorId = $('#filterProveedor').val();
        if (proveedorId) {
            filtered = filtered.filter(c => c.proveedorId === proveedorId);
        }

        const vencidoOnly = $('#filterVencido').is(':checked');
        if (vencidoOnly) {
            filtered = filtered.filter(c => c.estaVencida);
        }

        const fechaDesde = $('#filterFechaDesde').val();
        if (fechaDesde) {
            filtered = filtered.filter(c => new Date(c.fechaFactura) >= new Date(fechaDesde));
        }

        const fechaHasta = $('#filterFechaHasta').val();
        if (fechaHasta) {
            filtered = filtered.filter(c => new Date(c.fechaFactura) <= new Date(fechaHasta));
        }

        return filtered;
    }

    function loadSummaryCards() {
        $.ajax({
            url: '?handler=Summary',
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                $('#cardTotalPendiente').html(renderMontosPorMoneda(response.pendientePorMoneda, formatCurrency(0)));
                $('#cardTotalVencido').html(renderMontosPorMoneda(response.vencidoPorMoneda, formatCurrency(0)));
                $('#cardPagosDelMes').html(renderMontosPorMoneda(response.pagosDelMesPorMoneda, formatCurrency(0)));
            }
        });
    }

    function setupFormSubmit() {
        $('#formCuenta').on('submit', function(e) {
            e.preventDefault();
            if (this.checkValidity()) {
                save();
            } else {
                $(this).addClass('was-validated');
            }
        });

        $('#formPagar').on('submit', function(e) {
            e.preventDefault();
            if (this.checkValidity()) {
                registrarPago();
            } else {
                $(this).addClass('was-validated');
            }
        });
    }

    function openCreateModal() {
        $('#formCuenta')[0].reset();
        $('#formCuenta').removeClass('was-validated');
        $('#Cuenta_Id').val('00000000-0000-0000-0000-000000000000');
        $('#Cuenta_Moneda').val('CRC');
        $('#Cuenta_TipoCambio').val('1');
        setDefaultDates();
        $('#modalTitle').text('Nueva Cuenta por Pagar');
        $('#modalCuenta').modal('show');
    }

    function edit(id) {
        $.ajax({
            url: '?handler=Details&id=' + id,
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(data) {
                $('#Cuenta_Id').val(data.id);
                $('#Cuenta_ProveedorId').val(data.proveedorId);
                $('#Cuenta_NumeroFactura').val(data.numeroFactura);
                $('#Cuenta_FechaFactura').val(data.fechaFactura.split('T')[0]);
                $('#Cuenta_FechaVencimiento').val(data.fechaVencimiento.split('T')[0]);
                $('#Cuenta_MontoOriginal').val(data.montoOriginal);
                $('#Cuenta_Moneda').val(data.moneda);
                $('#Cuenta_TipoCambio').val(data.tipoCambio);
                $('#Cuenta_Observaciones').val(data.observaciones || '');

                $('#modalTitle').text('Editar Cuenta por Pagar');
                $('#formCuenta').removeClass('was-validated');
                $('#modalCuenta').modal('show');
            },
            error: function(xhr) {
                showError('Error al cargar la cuenta por pagar');
            }
        });
    }

    function save() {
        const cuentaData = {
            id: $('#Cuenta_Id').val(),
            proveedorId: $('#Cuenta_ProveedorId').val(),
            numeroFactura: $('#Cuenta_NumeroFactura').val(),
            fechaFactura: $('#Cuenta_FechaFactura').val(),
            fechaVencimiento: $('#Cuenta_FechaVencimiento').val(),
            montoOriginal: parseFloat($('#Cuenta_MontoOriginal').val()),
            moneda: $('#Cuenta_Moneda').val(),
            tipoCambio: parseFloat($('#Cuenta_TipoCambio').val()),
            observaciones: $('#Cuenta_Observaciones').val() || null
        };

        $.ajax({
            url: '?handler=Save',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(cuentaData),
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success) {
                    showSuccess(response.message);
                    $('#modalCuenta').modal('hide');
                    table.ajax.reload();
                    loadSummaryCards();
                } else {
                    showError(response.message || 'Error al guardar la cuenta por pagar');
                }
            },
            error: function(xhr) {
                handleAjaxError(xhr);
            }
        });
    }

    function openPagarModal(id) {
        const cuenta = cuentasPorPagar.find(c => c.id === id);
        if (!cuenta) {
            showError('No se encontró la cuenta por pagar');
            return;
        }

        $('#Pago_CuentaId').val(id);
        $('#infoPagoNumFactura').text(cuenta.numeroFactura);
        $('#infoPagoProveedor').text(cuenta.proveedorNombre || '-');
        $('#infoPagoSaldo').text(formatCurrency(cuenta.montoSaldo));
        $('#Pago_Monto').val(cuenta.montoSaldo).attr('max', cuenta.montoSaldo);

        $('#formPagar')[0].reset();
        $('#Pago_CuentaId').val(id);
        $('#Pago_Monto').val(cuenta.montoSaldo);
        setDefaultDates();
        $('#formPagar').removeClass('was-validated');
        $('#modalPagar').modal('show');
    }

    function registrarPago() {
        const pagoData = {
            cuentaPorPagarId: $('#Pago_CuentaId').val(),
            monto: parseFloat($('#Pago_Monto').val()),
            fechaPago: $('#Pago_FechaPago').val(),
            metodoPago: $('#Pago_MetodoPago').val(),
            cuentaBancariaId: $('#Pago_CuentaBancariaId').val() || null,
            numeroReferencia: $('#Pago_NumeroReferencia').val() || null,
            notas: $('#Pago_Notas').val() || null
        };

        $.ajax({
            url: '?handler=RegistrarPago',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(pagoData),
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success) {
                    showSuccess(response.message);
                    $('#modalPagar').modal('hide');
                    table.ajax.reload();
                    loadSummaryCards();
                } else {
                    showError(response.message || 'Error al registrar el pago');
                }
            },
            error: function(xhr) {
                handleAjaxError(xhr);
            }
        });
    }

    function verEstadoCuenta(proveedorId) {
        window.location.href = '/CxP/EstadoCuentaProveedor?proveedorId=' + proveedorId;
    }

    function deleteRecord(id) {
        confirmDelete('Esta acción no se puede revertir', function() {
            $.ajax({
                url: '?handler=Delete&id=' + id,
                type: 'POST',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        showSuccess(response.message);
                        table.ajax.reload();
                        loadSummaryCards();
                    } else {
                        showError(response.message || 'Error al eliminar la cuenta por pagar');
                    }
                },
                error: function(xhr) {
                    handleAjaxError(xhr);
                }
            });
        });
    }
</script>
}
