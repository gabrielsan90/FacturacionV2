@page
@model Facturacion.Frontend.Pages.CxP.EstadoCuentaProveedorModel
@{
    ViewData["Title"] = "Estado de Cuenta - Proveedor";
    ViewData["Breadcrumb"] = "Estado de Cuenta - Proveedor";
}

<!-- Page Header -->
<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h2><i class="fas fa-file-invoice-dollar"></i> Estado de Cuenta - Proveedor</h2>
            <p class="mb-0">Detalle completo de transacciones y pagos</p>
        </div>
        <div>
            <button class="btn btn-secondary" onclick="window.history.back()">
                <i class="fas fa-arrow-left me-2"></i>Volver
            </button>
            <button class="btn btn-primary" onclick="exportarPDF()">
                <i class="fas fa-file-pdf me-2"></i>Exportar PDF
            </button>
        </div>
    </div>
</div>

<!-- Proveedor Info Card -->
<div class="card shadow-custom mb-4" id="proveedorInfoCard" style="display: none;">
    <div class="card-body">
        <div class="row">
            <div class="col-md-8">
                <h4 class="mb-3" id="proveedorNombre"></h4>
                <div class="row">
                    <div class="col-md-6">
                        <p class="mb-1"><strong>Identificación:</strong> <span id="proveedorIdentificacion"></span></p>
                        <p class="mb-1"><strong>Email:</strong> <span id="proveedorEmail"></span></p>
                    </div>
                    <div class="col-md-6">
                        <p class="mb-1"><strong>Teléfono:</strong> <span id="proveedorTelefono"></span></p>
                        <p class="mb-1"><strong>Estado:</strong> <span id="proveedorEstado"></span></p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="text-end">
                    <h6 class="text-muted mb-1">Saldo Total</h6>
                    <h2 class="mb-0" id="saldoTotal">₡0.00</h2>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Summary Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card shadow-custom border-0">
            <div class="card-body">
                <h6 class="text-muted mb-1">Total Facturado</h6>
                <h4 class="mb-0" id="cardTotalFacturado">₡0.00</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-custom border-0">
            <div class="card-body">
                <h6 class="text-muted mb-1">Total Pagado</h6>
                <h4 class="mb-0 text-success" id="cardTotalPagado">₡0.00</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-custom border-0">
            <div class="card-body">
                <h6 class="text-muted mb-1">Saldo Pendiente</h6>
                <h4 class="mb-0 text-warning" id="cardSaldoPendiente">₡0.00</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-custom border-0">
            <div class="card-body">
                <h6 class="text-muted mb-1">Saldo Vencido</h6>
                <h4 class="mb-0 text-danger" id="cardSaldoVencido">₡0.00</h4>
            </div>
        </div>
    </div>
</div>

<!-- Filters and Transactions -->
<div class="card shadow-custom">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <strong>Transacciones</strong>
                <span class="badge bg-secondary ms-2" id="badgeTotalTransacciones">0</span>
            </div>
        </div>
    </div>
    <div class="card-body">
        <!-- Filters -->
        <div class="row mb-3">
            <div class="col-md-3">
                <label class="form-label">Proveedor</label>
                <select class="form-select" id="filterProveedor">
                    <option value="">Seleccione...</option>
                    @foreach (var proveedor in Model.Proveedores)
                    {
                        <option value="@proveedor.Value">@proveedor.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Desde</label>
                <input type="date" class="form-control" id="filterFechaDesde" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Hasta</label>
                <input type="date" class="form-control" id="filterFechaHasta" />
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-primary w-100" onclick="loadEstadoCuenta()">
                    <i class="fas fa-search me-2"></i>Buscar
                </button>
            </div>
        </div>

        <!-- Loading State -->
        <div id="tableTransaccionesLoader" class="text-center py-5">
            <div class="spinner-modern mx-auto"></div>
            <p class="text-muted mt-3">Cargando transacciones...</p>
        </div>

        <!-- Table Container -->
        <div id="tableTransaccionesContainer" style="display: none;">
            <table id="tableTransacciones" class="table table-hover">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Tipo</th>
                        <th>Documento</th>
                        <th>Descripción</th>
                        <th>Cargo</th>
                        <th>Abono</th>
                        <th>Saldo</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <!-- Empty State -->
        <div id="emptyStateTransacciones" class="empty-state" style="display: none;">
            <div class="empty-state-icon">
                <i class="fas fa-file-invoice"></i>
            </div>
            <h3 class="empty-state-title">No hay transacciones</h3>
            <p class="empty-state-description">Seleccione un proveedor para ver su estado de cuenta</p>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let table;
    let transacciones = [];
    let proveedorSeleccionado = null;

    $(document).ready(function() {
        initializePage();
        setupEventHandlers();
    });

    function initializePage() {
        // Get proveedorId from query string
        const urlParams = new URLSearchParams(window.location.search);
        const proveedorId = urlParams.get('proveedorId');

        if (proveedorId) {
            $('#filterProveedor').val(proveedorId);
            loadEstadoCuenta();
        }

        // Set default date range (last 3 months)
        const today = new Date();
        const threeMonthsAgo = new Date();
        threeMonthsAgo.setMonth(today.getMonth() - 3);

        $('#filterFechaDesde').val(threeMonthsAgo.toISOString().split('T')[0]);
        $('#filterFechaHasta').val(today.toISOString().split('T')[0]);
    }

    function setupEventHandlers() {
        $('#filterProveedor').on('change', function() {
            if ($(this).val()) {
                loadProveedorInfo();
            } else {
                $('#proveedorInfoCard').hide();
            }
        });
    }

    function loadProveedorInfo() {
        const proveedorId = $('#filterProveedor').val();
        if (!proveedorId) return;

        $.ajax({
            url: '?handler=ProveedorInfo&proveedorId=' + proveedorId,
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(data) {
                proveedorSeleccionado = data;
                $('#proveedorNombre').text(data.nombre);
                $('#proveedorIdentificacion').text(data.numeroIdentificacion);
                $('#proveedorEmail').text(data.emailPrincipal || '-');
                $('#proveedorTelefono').text(data.telefonoPrincipal || '-');

                const estadoBadge = data.activo
                    ? '<span class="badge bg-success">Activo</span>'
                    : '<span class="badge bg-secondary">Inactivo</span>';
                $('#proveedorEstado').html(estadoBadge);

                $('#proveedorInfoCard').show();
            },
            error: function(xhr) {
                showError('Error al cargar información del proveedor');
            }
        });
    }

    function loadEstadoCuenta() {
        const proveedorId = $('#filterProveedor').val();
        if (!proveedorId) {
            showWarning('Seleccione un proveedor');
            return;
        }

        const fechaDesde = $('#filterFechaDesde').val();
        const fechaHasta = $('#filterFechaHasta').val();

        $('#tableTransaccionesLoader').show();
        $('#tableTransaccionesContainer').hide();
        $('#emptyStateTransacciones').hide();

        $.ajax({
            url: '?handler=EstadoCuenta&proveedorId=' + proveedorId +
                 '&fechaDesde=' + fechaDesde + '&fechaHasta=' + fechaHasta,
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                transacciones = response.transacciones || [];
                $('#tableTransaccionesLoader').hide();

                if (transacciones.length > 0) {
                    renderTransacciones();
                    updateSummaryCards(response.resumen);
                    $('#tableTransaccionesContainer').show();
                } else {
                    $('#emptyStateTransacciones').show();
                }
            },
            error: function(xhr) {
                $('#tableTransaccionesLoader').hide();
                $('#emptyStateTransacciones').show();
                handleAjaxError(xhr);
            }
        });
    }

    function renderTransacciones() {
        if ($.fn.DataTable.isDataTable('#tableTransacciones')) {
            $('#tableTransacciones').DataTable().destroy();
        }

        table = initDataTable('#tableTransacciones', {
            data: transacciones,
            columns: [
                {
                    data: 'fecha',
                    render: function(data) {
                        return formatDate(data);
                    }
                },
                {
                    data: 'tipo',
                    render: function(data) {
                        const badges = {
                            'FACTURA': '<span class="badge bg-primary">Factura</span>',
                            'PAGO': '<span class="badge bg-success">Pago</span>',
                            'NOTA_CREDITO': '<span class="badge bg-info">Nota Crédito</span>',
                            'NOTA_DEBITO': '<span class="badge bg-warning">Nota Débito</span>'
                        };
                        return badges[data] || data;
                    }
                },
                { data: 'numeroDocumento' },
                {
                    data: 'descripcion',
                    render: function(data) {
                        return data || '<span class="text-muted">-</span>';
                    }
                },
                {
                    data: 'cargo',
                    render: function(data) {
                        return data > 0 ? formatCurrency(data) : '<span class="text-muted">-</span>';
                    }
                },
                {
                    data: 'abono',
                    render: function(data) {
                        return data > 0 ? `<span class="text-success">${formatCurrency(data)}</span>` : '<span class="text-muted">-</span>';
                    }
                },
                {
                    data: 'saldo',
                    render: function(data) {
                        const formatted = formatCurrency(data);
                        if (data > 0) {
                            return `<span class="fw-bold">${formatted}</span>`;
                        }
                        return `<span class="text-success">${formatted}</span>`;
                    }
                },
                {
                    data: 'estado',
                    render: function(data, type, row) {
                        if (row.tipo === 'PAGO') {
                            return '<span class="badge bg-success">Pagado</span>';
                        }

                        const badges = {
                            'PEN': '<span class="badge bg-warning">Pendiente</span>',
                            'PAR': '<span class="badge bg-info">Parcial</span>',
                            'PAG': '<span class="badge bg-success">Pagada</span>',
                            'VEN': '<span class="badge bg-danger">Vencida</span>'
                        };
                        return badges[data] || data;
                    }
                }
            ],
            order: [[0, 'asc']],
            pageLength: 50
        });

        $('#badgeTotalTransacciones').text(transacciones.length);
    }

    function updateSummaryCards(resumen) {
        $('#saldoTotal').text(formatCurrency(resumen.saldoTotal || 0));
        $('#cardTotalFacturado').text(formatCurrency(resumen.totalFacturado || 0));
        $('#cardTotalPagado').text(formatCurrency(resumen.totalPagado || 0));
        $('#cardSaldoPendiente').text(formatCurrency(resumen.saldoPendiente || 0));
        $('#cardSaldoVencido').text(formatCurrency(resumen.saldoVencido || 0));
    }

    function exportarPDF() {
        const proveedorId = $('#filterProveedor').val();
        if (!proveedorId) {
            showWarning('Seleccione un proveedor');
            return;
        }

        const fechaDesde = $('#filterFechaDesde').val();
        const fechaHasta = $('#filterFechaHasta').val();

        showLoading('Generando PDF...');

        // In a real implementation, this would call an API endpoint to generate the PDF
        setTimeout(() => {
            hideLoading();
            showInfo('Funcionalidad de exportación a PDF en desarrollo');
        }, 1500);
    }
</script>
}
