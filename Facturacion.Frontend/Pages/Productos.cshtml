@page
@model Facturacion.Frontend.Pages.ProductosModel
@{
    ViewData["Title"] = "Productos";
    ViewData["Breadcrumb"] = "Productos";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
            <i class="fas fa-boxes me-2"></i>Productos y Servicios
        </h5>
        <button class="btn btn-primary btn-sm" onclick="openCreateModal()">
            <i class="fas fa-plus me-1"></i> Nuevo Producto/Servicio
        </button>
    </div>
    <div class="card-body">
        <table id="tableProductos" class="table table-hover">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Tipo</th>
                    <th>Nombre</th>
                    <th>Categoría</th>
                    <th>Precio Venta</th>
                    <th>Impuesto</th>
                    <th>Inventario</th>
                    <th>Estado</th>
                    <th style="width: 120px;">Acciones</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<!-- Modal Create/Edit -->
<div class="modal fade" id="modalProducto" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitle">Nuevo Producto/Servicio</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="formProducto" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="Producto_Id" value="0" />

                    <!-- Información General -->
                    <h6 class="text-primary mb-3"><i class="fas fa-info-circle me-2"></i>Información General</h6>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Tipo <span class="text-danger">*</span></label>
                            <select class="form-select" id="Producto_Tipo" required>
                                <option value="">Seleccione...</option>
                                <option value="0">Producto</option>
                                <option value="1">Servicio</option>
                            </select>
                            <div class="invalid-feedback">Seleccione un tipo.</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Código <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="Producto_Codigo" maxlength="50" required />
                            <div class="invalid-feedback">El código es obligatorio.</div>
                            <small class="text-muted">Código único del producto/servicio</small>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Nombre <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="Producto_Nombre" maxlength="200" required />
                            <div class="invalid-feedback">El nombre es obligatorio.</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Categoría</label>
                            <select class="form-select" id="Producto_CategoriaId">
                                <option value="">Sin categoría</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Descripción</label>
                            <textarea class="form-control" id="Producto_Descripcion" rows="2" maxlength="500"></textarea>
                        </div>
                    </div>

                    <!-- Código CAByS -->
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Código CAByS <span class="text-danger">*</span></label>
                            <input type="hidden" id="Producto_CabysId" />
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-search"></i></span>
                                <input type="text" class="form-control" id="buscarCabys"
                                       placeholder="Buscar por código o descripción (ej: 1234567890123, computadora)">
                                <button type="button" class="btn btn-outline-primary" onclick="buscarCabys()">
                                    <i class="fas fa-search"></i> Buscar
                                </button>
                                <button type="button" class="btn btn-outline-danger" onclick="limpiarCabys()" title="Limpiar selección">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                            <div id="cabysSeleccionado" class="mt-2" style="display: none;">
                                <span class="badge bg-success p-2">
                                    <i class="fas fa-check-circle me-1"></i>
                                    <span id="cabysCodigoTexto"></span> - <span id="cabysDescripcionTexto"></span>
                                </span>
                            </div>
                            <small class="text-muted">Código de bienes y servicios obligatorio para facturación electrónica v4.4</small>

                            <!-- Resultados de búsqueda CABYS -->
                            <div id="resultadosCabys" class="mt-2" style="display: none;">
                                <div class="table-responsive" style="max-height: 200px; overflow-y: auto;">
                                    <table class="table table-sm table-hover">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Código</th>
                                                <th>Descripción</th>
                                                <th>IVA</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody id="tbodyResultadosCabys"></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <!-- Precio e Impuestos -->
                    <h6 class="text-primary mb-3"><i class="fas fa-dollar-sign me-2"></i>Precio e Impuestos</h6>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Unidad de Medida <span class="text-danger">*</span></label>
                            <select class="form-select" id="Producto_UnidadMedidaId" required>
                                <option value="">Seleccione...</option>
                            </select>
                            <div class="invalid-feedback">Seleccione una unidad de medida.</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Impuesto <span class="text-danger">*</span></label>
                            <select class="form-select" id="Producto_ImpuestoId" required>
                                <option value="">Seleccione...</option>
                            </select>
                            <div class="invalid-feedback">Seleccione un impuesto.</div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Costo</label>
                            <div class="input-group">
                                <span class="input-group-text">₡</span>
                                <input type="number" class="form-control" id="Producto_Costo" step="0.01" min="0" />
                            </div>
                            <small class="text-muted">Costo del producto/servicio (opcional)</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Precio de Venta <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">₡</span>
                                <input type="number" class="form-control" id="Producto_PrecioVenta" step="0.01" min="0" required />
                                <div class="invalid-feedback">El precio de venta es obligatorio.</div>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <!-- Control de Inventario -->
                    <h6 class="text-primary mb-3"><i class="fas fa-warehouse me-2"></i>Control de Inventario</h6>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="Producto_ControlarInventario" checked />
                                <label class="form-check-label" for="Producto_ControlarInventario">
                                    Controlar Inventario
                                </label>
                            </div>
                            <small class="text-muted">Si está activo, el sistema controlará el stock disponible</small>
                        </div>
                    </div>

                    <div class="row" id="stockMinimoContainer">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Stock Mínimo</label>
                            <input type="number" class="form-control" id="Producto_StockMinimo" step="0.01" min="0" />
                            <small class="text-muted">Cantidad mínima para alertas</small>
                        </div>
                    </div>

                    <hr />

                    <!-- Estado -->
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="Producto_Activo" checked />
                                <label class="form-check-label" for="Producto_Activo">
                                    Producto/Servicio Activo
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-1"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let table;
    const empresaId = '@Model.EmpresaId';

    $(document).ready(function() {
        loadDataTable();
        setupFormSubmit();
        setupEventHandlers();
    });

    function loadDataTable() {
        table = initDataTable('#tableProductos', {
            ajax: {
                url: '?handler=Data',
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                dataSrc: 'data'
            },
            columns: [
                { data: 'codigo' },
                {
                    data: 'tipo',
                    render: function(data) {
                        return data === 0
                            ? '<span class="badge bg-primary">Producto</span>'
                            : '<span class="badge bg-info">Servicio</span>';
                    }
                },
                { data: 'nombre' },
                {
                    data: 'categoria',
                    render: function(data) {
                        return data ? data.nombre : '<span class="text-muted">-</span>';
                    }
                },
                {
                    data: 'precioVenta',
                    render: function(data) {
                        return formatCurrency(data);
                    }
                },
                {
                    data: 'impuesto',
                    render: function(data) {
                        return data ? data.descripcion : '-';
                    }
                },
                {
                    data: 'controlarInventario',
                    render: function(data) {
                        return data
                            ? '<i class="fas fa-check-circle text-success"></i>'
                            : '<i class="fas fa-times-circle text-muted"></i>';
                    }
                },
                {
                    data: 'activo',
                    render: function(data) {
                        return data
                            ? '<span class="badge bg-success">Activo</span>'
                            : '<span class="badge bg-secondary">Inactivo</span>';
                    }
                },
                {
                    data: 'id',
                    orderable: false,
                    render: function(data) {
                        return `
                            <button class="btn btn-sm btn-info" onclick="edit('${data}')" title="Editar">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-sm btn-danger" onclick="deleteRecord('${data}')" title="Eliminar">
                                <i class="fas fa-trash"></i>
                            </button>
                        `;
                    }
                }
            ],
            order: [[2, 'asc']]
        });
    }

    function setupFormSubmit() {
        $('#formProducto').on('submit', function(e) {
            e.preventDefault();
            if (this.checkValidity()) {
                save();
            } else {
                $(this).addClass('was-validated');
            }
        });
    }

    function setupEventHandlers() {
        $('#Producto_Tipo').on('change', onTipoChange);
        $('#Producto_ControlarInventario').on('change', toggleStockMinimo);
    }

    function loadCategorias() {
        return $.ajax({
            url: '?handler=Categorias',
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(data) {
                const select = $('#Producto_CategoriaId');
                select.empty().append('<option value="">Sin categoría</option>');
                data.forEach(cat => {
                    select.append(`<option value="${cat.id}">${cat.nombre}</option>`);
                });
            },
            error: function(xhr) {
                handleAjaxError(xhr);
            }
        });
    }

    function loadUnidadesMedida() {
        return $.ajax({
            url: '?handler=UnidadesMedida',
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(data) {
                const select = $('#Producto_UnidadMedidaId');
                select.empty().append('<option value="">Seleccione...</option>');
                data.forEach(item => {
                    select.append(`<option value="${item.id}">${item.codigo} - ${item.descripcion}</option>`);
                });
            },
            error: function(xhr) {
                handleAjaxError(xhr);
            }
        });
    }

    function loadImpuestos() {
        return $.ajax({
            url: '?handler=Impuestos',
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(data) {
                const select = $('#Producto_ImpuestoId');
                select.empty().append('<option value="">Seleccione...</option>');
                data.forEach(item => {
                    // Mostrar descripción con porcentaje: "Impuesto al Valor Agregado - 13%"
                    const porcentaje = item.tarifa !== undefined ? item.tarifa : 0;
                    const texto = `${item.descripcion} - ${porcentaje}%`;
                    select.append(`<option value="${item.id}">${texto}</option>`);
                });
            },
            error: function(xhr) {
                handleAjaxError(xhr);
            }
        });
    }

    function openCreateModal() {
        $('#formProducto')[0].reset();
        $('#formProducto').removeClass('was-validated');
        $('#Producto_Id').val('0');
        $('#Producto_Activo').prop('checked', true);
        $('#Producto_ControlarInventario').prop('checked', true);
        $('#modalTitle').text('Nuevo Producto/Servicio');

        // Limpiar CABYS seleccionado
        limpiarCabys();

        // Load all dropdowns
        $.when(loadCategorias(), loadUnidadesMedida(), loadImpuestos())
            .done(function() {
                onTipoChange();
                $('#modalProducto').modal('show');
            });
    }

    function edit(id) {
        // First load all dropdowns
        $.when(loadCategorias(), loadUnidadesMedida(), loadImpuestos())
            .done(function() {
                // Then load the product data
                $.ajax({
                    url: '?handler=Details&id=' + id,
                    type: 'GET',
                    headers: {
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(data) {
                        $('#Producto_Id').val(data.id);
                        $('#Producto_Tipo').val(data.tipo);
                        $('#Producto_Codigo').val(data.codigo);
                        $('#Producto_Nombre').val(data.nombre);
                        $('#Producto_Descripcion').val(data.descripcion || '');

                        // Cargar CABYS seleccionado
                        limpiarCabys();
                        if (data.cabysId && data.cabys) {
                            seleccionarCabys(data.cabysId, data.cabys.codigo, data.cabys.descripcion);
                        }

                        $('#Producto_UnidadMedidaId').val(data.unidadMedidaId || '');
                        $('#Producto_PrecioVenta').val(data.precioVenta);
                        $('#Producto_Costo').val(data.costo || '');
                        $('#Producto_ImpuestoId').val(data.impuestoId || '');
                        $('#Producto_ControlarInventario').prop('checked', data.controlarInventario);
                        $('#Producto_StockMinimo').val(data.stockMinimo || '');
                        $('#Producto_CategoriaId').val(data.categoriaId || '');
                        $('#Producto_Activo').prop('checked', data.activo);

                        $('#modalTitle').text('Editar Producto/Servicio');
                        $('#formProducto').removeClass('was-validated');

                        onTipoChange();
                        $('#modalProducto').modal('show');
                    },
                    error: function(xhr) {
                        showError('Error al cargar el producto/servicio');
                    }
                });
            });
    }

    function save() {
        const tipo = parseInt($('#Producto_Tipo').val());
        let controlarInventario = $('#Producto_ControlarInventario').is(':checked');
        let stockMinimo = $('#Producto_StockMinimo').val();

        // Force business rules for Servicio
        if (tipo === 1) {
            controlarInventario = false;
            stockMinimo = null;
        }

        const productoData = {
            id: $('#Producto_Id').val() === '0' ? '00000000-0000-0000-0000-000000000000' : $('#Producto_Id').val(),
            empresaId: empresaId,
            tipo: tipo,
            codigo: $('#Producto_Codigo').val(),
            nombre: $('#Producto_Nombre').val(),
            descripcion: $('#Producto_Descripcion').val() || null,
            cabysId: $('#Producto_CabysId').val() ? parseInt($('#Producto_CabysId').val()) : null,
            unidadMedidaId: $('#Producto_UnidadMedidaId').val() ? parseInt($('#Producto_UnidadMedidaId').val()) : 0,
            precioVenta: parseFloat($('#Producto_PrecioVenta').val()),
            costo: $('#Producto_Costo').val() ? parseFloat($('#Producto_Costo').val()) : null,
            impuestoId: $('#Producto_ImpuestoId').val() ? parseInt($('#Producto_ImpuestoId').val()) : 0,
            controlarInventario: controlarInventario,
            stockMinimo: stockMinimo ? parseFloat(stockMinimo) : null,
            categoriaId: $('#Producto_CategoriaId').val() || null,
            activo: $('#Producto_Activo').is(':checked')
        };

        $.ajax({
            url: '?handler=Save',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(productoData),
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success) {
                    showSuccess(response.message);
                    $('#modalProducto').modal('hide');
                    table.ajax.reload();
                } else {
                    showError(response.message);
                }
            },
            error: function(xhr) {
                handleAjaxError(xhr);
            }
        });
    }

    function deleteRecord(id) {
        confirmDelete('Esta acción no se puede revertir', function() {
            $.ajax({
                url: '?handler=Delete&id=' + id,
                type: 'POST',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        showSuccess(response.message);
                        table.ajax.reload();
                    } else {
                        showError(response.message);
                    }
                },
                error: function(xhr) {
                    handleAjaxError(xhr);
                }
            });
        });
    }

    function onTipoChange() {
        const tipo = parseInt($('#Producto_Tipo').val());

        if (tipo === 1) { // Servicio
            $('#Producto_ControlarInventario').prop('checked', false);
            $('#Producto_ControlarInventario').prop('disabled', true);
            $('#Producto_StockMinimo').prop('disabled', true);
            $('#Producto_StockMinimo').val('');
            $('#stockMinimoContainer').hide();
        } else { // Producto
            $('#Producto_ControlarInventario').prop('disabled', false);
            toggleStockMinimo();
            $('#stockMinimoContainer').show();
        }
    }

    function toggleStockMinimo() {
        const controlarInventario = $('#Producto_ControlarInventario').is(':checked');

        if (controlarInventario) {
            $('#Producto_StockMinimo').prop('disabled', false);
        } else {
            $('#Producto_StockMinimo').prop('disabled', true);
            $('#Producto_StockMinimo').val('');
        }
    }

    // ========================================
    // Funciones para búsqueda y selección de CABYS
    // ========================================

    function buscarCabys() {
        const query = $('#buscarCabys').val().trim();
        if (!query || query.length < 2) {
            showWarning('Ingrese al menos 2 caracteres para buscar');
            return;
        }

        $.ajax({
            url: '?handler=BuscarCabys&q=' + encodeURIComponent(query),
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success && response.data) {
                    const resultados = response.data;
                    const tbody = $('#tbodyResultadosCabys');
                    tbody.empty();

                    if (resultados.length === 0) {
                        tbody.append('<tr><td colspan="4" class="text-center text-muted">No se encontraron resultados</td></tr>');
                    } else {
                        resultados.forEach(cabys => {
                            const impuesto = cabys.impuesto !== null ? cabys.impuesto + '%' : '-';
                            const row = `
                                <tr>
                                    <td><code>${cabys.codigo}</code></td>
                                    <td>${cabys.descripcion.substring(0, 80)}${cabys.descripcion.length > 80 ? '...' : ''}</td>
                                    <td>${impuesto}</td>
                                    <td>
                                        <button type="button" class="btn btn-xs btn-success"
                                                onclick="seleccionarCabys(${cabys.id}, '${cabys.codigo}', '${cabys.descripcion.replace(/'/g, "\\'")}')">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    </td>
                                </tr>
                            `;
                            tbody.append(row);
                        });
                    }
                    $('#resultadosCabys').show();
                } else {
                    showError(response.message || 'Error al buscar códigos CABYS');
                }
            },
            error: function(xhr) {
                handleAjaxError(xhr);
            }
        });
    }

    function seleccionarCabys(id, codigo, descripcion) {
        $('#Producto_CabysId').val(id);
        $('#cabysCodigoTexto').text(codigo);
        $('#cabysDescripcionTexto').text(descripcion.substring(0, 60) + (descripcion.length > 60 ? '...' : ''));
        $('#cabysSeleccionado').show();
        $('#resultadosCabys').hide();
        $('#buscarCabys').val('');
    }

    function limpiarCabys() {
        $('#Producto_CabysId').val('');
        $('#cabysSeleccionado').hide();
        $('#resultadosCabys').hide();
        $('#buscarCabys').val('');
    }

    // Búsqueda con Enter
    $('#buscarCabys').on('keypress', function(e) {
        if (e.which === 13) {
            e.preventDefault();
            buscarCabys();
        }
    });
</script>
}
