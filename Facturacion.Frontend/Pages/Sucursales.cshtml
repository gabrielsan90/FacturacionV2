@page
@model Facturacion.Frontend.Pages.SucursalesModel
@{
    ViewData["Title"] = "Sucursales";
    ViewData["Breadcrumb"] = "Sucursales";
}

@Html.AntiForgeryToken()

<!-- Page Header -->
<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h2><i class="fas fa-building"></i> Sucursales</h2>
            <p class="mb-0">Gestión de sucursales y puntos de venta de la empresa</p>
        </div>
        <button class="btn btn-primary" onclick="openCreateModal()">
            <i class="fas fa-plus me-2"></i>Nueva Sucursal
        </button>
    </div>
</div>

<div class="card shadow-custom">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <strong>Listado de Sucursales</strong>
                <span class="badge bg-secondary ms-2" id="badgeTotalSucursales">0</span>
            </div>
        </div>
    </div>
    <div class="card-body">
        <!-- Loading State -->
        <div id="tableSucursalesLoader" class="text-center py-5">
            <div class="spinner-modern mx-auto"></div>
            <p class="text-muted mt-3">Cargando sucursales...</p>
        </div>

        <!-- Table Container -->
        <div id="tableSucursalesContainer" style="display: none;">
            <table id="tableSucursales" class="table table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        @if (User.IsInRole("SuperUser"))
                        {
                            <th>Empresa</th>
                        }
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Teléfono</th>
                        <th>Email</th>
                        <th>Principal</th>
                        <th>Estado</th>
                        <th style="width: 120px;">Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <!-- Empty State -->
        <div id="emptyStateSucursales" class="empty-state" style="display: none;">
            <div class="empty-state-icon">
                <i class="fas fa-building"></i>
            </div>
            <h3 class="empty-state-title">No hay sucursales registradas</h3>
            <p class="empty-state-description">Crea al menos una sucursal para comenzar a facturar</p>
            <button class="btn btn-primary" onclick="openCreateModal()">
                <i class="fas fa-plus me-2"></i>Crear Primera Sucursal
            </button>
        </div>
    </div>
</div>

<!-- Modal Create/Edit -->
<div class="modal fade" id="modalSucursal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">
                    <i class="fas fa-building me-2 text-primary"></i>Nueva Sucursal
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="formSucursal">
                <div class="modal-body">
                    <input type="hidden" id="Sucursal_Id" value="0" />

                    <h6 class="mb-3 text-primary"><i class="fas fa-info-circle"></i> Información General</h6>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Código <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="Sucursal_Codigo" maxlength="10" required />
                                <small class="text-muted">Código único de 3 dígitos (ej: 001, 002)</small>
                                <div class="invalid-feedback">El código es obligatorio.</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Nombre <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="Sucursal_Nombre" maxlength="200" required />
                                <div class="invalid-feedback">El nombre es obligatorio.</div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Teléfono</label>
                                <input type="tel" class="form-control" id="Sucursal_Telefono" maxlength="20" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Email</label>
                                <input type="email" class="form-control" id="Sucursal_Email" maxlength="100" />
                            </div>
                        </div>
                    </div>

                    @if (User.IsInRole("SuperUser"))
                    {
                        <div class="row">
                            <div class="col-md-12">
                                <div class="mb-3">
                                    <label class="form-label">Empresa <span class="text-danger">*</span></label>
                                    <select class="form-select" id="Sucursal_EmpresaId" required>
                                        <option value="">Seleccione...</option>
                                    </select>
                                    <div class="invalid-feedback">Seleccione una empresa.</div>
                                </div>
                            </div>
                        </div>
                    }

                    <hr class="my-4" />

                    <h6 class="mb-3 text-primary"><i class="fas fa-cog"></i> Configuración</h6>

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="Sucursal_EsPrincipal" />
                        <label class="form-check-label" for="Sucursal_EsPrincipal">
                            <strong>Sucursal Principal</strong>
                        </label>
                    </div>
                    <div id="warningEsPrincipal" class="alert alert-warning mb-3 d-none" role="alert">
                        <i class="fas fa-exclamation-triangle"></i> Al marcar como principal, la anterior sucursal principal será automáticamente desmarcada.
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="Sucursal_Activo" checked />
                        <label class="form-check-label" for="Sucursal_Activo">
                            Sucursal Activa
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-1"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let table;
    let empresas = [];
    const isSuperUser = @Json.Serialize(User.IsInRole("SuperUser"));
    const userEmpresaId = '@User.FindFirst("EmpresaId")?.Value';

    $(document).ready(function() {
        if (isSuperUser) {
            loadEmpresas();
        }
        loadDataTable();
        setupFormSubmit();
        setupCheckboxWarning();
    });

    function loadDataTable() {
        const columns = [
            { data: 'id', visible: false }
        ];

        // Add empresa column for SuperUser
        if (isSuperUser) {
            columns.push({
                data: 'empresa.nombreComercial',
                render: function(data) {
                    return data || '<span class="text-muted">-</span>';
                }
            });
        }

        // Add remaining columns
        columns.push(
            { data: 'codigo' },
            { data: 'nombre' },
            {
                data: 'telefono',
                render: function(data) {
                    return data || '<span class="text-muted">-</span>';
                }
            },
            {
                data: 'email',
                render: function(data) {
                    return data || '<span class="text-muted">-</span>';
                }
            },
            {
                data: 'esPrincipal',
                render: function(data) {
                    return data
                        ? '<span class="badge bg-primary"><i class="fas fa-star"></i> Principal</span>'
                        : '<span class="text-muted">-</span>';
                }
            },
            {
                data: 'activo',
                render: function(data) {
                    return data
                        ? '<span class="badge bg-success">Activa</span>'
                        : '<span class="badge bg-secondary">Inactiva</span>';
                }
            },
            {
                data: 'id',
                orderable: false,
                render: function(data, type, row) {
                    return `
                        <button class="btn btn-sm btn-info" onclick="edit('${data}')" title="Editar">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button class="btn btn-sm btn-danger" onclick="deleteRecord('${data}', '${row.nombre}')" title="Eliminar">
                            <i class="fas fa-trash"></i>
                        </button>
                    `;
                }
            }
        );

        const orderColumn = isSuperUser ? 2 : 1; // Codigo column

        table = initDataTable('#tableSucursales', {
            ajax: {
                url: '?handler=Data',
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                dataSrc: function(json) {
                    // Hide loader
                    $('#tableSucursalesLoader').hide();

                    // Get data array
                    const data = json.data || json || [];

                    // Update badge count
                    $('#badgeTotalSucursales').text(data.length);

                    // Show appropriate state
                    if (data.length > 0) {
                        $('#tableSucursalesContainer').show();
                        $('#emptyStateSucursales').hide();
                    } else {
                        $('#tableSucursalesContainer').hide();
                        $('#emptyStateSucursales').show();
                    }

                    return data;
                },
                error: function(xhr, error, code) {
                    $('#tableSucursalesLoader').hide();
                    $('#tableSucursalesContainer').hide();
                    $('#emptyStateSucursales').show();
                    $('#badgeTotalSucursales').text('0');
                    console.error('Error loading sucursales:', error);
                }
            },
            columns: columns,
            order: [[orderColumn, 'asc']]
        });
    }

    function setupFormSubmit() {
        $('#formSucursal').on('submit', function(e) {
            e.preventDefault();
            if (this.checkValidity()) {
                save();
            } else {
                $(this).addClass('was-validated');
            }
        });
    }


    function setupCheckboxWarning() {
        $('#Sucursal_EsPrincipal').on('change', function() {
            if ($(this).is(':checked')) {
                $('#warningEsPrincipal').removeClass('d-none');
            } else {
                $('#warningEsPrincipal').addClass('d-none');
            }
        });
    }

    function loadEmpresas() {
        $.ajax({
            url: '?handler=Empresas',
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(data) {
                empresas = data;
                const select = $('#Sucursal_EmpresaId');
                select.empty().append('<option value="">Seleccione...</option>');
                data.forEach(item => {
                    select.append(`<option value="${item.id}">${item.nombreComercial}</option>`);
                });
            },
            error: function(xhr) {
                handleAjaxError(xhr);
            }
        });
    }

    function openCreateModal() {
        $('#formSucursal')[0].reset();
        $('#formSucursal').removeClass('was-validated');
        $('#Sucursal_Id').val('0');
        $('#Sucursal_Activo').prop('checked', true);
        $('#Sucursal_EsPrincipal').prop('checked', false);
        $('#warningEsPrincipal').addClass('d-none');
        $('#modalTitle').text('Nueva Sucursal');

        // Set empresa for non-SuperUser
        if (!isSuperUser && userEmpresaId) {
            // EmpresaId will be set on save from backend
        }

        $('#modalSucursal').modal('show');
    }

    function edit(id) {
        $.ajax({
            url: '?handler=Details&id=' + id,
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success) {
                    const data = response.data;
                    $('#Sucursal_Id').val(data.id);
                    $('#Sucursal_Codigo').val(data.codigo);
                    $('#Sucursal_Nombre').val(data.nombre);
                    $('#Sucursal_Telefono').val(data.telefono || '');
                    $('#Sucursal_Email').val(data.email || '');
                    $('#Sucursal_EsPrincipal').prop('checked', data.esPrincipal);
                    $('#Sucursal_Activo').prop('checked', data.activo);

                    // Set empresa for SuperUser
                    if (isSuperUser && data.empresaId) {
                        $('#Sucursal_EmpresaId').val(data.empresaId);
                    }

                    // Show/hide warning
                    if (data.esPrincipal) {
                        $('#warningEsPrincipal').addClass('d-none');
                    }

                    $('#modalTitle').text('Editar Sucursal');
                    $('#formSucursal').removeClass('was-validated');
                    $('#modalSucursal').modal('show');
                } else {
                    showError(response.message || 'Error al cargar la sucursal');
                }
            },
            error: function(xhr) {
                handleAjaxError(xhr);
            }
        });
    }

    function save() {
        const id = $('#Sucursal_Id').val();

        // Validate empresa selection for SuperUser
        if (isSuperUser) {
            const empresaId = $('#Sucursal_EmpresaId').val();
            if (!empresaId || empresaId === '') {
                showError('Debe seleccionar una empresa');
                $('#Sucursal_EmpresaId').addClass('is-invalid');
                return;
            }
            $('#Sucursal_EmpresaId').removeClass('is-invalid');
        }

        const data = {
            codigo: $('#Sucursal_Codigo').val(),
            nombre: $('#Sucursal_Nombre').val(),
            telefono: $('#Sucursal_Telefono').val() || null,
            email: $('#Sucursal_Email').val() || null,
            esPrincipal: $('#Sucursal_EsPrincipal').is(':checked'),
            activo: $('#Sucursal_Activo').is(':checked')
        };

        // Set ID properly - empty Guid for new, actual Guid for edit
        const isNew = id === '0' || !id;
        if (isNew) {
            data.id = '00000000-0000-0000-0000-000000000000';
        } else {
            data.id = id;
        }

        // Add EmpresaId for SuperUser
        if (isSuperUser) {
            data.empresaId = $('#Sucursal_EmpresaId').val();
        }

        $.ajax({
            url: '?handler=Save',
            type: 'POST',
            data: JSON.stringify(data),
            contentType: 'application/json',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success) {
                    showSuccess(response.message);
                    $('#modalSucursal').modal('hide');
                    table.ajax.reload();
                } else {
                    showError(response.message || 'Error al guardar la sucursal');
                }
            },
            error: function(xhr) {
                handleAjaxError(xhr);
            }
        });
    }

    function deleteRecord(id, nombre) {
        confirmDelete(`¿Está seguro de eliminar la sucursal "${nombre}"?`, function() {
            $.ajax({
                url: '?handler=Delete&id=' + id,
                type: 'POST',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        showSuccess(response.message);
                        table.ajax.reload();
                    } else {
                        showError(response.message || 'Error al eliminar la sucursal');
                    }
                },
                error: function(xhr) {
                    handleAjaxError(xhr);
                }
            });
        });
    }
</script>
}
