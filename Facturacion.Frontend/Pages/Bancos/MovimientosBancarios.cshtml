@page
@model Facturacion.Frontend.Pages.Bancos.MovimientosBancariosModel
@{
    ViewData["Title"] = "Movimientos Bancarios";
    ViewData["Breadcrumb"] = "Movimientos Bancarios";
}

<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <h2><i class="fas fa-exchange-alt"></i> Movimientos Bancarios</h2>
            <p class="mb-0">Registro de depósitos, retiros, transferencias y otros movimientos</p>
        </div>
        <button class="btn btn-primary" onclick="openCreateModal()">
            <i class="fas fa-plus me-2"></i>Nuevo Movimiento
        </button>
    </div>
</div>

<!-- Filtros -->
<div class="card shadow-custom mb-4">
    <div class="card-header">
        <i class="fas fa-filter me-2 text-primary"></i>
        <strong>Filtros</strong>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Cuenta Bancaria</label>
                <select id="filterCuenta" class="form-select select2" onchange="filterData()">
                    <option value="">Todas las cuentas</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Tipo de Movimiento</label>
                <select id="filterTipo" class="form-select" onchange="filterData()">
                    <option value="">Todos</option>
                    <option value="DEP">Depósito</option>
                    <option value="RET">Retiro</option>
                    <option value="TRA">Transferencia</option>
                    <option value="CHE">Cheque</option>
                    <option value="COM">Comisión</option>
                    <option value="INT">Interés</option>
                    <option value="OTR">Otro</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Estado</label>
                <select id="filterEstado" class="form-select" onchange="filterData()">
                    <option value="">Todos</option>
                    <option value="REG">Registrado</option>
                    <option value="CON">Conciliado</option>
                    <option value="ANU">Anulado</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button class="btn btn-secondary w-100" onclick="clearFilters()">
                    <i class="fas fa-eraser me-2"></i>Limpiar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Saldo de la Cuenta Seleccionada -->
<div id="saldoCuenta" class="alert alert-info mb-4" style="display: none;">
    <div class="row">
        <div class="col-md-6">
            <strong><i class="fas fa-university me-2"></i>Cuenta:</strong> <span id="cuentaNombre"></span>
        </div>
        <div class="col-md-6 text-end">
            <strong><i class="fas fa-money-bill-wave me-2"></i>Saldo Actual:</strong> <span id="saldoActual" class="fs-5"></span>
        </div>
    </div>
</div>

<!-- Tabla de Movimientos -->
<div class="card shadow-custom">
    <div class="card-header">
        <i class="fas fa-table me-2 text-primary"></i>
        <strong>Movimientos Bancarios</strong>
    </div>
    <div class="card-body">
        <table id="tblMovimientos" class="table table-striped table-hover" style="width:100%">
            <thead>
                <tr>
                    <th>Número</th>
                    <th>Fecha</th>
                    <th>Cuenta</th>
                    <th>Tipo</th>
                    <th>Naturaleza</th>
                    <th>Monto</th>
                    <th>Beneficiario</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<!-- Modal Crear/Editar -->
<div class="modal fade" id="modalMovimiento" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Nuevo Movimiento Bancario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formMovimiento">
                    <input type="hidden" id="movimientoId" value="">

                    <!-- Identificación -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Número <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="numero" required maxlength="20">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Fecha <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="fecha" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Cuenta Bancaria <span class="text-danger">*</span></label>
                            <select class="form-select select2" id="cuentaBancariaId" required>
                                <option value="">Seleccione...</option>
                            </select>
                        </div>
                    </div>

                    <!-- Tipo y Naturaleza -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Tipo de Movimiento <span class="text-danger">*</span></label>
                            <select class="form-select" id="tipoMovimiento" required onchange="updateNaturaleza()">
                                <option value="DEP">Depósito</option>
                                <option value="RET">Retiro</option>
                                <option value="TRA">Transferencia</option>
                                <option value="CHE">Cheque</option>
                                <option value="COM">Comisión</option>
                                <option value="INT">Interés</option>
                                <option value="OTR">Otro</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Naturaleza <span class="text-danger">*</span></label>
                            <select class="form-select" id="naturaleza" required>
                                <option value="CRE">Crédito (Entrada)</option>
                                <option value="DEB">Débito (Salida)</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Monto <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="monto" step="0.01" required>
                        </div>
                    </div>

                    <!-- Información del Movimiento -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Beneficiario</label>
                            <input type="text" class="form-control" id="beneficiario" maxlength="100">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Número de Referencia</label>
                            <input type="text" class="form-control" id="numeroReferencia" maxlength="50">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Número de Documento</label>
                            <input type="text" class="form-control" id="numeroDocumento" maxlength="50">
                        </div>
                    </div>

                    <!-- Descripción y Documento Origen -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label class="form-label">Descripción</label>
                            <textarea class="form-control" id="descripcion" rows="2" maxlength="500"></textarea>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Tipo Documento Origen</label>
                            <input type="text" class="form-control" id="tipoDocumentoOrigen" maxlength="50" placeholder="FAC, NC, ND, PAG...">
                        </div>
                    </div>

                    <!-- Estado y Observaciones -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Estado</label>
                            <select class="form-select" id="estado" disabled>
                                <option value="REG">Registrado</option>
                                <option value="CON">Conciliado</option>
                                <option value="ANU">Anulado</option>
                            </select>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Observaciones</label>
                            <textarea class="form-control" id="observaciones" rows="2" maxlength="500"></textarea>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Cancelar
                </button>
                <button type="button" class="btn btn-primary" onclick="saveMovimiento()">
                    <i class="fas fa-save me-2"></i>Guardar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;
        let movimientosData = [];
        let cuentasData = [];
        let currentCuentaId = null;

        $(document).ready(function() {
            initDataTable();
            loadCuentasBancarias();
            setDefaultDate();
        });

        function initDataTable() {
            table = $('#tblMovimientos').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'
                },
                ajax: {
                    url: '?handler=Data',
                    dataSrc: function(json) {
                        movimientosData = json;
                        return json;
                    }
                },
                columns: [
                    { data: 'numero' },
                    {
                        data: 'fecha',
                        render: function(data) {
                            return new Date(data).toLocaleDateString('es-CR', {day: '2-digit', month: '2-digit', year: 'numeric'});
                        }
                    },
                    {
                        data: null,
                        render: function(data) {
                            return data.cuentaBancaria?.nombre || '-';
                        }
                    },
                    {
                        data: 'tipoMovimiento',
                        render: function(data) {
                            const tipos = {
                                'DEP': '<span class="badge bg-success">Depósito</span>',
                                'RET': '<span class="badge bg-warning">Retiro</span>',
                                'TRA': '<span class="badge bg-info">Transferencia</span>',
                                'CHE': '<span class="badge bg-secondary">Cheque</span>',
                                'COM': '<span class="badge bg-danger">Comisión</span>',
                                'INT': '<span class="badge bg-primary">Interés</span>',
                                'OTR': '<span class="badge bg-dark">Otro</span>'
                            };
                            return tipos[data] || data;
                        }
                    },
                    {
                        data: 'naturaleza',
                        render: function(data) {
                            return data === 'CRE'
                                ? '<span class="badge bg-success">Crédito</span>'
                                : '<span class="badge bg-danger">Débito</span>';
                        }
                    },
                    {
                        data: 'monto',
                        render: function(data, type, row) {
                            const valor = parseFloat(data).toLocaleString('es-CR', { minimumFractionDigits: 2 });
                            const clase = row.naturaleza === 'CRE' ? 'text-success' : 'text-danger';
                            const signo = row.naturaleza === 'CRE' ? '+' : '-';
                            return `<span class="${clase} fw-bold">${signo}₡${valor}</span>`;
                        }
                    },
                    {
                        data: 'beneficiario',
                        render: function(data) {
                            return data || '-';
                        }
                    },
                    {
                        data: 'estado',
                        render: function(data) {
                            const estados = {
                                'REG': '<span class="badge bg-warning">Registrado</span>',
                                'CON': '<span class="badge bg-success">Conciliado</span>',
                                'ANU': '<span class="badge bg-danger">Anulado</span>'
                            };
                            return estados[data] || data;
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        render: function(data) {
                            let buttons = '<div class="btn-group btn-group-sm">';

                            // Solo mostrar editar si no está conciliado o anulado
                            if (data.estado === 'REG') {
                                buttons += `<button class="btn btn-outline-primary" onclick="editMovimiento('${data.id}')" title="Editar">
                                    <i class="fas fa-edit"></i>
                                </button>`;
                                buttons += `<button class="btn btn-outline-danger" onclick="deleteMovimiento('${data.id}')" title="Eliminar">
                                    <i class="fas fa-trash"></i>
                                </button>`;
                            }

                            // Botón para ver detalles
                            buttons += `<button class="btn btn-outline-info" onclick="viewMovimiento('${data.id}')" title="Ver Detalles">
                                <i class="fas fa-eye"></i>
                            </button>`;

                            buttons += '</div>';
                            return buttons;
                        }
                    }
                ],
                order: [[1, 'desc']],
                responsive: true,
                pageLength: 25
            });
        }

        function loadCuentasBancarias() {
            $.get('?handler=CuentasBancarias', function(data) {
                cuentasData = data;
                let options = '<option value="">Seleccione...</option>';
                let filterOptions = '<option value="">Todas las cuentas</option>';

                data.forEach(c => {
                    if (c.activo) {
                        const moneda = c.moneda === 'CRC' ? '₡' : (c.moneda === 'USD' ? '$' : '€');
                        options += `<option value="${c.id}">${c.nombre} - ${c.numeroCuenta} (${moneda})</option>`;
                        filterOptions += `<option value="${c.id}">${c.nombre} - ${c.numeroCuenta}</option>`;
                    }
                });

                $('#cuentaBancariaId').html(options);
                $('#filterCuenta').html(filterOptions);

                // Inicializar Select2
                $('.select2').select2({
                    dropdownParent: $('#modalMovimiento'),
                    width: '100%'
                });
            });
        }

        function filterData() {
            const cuentaId = $('#filterCuenta').val();
            const tipo = $('#filterTipo').val();
            const estado = $('#filterEstado').val();

            // Si hay cuenta seleccionada, filtrar por cuenta usando el handler específico
            if (cuentaId) {
                currentCuentaId = cuentaId;
                $.get(`?handler=PorCuenta&cuentaBancariaId=${cuentaId}`, function(data) {
                    movimientosData = data;
                    table.clear().rows.add(data).draw();

                    // Aplicar filtros adicionales
                    applyFilters(tipo, estado);

                    // Mostrar saldo de la cuenta
                    loadSaldoCuenta(cuentaId);
                });
            } else {
                currentCuentaId = null;
                $('#saldoCuenta').hide();
                table.ajax.reload();
                setTimeout(() => applyFilters(tipo, estado), 500);
            }
        }

        function applyFilters(tipo, estado) {
            if (tipo) {
                table.column(3).search(tipo);
            } else {
                table.column(3).search('');
            }

            if (estado) {
                table.column(7).search(estado);
            } else {
                table.column(7).search('');
            }

            table.draw();
        }

        function loadSaldoCuenta(cuentaId) {
            const cuenta = cuentasData.find(c => c.id === cuentaId);
            if (!cuenta) return;

            $('#cuentaNombre').text(`${cuenta.nombre} - ${cuenta.numeroCuenta}`);

            $.get(`?handler=SaldoCuenta&cuentaBancariaId=${cuentaId}`, function(data) {
                const moneda = cuenta.moneda === 'CRC' ? '₡' : (cuenta.moneda === 'USD' ? '$' : '€');
                const valor = parseFloat(data.saldo || 0).toLocaleString('es-CR', { minimumFractionDigits: 2 });
                const clase = data.saldo >= 0 ? 'text-success' : 'text-danger';
                $('#saldoActual').html(`<span class="${clase}">${moneda}${valor}</span>`);
                $('#saldoCuenta').show();
            });
        }

        function clearFilters() {
            $('#filterCuenta').val('').trigger('change');
            $('#filterTipo').val('');
            $('#filterEstado').val('');
            $('#saldoCuenta').hide();
            currentCuentaId = null;
            table.ajax.reload();
        }

        function setDefaultDate() {
            const today = new Date().toISOString().split('T')[0];
            $('#fecha').val(today);
        }

        function openCreateModal() {
            resetForm();
            $('#modalTitle').text('Nuevo Movimiento Bancario');
            $('#estado').val('REG');
            $('#modalMovimiento').modal('show');
        }

        function resetForm() {
            $('#movimientoId').val('');
            $('#numero').val('');
            setDefaultDate();
            $('#cuentaBancariaId').val('').trigger('change');
            $('#tipoMovimiento').val('DEP');
            $('#naturaleza').val('CRE');
            $('#monto').val('');
            $('#beneficiario').val('');
            $('#numeroReferencia').val('');
            $('#numeroDocumento').val('');
            $('#descripcion').val('');
            $('#tipoDocumentoOrigen').val('');
            $('#estado').val('REG');
            $('#observaciones').val('');
        }

        function updateNaturaleza() {
            const tipo = $('#tipoMovimiento').val();
            // Sugerir naturaleza según tipo de movimiento
            switch(tipo) {
                case 'DEP':
                case 'INT':
                    $('#naturaleza').val('CRE');
                    break;
                case 'RET':
                case 'CHE':
                case 'COM':
                    $('#naturaleza').val('DEB');
                    break;
                default:
                    // Para TRA y OTR, dejar que el usuario decida
                    break;
            }
        }

        function editMovimiento(id) {
            $.get(`?handler=ById&id=${id}`, function(movimiento) {
                if (!movimiento) {
                    Swal.fire('Error', 'No se encontró el movimiento.', 'error');
                    return;
                }

                $('#movimientoId').val(movimiento.id);
                $('#numero').val(movimiento.numero);

                const fecha = new Date(movimiento.fecha);
                $('#fecha').val(fecha.toISOString().split('T')[0]);

                $('#cuentaBancariaId').val(movimiento.cuentaBancariaId).trigger('change');
                $('#tipoMovimiento').val(movimiento.tipoMovimiento);
                $('#naturaleza').val(movimiento.naturaleza);
                $('#monto').val(movimiento.monto);
                $('#beneficiario').val(movimiento.beneficiario || '');
                $('#numeroReferencia').val(movimiento.numeroReferencia || '');
                $('#numeroDocumento').val(movimiento.numeroDocumento || '');
                $('#descripcion').val(movimiento.descripcion || '');
                $('#tipoDocumentoOrigen').val(movimiento.tipoDocumentoOrigen || '');
                $('#estado').val(movimiento.estado);
                $('#observaciones').val(movimiento.observaciones || '');

                $('#modalTitle').text('Editar Movimiento Bancario');
                $('#modalMovimiento').modal('show');
            }).fail(function(xhr) {
                Swal.fire('Error', xhr.responseText || 'Error al cargar el movimiento.', 'error');
            });
        }

        function viewMovimiento(id) {
            const movimiento = movimientosData.find(m => m.id === id);
            if (!movimiento) return;

            const cuenta = movimiento.cuentaBancaria;
            const moneda = cuenta?.moneda === 'CRC' ? '₡' : (cuenta?.moneda === 'USD' ? '$' : '€');

            Swal.fire({
                title: 'Detalles del Movimiento',
                html: `
                    <div class="text-start">
                        <p><strong>Número:</strong> ${movimiento.numero}</p>
                        <p><strong>Fecha:</strong> ${new Date(movimiento.fecha).toLocaleDateString('es-CR', {day: '2-digit', month: '2-digit', year: 'numeric'})}</p>
                        <p><strong>Cuenta:</strong> ${cuenta?.nombre || '-'} - ${cuenta?.numeroCuenta || ''}</p>
                        <p><strong>Tipo:</strong> ${movimiento.tipoMovimientoDescripcion || movimiento.tipoMovimiento}</p>
                        <p><strong>Naturaleza:</strong> ${movimiento.naturalezaDescripcion || movimiento.naturaleza}</p>
                        <p><strong>Monto:</strong> ${moneda}${parseFloat(movimiento.monto).toLocaleString('es-CR', { minimumFractionDigits: 2 })}</p>
                        <p><strong>Saldo Anterior:</strong> ${moneda}${parseFloat(movimiento.saldoAnterior).toLocaleString('es-CR', { minimumFractionDigits: 2 })}</p>
                        <p><strong>Saldo Nuevo:</strong> ${moneda}${parseFloat(movimiento.saldoNuevo).toLocaleString('es-CR', { minimumFractionDigits: 2 })}</p>
                        <p><strong>Beneficiario:</strong> ${movimiento.beneficiario || '-'}</p>
                        <p><strong>Referencia:</strong> ${movimiento.numeroReferencia || '-'}</p>
                        <p><strong>Documento:</strong> ${movimiento.numeroDocumento || '-'}</p>
                        <p><strong>Descripción:</strong> ${movimiento.descripcion || '-'}</p>
                        <p><strong>Estado:</strong> ${movimiento.estadoDescripcion || movimiento.estado}</p>
                        <p><strong>Conciliado:</strong> ${movimiento.conciliado ? 'Sí' : 'No'}</p>
                        ${movimiento.observaciones ? `<p><strong>Observaciones:</strong> ${movimiento.observaciones}</p>` : ''}
                    </div>
                `,
                icon: 'info',
                confirmButtonText: 'Cerrar'
            });
        }

        function saveMovimiento() {
            if (!$('#formMovimiento')[0].checkValidity()) {
                $('#formMovimiento')[0].reportValidity();
                return;
            }

            const movimiento = {
                id: $('#movimientoId').val() || '00000000-0000-0000-0000-000000000000',
                cuentaBancariaId: $('#cuentaBancariaId').val(),
                numero: $('#numero').val(),
                fecha: $('#fecha').val(),
                tipoMovimiento: $('#tipoMovimiento').val(),
                naturaleza: $('#naturaleza').val(),
                monto: parseFloat($('#monto').val()),
                beneficiario: $('#beneficiario').val() || null,
                numeroReferencia: $('#numeroReferencia').val() || null,
                numeroDocumento: $('#numeroDocumento').val() || null,
                descripcion: $('#descripcion').val() || null,
                tipoDocumentoOrigen: $('#tipoDocumentoOrigen').val() || null,
                documentoOrigenId: null,
                estado: $('#estado').val(),
                observaciones: $('#observaciones').val() || null
            };

            $.ajax({
                url: '?handler=Save',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(movimiento),
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    $('#modalMovimiento').modal('hide');
                    table.ajax.reload();
                    Swal.fire('Éxito', 'El movimiento bancario ha sido guardado correctamente.', 'success');

                    // Si hay cuenta seleccionada en filtro, actualizar saldo
                    if (currentCuentaId) {
                        loadSaldoCuenta(currentCuentaId);
                    }
                },
                error: function(xhr) {
                    Swal.fire('Error', xhr.responseText || 'Error al guardar el movimiento bancario.', 'error');
                }
            });
        }

        function deleteMovimiento(id) {
            const movimiento = movimientosData.find(m => m.id === id);
            if (!movimiento) return;

            Swal.fire({
                title: '¿Eliminar movimiento?',
                html: `¿Está seguro que desea eliminar el movimiento <strong>${movimiento.numero}</strong>?<br>Esta acción no se puede deshacer.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: `?handler=Delete&id=${id}`,
                        type: 'POST',
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            table.ajax.reload();
                            Swal.fire('Eliminado', 'El movimiento bancario ha sido eliminado.', 'success');

                            // Si hay cuenta seleccionada en filtro, actualizar saldo
                            if (currentCuentaId) {
                                loadSaldoCuenta(currentCuentaId);
                            }
                        },
                        error: function(xhr) {
                            Swal.fire('Error', xhr.responseText || 'Error al eliminar el movimiento bancario.', 'error');
                        }
                    });
                }
            });
        }
    </script>
}
