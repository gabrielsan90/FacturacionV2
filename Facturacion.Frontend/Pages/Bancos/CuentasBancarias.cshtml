@page
@model Facturacion.Frontend.Pages.Bancos.CuentasBancariasModel
@{
    ViewData["Title"] = "Cuentas Bancarias";
    ViewData["Breadcrumb"] = "Cuentas Bancarias";
}

<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <h2><i class="fas fa-credit-card"></i> Cuentas Bancarias</h2>
            <p class="mb-0">Gestión de cuentas bancarias de la empresa</p>
        </div>
        <button class="btn btn-primary" onclick="openCreateModal()">
            <i class="fas fa-plus me-2"></i>Nueva Cuenta
        </button>
    </div>
</div>

<!-- Filtros -->
<div class="card shadow-custom mb-4">
    <div class="card-header">
        <i class="fas fa-filter me-2 text-primary"></i>
        <strong>Filtros</strong>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Tipo de Cuenta</label>
                <select id="filterTipo" class="form-select" onchange="filterData()">
                    <option value="">Todos</option>
                    <option value="CTE">Corriente</option>
                    <option value="AHO">Ahorro</option>
                    <option value="INV">Inversión</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Moneda</label>
                <select id="filterMoneda" class="form-select" onchange="filterData()">
                    <option value="">Todas</option>
                    <option value="CRC">Colones (CRC)</option>
                    <option value="USD">Dólares (USD)</option>
                    <option value="EUR">Euros (EUR)</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Estado</label>
                <select id="filterEstado" class="form-select" onchange="filterData()">
                    <option value="">Todos</option>
                    <option value="true">Activas</option>
                    <option value="false">Inactivas</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-secondary w-100" onclick="clearFilters()">
                    <i class="fas fa-eraser me-2"></i>Limpiar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Tabla de Cuentas -->
<div class="card shadow-custom">
    <div class="card-header">
        <i class="fas fa-table me-2 text-primary"></i>
        <strong>Cuentas Bancarias</strong>
    </div>
    <div class="card-body">
        <table id="tblCuentas" class="table table-striped table-hover" style="width:100%">
            <thead>
                <tr>
                    <th>Número</th>
                    <th>Nombre</th>
                    <th>Banco</th>
                    <th>Tipo</th>
                    <th>Moneda</th>
                    <th>Saldo Actual</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<!-- Modal Crear/Editar -->
<div class="modal fade" id="modalCuenta" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Nueva Cuenta Bancaria</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formCuenta">
                    <input type="hidden" id="cuentaId" value="">

                    <!-- Identificación -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Número de Cuenta <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="numeroCuenta" required maxlength="50">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Nombre <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="nombre" required maxlength="100">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Tipo de Cuenta <span class="text-danger">*</span></label>
                            <select class="form-select" id="tipoCuenta" required>
                                <option value="CTE">Corriente</option>
                                <option value="AHO">Ahorro</option>
                                <option value="INV">Inversión</option>
                            </select>
                        </div>
                    </div>

                    <!-- Banco y Sucursal -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Banco</label>
                            <select class="form-select" id="bancoId">
                                <option value="">Seleccione un banco...</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Nombre del Banco (si no está en lista)</label>
                            <input type="text" class="form-control" id="nombreBanco" maxlength="100">
                        </div>
                    </div>

                    <!-- Moneda y Saldos -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Moneda <span class="text-danger">*</span></label>
                            <select class="form-select" id="moneda" required>
                                <option value="CRC">Colones (CRC)</option>
                                <option value="USD">Dólares (USD)</option>
                                <option value="EUR">Euros (EUR)</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Saldo Inicial</label>
                            <input type="number" class="form-control" id="saldoInicial" step="0.01" value="0">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Fecha de Apertura</label>
                            <input type="date" class="form-control" id="fechaApertura">
                        </div>
                    </div>

                    <!-- Información Bancaria -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">IBAN / CLABE</label>
                            <input type="text" class="form-control" id="numeroClabe" maxlength="50">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Código SWIFT</label>
                            <input type="text" class="form-control" id="swiftCode" maxlength="20">
                        </div>
                    </div>

                    <!-- Contacto -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Contacto en el Banco</label>
                            <input type="text" class="form-control" id="contacto" maxlength="200">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Teléfono de Contacto</label>
                            <input type="text" class="form-control" id="telefono" maxlength="50">
                        </div>
                    </div>

                    <!-- Sucursal y Cuenta Contable -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Sucursal (opcional)</label>
                            <select class="form-select" id="sucursalId">
                                <option value="">Ninguna</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Cuenta Contable</label>
                            <select class="form-select" id="cuentaContableId">
                                <option value="">Seleccione...</option>
                            </select>
                        </div>
                    </div>

                    <!-- Observaciones y Estado -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-9">
                            <label class="form-label">Observaciones</label>
                            <textarea class="form-control" id="observaciones" rows="2" maxlength="500"></textarea>
                        </div>
                        <div class="col-md-3 d-flex align-items-center">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="activo" checked>
                                <label class="form-check-label" for="activo">Cuenta Activa</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Cancelar
                </button>
                <button type="button" class="btn btn-primary" onclick="saveCuenta()">
                    <i class="fas fa-save me-2"></i>Guardar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;
        let cuentasData = [];
        let bancosData = [];
        let sucursalesData = [];
        let cuentasContablesData = [];

        $(document).ready(function() {
            initDataTable();
            loadCombos();
        });

        function initDataTable() {
            table = $('#tblCuentas').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'
                },
                ajax: {
                    url: '?handler=Data',
                    dataSrc: function(json) {
                        cuentasData = json;
                        return json;
                    }
                },
                columns: [
                    { data: 'numeroCuenta' },
                    { data: 'nombre' },
                    {
                        data: null,
                        render: function(data) {
                            return data.banco?.nombre || data.nombreBanco || '-';
                        }
                    },
                    {
                        data: 'tipoCuenta',
                        render: function(data) {
                            const tipos = { 'CTE': 'Corriente', 'AHO': 'Ahorro', 'INV': 'Inversión' };
                            return tipos[data] || data;
                        }
                    },
                    {
                        data: 'moneda',
                        render: function(data) {
                            const monedas = { 'CRC': '₡', 'USD': '$', 'EUR': '€' };
                            return `<span class="badge bg-info">${monedas[data] || data}</span>`;
                        }
                    },
                    {
                        data: 'saldoActual',
                        render: function(data, type, row) {
                            const monedas = { 'CRC': '₡', 'USD': '$', 'EUR': '€' };
                            const simbolo = monedas[row.moneda] || '';
                            const valor = parseFloat(data).toLocaleString('es-CR', { minimumFractionDigits: 2 });
                            const clase = data >= 0 ? 'text-success' : 'text-danger';
                            return `<span class="${clase}">${simbolo}${valor}</span>`;
                        }
                    },
                    {
                        data: 'activo',
                        render: function(data) {
                            return data
                                ? '<span class="badge bg-success">Activa</span>'
                                : '<span class="badge bg-secondary">Inactiva</span>';
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        render: function(data) {
                            return `
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-primary" onclick="editCuenta('${data.id}')" title="Editar">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn btn-outline-danger" onclick="deleteCuenta('${data.id}')" title="Eliminar">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            `;
                        }
                    }
                ],
                order: [[1, 'asc']],
                responsive: true
            });
        }

        function loadCombos() {
            // Cargar bancos
            $.get('?handler=Bancos', function(data) {
                bancosData = data;
                let options = '<option value="">Seleccione un banco...</option>';
                data.forEach(b => {
                    options += `<option value="${b.id}">${b.nombre} ${b.codigoSINPE ? '(' + b.codigoSINPE + ')' : ''}</option>`;
                });
                $('#bancoId').html(options);
            });

            // Cargar sucursales
            $.get('?handler=Sucursales', function(data) {
                sucursalesData = data.result || data;
                let options = '<option value="">Ninguna</option>';
                if (Array.isArray(sucursalesData)) {
                    sucursalesData.forEach(s => {
                        options += `<option value="${s.id}">${s.nombre}</option>`;
                    });
                }
                $('#sucursalId').html(options);
            });

            // Cargar cuentas contables
            $.get('?handler=CuentasContables', function(data) {
                cuentasContablesData = data;
                let options = '<option value="">Seleccione...</option>';
                if (Array.isArray(data)) {
                    data.forEach(c => {
                        options += `<option value="${c.id}">${c.codigo} - ${c.nombre}</option>`;
                    });
                }
                $('#cuentaContableId').html(options);
            });
        }

        function filterData() {
            const tipo = $('#filterTipo').val();
            const moneda = $('#filterMoneda').val();
            const estado = $('#filterEstado').val();

            table.columns(3).search(tipo ? tipo : '');
            table.columns(4).search(moneda ? moneda : '');

            if (estado !== '') {
                const estadoTexto = estado === 'true' ? 'Activa' : 'Inactiva';
                table.columns(6).search(estadoTexto);
            } else {
                table.columns(6).search('');
            }

            table.draw();
        }

        function clearFilters() {
            $('#filterTipo').val('');
            $('#filterMoneda').val('');
            $('#filterEstado').val('');
            table.search('').columns().search('').draw();
        }

        function openCreateModal() {
            resetForm();
            $('#modalTitle').text('Nueva Cuenta Bancaria');
            $('#modalCuenta').modal('show');
        }

        function resetForm() {
            $('#cuentaId').val('');
            $('#numeroCuenta').val('');
            $('#nombre').val('');
            $('#tipoCuenta').val('CTE');
            $('#bancoId').val('');
            $('#nombreBanco').val('');
            $('#moneda').val('CRC');
            $('#saldoInicial').val('0');
            $('#fechaApertura').val('');
            $('#numeroClabe').val('');
            $('#swiftCode').val('');
            $('#contacto').val('');
            $('#telefono').val('');
            $('#sucursalId').val('');
            $('#cuentaContableId').val('');
            $('#observaciones').val('');
            $('#activo').prop('checked', true);
        }

        function editCuenta(id) {
            const cuenta = cuentasData.find(c => c.id === id);
            if (!cuenta) return;

            $('#cuentaId').val(cuenta.id);
            $('#numeroCuenta').val(cuenta.numeroCuenta);
            $('#nombre').val(cuenta.nombre);
            $('#tipoCuenta').val(cuenta.tipoCuenta);
            $('#bancoId').val(cuenta.bancoId || '');
            $('#nombreBanco').val(cuenta.nombreBanco || '');
            $('#moneda').val(cuenta.moneda);
            $('#saldoInicial').val(cuenta.saldoInicial);

            if (cuenta.fechaApertura) {
                const fecha = new Date(cuenta.fechaApertura);
                $('#fechaApertura').val(fecha.toISOString().split('T')[0]);
            } else {
                $('#fechaApertura').val('');
            }

            $('#numeroClabe').val(cuenta.numeroClabe || '');
            $('#swiftCode').val(cuenta.swiftCode || '');
            $('#contacto').val(cuenta.contacto || '');
            $('#telefono').val(cuenta.telefono || '');
            $('#sucursalId').val(cuenta.sucursalId || '');
            $('#cuentaContableId').val(cuenta.cuentaContableId || '');
            $('#observaciones').val(cuenta.observaciones || '');
            $('#activo').prop('checked', cuenta.activo);

            $('#modalTitle').text('Editar Cuenta Bancaria');
            $('#modalCuenta').modal('show');
        }

        function saveCuenta() {
            if (!$('#formCuenta')[0].checkValidity()) {
                $('#formCuenta')[0].reportValidity();
                return;
            }

            const cuenta = {
                id: $('#cuentaId').val() || '00000000-0000-0000-0000-000000000000',
                numeroCuenta: $('#numeroCuenta').val(),
                nombre: $('#nombre').val(),
                tipoCuenta: $('#tipoCuenta').val(),
                bancoId: $('#bancoId').val() || null,
                nombreBanco: $('#nombreBanco').val() || null,
                moneda: $('#moneda').val(),
                saldoInicial: parseFloat($('#saldoInicial').val()) || 0,
                fechaApertura: $('#fechaApertura').val() || null,
                numeroClabe: $('#numeroClabe').val() || null,
                swiftCode: $('#swiftCode').val() || null,
                contacto: $('#contacto').val() || null,
                telefono: $('#telefono').val() || null,
                sucursalId: $('#sucursalId').val() || null,
                cuentaContableId: $('#cuentaContableId').val() || null,
                observaciones: $('#observaciones').val() || null,
                activo: $('#activo').is(':checked')
            };

            $.ajax({
                url: '?handler=Save',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(cuenta),
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    $('#modalCuenta').modal('hide');
                    table.ajax.reload();
                    Swal.fire('Éxito', 'La cuenta bancaria ha sido guardada correctamente.', 'success');
                },
                error: function(xhr) {
                    Swal.fire('Error', xhr.responseText || 'Error al guardar la cuenta bancaria.', 'error');
                }
            });
        }

        function deleteCuenta(id) {
            const cuenta = cuentasData.find(c => c.id === id);
            if (!cuenta) return;

            Swal.fire({
                title: '¿Eliminar cuenta?',
                html: `¿Está seguro que desea eliminar la cuenta <strong>${cuenta.nombre}</strong>?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: `?handler=Delete&id=${id}`,
                        type: 'POST',
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            table.ajax.reload();
                            Swal.fire('Eliminada', 'La cuenta bancaria ha sido eliminada.', 'success');
                        },
                        error: function(xhr) {
                            Swal.fire('Error', xhr.responseText || 'Error al eliminar la cuenta bancaria.', 'error');
                        }
                    });
                }
            });
        }
    </script>
}
