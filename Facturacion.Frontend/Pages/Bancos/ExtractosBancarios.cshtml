@page
@model Facturacion.Frontend.Pages.Bancos.ExtractosBancariosModel
@{
    ViewData["Title"] = "Extractos Bancarios";
    ViewData["Breadcrumb"] = "Extractos Bancarios";
}

<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <h2><i class="fas fa-file-invoice-dollar"></i> Extractos Bancarios</h2>
            <p class="mb-0">Importación y gestión de extractos bancarios</p>
        </div>
        <button class="btn btn-primary" onclick="openCreateModal()">
            <i class="fas fa-plus me-2"></i>Nuevo Extracto
        </button>
    </div>
</div>

<!-- Filtros -->
<div class="card shadow-custom mb-4">
    <div class="card-header">
        <i class="fas fa-filter me-2 text-primary"></i>
        <strong>Filtros</strong>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Cuenta Bancaria</label>
                <select id="filterCuenta" class="form-select select2" onchange="filterByCuenta()">
                    <option value="">Todas las cuentas</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Estado</label>
                <select id="filterEstado" class="form-select" onchange="filterData()">
                    <option value="">Todos</option>
                    <option value="PEN">Pendiente</option>
                    <option value="PAR">Parcialmente Conciliado</option>
                    <option value="CON">Conciliado</option>
                    <option value="CER">Cerrado</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Formato</label>
                <select id="filterFormato" class="form-select" onchange="filterData()">
                    <option value="">Todos</option>
                    <option value="CSV">CSV</option>
                    <option value="OFX">OFX</option>
                    <option value="MT940">MT940</option>
                    <option value="XLSX">XLSX</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button class="btn btn-secondary w-100" onclick="clearFilters()">
                    <i class="fas fa-eraser me-2"></i>Limpiar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Tabla de Extractos -->
<div class="card shadow-custom">
    <div class="card-header">
        <i class="fas fa-table me-2 text-primary"></i>
        <strong>Extractos Bancarios</strong>
    </div>
    <div class="card-body">
        <table id="tblExtractos" class="table table-striped table-hover" style="width:100%">
            <thead>
                <tr>
                    <th>Número</th>
                    <th>Cuenta</th>
                    <th>Periodo</th>
                    <th>Saldo Inicial</th>
                    <th>Saldo Final</th>
                    <th>Transacciones</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<!-- Modal Crear/Editar -->
<div class="modal fade" id="modalExtracto" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Nuevo Extracto Bancario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formExtracto">
                    <input type="hidden" id="extractoId" value="">

                    <!-- Cuenta y Número -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Cuenta Bancaria <span class="text-danger">*</span></label>
                            <select class="form-select select2" id="cuentaBancariaId" required>
                                <option value="">Seleccione una cuenta...</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Número de Extracto <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="numero" required maxlength="20" placeholder="EXT-2026-001">
                        </div>
                    </div>

                    <!-- Período -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Fecha de Inicio <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="fechaInicio" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Fecha de Fin <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="fechaFin" required>
                        </div>
                    </div>

                    <!-- Saldos -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Saldo Inicial <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">₡</span>
                                <input type="number" class="form-control" id="saldoInicial" required step="0.01" value="0">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Saldo Final <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">₡</span>
                                <input type="number" class="form-control" id="saldoFinal" required step="0.01" value="0">
                            </div>
                        </div>
                    </div>

                    <!-- Totales (opcional para carga manual) -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Total Créditos</label>
                            <div class="input-group">
                                <span class="input-group-text">₡</span>
                                <input type="number" class="form-control" id="totalCreditos" step="0.01" value="0">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Total Débitos</label>
                            <div class="input-group">
                                <span class="input-group-text">₡</span>
                                <input type="number" class="form-control" id="totalDebitos" step="0.01" value="0">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Cantidad de Transacciones</label>
                            <input type="number" class="form-control" id="cantidadTransacciones" min="0" value="0">
                        </div>
                    </div>

                    <!-- Archivo (futuro) -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label class="form-label">Archivo de Origen</label>
                            <input type="text" class="form-control" id="archivoOrigen" maxlength="500" placeholder="Nombre del archivo importado">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Formato</label>
                            <select class="form-select" id="formatoArchivo">
                                <option value="">Sin especificar</option>
                                <option value="CSV">CSV</option>
                                <option value="OFX">OFX</option>
                                <option value="MT940">MT940</option>
                                <option value="XLSX">XLSX</option>
                            </select>
                        </div>
                    </div>

                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        <small>La importación automática de archivos estará disponible en una próxima versión.</small>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Cancelar
                </button>
                <button type="button" class="btn btn-primary" onclick="saveExtracto()">
                    <i class="fas fa-save me-2"></i>Guardar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;
        let extractosData = [];
        let cuentasData = [];
        let currentCuentaId = null;

        $(document).ready(function() {
            initSelect2();
            loadCuentas();
        });

        function initSelect2() {
            $('.select2').select2({
                theme: 'bootstrap-5',
                width: '100%',
                placeholder: 'Seleccione...',
                allowClear: true,
                language: 'es'
            });
        }

        function loadCuentas() {
            $.get('?handler=CuentasBancarias', function(data) {
                cuentasData = data || [];
                let options = '<option value="">Todas las cuentas</option>';
                cuentasData.forEach(c => {
                    options += `<option value="${c.id}">${c.nombre} (${c.numeroCuenta})</option>`;
                });
                $('#filterCuenta').html(options);

                // Para el modal
                let modalOptions = '<option value="">Seleccione una cuenta...</option>';
                cuentasData.forEach(c => {
                    modalOptions += `<option value="${c.id}">${c.nombre} - ${c.numeroCuenta}</option>`;
                });
                $('#cuentaBancariaId').html(modalOptions);

                // Inicializar tabla con la primera cuenta si existe
                if (cuentasData.length > 0) {
                    currentCuentaId = cuentasData[0].id;
                    $('#filterCuenta').val(currentCuentaId).trigger('change');
                    initDataTable();
                } else {
                    initDataTable();
                    Swal.fire('Atención', 'No hay cuentas bancarias registradas. Por favor, cree una cuenta primero.', 'warning');
                }
            }).fail(function() {
                Swal.fire('Error', 'No se pudieron cargar las cuentas bancarias.', 'error');
                initDataTable();
            });
        }

        function initDataTable() {
            if (table) {
                table.destroy();
            }

            table = $('#tblExtractos').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'
                },
                ajax: {
                    url: function() {
                        return '?handler=Data&cuentaId=' + (currentCuentaId || '');
                    },
                    dataSrc: function(json) {
                        extractosData = json || [];
                        return extractosData;
                    }
                },
                columns: [
                    { data: 'numero' },
                    {
                        data: null,
                        render: function(data) {
                            if (data.cuentaBancaria) {
                                return `${data.cuentaBancaria.nombre}<br><small class="text-muted">${data.cuentaBancaria.numeroCuenta}</small>`;
                            }
                            return '-';
                        }
                    },
                    {
                        data: null,
                        render: function(data) {
                            const inicio = new Date(data.fechaInicio).toLocaleDateString('es-CR');
                            const fin = new Date(data.fechaFin).toLocaleDateString('es-CR');
                            return `${inicio}<br><small class="text-muted">al ${fin}</small>`;
                        }
                    },
                    {
                        data: 'saldoInicial',
                        render: function(data) {
                            const valor = parseFloat(data).toLocaleString('es-CR', { minimumFractionDigits: 2 });
                            const clase = data >= 0 ? 'text-success' : 'text-danger';
                            return `<span class="${clase}">₡${valor}</span>`;
                        }
                    },
                    {
                        data: 'saldoFinal',
                        render: function(data) {
                            const valor = parseFloat(data).toLocaleString('es-CR', { minimumFractionDigits: 2 });
                            const clase = data >= 0 ? 'text-success' : 'text-danger';
                            return `<span class="${clase}">₡${valor}</span>`;
                        }
                    },
                    {
                        data: null,
                        render: function(data) {
                            const creditos = parseFloat(data.totalCreditos).toLocaleString('es-CR', { minimumFractionDigits: 2 });
                            const debitos = parseFloat(data.totalDebitos).toLocaleString('es-CR', { minimumFractionDigits: 2 });
                            return `
                                <div class="small">
                                    <div><span class="text-success">+₡${creditos}</span></div>
                                    <div><span class="text-danger">-₡${debitos}</span></div>
                                    <div class="text-muted">${data.cantidadTransacciones} transacciones</div>
                                </div>
                            `;
                        }
                    },
                    {
                        data: 'estado',
                        render: function(data) {
                            const estados = {
                                'PEN': { text: 'Pendiente', class: 'warning' },
                                'PAR': { text: 'Parcialmente Conciliado', class: 'info' },
                                'CON': { text: 'Conciliado', class: 'success' },
                                'CER': { text: 'Cerrado', class: 'secondary' }
                            };
                            const estado = estados[data] || { text: data, class: 'secondary' };
                            return `<span class="badge bg-${estado.class}">${estado.text}</span>`;
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        render: function(data) {
                            let btnProcesar = data.estado === 'PEN'
                                ? `<button class="btn btn-outline-success btn-sm" onclick="procesarExtracto('${data.id}')" title="Procesar para conciliación">
                                    <i class="fas fa-cog"></i>
                                   </button>`
                                : '';

                            return `
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-info" onclick="verLineas('${data.id}')" title="Ver líneas">
                                        <i class="fas fa-list"></i>
                                    </button>
                                    <button class="btn btn-outline-primary" onclick="editExtracto('${data.id}')" title="Editar">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    ${btnProcesar}
                                    <button class="btn btn-outline-danger" onclick="deleteExtracto('${data.id}')" title="Eliminar">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            `;
                        }
                    }
                ],
                order: [[0, 'desc']],
                responsive: true,
                pageLength: 25
            });
        }

        function filterByCuenta() {
            currentCuentaId = $('#filterCuenta').val();
            table.ajax.reload();
        }

        function filterData() {
            const estado = $('#filterEstado').val();
            const formato = $('#filterFormato').val();

            table.columns(6).search(estado ? estado : '');

            if (formato) {
                // Filtrar por formato requeriría agregar una columna oculta o buscar en los datos
                // Por ahora solo filtramos por estado
            }

            table.draw();
        }

        function clearFilters() {
            $('#filterCuenta').val('').trigger('change');
            $('#filterEstado').val('');
            $('#filterFormato').val('');
            currentCuentaId = null;
            table.search('').columns().search('').draw();
            table.ajax.reload();
        }

        function openCreateModal() {
            resetForm();
            $('#modalTitle').text('Nuevo Extracto Bancario');
            $('#modalExtracto').modal('show');
        }

        function resetForm() {
            $('#extractoId').val('');
            $('#cuentaBancariaId').val('').trigger('change');
            $('#numero').val('');
            $('#fechaInicio').val('');
            $('#fechaFin').val('');
            $('#saldoInicial').val('0');
            $('#saldoFinal').val('0');
            $('#totalCreditos').val('0');
            $('#totalDebitos').val('0');
            $('#cantidadTransacciones').val('0');
            $('#archivoOrigen').val('');
            $('#formatoArchivo').val('');
        }

        function editExtracto(id) {
            $.get(`?handler=ById&id=${id}`, function(data) {
                if (data) {
                    $('#extractoId').val(data.id);
                    $('#cuentaBancariaId').val(data.cuentaBancariaId).trigger('change');
                    $('#numero').val(data.numero);

                    const fechaInicio = new Date(data.fechaInicio);
                    $('#fechaInicio').val(fechaInicio.toISOString().split('T')[0]);

                    const fechaFin = new Date(data.fechaFin);
                    $('#fechaFin').val(fechaFin.toISOString().split('T')[0]);

                    $('#saldoInicial').val(data.saldoInicial);
                    $('#saldoFinal').val(data.saldoFinal);
                    $('#totalCreditos').val(data.totalCreditos);
                    $('#totalDebitos').val(data.totalDebitos);
                    $('#cantidadTransacciones').val(data.cantidadTransacciones);
                    $('#archivoOrigen').val(data.archivoOrigen || '');
                    $('#formatoArchivo').val(data.formatoArchivo || '');

                    $('#modalTitle').text('Editar Extracto Bancario');
                    $('#modalExtracto').modal('show');
                }
            }).fail(function() {
                Swal.fire('Error', 'No se pudo cargar el extracto.', 'error');
            });
        }

        function saveExtracto() {
            if (!$('#formExtracto')[0].checkValidity()) {
                $('#formExtracto')[0].reportValidity();
                return;
            }

            const extracto = {
                id: $('#extractoId').val() || '00000000-0000-0000-0000-000000000000',
                cuentaBancariaId: $('#cuentaBancariaId').val(),
                numero: $('#numero').val(),
                fechaInicio: $('#fechaInicio').val(),
                fechaFin: $('#fechaFin').val(),
                saldoInicial: parseFloat($('#saldoInicial').val()) || 0,
                saldoFinal: parseFloat($('#saldoFinal').val()) || 0,
                totalCreditos: parseFloat($('#totalCreditos').val()) || 0,
                totalDebitos: parseFloat($('#totalDebitos').val()) || 0,
                cantidadTransacciones: parseInt($('#cantidadTransacciones').val()) || 0,
                archivoOrigen: $('#archivoOrigen').val() || null,
                formatoArchivo: $('#formatoArchivo').val() || null,
                estado: 'PEN'
            };

            $.ajax({
                url: '?handler=Save',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(extracto),
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    $('#modalExtracto').modal('hide');
                    table.ajax.reload();
                    Swal.fire('Éxito', 'El extracto bancario ha sido guardado correctamente.', 'success');
                },
                error: function(xhr) {
                    Swal.fire('Error', xhr.responseText || 'Error al guardar el extracto bancario.', 'error');
                }
            });
        }

        function procesarExtracto(id) {
            Swal.fire({
                title: '¿Procesar extracto?',
                text: 'Esto preparará el extracto para conciliación automática.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, procesar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: `?handler=Procesar&id=${id}`,
                        type: 'POST',
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            table.ajax.reload();
                            Swal.fire('Procesado', 'El extracto ha sido procesado correctamente.', 'success');
                        },
                        error: function(xhr) {
                            Swal.fire('Error', xhr.responseText || 'Error al procesar el extracto.', 'error');
                        }
                    });
                }
            });
        }

        function verLineas(id) {
            Swal.fire('Información', 'La visualización de líneas de extracto estará disponible próximamente.', 'info');
        }

        function deleteExtracto(id) {
            const extracto = extractosData.find(e => e.id === id);
            if (!extracto) return;

            Swal.fire({
                title: '¿Eliminar extracto?',
                html: `¿Está seguro que desea eliminar el extracto <strong>${extracto.numero}</strong>?<br><small class="text-danger">Esta acción no se puede deshacer.</small>`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: `?handler=Delete&id=${id}`,
                        type: 'POST',
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            table.ajax.reload();
                            Swal.fire('Eliminado', 'El extracto bancario ha sido eliminado.', 'success');
                        },
                        error: function(xhr) {
                            Swal.fire('Error', xhr.responseText || 'Error al eliminar el extracto.', 'error');
                        }
                    });
                }
            });
        }
    </script>
}
