@page
@model Facturacion.Frontend.Pages.Stock.InventarioModel
@{
    ViewData["Title"] = "Gestión de Inventario";
    ViewData["Breadcrumb"] = "Inventario";
}

<!-- Page Header -->
<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <h2><i class="fas fa-warehouse"></i> Gestión de Inventario</h2>
            <p class="mb-0">Control de existencias por producto y sucursal</p>
        </div>
        <div>
            <button class="btn btn-warning me-2" id="btnLowStock" style="display:none;">
                <i class="fas fa-exclamation-triangle"></i> Bajo Stock <span id="badgeLowStock" class="badge bg-danger">0</span>
            </button>
            <button class="btn btn-primary" onclick="openCreateModal()" aria-label="Crear nuevo inventario">
                <i class="fas fa-plus me-2"></i>Nuevo Inventario
            </button>
        </div>
    </div>
</div>

<!-- Inventario Table Card -->
<div class="card shadow-custom">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <i class="fas fa-table me-2 text-primary"></i>
            <strong>Listado de Inventario</strong>
            <span class="badge bg-secondary ms-2" id="badgeTotalInventario">0</span>
        </div>
        <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="btn btn-outline-success" onclick="descargarPlantilla()" title="Descargar plantilla Excel">
                <i class="fas fa-download"></i> Plantilla
            </button>
            <button type="button" class="btn btn-outline-success" onclick="$('#fileImport').click()" title="Importar desde Excel">
                <i class="fas fa-file-import"></i> Importar
            </button>
            <input type="file" id="fileImport" accept=".xlsx,.xls" style="display:none;" onchange="importarExcel(this)" />
            <button type="button" class="btn btn-outline-primary" onclick="exportarExcel()" title="Exportar a Excel">
                <i class="fas fa-file-excel"></i>
            </button>
            <button type="button" class="btn btn-outline-primary" onclick="refrescarTabla()" title="Refrescar tabla">
                <i class="fas fa-sync-alt"></i>
            </button>
        </div>
    </div>
    <div class="card-body">
        <!-- Loading State -->
        <div id="tableInventarioLoader" class="text-center py-5">
            <div class="spinner-modern mx-auto"></div>
            <p class="text-muted mt-3">Cargando inventario...</p>
        </div>

        <!-- Table -->
        <div class="table-responsive" id="tableInventarioContainer" style="display:none;">
            <table id="tableInventario" class="table table-hover">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Sucursal</th>
                        <th>Cantidad Actual</th>
                        <th>Cantidad Reservada</th>
                        <th>Cantidad Disponible</th>
                        <th>Última Actualización</th>
                        <th style="width: 160px;">Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <!-- Empty State -->
        <div id="emptyStateInventario" class="empty-state" style="display:none;">
            <div class="empty-state-icon">
                <i class="fas fa-warehouse"></i>
            </div>
            <h3 class="empty-state-title">No hay inventario registrado</h3>
            <p class="empty-state-description">Comienza agregando el inventario inicial de tus productos</p>
            <button class="btn btn-primary" onclick="openCreateModal()">
                <i class="fas fa-plus me-2"></i>Crear Primer Inventario
            </button>
        </div>
    </div>
</div>

<!-- Modal for Create Initial Inventario -->
<div class="modal fade" id="modalInventario" tabindex="-1" aria-labelledby="modalInventarioLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalInventarioLabel">
                    <i class="fas fa-warehouse"></i> Nuevo Inventario
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formInventario">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="Inventario_ProductoId" class="form-label">Producto <span class="text-danger">*</span></label>
                                <select class="form-select" id="Inventario_ProductoId" required>
                                    <option value="">Seleccione...</option>
                                </select>
                                <div class="invalid-feedback">Seleccione un producto.</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="Inventario_SucursalId" class="form-label">Sucursal <span class="text-danger">*</span></label>
                                <select class="form-select" id="Inventario_SucursalId" required>
                                    <option value="">Seleccione...</option>
                                </select>
                                <div class="invalid-feedback">Seleccione una sucursal.</div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label for="Inventario_CantidadInicial" class="form-label">Cantidad Inicial</label>
                                <input type="number" class="form-control" id="Inventario_CantidadInicial" step="0.01" min="0" value="0" />
                                <small class="form-text text-muted">Cantidad inicial de stock (opcional, por defecto 0).</small>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label for="Inventario_Observaciones" class="form-label">Observaciones</label>
                                <textarea class="form-control" id="Inventario_Observaciones" rows="3" maxlength="500"></textarea>
                                <small class="form-text text-muted">Observaciones opcionales sobre el inventario inicial.</small>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal for Ajuste (Adjustment) -->
<div class="modal fade" id="modalAjuste" tabindex="-1" aria-labelledby="modalAjusteLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="modalAjusteLabel">
                    <i class="fas fa-sliders-h"></i> Ajuste de Inventario
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formAjuste">
                <div class="modal-body">
                    <input type="hidden" id="Ajuste_InventarioId" />

                    <div class="alert alert-info">
                        <h6><i class="fas fa-info-circle"></i> Información del Inventario</h6>
                        <p class="mb-1"><strong>Producto:</strong> <span id="Ajuste_ProductoNombre"></span></p>
                        <p class="mb-1"><strong>Sucursal:</strong> <span id="Ajuste_SucursalNombre"></span></p>
                        <p class="mb-0"><strong>Cantidad Actual:</strong> <span id="Ajuste_CantidadActual"></span></p>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label for="Ajuste_Cantidad" class="form-label">Cantidad de Ajuste <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="Ajuste_Cantidad" step="0.01" required />
                                <div class="invalid-feedback">La cantidad es obligatoria.</div>
                                <small class="form-text text-muted">Puede ser positivo (agregar) o negativo (restar). No puede resultar en stock negativo.</small>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label for="Ajuste_Referencia" class="form-label">Referencia</label>
                                <input type="text" class="form-control" id="Ajuste_Referencia" maxlength="100" />
                                <small class="form-text text-muted">Referencia del ajuste (opcional, máximo 100 caracteres).</small>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label for="Ajuste_Observaciones" class="form-label">Observaciones</label>
                                <textarea class="form-control" id="Ajuste_Observaciones" rows="3" maxlength="500"></textarea>
                                <small class="form-text text-muted">Observaciones opcionales (máximo 500 caracteres).</small>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-warning">
                        <i class="fas fa-sliders-h"></i> Realizar Ajuste
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal for Traslado (Transfer) -->
<div class="modal fade" id="modalTraslado" tabindex="-1" aria-labelledby="modalTrasladoLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="modalTrasladoLabel">
                    <i class="fas fa-exchange-alt"></i> Traslado de Inventario
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formTraslado">
                <div class="modal-body">
                    <input type="hidden" id="Traslado_InventarioId" />
                    <input type="hidden" id="Traslado_SucursalOrigenId" />
                    <input type="hidden" id="Traslado_ProductoId" />

                    <div class="alert alert-info">
                        <h6><i class="fas fa-info-circle"></i> Información del Inventario Origen</h6>
                        <p class="mb-1"><strong>Producto:</strong> <span id="Traslado_ProductoNombre"></span></p>
                        <p class="mb-1"><strong>Sucursal Origen:</strong> <span id="Traslado_SucursalOrigen"></span></p>
                        <p class="mb-0"><strong>Cantidad Disponible:</strong> <span id="Traslado_CantidadDisponible"></span></p>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label for="Traslado_SucursalDestinoId" class="form-label">Sucursal Destino <span class="text-danger">*</span></label>
                                <select class="form-select" id="Traslado_SucursalDestinoId" required>
                                    <option value="">Seleccione...</option>
                                </select>
                                <div class="invalid-feedback">Seleccione una sucursal de destino.</div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label for="Traslado_Cantidad" class="form-label">Cantidad a Trasladar <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="Traslado_Cantidad" step="0.01" min="0.01" required />
                                <div class="invalid-feedback">La cantidad debe ser mayor a 0 y no exceder la cantidad disponible.</div>
                                <small class="form-text text-muted">Cantidad a trasladar (debe ser positiva y no exceder cantidad disponible).</small>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label for="Traslado_Referencia" class="form-label">Referencia</label>
                                <input type="text" class="form-control" id="Traslado_Referencia" maxlength="100" />
                                <small class="form-text text-muted">Referencia del traslado (opcional, máximo 100 caracteres).</small>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label for="Traslado_Observaciones" class="form-label">Observaciones</label>
                                <textarea class="form-control" id="Traslado_Observaciones" rows="3" maxlength="500"></textarea>
                                <small class="form-text text-muted">Observaciones opcionales (máximo 500 caracteres).</small>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-exchange-alt"></i> Realizar Traslado
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal for View Details -->
<div class="modal fade" id="modalDetails" tabindex="-1" aria-labelledby="modalDetailsLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="modalDetailsLabel">
                    <i class="fas fa-info-circle"></i> Detalles del Inventario
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="detailsContent">
                <!-- Content will be loaded dynamically -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;
        let productos = [];
        let sucursales = [];
        let currentInventarioData = null;

        $(document).ready(function () {
            loadDataTable();
            checkLowStock();

            // Setup form validation
            $('#formInventario').on('submit', function (e) {
                e.preventDefault();
                if (this.checkValidity()) {
                    saveInventario();
                } else {
                    $(this).addClass('was-validated');
                }
            });

            $('#formAjuste').on('submit', function (e) {
                e.preventDefault();
                if (this.checkValidity()) {
                    saveAjuste();
                } else {
                    $(this).addClass('was-validated');
                }
            });

            $('#formTraslado').on('submit', function (e) {
                e.preventDefault();
                if (this.checkValidity()) {
                    saveTraslado();
                } else {
                    $(this).addClass('was-validated');
                }
            });

            // Low Stock button click
            $('#btnLowStock').on('click', function () {
                showLowStockItems();
            });
        });

        function getAntiForgeryToken() {
            return $('input[name="__RequestVerificationToken"]').val();
        }

        function loadDataTable() {
            table = $('#tableInventario').DataTable({
                ajax: {
                    url: '?handler=Data',
                    type: 'GET',
                    headers: {
                        "RequestVerificationToken": getAntiForgeryToken()
                    },
                    dataSrc: function(json) {
                        // Hide loader
                        $('#tableInventarioLoader').hide();

                        // Get data array
                        const data = json.data || json || [];

                        // Update badge count
                        $('#badgeTotalInventario').text(data.length);

                        // Show appropriate state
                        if (data.length > 0) {
                            $('#tableInventarioContainer').show();
                            $('#emptyStateInventario').hide();
                        } else {
                            $('#tableInventarioContainer').hide();
                            $('#emptyStateInventario').show();
                        }

                        return data;
                    },
                    error: function (xhr, error, thrown) {
                        $('#tableInventarioLoader').hide();
                        $('#tableInventarioContainer').hide();
                        $('#emptyStateInventario').show();
                        $('#badgeTotalInventario').text('0');
                        console.error('Error loading data:', error);
                        Swal.fire('Error', 'No se pudo cargar el inventario.', 'error');
                    }
                },
                columns: [
                    {
                        data: 'producto',
                        render: function (data) {
                            return data ? data.nombre : '-';
                        }
                    },
                    {
                        data: 'sucursal',
                        render: function (data) {
                            return data ? data.nombre : '-';
                        }
                    },
                    {
                        data: 'cantidadActual',
                        render: function (data) {
                            return parseFloat(data).toFixed(2);
                        }
                    },
                    {
                        data: 'cantidadReservada',
                        render: function (data) {
                            return data ? parseFloat(data).toFixed(2) : '0.00';
                        }
                    },
                    {
                        data: null,
                        render: function (data, type, row) {
                            const disponible = row.cantidadActual - (row.cantidadReservada || 0);
                            const stockMinimo = row.producto?.stockMinimo || 0;
                            const isLowStock = disponible <= stockMinimo;
                            const colorClass = isLowStock ? 'text-danger fw-bold' : '';
                            return `<span class="${colorClass}">${disponible.toFixed(2)}</span>`;
                        }
                    },
                    {
                        data: 'ultimaActualizacion',
                        render: function (data) {
                            return new Date(data).toLocaleString('es-CR');
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        render: function (data, type, row) {
                            return `
                                <button class="btn btn-sm btn-info" onclick="viewDetails('${row.id}')" title="Ver Detalles">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button class="btn btn-sm btn-warning" onclick="openAjusteModal('${row.id}')" title="Ajuste">
                                    <i class="fas fa-sliders-h"></i>
                                </button>
                                <button class="btn btn-sm btn-success" onclick="openTrasladoModal('${row.id}')" title="Traslado">
                                    <i class="fas fa-exchange-alt"></i>
                                </button>
                                <button class="btn btn-sm btn-danger" onclick="deleteInventario('${row.id}', '${row.producto.nombre}', '${row.sucursal.nombre}')" title="Eliminar">
                                    <i class="fas fa-trash"></i>
                                </button>
                            `;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json'
                },
                pageLength: 25,
                order: [[0, 'asc']] // Order by Producto
            });
        }

        function loadProductos() {
            return $.ajax({
                url: '?handler=Productos',
                type: 'GET',
                headers: {
                    "RequestVerificationToken": getAntiForgeryToken()
                },
                success: function (response) {
                    // Handle different response formats
                    const data = response.data || response.result || response || [];

                    if (Array.isArray(data)) {
                        // Filter only products with ControlarInventario = true and Activo = true
                        productos = data.filter(p =>
                            (p.controlarInventario === true || p.ControlarInventario === true) &&
                            (p.activo === true || p.Activo === true)
                        );

                        const select = $('#Inventario_ProductoId');
                        select.empty().append('<option value="">Seleccione...</option>');
                        productos.forEach(function (item) {
                            const codigo = item.codigo || item.Codigo || '';
                            const nombre = item.nombre || item.Nombre || '';
                            select.append(`<option value="${item.id || item.Id}">${codigo} - ${nombre}</option>`);
                        });
                    }
                },
                error: function (xhr) {
                    console.error('Error loading productos:', xhr);
                }
            });
        }

        function loadSucursales() {
            return $.ajax({
                url: '?handler=Sucursales',
                type: 'GET',
                headers: {
                    "RequestVerificationToken": getAntiForgeryToken()
                },
                success: function (response) {
                    // Handle different response formats
                    const data = response.data || response.result || response || [];

                    if (Array.isArray(data)) {
                        sucursales = data.filter(s => s.activo === true || s.Activo === true);
                        const select = $('#Inventario_SucursalId');
                        select.empty().append('<option value="">Seleccione...</option>');
                        sucursales.forEach(function (item) {
                            const nombre = item.nombre || item.Nombre || '';
                            select.append(`<option value="${item.id || item.Id}">${nombre}</option>`);
                        });
                    }
                },
                error: function (xhr) {
                    console.error('Error loading sucursales:', xhr);
                }
            });
        }

        function checkLowStock() {
            $.ajax({
                url: '?handler=LowStock',
                type: 'GET',
                headers: {
                    "RequestVerificationToken": getAntiForgeryToken()
                },
                success: function (response) {
                    if (response.success && response.data && response.data.length > 0) {
                        $('#badgeLowStock').text(response.data.length);
                        $('#btnLowStock').show();
                    } else {
                        $('#btnLowStock').hide();
                    }
                },
                error: function () {
                    $('#btnLowStock').hide();
                }
            });
        }

        function showLowStockItems() {
            $.ajax({
                url: '?handler=LowStock',
                type: 'GET',
                headers: {
                    "RequestVerificationToken": getAntiForgeryToken()
                },
                success: function (response) {
                    if (response.success && response.data && response.data.length > 0) {
                        let html = '<div class="table-responsive"><table class="table table-sm table-striped"><thead><tr><th>Producto</th><th>Sucursal</th><th>Disponible</th><th>Stock Mínimo</th></tr></thead><tbody>';
                        response.data.forEach(function (item) {
                            const disponible = item.cantidadActual - (item.cantidadReservada || 0);
                            html += `<tr>
                                <td>${item.producto.nombre}</td>
                                <td>${item.sucursal.nombre}</td>
                                <td class="text-danger fw-bold">${disponible.toFixed(2)}</td>
                                <td>${item.producto.stockMinimo ? item.producto.stockMinimo.toFixed(2) : '0.00'}</td>
                            </tr>`;
                        });
                        html += '</tbody></table></div>';

                        Swal.fire({
                            title: 'Productos con Bajo Stock',
                            html: html,
                            icon: 'warning',
                            width: '800px',
                            confirmButtonText: 'Cerrar'
                        });
                    } else {
                        Swal.fire('Información', 'No hay productos con bajo stock.', 'info');
                    }
                },
                error: function () {
                    Swal.fire('Error', 'No se pudo cargar la información de bajo stock.', 'error');
                }
            });
        }

        function openCreateModal() {
            $('#formInventario')[0].reset();
            $('#formInventario').removeClass('was-validated');

            // Load dropdowns
            $.when(
                loadProductos(),
                loadSucursales()
            ).done(function () {
                $('#modalInventario').modal('show');
            });
        }

        function viewDetails(id) {
            $.ajax({
                url: '?handler=Details&id=' + id,
                type: 'GET',
                headers: {
                    "RequestVerificationToken": getAntiForgeryToken()
                },
                success: function (response) {
                    if (response.success && response.data) {
                        const data = response.data;
                        const disponible = data.cantidadActual - (data.cantidadReservada || 0);
                        const stockMinimo = data.producto?.stockMinimo || 0;
                        const isLowStock = disponible <= stockMinimo;

                        let html = `
                            <div class="row">
                                <div class="col-md-6">
                                    <h6 class="text-primary"><i class="fas fa-box"></i> Producto</h6>
                                    <p><strong>Código:</strong> ${data.producto.codigo}</p>
                                    <p><strong>Nombre:</strong> ${data.producto.nombre}</p>
                                    ${data.producto.descripcion ? `<p><strong>Descripción:</strong> ${data.producto.descripcion}</p>` : ''}
                                </div>
                                <div class="col-md-6">
                                    <h6 class="text-primary"><i class="fas fa-building"></i> Sucursal</h6>
                                    <p><strong>Nombre:</strong> ${data.sucursal.nombre}</p>
                                    <p><strong>Dirección:</strong> ${data.sucursal.direccion || 'No especificado'}</p>
                                </div>
                            </div>
                            <hr />
                            <div class="row">
                                <div class="col-md-12">
                                    <h6 class="text-primary"><i class="fas fa-warehouse"></i> Stock</h6>
                                    <p><strong>Cantidad Actual:</strong> ${data.cantidadActual.toFixed(2)}</p>
                                    <p><strong>Cantidad Reservada:</strong> ${(data.cantidadReservada || 0).toFixed(2)}</p>
                                    <p><strong>Cantidad Disponible:</strong> <span class="${isLowStock ? 'text-danger fw-bold' : ''}">${disponible.toFixed(2)}</span></p>
                                    <p><strong>Stock Mínimo:</strong> ${stockMinimo.toFixed(2)}</p>
                                    ${isLowStock ? '<div class="alert alert-danger"><i class="fas fa-exclamation-triangle"></i> Este inventario está por debajo del stock mínimo.</div>' : ''}
                                </div>
                            </div>
                            <hr />
                            <div class="row">
                                <div class="col-md-12">
                                    <p><strong>Última Actualización:</strong> ${new Date(data.ultimaActualizacion).toLocaleString('es-CR')}</p>
                                    <p><strong>Fecha de Creación:</strong> ${new Date(data.fechaCreacion).toLocaleString('es-CR')}</p>
                                </div>
                            </div>
                        `;

                        $('#detailsContent').html(html);
                        $('#modalDetails').modal('show');
                    } else {
                        Swal.fire('Error', response.message || 'No se pudo cargar la información del inventario.', 'error');
                    }
                },
                error: function () {
                    Swal.fire('Error', 'No se pudo cargar la información del inventario.', 'error');
                }
            });
        }

        function openAjusteModal(id) {
            $.ajax({
                url: '?handler=Details&id=' + id,
                type: 'GET',
                headers: {
                    "RequestVerificationToken": getAntiForgeryToken()
                },
                success: function (response) {
                    if (response.success && response.data) {
                        const data = response.data;
                        currentInventarioData = data;
                        $('#formAjuste')[0].reset();
                        $('#formAjuste').removeClass('was-validated');

                        $('#Ajuste_InventarioId').val(data.id);
                        $('#Ajuste_ProductoNombre').text(data.producto.nombre);
                        $('#Ajuste_SucursalNombre').text(data.sucursal.nombre);
                        $('#Ajuste_CantidadActual').text(data.cantidadActual.toFixed(2));

                        $('#modalAjuste').modal('show');
                    } else {
                        Swal.fire('Error', response.message || 'No se pudo cargar la información del inventario.', 'error');
                    }
                },
                error: function () {
                    Swal.fire('Error', 'No se pudo cargar la información del inventario.', 'error');
                }
            });
        }

        function openTrasladoModal(id) {
            $.ajax({
                url: '?handler=Details&id=' + id,
                type: 'GET',
                headers: {
                    "RequestVerificationToken": getAntiForgeryToken()
                },
                success: function (response) {
                    if (response.success && response.data) {
                        const data = response.data;
                        currentInventarioData = data;
                        $('#formTraslado')[0].reset();
                        $('#formTraslado').removeClass('was-validated');

                        const disponible = data.cantidadActual - (data.cantidadReservada || 0);

                        $('#Traslado_InventarioId').val(data.id);
                        $('#Traslado_SucursalOrigenId').val(data.sucursalId);
                        $('#Traslado_ProductoId').val(data.productoId);
                        $('#Traslado_ProductoNombre').text(data.producto.nombre);
                        $('#Traslado_SucursalOrigen').text(data.sucursal.nombre);
                        $('#Traslado_CantidadDisponible').text(disponible.toFixed(2));

                        // Set max value for quantity
                        $('#Traslado_Cantidad').attr('max', disponible);

                        // Load sucursales excluding current one
                        loadSucursalesForTraslado(data.sucursalId);

                        $('#modalTraslado').modal('show');
                    } else {
                        Swal.fire('Error', response.message || 'No se pudo cargar la información del inventario.', 'error');
                    }
                },
                error: function () {
                    Swal.fire('Error', 'No se pudo cargar la información del inventario.', 'error');
                }
            });
        }

        function loadSucursalesForTraslado(excludeSucursalId) {
            $.ajax({
                url: '?handler=Sucursales',
                type: 'GET',
                headers: {
                    "RequestVerificationToken": getAntiForgeryToken()
                },
                success: function (response) {
                    if (response.success && response.data) {
                        const select = $('#Traslado_SucursalDestinoId');
                        select.empty().append('<option value="">Seleccione...</option>');
                        response.data.filter(s => s.activo === true && s.id !== excludeSucursalId).forEach(function (item) {
                            select.append(`<option value="${item.id}">${item.nombre}</option>`);
                        });
                    }
                },
                error: function (xhr) {
                    console.error('Error loading sucursales:', xhr);
                }
            });
        }

        function saveInventario() {
            const inventario = {
                id: '00000000-0000-0000-0000-000000000000',
                productoId: $('#Inventario_ProductoId').val(),
                sucursalId: $('#Inventario_SucursalId').val(),
                cantidadActual: parseFloat($('#Inventario_CantidadInicial').val()) || 0
            };

            $.ajax({
                url: '?handler=Save',
                type: 'POST',
                contentType: 'application/json',
                headers: {
                    "RequestVerificationToken": getAntiForgeryToken()
                },
                data: JSON.stringify(inventario),
                success: function (response) {
                    if (response.success) {
                        Swal.fire('Éxito', response.message || 'Inventario creado correctamente.', 'success');
                        $('#modalInventario').modal('hide');
                        table.ajax.reload();
                        checkLowStock();
                    } else {
                        Swal.fire('Error', response.message || 'Ocurrió un error al crear el inventario.', 'error');
                    }
                },
                error: function (xhr) {
                    const message = xhr.responseJSON?.message || xhr.responseText || 'Ocurrió un error al crear el inventario.';
                    Swal.fire('Error', message, 'error');
                }
            });
        }

        function saveAjuste() {
            const cantidad = parseFloat($('#Ajuste_Cantidad').val());
            const cantidadActual = currentInventarioData.cantidadActual;

            // Validate that the result won't be negative
            if (cantidadActual + cantidad < 0) {
                Swal.fire('Error', 'El ajuste no puede resultar en stock negativo.', 'error');
                return;
            }

            const ajuste = {
                cantidad: cantidad,
                referencia: $('#Ajuste_Referencia').val() || null,
                observaciones: $('#Ajuste_Observaciones').val() || null
            };

            const id = $('#Ajuste_InventarioId').val();

            $.ajax({
                url: '?handler=Ajuste&id=' + id,
                type: 'POST',
                contentType: 'application/json',
                headers: {
                    "RequestVerificationToken": getAntiForgeryToken()
                },
                data: JSON.stringify(ajuste),
                success: function (response) {
                    if (response.success) {
                        Swal.fire('Éxito', response.message || 'Ajuste realizado correctamente.', 'success');
                        $('#modalAjuste').modal('hide');
                        table.ajax.reload();
                        checkLowStock();
                    } else {
                        Swal.fire('Error', response.message || 'Ocurrió un error al realizar el ajuste.', 'error');
                    }
                },
                error: function (xhr) {
                    const message = xhr.responseJSON?.message || xhr.responseText || 'Ocurrió un error al realizar el ajuste.';
                    Swal.fire('Error', message, 'error');
                }
            });
        }

        function saveTraslado() {
            const cantidad = parseFloat($('#Traslado_Cantidad').val());
            const disponible = currentInventarioData.cantidadActual - (currentInventarioData.cantidadReservada || 0);

            // Validate quantity
            if (cantidad <= 0) {
                Swal.fire('Error', 'La cantidad debe ser mayor a 0.', 'error');
                return;
            }

            if (cantidad > disponible) {
                Swal.fire('Error', 'La cantidad no puede exceder la cantidad disponible.', 'error');
                return;
            }

            const traslado = {
                sucursalDestinoId: $('#Traslado_SucursalDestinoId').val(),
                cantidad: cantidad,
                referencia: $('#Traslado_Referencia').val() || null,
                observaciones: $('#Traslado_Observaciones').val() || null
            };

            const id = $('#Traslado_InventarioId').val();

            $.ajax({
                url: '?handler=Traslado&id=' + id,
                type: 'POST',
                contentType: 'application/json',
                headers: {
                    "RequestVerificationToken": getAntiForgeryToken()
                },
                data: JSON.stringify(traslado),
                success: function (response) {
                    if (response.success) {
                        Swal.fire('Éxito', response.message || 'Traslado realizado correctamente.', 'success');
                        $('#modalTraslado').modal('hide');
                        table.ajax.reload();
                        checkLowStock();
                    } else {
                        Swal.fire('Error', response.message || 'Ocurrió un error al realizar el traslado.', 'error');
                    }
                },
                error: function (xhr) {
                    const message = xhr.responseJSON?.message || xhr.responseText || 'Ocurrió un error al realizar el traslado.';
                    Swal.fire('Error', message, 'error');
                }
            });
        }

        function deleteInventario(id, productoNombre, sucursalNombre) {
            Swal.fire({
                title: '¿Está seguro?',
                text: `¿Desea eliminar el inventario de "${productoNombre}" en "${sucursalNombre}"?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '?handler=Delete&id=' + id,
                        type: 'POST',
                        headers: {
                            "RequestVerificationToken": getAntiForgeryToken()
                        },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire('Eliminado', response.message || 'Inventario eliminado correctamente.', 'success');
                                table.ajax.reload();
                                checkLowStock();
                            } else {
                                Swal.fire('Error', response.message || 'Ocurrió un error al eliminar el inventario.', 'error');
                            }
                        },
                        error: function (xhr) {
                            const message = xhr.responseJSON?.message || xhr.responseText || 'Ocurrió un error al eliminar el inventario.';
                            Swal.fire('Error', message, 'error');
                        }
                    });
                }
            });
        }

        function refrescarTabla() {
            $('#tableInventarioLoader').show();
            $('#tableInventarioContainer').hide();
            $('#emptyStateInventario').hide();
            table.ajax.reload();
        }

        function exportarExcel() {
            showWarning('Función de exportación en desarrollo');
        }

        function descargarPlantilla() {
            window.location.href = '?handler=Plantilla';
        }

        function importarExcel(input) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                const formData = new FormData();
                formData.append('file', file);

                Swal.fire({
                    title: 'Importando...',
                    html: 'Por favor espere mientras se procesan los datos.',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                $.ajax({
                    url: '?handler=Importar',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    headers: {
                        "RequestVerificationToken": getAntiForgeryToken()
                    },
                    success: function(response) {
                        Swal.close();
                        if (response.success) {
                            let message = response.message;
                            if (response.totalImportados > 0) {
                                message += `<br><br><strong>Importados:</strong> ${response.totalImportados}`;
                            }
                            if (response.totalErrores > 0) {
                                message += `<br><strong>Errores:</strong> ${response.totalErrores}`;
                                if (response.errores && response.errores.length > 0) {
                                    message += '<br><br><strong>Detalle de errores:</strong><ul class="text-start small">';
                                    response.errores.slice(0, 10).forEach(function(err) {
                                        message += `<li>${err}</li>`;
                                    });
                                    if (response.errores.length > 10) {
                                        message += `<li>... y ${response.errores.length - 10} errores más</li>`;
                                    }
                                    message += '</ul>';
                                }
                            }
                            Swal.fire({
                                icon: response.totalErrores > 0 ? 'warning' : 'success',
                                title: response.totalErrores > 0 ? 'Importación con advertencias' : 'Importación exitosa',
                                html: message
                            });
                            table.ajax.reload();
                            checkLowStock();
                        } else {
                            Swal.fire('Error', response.message || 'Error al importar los datos', 'error');
                        }
                    },
                    error: function(xhr) {
                        Swal.close();
                        const message = xhr.responseJSON?.message || xhr.responseText || 'Ocurrió un error al importar el inventario.';
                        Swal.fire('Error', message, 'error');
                    },
                    complete: function() {
                        input.value = '';
                    }
                });
            }
        }
    </script>
}
