@page
@model Facturacion.Frontend.Pages.Stock.AjustesInventarioModel
@{
    ViewData["Title"] = "Ajustes de Inventario";
    ViewData["Breadcrumb"] = "Ajustes de Inventario";
}

@Html.AntiForgeryToken()

<!-- Page Header -->
<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <h2><i class="fas fa-sliders-h"></i> Ajustes de Inventario</h2>
            <p class="mb-0">Gestión de ajustes de inventario por bodega</p>
        </div>
        <div>
            <button class="btn btn-primary" onclick="openCreateModal()" aria-label="Crear nuevo ajuste">
                <i class="fas fa-plus me-2"></i>Nuevo Ajuste
            </button>
        </div>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card shadow-custom border-start border-primary border-4">
            <div class="card-body py-3">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="stat-icon bg-primary bg-opacity-10 text-primary rounded-circle p-3">
                            <i class="fas fa-list fa-lg"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Total Ajustes</h6>
                        <h3 id="statTotal" class="mb-0">0</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-custom border-start border-warning border-4">
            <div class="card-body py-3">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="stat-icon bg-warning bg-opacity-10 text-warning rounded-circle p-3">
                            <i class="fas fa-clock fa-lg"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Pendientes</h6>
                        <h3 id="statPendientes" class="text-warning mb-0">0</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-custom border-start border-success border-4">
            <div class="card-body py-3">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="stat-icon bg-success bg-opacity-10 text-success rounded-circle p-3">
                            <i class="fas fa-check-circle fa-lg"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Aprobados</h6>
                        <h3 id="statAprobados" class="text-success mb-0">0</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-custom border-start border-danger border-4">
            <div class="card-body py-3">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="stat-icon bg-danger bg-opacity-10 text-danger rounded-circle p-3">
                            <i class="fas fa-ban fa-lg"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Anulados</h6>
                        <h3 id="statAnulados" class="text-danger mb-0">0</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Ajustes Table Card -->
<div class="card shadow-custom">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <i class="fas fa-table me-2 text-primary"></i>
            <strong>Listado de Ajustes de Inventario</strong>
            <span class="badge bg-secondary ms-2" id="badgeTotalAjustes">0</span>
        </div>
        <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="btn btn-outline-primary" onclick="refrescarTabla()" title="Refrescar tabla">
                <i class="fas fa-sync-alt"></i>
            </button>
        </div>
    </div>
    <div class="card-body">
        <!-- Loading State -->
        <div id="tableAjustesLoader" class="text-center py-5">
            <div class="spinner-modern mx-auto"></div>
            <p class="text-muted mt-3">Cargando ajustes...</p>
        </div>

        <!-- Table -->
        <div class="table-responsive" id="tableAjustesContainer" style="display:none;">
            <table id="tableAjustes" class="table table-hover">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Número</th>
                        <th>Tipo</th>
                        <th>Bodega</th>
                        <th>Observación</th>
                        <th>Estado</th>
                        <th>Items</th>
                        <th style="width: 200px;">Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <!-- Empty State -->
        <div id="emptyStateAjustes" class="empty-state" style="display:none;">
            <div class="empty-state-icon">
                <i class="fas fa-sliders-h"></i>
            </div>
            <h3 class="empty-state-title">No hay ajustes registrados</h3>
            <p class="empty-state-description">Comienza creando un ajuste de inventario</p>
            <button class="btn btn-primary" onclick="openCreateModal()">
                <i class="fas fa-plus me-2"></i>Crear Primer Ajuste
            </button>
        </div>
    </div>
</div>

<!-- Modal for Create/Edit Ajuste -->
<div class="modal fade" id="modalAjuste" tabindex="-1" aria-labelledby="modalAjusteLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalAjusteLabel">
                    <i class="fas fa-sliders-h"></i> <span id="modalAjusteTitulo">Nuevo Ajuste de Inventario</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formAjuste">
                <div class="modal-body">
                    <input type="hidden" id="Ajuste_Id" value="00000000-0000-0000-0000-000000000000" />

                    <!-- Header Information -->
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label for="Ajuste_Fecha" class="form-label">Fecha <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="Ajuste_Fecha" required />
                            <div class="invalid-feedback">La fecha es obligatoria.</div>
                        </div>
                        <div class="col-md-3">
                            <label for="Ajuste_BodegaId" class="form-label">Bodega <span class="text-danger">*</span></label>
                            <select class="form-select" id="Ajuste_BodegaId" required>
                                <option value="">Seleccione...</option>
                            </select>
                            <div class="invalid-feedback">Seleccione una bodega.</div>
                        </div>
                        <div class="col-md-3">
                            <label for="Ajuste_TipoAjuste" class="form-label">Tipo de Ajuste <span class="text-danger">*</span></label>
                            <select class="form-select" id="Ajuste_TipoAjuste" required>
                                <option value="">Seleccione...</option>
                                <option value="POS">Ajuste Positivo</option>
                                <option value="NEG">Ajuste Negativo</option>
                                <option value="CON">Conteo Físico</option>
                            </select>
                            <div class="invalid-feedback">Seleccione el tipo de ajuste.</div>
                        </div>
                        <div class="col-md-3">
                            <label for="Ajuste_Numero" class="form-label">Número</label>
                            <input type="text" class="form-control" id="Ajuste_Numero" readonly placeholder="Auto-generado" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="Ajuste_Motivo" class="form-label">Motivo</label>
                            <input type="text" class="form-control" id="Ajuste_Motivo" maxlength="200" />
                        </div>
                        <div class="col-md-6">
                            <label for="Ajuste_Observaciones" class="form-label">Observaciones</label>
                            <textarea class="form-control" id="Ajuste_Observaciones" rows="2" maxlength="500"></textarea>
                        </div>
                    </div>

                    <hr />

                    <!-- Product Lines Section -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="mb-0"><i class="fas fa-boxes me-2"></i>Productos</h6>
                        <button type="button" class="btn btn-sm btn-success" onclick="agregarLineaProducto()" id="btnAgregarLinea">
                            <i class="fas fa-plus me-1"></i>Agregar Producto
                        </button>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-sm table-bordered" id="tableDetalles">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 35%;">Producto</th>
                                    <th style="width: 15%;">Cant. Sistema</th>
                                    <th style="width: 15%;">Cant. Física</th>
                                    <th style="width: 10%;">Diferencia</th>
                                    <th style="width: 15%;">Costo Unit.</th>
                                    <th style="width: 5%;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="detallesBody">
                                <!-- Dynamic rows will be added here -->
                            </tbody>
                        </table>
                    </div>

                    <div id="emptyDetalles" class="alert alert-info" style="display:none;">
                        <i class="fas fa-info-circle me-2"></i>Agregue al menos un producto al ajuste.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary" id="btnGuardarAjuste">
                        <i class="fas fa-save"></i> Guardar Borrador
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal for View Details -->
<div class="modal fade" id="modalDetalles" tabindex="-1" aria-labelledby="modalDetallesLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="modalDetallesLabel">
                    <i class="fas fa-info-circle"></i> Detalles del Ajuste
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="detallesContent">
                <!-- Content will be loaded dynamically -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;
        let productos = [];
        let bodegas = [];
        let detalleCounter = 0;
        let currentAjusteId = null;

        $(document).ready(function () {
            // Set today's date as default
            const today = new Date().toISOString().split('T')[0];
            $('#Ajuste_Fecha').val(today);

            loadDataTable();
            setupFormSubmit();
        });

        function getAntiForgeryToken() {
            return $('input[name="__RequestVerificationToken"]').val();
        }

        function loadDataTable() {
            table = $('#tableAjustes').DataTable({
                ajax: {
                    url: '?handler=Data',
                    type: 'GET',
                    headers: {
                        "RequestVerificationToken": getAntiForgeryToken()
                    },
                    dataSrc: function(json) {
                        $('#tableAjustesLoader').hide();
                        const data = json.data || json || [];
                        $('#badgeTotalAjustes').text(data.length);
                        updateStatistics(data);

                        if (data.length > 0) {
                            $('#tableAjustesContainer').show();
                            $('#emptyStateAjustes').hide();
                        } else {
                            $('#tableAjustesContainer').hide();
                            $('#emptyStateAjustes').show();
                        }
                        return data;
                    },
                    error: function (xhr, error, thrown) {
                        $('#tableAjustesLoader').hide();
                        $('#tableAjustesContainer').hide();
                        $('#emptyStateAjustes').show();
                        $('#badgeTotalAjustes').text('0');
                        console.error('Error loading data:', error);
                        Swal.fire('Error', 'No se pudo cargar los ajustes.', 'error');
                    }
                },
                columns: [
                    {
                        data: 'fecha',
                        render: function (data) {
                            return formatDate(data);
                        }
                    },
                    { data: 'numero' },
                    {
                        data: 'tipoAjuste',
                        render: function (data) {
                            return getTipoAjusteBadge(data);
                        }
                    },
                    {
                        data: 'bodega',
                        render: function (data) {
                            return data ? data.nombre : '-';
                        }
                    },
                    {
                        data: 'observaciones',
                        render: function (data) {
                            if (!data) return '<span class="text-muted">-</span>';
                            return data.length > 50 ? data.substring(0, 50) + '...' : data;
                        }
                    },
                    {
                        data: 'estado',
                        render: function (data) {
                            return getEstadoBadge(data);
                        }
                    },
                    {
                        data: 'detalles',
                        render: function (data) {
                            const count = data ? data.length : 0;
                            return `<span class="badge bg-secondary">${count}</span>`;
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        render: function (data, type, row) {
                            const isPendiente = row.estado === 'PEN';
                            let actions = `
                                <button class="btn btn-sm btn-info" onclick="viewDetails('${row.id}')" title="Ver Detalles">
                                    <i class="fas fa-eye"></i>
                                </button>
                            `;

                            if (isPendiente) {
                                actions += `
                                    <button class="btn btn-sm btn-success" onclick="aplicarAjuste('${row.id}')" title="Aplicar Ajuste">
                                        <i class="fas fa-check"></i>
                                    </button>
                                    <button class="btn btn-sm btn-danger" onclick="deleteAjuste('${row.id}', '${row.numero}')" title="Eliminar">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                `;
                            }

                            return actions;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json'
                },
                pageLength: 25,
                order: [[0, 'desc']]
            });
        }

        function setupFormSubmit() {
            $('#formAjuste').on('submit', function (e) {
                e.preventDefault();
                if (this.checkValidity()) {
                    saveAjuste();
                } else {
                    $(this).addClass('was-validated');
                }
            });

            // Al cambiar bodega, actualizar cant sistema de todos los productos
            $('#Ajuste_BodegaId').on('change', function() {
                $('#detallesBody .detalle-producto').each(function() {
                    if ($(this).val()) {
                        actualizarCantSistema($(this));
                    }
                });
            });

            // Al seleccionar producto, consultar stock en bodega
            $(document).on('change', '.detalle-producto', function() {
                actualizarCantSistema($(this));
            });
        }

        function actualizarCantSistema(selectElement) {
            const productoId = selectElement.val();
            const bodegaId = $('#Ajuste_BodegaId').val();
            const index = selectElement.data('index');
            const cantSistemaInput = $(`.detalle-cant-sistema[data-index="${index}"]`);

            if (!productoId || !bodegaId) {
                cantSistemaInput.val(0);
                calcularDiferencia(index);
                return;
            }

            $.ajax({
                url: `?handler=Stock&productoId=${productoId}&bodegaId=${bodegaId}`,
                type: 'GET',
                headers: {
                    "RequestVerificationToken": getAntiForgeryToken()
                },
                success: function(response) {
                    const stock = response.stock || 0;
                    cantSistemaInput.val(parseFloat(stock).toFixed(4));
                    calcularDiferencia(index);
                },
                error: function() {
                    cantSistemaInput.val(0);
                    calcularDiferencia(index);
                }
            });
        }

        function loadProductos() {
            return $.ajax({
                url: '?handler=Productos',
                type: 'GET',
                headers: {
                    "RequestVerificationToken": getAntiForgeryToken()
                },
                success: function (response) {
                    const data = response.data || response.result || response || [];
                    if (Array.isArray(data)) {
                        productos = data.filter(p =>
                            (p.controlarInventario === true || p.ControlarInventario === true) &&
                            (p.activo === true || p.Activo === true)
                        );
                    }
                },
                error: function (xhr) {
                    console.error('Error loading productos:', xhr);
                }
            });
        }

        function loadBodegas() {
            return $.ajax({
                url: '?handler=Bodegas',
                type: 'GET',
                headers: {
                    "RequestVerificationToken": getAntiForgeryToken()
                },
                success: function (response) {
                    const data = response.data || response.result || response || [];
                    if (Array.isArray(data)) {
                        bodegas = data.filter(b => b.activo === true || b.Activo === true);
                        const select = $('#Ajuste_BodegaId');
                        select.empty().append('<option value="">Seleccione...</option>');
                        bodegas.forEach(function (item) {
                            const nombre = item.nombre || item.Nombre || '';
                            select.append(`<option value="${item.id || item.Id}">${nombre}</option>`);
                        });
                    }
                },
                error: function (xhr) {
                    console.error('Error loading bodegas:', xhr);
                }
            });
        }

        function openCreateModal() {
            $('#formAjuste')[0].reset();
            $('#formAjuste').removeClass('was-validated');
            $('#Ajuste_Id').val('00000000-0000-0000-0000-000000000000');
            $('#modalAjusteTitulo').text('Nuevo Ajuste de Inventario');

            const today = new Date().toISOString().split('T')[0];
            $('#Ajuste_Fecha').val(today);

            // Clear details
            detalleCounter = 0;
            $('#detallesBody').empty();
            $('#emptyDetalles').show();

            $.when(loadProductos(), loadBodegas()).done(function () {
                $('#modalAjuste').modal('show');
            });
        }

        function agregarLineaProducto() {
            if (productos.length === 0) {
                Swal.fire('Error', 'No hay productos disponibles.', 'error');
                return;
            }

            detalleCounter++;
            const rowId = `detalle_${detalleCounter}`;

            let productosOptions = '<option value="">Seleccione producto...</option>';
            productos.forEach(p => {
                const codigo = p.codigo || p.Codigo || '';
                const nombre = p.nombre || p.Nombre || '';
                productosOptions += `<option value="${p.id || p.Id}">${codigo} - ${nombre}</option>`;
            });

            const row = `
                <tr id="${rowId}" data-index="${detalleCounter}">
                    <td>
                        <select class="form-select form-select-sm detalle-producto" data-index="${detalleCounter}" required>
                            ${productosOptions}
                        </select>
                    </td>
                    <td>
                        <input type="number" class="form-control form-control-sm text-end detalle-cant-sistema"
                               data-index="${detalleCounter}" step="0.0001" readonly value="0" />
                    </td>
                    <td>
                        <input type="number" class="form-control form-control-sm text-end detalle-cant-fisica"
                               data-index="${detalleCounter}" step="0.0001" min="0" required value="0" />
                    </td>
                    <td>
                        <input type="number" class="form-control form-control-sm text-end detalle-diferencia"
                               data-index="${detalleCounter}" step="0.0001" readonly value="0" />
                    </td>
                    <td>
                        <input type="number" class="form-control form-control-sm text-end detalle-costo"
                               data-index="${detalleCounter}" step="0.000001" min="0" required value="0" />
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-danger" onclick="eliminarLineaProducto('${rowId}')">
                            <i class="fas fa-trash"></i>
                        </button>
                    </td>
                </tr>
            `;

            $('#detallesBody').append(row);
            $('#emptyDetalles').hide();

            // Bind events
            $(`#${rowId} .detalle-cant-fisica`).on('input', function() {
                calcularDiferencia(detalleCounter);
            });
        }

        function eliminarLineaProducto(rowId) {
            $(`#${rowId}`).remove();
            if ($('#detallesBody tr').length === 0) {
                $('#emptyDetalles').show();
            }
        }

        function calcularDiferencia(index) {
            const cantSistema = parseFloat($(`.detalle-cant-sistema[data-index="${index}"]`).val()) || 0;
            const cantFisica = parseFloat($(`.detalle-cant-fisica[data-index="${index}"]`).val()) || 0;
            const diferencia = cantFisica - cantSistema;
            $(`.detalle-diferencia[data-index="${index}"]`).val(diferencia.toFixed(4));
        }

        function saveAjuste() {
            // Validate at least one detail
            if ($('#detallesBody tr').length === 0) {
                Swal.fire('Error', 'Debe agregar al menos un producto.', 'error');
                return;
            }

            // Collect details
            const detalles = [];
            $('#detallesBody tr').each(function() {
                const index = $(this).data('index');
                const productoId = $(`.detalle-producto[data-index="${index}"]`).val();

                if (!productoId) {
                    return; // Skip empty rows
                }

                detalles.push({
                    id: '00000000-0000-0000-0000-000000000000',
                    productoId: productoId,
                    cantidadSistema: parseFloat($(`.detalle-cant-sistema[data-index="${index}"]`).val()) || 0,
                    cantidadFisica: parseFloat($(`.detalle-cant-fisica[data-index="${index}"]`).val()) || 0,
                    diferencia: parseFloat($(`.detalle-diferencia[data-index="${index}"]`).val()) || 0,
                    costoUnitario: parseFloat($(`.detalle-costo[data-index="${index}"]`).val()) || 0
                });
            });

            if (detalles.length === 0) {
                Swal.fire('Error', 'Debe completar la información de al menos un producto.', 'error');
                return;
            }

            const ajuste = {
                id: $('#Ajuste_Id').val(),
                fecha: $('#Ajuste_Fecha').val(),
                bodegaId: $('#Ajuste_BodegaId').val(),
                tipoAjuste: $('#Ajuste_TipoAjuste').val(),
                motivo: $('#Ajuste_Motivo').val() || null,
                observaciones: $('#Ajuste_Observaciones').val() || null,
                detalles: detalles
            };

            $.ajax({
                url: '?handler=Save',
                type: 'POST',
                contentType: 'application/json',
                headers: {
                    "RequestVerificationToken": getAntiForgeryToken()
                },
                data: JSON.stringify(ajuste),
                success: function (response) {
                    if (response.success) {
                        Swal.fire('Éxito', response.message || 'Ajuste guardado correctamente.', 'success');
                        $('#modalAjuste').modal('hide');
                        table.ajax.reload();
                    } else {
                        Swal.fire('Error', response.message || 'Ocurrió un error al guardar el ajuste.', 'error');
                    }
                },
                error: function (xhr) {
                    const message = xhr.responseJSON?.message || xhr.responseText || 'Ocurrió un error al guardar el ajuste.';
                    Swal.fire('Error', message, 'error');
                }
            });
        }

        function viewDetails(id) {
            $.ajax({
                url: '?handler=Details&id=' + id,
                type: 'GET',
                headers: {
                    "RequestVerificationToken": getAntiForgeryToken()
                },
                success: function (response) {
                    if (response.success && response.data) {
                        const ajuste = response.data;

                        let html = `
                            <div class="row mb-3">
                                <div class="col-md-3">
                                    <label class="form-label fw-bold text-muted">Número</label>
                                    <p class="form-control-plaintext">${ajuste.numero}</p>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-bold text-muted">Fecha</label>
                                    <p class="form-control-plaintext">${formatDate(ajuste.fecha)}</p>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-bold text-muted">Tipo</label>
                                    <p class="form-control-plaintext">${getTipoAjusteBadge(ajuste.tipoAjuste)}</p>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-bold text-muted">Estado</label>
                                    <p class="form-control-plaintext">${getEstadoBadge(ajuste.estado)}</p>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-muted">Bodega</label>
                                    <p class="form-control-plaintext">${ajuste.bodega?.nombre || 'N/A'}</p>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-muted">Motivo</label>
                                    <p class="form-control-plaintext">${ajuste.motivo || 'N/A'}</p>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-12">
                                    <label class="form-label fw-bold text-muted">Observaciones</label>
                                    <p class="form-control-plaintext">${ajuste.observaciones || 'Sin observaciones'}</p>
                                </div>
                            </div>

                            <hr />

                            <h6 class="mb-3"><i class="fas fa-boxes me-2"></i>Detalle de Productos</h6>
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Producto</th>
                                            <th class="text-end">Cant. Sistema</th>
                                            <th class="text-end">Cant. Física</th>
                                            <th class="text-end">Diferencia</th>
                                            <th class="text-end">Costo Unit.</th>
                                            <th class="text-end">Valor Dif.</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                        `;

                        if (ajuste.detalles && ajuste.detalles.length > 0) {
                            ajuste.detalles.forEach(det => {
                                const valorDif = det.diferencia * det.costoUnitario;
                                const colorDif = det.diferencia > 0 ? 'text-success' : (det.diferencia < 0 ? 'text-danger' : '');
                                html += `
                                    <tr>
                                        <td>${det.producto?.nombre || 'N/A'}</td>
                                        <td class="text-end">${det.cantidadSistema.toFixed(4)}</td>
                                        <td class="text-end">${det.cantidadFisica.toFixed(4)}</td>
                                        <td class="text-end ${colorDif}"><strong>${det.diferencia.toFixed(4)}</strong></td>
                                        <td class="text-end">₡${det.costoUnitario.toFixed(6)}</td>
                                        <td class="text-end ${colorDif}"><strong>₡${valorDif.toFixed(2)}</strong></td>
                                    </tr>
                                `;
                            });
                        }

                        html += `
                                    </tbody>
                                </table>
                            </div>
                        `;

                        $('#detallesContent').html(html);
                        $('#modalDetalles').modal('show');
                    } else {
                        Swal.fire('Error', response.message || 'No se pudo cargar la información del ajuste.', 'error');
                    }
                },
                error: function () {
                    Swal.fire('Error', 'No se pudo cargar la información del ajuste.', 'error');
                }
            });
        }

        function aplicarAjuste(id) {
            Swal.fire({
                title: '¿Aplicar este ajuste?',
                text: "Esta acción afectará el inventario y no se puede revertir",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#10b981',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Sí, aplicar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '?handler=Aplicar&id=' + id,
                        type: 'POST',
                        headers: {
                            "RequestVerificationToken": getAntiForgeryToken()
                        },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire('Aplicado', response.message || 'Ajuste aplicado correctamente.', 'success');
                                table.ajax.reload();
                            } else {
                                Swal.fire('Error', response.message || 'Ocurrió un error al aplicar el ajuste.', 'error');
                            }
                        },
                        error: function (xhr) {
                            const message = xhr.responseJSON?.message || xhr.responseText || 'Ocurrió un error al aplicar el ajuste.';
                            Swal.fire('Error', message, 'error');
                        }
                    });
                }
            });
        }

        function deleteAjuste(id, numero) {
            Swal.fire({
                title: '¿Está seguro?',
                text: `¿Desea eliminar el ajuste ${numero}?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '?handler=Delete&id=' + id,
                        type: 'POST',
                        headers: {
                            "RequestVerificationToken": getAntiForgeryToken()
                        },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire('Eliminado', response.message || 'Ajuste eliminado correctamente.', 'success');
                                table.ajax.reload();
                            } else {
                                Swal.fire('Error', response.message || 'Ocurrió un error al eliminar el ajuste.', 'error');
                            }
                        },
                        error: function (xhr) {
                            const message = xhr.responseJSON?.message || xhr.responseText || 'Ocurrió un error al eliminar el ajuste.';
                            Swal.fire('Error', message, 'error');
                        }
                    });
                }
            });
        }

        function getTipoAjusteBadge(tipo) {
            const badges = {
                'POS': { text: 'Ajuste Positivo', class: 'bg-success' },
                'NEG': { text: 'Ajuste Negativo', class: 'bg-danger' },
                'CON': { text: 'Conteo Físico', class: 'bg-info' }
            };
            const badge = badges[tipo] || { text: tipo, class: 'bg-secondary' };
            return `<span class="badge ${badge.class}">${badge.text}</span>`;
        }

        function getEstadoBadge(estado) {
            const badges = {
                'PEN': { text: 'Pendiente', class: 'bg-warning' },
                'APR': { text: 'Aprobado', class: 'bg-success' },
                'ANU': { text: 'Anulado', class: 'bg-danger' }
            };
            const badge = badges[estado] || { text: estado, class: 'bg-secondary' };
            return `<span class="badge ${badge.class}">${badge.text}</span>`;
        }

        function updateStatistics(data) {
            if (!data || !Array.isArray(data)) {
                $('#statTotal').text('0');
                $('#statPendientes').text('0');
                $('#statAprobados').text('0');
                $('#statAnulados').text('0');
                return;
            }

            const total = data.length;
            const pendientes = data.filter(a => a.estado === 'PEN').length;
            const aprobados = data.filter(a => a.estado === 'APR').length;
            const anulados = data.filter(a => a.estado === 'ANU').length;

            $('#statTotal').text(total);
            $('#statPendientes').text(pendientes);
            $('#statAprobados').text(aprobados);
            $('#statAnulados').text(anulados);
        }

        function refrescarTabla() {
            $('#tableAjustesLoader').show();
            $('#tableAjustesContainer').hide();
            $('#emptyStateAjustes').hide();
            table.ajax.reload();
        }
    </script>
}
