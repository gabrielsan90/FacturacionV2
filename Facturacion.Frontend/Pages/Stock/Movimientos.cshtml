@page
@model Facturacion.Frontend.Pages.Stock.MovimientosModel
@{
    ViewData["Title"] = "Movimientos de Inventario";
    ViewData["Breadcrumb"] = "Movimientos";
}

@Html.AntiForgeryToken()

<!-- Page Header -->
<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <h2><i class="fas fa-exchange-alt"></i> Movimientos de Inventario</h2>
            <p class="mb-0">Historial de movimientos de entradas y salidas de inventario</p>
        </div>
        <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="btn btn-outline-primary" onclick="exportarExcel()" title="Exportar a Excel">
                <i class="fas fa-file-excel"></i>
            </button>
            <button type="button" class="btn btn-outline-primary" onclick="refrescarTabla()" title="Refrescar">
                <i class="fas fa-sync-alt"></i>
            </button>
        </div>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card shadow-custom border-start border-primary border-4">
            <div class="card-body py-3">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="stat-icon bg-primary bg-opacity-10 text-primary rounded-circle p-3">
                            <i class="fas fa-list fa-lg"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Total Movimientos</h6>
                        <h3 id="statTotalMovimientos" class="mb-0">0</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-custom border-start border-success border-4">
            <div class="card-body py-3">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="stat-icon bg-success bg-opacity-10 text-success rounded-circle p-3">
                            <i class="fas fa-arrow-up fa-lg"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Total Entradas</h6>
                        <h3 id="statTotalEntradas" class="text-success mb-0">0</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-custom border-start border-danger border-4">
            <div class="card-body py-3">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="stat-icon bg-danger bg-opacity-10 text-danger rounded-circle p-3">
                            <i class="fas fa-arrow-down fa-lg"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Total Salidas</h6>
                        <h3 id="statTotalSalidas" class="text-danger mb-0">0</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-custom border-start border-info border-4">
            <div class="card-body py-3">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="stat-icon bg-info bg-opacity-10 text-info rounded-circle p-3">
                            <i class="fas fa-balance-scale fa-lg"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Cantidad Neta</h6>
                        <h3 id="statCantidadNeta" class="mb-0">0</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filter Card -->
<div class="card shadow-custom mb-4">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <i class="fas fa-filter me-2 text-primary"></i>
                <strong>Filtros de Búsqueda</strong>
            </div>
            <button class="btn btn-sm btn-link" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFilters">
                <i class="fas fa-chevron-down"></i>
            </button>
        </div>
    </div>
    <div class="collapse show" id="collapseFilters">
        <div class="card-body">
            <form id="formFiltros">
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label for="filterFechaInicio" class="form-label">Fecha Inicio</label>
                        <input type="date" class="form-control" id="filterFechaInicio" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label for="filterFechaFin" class="form-label">Fecha Fin</label>
                        <input type="date" class="form-control" id="filterFechaFin" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label for="filterTipoMovimiento" class="form-label">Tipo de Movimiento</label>
                        <select class="form-select" id="filterTipoMovimiento">
                            <option value="">Todos</option>
                            <option value="1">Compra</option>
                            <option value="2">Venta</option>
                            <option value="3">Ajuste Entrada</option>
                            <option value="4">Ajuste Salida</option>
                            <option value="5">Traslado Entrada</option>
                            <option value="6">Traslado Salida</option>
                            <option value="7">Devolución Cliente</option>
                            <option value="8">Devolución Proveedor</option>
                            <option value="9">Merma</option>
                        </select>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label for="filterProducto" class="form-label">Producto</label>
                        <select class="form-select" id="filterProducto">
                            <option value="">Todos</option>
                        </select>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label for="filterSucursal" class="form-label">Sucursal</label>
                        <select class="form-select" id="filterSucursal">
                            <option value="">Todas</option>
                        </select>
                    </div>
                    <div class="col-md-9 mb-3 d-flex align-items-end gap-2">
                        <button type="button" class="btn btn-primary" onclick="aplicarFiltros()">
                            <i class="fas fa-search me-1"></i> Filtrar
                        </button>
                        <button type="button" class="btn btn-outline-secondary" onclick="limpiarFiltros()">
                            <i class="fas fa-eraser me-1"></i> Limpiar
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Movimientos Table Card -->
<div class="card shadow-custom">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <i class="fas fa-table me-2 text-primary"></i>
            <strong>Historial de Movimientos</strong>
            <span class="badge bg-secondary ms-2" id="badgeTotalMovimientos">0</span>
        </div>
    </div>
    <div class="card-body">
        <!-- Loading State -->
        <div id="tableMovimientosLoader" class="text-center py-5">
            <div class="spinner-modern mx-auto"></div>
            <p class="text-muted mt-3">Cargando movimientos...</p>
        </div>

        <!-- Table -->
        <div class="table-responsive" id="tableMovimientosContainer" style="display:none;">
            <table id="tableMovimientos" class="table table-hover">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Producto</th>
                        <th>Sucursal</th>
                        <th>Tipo</th>
                        <th>Cantidad</th>
                        <th>Cant. Anterior</th>
                        <th>Cant. Nueva</th>
                        <th>Referencia</th>
                        <th>Usuario</th>
                        <th style="width: 80px;">Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <!-- Empty State -->
        <div id="emptyStateMovimientos" class="empty-state" style="display:none;">
            <div class="empty-state-icon">
                <i class="fas fa-exchange-alt"></i>
            </div>
            <h3 class="empty-state-title">No hay movimientos registrados</h3>
            <p class="empty-state-description">No se encontraron movimientos con los filtros seleccionados</p>
            <button class="btn btn-outline-primary" onclick="limpiarFiltros()">
                <i class="fas fa-eraser me-2"></i>Limpiar Filtros
            </button>
        </div>
    </div>
</div>

<!-- View Details Modal -->
<div class="modal fade" id="modalDetalles" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">
                    <i class="fas fa-info-circle me-2"></i>Detalles del Movimiento
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold text-muted">Fecha y Hora</label>
                        <p id="detFecha" class="form-control-plaintext border-bottom"></p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold text-muted">Tipo de Movimiento</label>
                        <p id="detTipoMovimiento"></p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold text-muted">Producto</label>
                        <p id="detProducto" class="form-control-plaintext border-bottom"></p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold text-muted">Sucursal</label>
                        <p id="detSucursal" class="form-control-plaintext border-bottom"></p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold text-muted">Cantidad Movida</label>
                        <p id="detCantidad" class="form-control-plaintext border-bottom"></p>
                    </div>
                    <div class="col-md-8 mb-3">
                        <label class="form-label fw-bold text-muted">Cambio de Stock</label>
                        <p id="detCambioStock" class="form-control-plaintext"></p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold text-muted">Referencia</label>
                        <p id="detReferencia" class="form-control-plaintext border-bottom"></p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold text-muted">Usuario</label>
                        <p id="detUsuario" class="form-control-plaintext border-bottom"></p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12 mb-3">
                        <label class="form-label fw-bold text-muted">Observaciones</label>
                        <p id="detObservaciones" class="form-control-plaintext border-bottom"></p>
                    </div>
                </div>

                <!-- Optional Fields -->
                <div id="detSucursalOrigen" class="row" style="display:none;">
                    <div class="col-12 mb-3">
                        <label class="form-label fw-bold text-muted">Sucursal Origen</label>
                        <p id="detSucursalOrigenText" class="form-control-plaintext border-bottom"></p>
                    </div>
                </div>

                <div id="detSucursalDestino" class="row" style="display:none;">
                    <div class="col-12 mb-3">
                        <label class="form-label fw-bold text-muted">Sucursal Destino</label>
                        <p id="detSucursalDestinoText" class="form-control-plaintext border-bottom"></p>
                    </div>
                </div>

                <div id="detCliente" class="row" style="display:none;">
                    <div class="col-12 mb-3">
                        <label class="form-label fw-bold text-muted">Cliente</label>
                        <p id="detClienteText" class="form-control-plaintext border-bottom"></p>
                    </div>
                </div>

                <div id="detProveedor" class="row" style="display:none;">
                    <div class="col-12 mb-3">
                        <label class="form-label fw-bold text-muted">Proveedor</label>
                        <p id="detProveedorText" class="form-control-plaintext border-bottom"></p>
                    </div>
                </div>

                <div id="detDocumento" class="row" style="display:none;">
                    <div class="col-12 mb-3">
                        <label class="form-label fw-bold text-muted">Documento Relacionado</label>
                        <p id="detDocumentoText" class="form-control-plaintext border-bottom"></p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i> Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let table;

    $(document).ready(function() {
        // Set default date range (last 365 days to ensure we get data)
        const today = new Date();
        const yearAgo = new Date(today.getTime() - (365 * 24 * 60 * 60 * 1000));

        $('#filterFechaInicio').val(yearAgo.toISOString().split('T')[0]);
        $('#filterFechaFin').val(today.toISOString().split('T')[0]);

        // Load filter dropdowns
        loadProductosFilter();
        loadSucursalesFilter();

        // Initialize DataTable
        loadDataTable();
    });

    function loadDataTable() {
        table = initDataTable('#tableMovimientos', {
            ajax: {
                url: buildHandlerUrl(),
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                dataSrc: function(json) {
                    // Hide loader
                    $('#tableMovimientosLoader').hide();

                    // Debug logging
                    console.log('Movimientos API response:', json);

                    // Get data array - handle wrapped response
                    let data = [];
                    if (json && json.data) {
                        // If data is an array, use it directly
                        if (Array.isArray(json.data)) {
                            data = json.data;
                        } else {
                            // If data is a JsonElement (from C#), try to convert
                            try {
                                data = Object.values(json.data);
                            } catch (e) {
                                console.error('Error parsing data:', e);
                                data = [];
                            }
                        }
                    } else if (Array.isArray(json)) {
                        data = json;
                    }

                    console.log('Parsed data count:', data.length);

                    // Update badge count
                    $('#badgeTotalMovimientos').text(data.length);

                    // Update statistics
                    updateStatistics(data);

                    // Show appropriate state
                    if (data.length > 0) {
                        $('#tableMovimientosContainer').show();
                        $('#emptyStateMovimientos').hide();
                    } else {
                        $('#tableMovimientosContainer').hide();
                        $('#emptyStateMovimientos').show();
                    }

                    return data;
                },
                error: function(xhr, error, code) {
                    $('#tableMovimientosLoader').hide();
                    $('#tableMovimientosContainer').hide();
                    $('#emptyStateMovimientos').show();
                    $('#badgeTotalMovimientos').text('0');
                    console.error('Error loading movimientos:', error);
                    handleAjaxError(xhr);
                }
            },
            columns: [
                {
                    data: 'fecha',
                    render: function(data) {
                        return formatDateTime(data);
                    }
                },
                {
                    data: null,
                    render: function(data, type, row) {
                        // Handle nested property with camelCase/PascalCase
                        const inventario = row.inventario || row.Inventario;
                        const producto = inventario?.producto || inventario?.Producto;
                        return producto?.nombre || producto?.Nombre || 'N/A';
                    }
                },
                {
                    data: null,
                    render: function(data, type, row) {
                        // Handle nested property
                        const inventario = row.inventario || row.Inventario;
                        const sucursal = inventario?.sucursal || inventario?.Sucursal;
                        return sucursal?.nombre || sucursal?.Nombre || 'N/A';
                    }
                },
                {
                    data: 'tipoMovimiento',
                    render: function(data, type, row) {
                        const tipo = data ?? row.TipoMovimiento;
                        return getTipoMovimientoBadge(tipo);
                    }
                },
                {
                    data: 'cantidad',
                    render: function(data, type, row) {
                        const cantidad = data ?? row.Cantidad ?? 0;
                        return parseFloat(cantidad).toFixed(2);
                    },
                    className: 'text-end'
                },
                {
                    data: 'cantidadAnterior',
                    render: function(data, type, row) {
                        const cantidad = data ?? row.CantidadAnterior ?? 0;
                        return parseFloat(cantidad).toFixed(2);
                    },
                    className: 'text-end'
                },
                {
                    data: 'cantidadNueva',
                    render: function(data, type, row) {
                        const cantidad = data ?? row.CantidadNueva ?? 0;
                        return parseFloat(cantidad).toFixed(2);
                    },
                    className: 'text-end'
                },
                {
                    data: 'referencia',
                    render: function(data, type, row) {
                        const ref = data ?? row.Referencia;
                        return ref || '<span class="text-muted">-</span>';
                    }
                },
                {
                    data: null,
                    render: function(data, type, row) {
                        // Handle nested user property
                        const usuario = row.usuarioCreacion || row.UsuarioCreacion;
                        return usuario?.userName || usuario?.UserName || 'N/A';
                    }
                },
                {
                    data: 'id',
                    orderable: false,
                    render: function(data, type, row) {
                        const id = data ?? row.Id;
                        return `
                            <button class="btn btn-sm btn-info" onclick="viewDetails('${id}')" title="Ver Detalles">
                                <i class="fas fa-eye"></i>
                            </button>
                        `;
                    },
                    className: 'text-center'
                }
            ],
            order: [[0, 'desc']]
        });
    }

    function buildHandlerUrl() {
        const fechaInicio = $('#filterFechaInicio').val();
        const fechaFin = $('#filterFechaFin').val();
        const tipoMovimiento = $('#filterTipoMovimiento').val();
        const productoId = $('#filterProducto').val();
        const sucursalId = $('#filterSucursal').val();

        const params = ['handler=Data'];

        if (fechaInicio) params.push(`fechaInicio=${encodeURIComponent(fechaInicio)}`);
        if (fechaFin) params.push(`fechaFin=${encodeURIComponent(fechaFin)}`);
        if (tipoMovimiento) params.push(`tipoMovimiento=${tipoMovimiento}`);
        if (productoId) params.push(`productoId=${productoId}`);
        if (sucursalId) params.push(`sucursalId=${sucursalId}`);

        return '?' + params.join('&');
    }

    function loadProductosFilter() {
        $.ajax({
            url: '?handler=Productos',
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                const data = response?.data || response?.result || response || [];
                const select = $('#filterProducto');
                select.empty();
                select.append('<option value="">Todos</option>');

                if (Array.isArray(data)) {
                    data.forEach(producto => {
                        const id = producto.id || producto.Id;
                        const codigo = producto.codigo || producto.Codigo || '';
                        const nombre = producto.nombre || producto.Nombre || '';
                        select.append(`<option value="${id}">${codigo} - ${nombre}</option>`);
                    });
                }
            },
            error: function(xhr) {
                console.error('Error loading productos:', xhr);
            }
        });
    }

    function loadSucursalesFilter() {
        $.ajax({
            url: '?handler=Sucursales',
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                const data = response?.data || response?.result || response || [];
                const select = $('#filterSucursal');
                select.empty();
                select.append('<option value="">Todas</option>');

                if (Array.isArray(data)) {
                    data.forEach(sucursal => {
                        const id = sucursal.id || sucursal.Id;
                        const nombre = sucursal.nombre || sucursal.Nombre || '';
                        select.append(`<option value="${id}">${nombre}</option>`);
                    });
                }
            },
            error: function(xhr) {
                console.error('Error loading sucursales:', xhr);
            }
        });
    }

    function aplicarFiltros() {
        // Show loader
        $('#tableMovimientosLoader').show();
        $('#tableMovimientosContainer').hide();
        $('#emptyStateMovimientos').hide();

        // Update URL with new filters and reload
        table.ajax.url(buildHandlerUrl()).load();
    }

    function limpiarFiltros() {
        $('#formFiltros')[0].reset();

        // Reset date range to last 365 days
        const today = new Date();
        const yearAgo = new Date(today.getTime() - (365 * 24 * 60 * 60 * 1000));

        $('#filterFechaInicio').val(yearAgo.toISOString().split('T')[0]);
        $('#filterFechaFin').val(today.toISOString().split('T')[0]);

        // Show loader and reload
        $('#tableMovimientosLoader').show();
        $('#tableMovimientosContainer').hide();
        $('#emptyStateMovimientos').hide();

        table.ajax.url(buildHandlerUrl()).load();
    }

    function viewDetails(id) {
        $.ajax({
            url: '?handler=Details&id=' + id,
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success && response.data) {
                    const mov = response.data;

                    // Handle both camelCase and PascalCase
                    const inventario = mov.inventario || mov.Inventario;
                    const producto = inventario?.producto || inventario?.Producto;
                    const sucursal = inventario?.sucursal || inventario?.Sucursal;
                    const usuario = mov.usuarioCreacion || mov.UsuarioCreacion;

                    // Fill basic information
                    $('#detFecha').text(formatDateTime(mov.fecha || mov.Fecha));
                    $('#detTipoMovimiento').html(getTipoMovimientoBadge(mov.tipoMovimiento || mov.TipoMovimiento));

                    const prodCodigo = producto?.codigo || producto?.Codigo || '';
                    const prodNombre = producto?.nombre || producto?.Nombre || 'N/A';
                    $('#detProducto').text(prodCodigo ? `${prodCodigo} - ${prodNombre}` : prodNombre);

                    $('#detSucursal').text(sucursal?.nombre || sucursal?.Nombre || 'N/A');

                    const cantidad = mov.cantidad ?? mov.Cantidad ?? 0;
                    $('#detCantidad').text(parseFloat(cantidad).toFixed(2));

                    // Format stock change with arrow
                    const cantAnterior = mov.cantidadAnterior ?? mov.CantidadAnterior ?? 0;
                    const cantNueva = mov.cantidadNueva ?? mov.CantidadNueva ?? 0;
                    const stockChange = `
                        <span class="badge bg-secondary">${parseFloat(cantAnterior).toFixed(2)}</span>
                        <i class="fas fa-arrow-right mx-2"></i>
                        <span class="badge ${cantNueva > cantAnterior ? 'bg-success' : 'bg-danger'}">
                            ${parseFloat(cantNueva).toFixed(2)}
                        </span>
                    `;
                    $('#detCambioStock').html(stockChange);

                    $('#detReferencia').text(mov.referencia || mov.Referencia || 'N/A');
                    $('#detUsuario').text(usuario?.userName || usuario?.UserName || 'N/A');
                    $('#detObservaciones').text(mov.observaciones || mov.Observaciones || 'Sin observaciones');

                    // Show/hide optional fields
                    const sucOrigen = mov.sucursalOrigen || mov.SucursalOrigen;
                    if (sucOrigen) {
                        $('#detSucursalOrigenText').text(sucOrigen.nombre || sucOrigen.Nombre);
                        $('#detSucursalOrigen').show();
                    } else {
                        $('#detSucursalOrigen').hide();
                    }

                    const sucDestino = mov.sucursalDestino || mov.SucursalDestino;
                    if (sucDestino) {
                        $('#detSucursalDestinoText').text(sucDestino.nombre || sucDestino.Nombre);
                        $('#detSucursalDestino').show();
                    } else {
                        $('#detSucursalDestino').hide();
                    }

                    const cliente = mov.cliente || mov.Cliente;
                    if (cliente) {
                        $('#detClienteText').text(cliente.nombre || cliente.Nombre);
                        $('#detCliente').show();
                    } else {
                        $('#detCliente').hide();
                    }

                    const proveedor = mov.proveedor || mov.Proveedor;
                    if (proveedor) {
                        $('#detProveedorText').text(proveedor.nombre || proveedor.Nombre);
                        $('#detProveedor').show();
                    } else {
                        $('#detProveedor').hide();
                    }

                    const documentoId = mov.documentoId || mov.DocumentoId;
                    if (documentoId) {
                        $('#detDocumentoText').text(documentoId);
                        $('#detDocumento').show();
                    } else {
                        $('#detDocumento').hide();
                    }

                    $('#modalDetalles').modal('show');
                } else {
                    showError(response.message || 'No se pudieron cargar los detalles');
                }
            },
            error: function(xhr) {
                handleAjaxError(xhr);
            }
        });
    }

    function getTipoMovimientoBadge(tipo) {
        // Handle both numeric and string enum values
        const tiposPorNumero = {
            1: { text: 'Compra', class: 'bg-success' },
            2: { text: 'Venta', class: 'bg-danger' },
            3: { text: 'Ajuste Entrada', class: 'bg-success' },
            4: { text: 'Ajuste Salida', class: 'bg-danger' },
            5: { text: 'Traslado Entrada', class: 'bg-info' },
            6: { text: 'Traslado Salida', class: 'bg-warning' },
            7: { text: 'Devolución Cliente', class: 'bg-success' },
            8: { text: 'Devolución Proveedor', class: 'bg-danger' },
            9: { text: 'Merma', class: 'bg-danger' }
        };

        const tiposPorNombre = {
            'Compra': { text: 'Compra', class: 'bg-success' },
            'Venta': { text: 'Venta', class: 'bg-danger' },
            'AjusteEntrada': { text: 'Ajuste Entrada', class: 'bg-success' },
            'AjusteSalida': { text: 'Ajuste Salida', class: 'bg-danger' },
            'TrasladoEntrada': { text: 'Traslado Entrada', class: 'bg-info' },
            'TrasladoSalida': { text: 'Traslado Salida', class: 'bg-warning' },
            'DevolucionCliente': { text: 'Devolución Cliente', class: 'bg-success' },
            'DevolucionProveedor': { text: 'Devolución Proveedor', class: 'bg-danger' },
            'Merma': { text: 'Merma', class: 'bg-danger' }
        };

        let tipoInfo = tiposPorNumero[tipo] || tiposPorNombre[tipo] || { text: tipo || 'Desconocido', class: 'bg-secondary' };
        return `<span class="badge ${tipoInfo.class}">${tipoInfo.text}</span>`;
    }

    function updateStatistics(data) {
        if (!data || !Array.isArray(data)) {
            $('#statTotalMovimientos').text('0');
            $('#statTotalEntradas').text('0');
            $('#statTotalSalidas').text('0');
            $('#statCantidadNeta').text('0');
            return;
        }

        // Map string enum values to type category
        const tiposEntrada = [1, 3, 5, 7, 'Compra', 'AjusteEntrada', 'TrasladoEntrada', 'DevolucionCliente'];
        const tiposSalida = [2, 4, 6, 8, 9, 'Venta', 'AjusteSalida', 'TrasladoSalida', 'DevolucionProveedor', 'Merma'];

        let totalEntradas = 0;
        let totalSalidas = 0;

        data.forEach(mov => {
            const cantidad = parseFloat(mov.cantidad ?? mov.Cantidad ?? 0);
            const tipo = mov.tipoMovimiento ?? mov.TipoMovimiento;

            // Positive movement types (entradas)
            if (tiposEntrada.includes(tipo)) {
                totalEntradas += Math.abs(cantidad);
            }
            // Negative movement types (salidas)
            else if (tiposSalida.includes(tipo)) {
                totalSalidas += Math.abs(cantidad);
            }
        });

        const cantidadNeta = totalEntradas - totalSalidas;

        $('#statTotalMovimientos').text(data.length);
        $('#statTotalEntradas').text(totalEntradas.toFixed(2));
        $('#statTotalSalidas').text(totalSalidas.toFixed(2));
        $('#statCantidadNeta').text(cantidadNeta.toFixed(2));

        // Change color based on net quantity
        const netaElement = $('#statCantidadNeta');
        netaElement.removeClass('text-success text-danger text-info');
        if (cantidadNeta > 0) {
            netaElement.addClass('text-success');
        } else if (cantidadNeta < 0) {
            netaElement.addClass('text-danger');
        } else {
            netaElement.addClass('text-info');
        }
    }

    function formatDateTime(dateString) {
        if (!dateString) return 'N/A';

        const date = new Date(dateString);
        if (isNaN(date.getTime())) return 'N/A';

        const day = String(date.getDate()).padStart(2, '0');
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const year = date.getFullYear();
        const hours = String(date.getHours()).padStart(2, '0');
        const minutes = String(date.getMinutes()).padStart(2, '0');

        return `${day}/${month}/${year} ${hours}:${minutes}`;
    }

    function refrescarTabla() {
        // Show loader
        $('#tableMovimientosLoader').show();
        $('#tableMovimientosContainer').hide();
        $('#emptyStateMovimientos').hide();
        // Reload table
        table.ajax.reload();
    }

    function exportarExcel() {
        showWarning('Función de exportación en desarrollo');
    }

    // Expose functions to global scope for onclick handlers
    window.aplicarFiltros = aplicarFiltros;
    window.limpiarFiltros = limpiarFiltros;
    window.viewDetails = viewDetails;
    window.refrescarTabla = refrescarTabla;
    window.exportarExcel = exportarExcel;
</script>
}
