@page
@model Facturacion.Frontend.Pages.Stock.MovimientosInventarioModel
@{
    ViewData["Title"] = "Movimientos de Inventario";
    ViewData["Breadcrumb"] = "Movimientos de Inventario";
}

@Html.AntiForgeryToken()

<!-- Page Header -->
<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <h2><i class="fas fa-exchange-alt"></i> Movimientos de Inventario</h2>
            <p class="mb-0">Historial completo de movimientos de inventario por bodega</p>
        </div>
    </div>
</div>

<!-- Filtros -->
<div class="card mb-4">
    <div class="card-header">
        <i class="fas fa-filter me-2"></i>Filtros de Búsqueda
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Producto</label>
                <select id="filtroProducto" class="form-select">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Bodega</label>
                <select id="filtroBodega" class="form-select">
                    <option value="">Todas</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Tipo de Movimiento</label>
                <select id="filtroTipo" class="form-select">
                    <option value="">Todos</option>
                    <option value="0">Entrada</option>
                    <option value="1">Salida</option>
                    <option value="2">Ajuste Positivo</option>
                    <option value="3">Ajuste Negativo</option>
                    <option value="4">Traslado Entrada</option>
                    <option value="5">Traslado Salida</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Fecha Desde</label>
                <input type="date" id="filtroFechaDesde" class="form-control">
            </div>
            <div class="col-md-2">
                <label class="form-label">Fecha Hasta</label>
                <input type="date" id="filtroFechaHasta" class="form-control">
            </div>
        </div>
        <div class="row mt-3">
            <div class="col-12">
                <button type="button" class="btn btn-primary" onclick="aplicarFiltros()">
                    <i class="fas fa-search me-1"></i>Buscar
                </button>
                <button type="button" class="btn btn-secondary" onclick="limpiarFiltros()">
                    <i class="fas fa-eraser me-1"></i>Limpiar
                </button>
                <button type="button" class="btn btn-success" onclick="exportarExcel()">
                    <i class="fas fa-file-excel me-1"></i>Exportar Excel
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4" id="estadisticasContainer" style="display: none;">
    <div class="col-md-3">
        <div class="card shadow-custom border-start border-success border-4">
            <div class="card-body py-3">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="stat-icon bg-success bg-opacity-10 text-success rounded-circle p-3">
                            <i class="fas fa-arrow-down fa-lg"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Entradas</h6>
                        <h3 id="statEntradas" class="mb-0 text-success">0</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-custom border-start border-danger border-4">
            <div class="card-body py-3">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="stat-icon bg-danger bg-opacity-10 text-danger rounded-circle p-3">
                            <i class="fas fa-arrow-up fa-lg"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Salidas</h6>
                        <h3 id="statSalidas" class="mb-0 text-danger">0</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-custom border-start border-warning border-4">
            <div class="card-body py-3">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="stat-icon bg-warning bg-opacity-10 text-warning rounded-circle p-3">
                            <i class="fas fa-sliders-h fa-lg"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Ajustes</h6>
                        <h3 id="statAjustes" class="mb-0 text-warning">0</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-custom border-start border-primary border-4">
            <div class="card-body py-3">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="stat-icon bg-primary bg-opacity-10 text-primary rounded-circle p-3">
                            <i class="fas fa-list fa-lg"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1">Total Movimientos</h6>
                        <h3 id="statTotal" class="mb-0">0</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Movimientos Table Card -->
<div class="card shadow-custom">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <i class="fas fa-table me-2 text-primary"></i>
            <strong>Listado de Movimientos</strong>
            <span class="badge bg-secondary ms-2" id="badgeTotalMovimientos">0</span>
        </div>
        <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="btn btn-outline-primary" onclick="refrescarTabla()" title="Refrescar tabla">
                <i class="fas fa-sync-alt"></i>
            </button>
        </div>
    </div>
    <div class="card-body">
        <!-- Loading State -->
        <div id="tableMovimientosLoader" class="text-center py-5">
            <div class="spinner-modern mx-auto"></div>
            <p class="text-muted mt-3">Cargando movimientos...</p>
        </div>

        <!-- Table -->
        <div class="table-responsive" id="tableMovimientosContainer" style="display:none;">
            <table id="tableMovimientos" class="table table-hover table-sm">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Tipo</th>
                        <th>Producto</th>
                        <th>Bodega</th>
                        <th>Cantidad</th>
                        <th>Saldo Anterior</th>
                        <th>Saldo Nuevo</th>
                        <th>Referencia</th>
                        <th>Usuario</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <!-- Empty State -->
        <div id="emptyStateMovimientos" class="empty-state" style="display:none;">
            <div class="empty-state-icon">
                <i class="fas fa-exchange-alt"></i>
            </div>
            <h3 class="empty-state-title">No hay movimientos registrados</h3>
            <p class="empty-state-description">Los movimientos se generan automáticamente desde otros módulos</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;

        $(document).ready(function () {
            // Set default dates (last 30 days)
            const hoy = new Date();
            const hace30 = new Date();
            hace30.setDate(hace30.getDate() - 30);
            $('#filtroFechaHasta').val(hoy.toISOString().split('T')[0]);
            $('#filtroFechaDesde').val(hace30.toISOString().split('T')[0]);

            loadDataTable();
            loadProductos();
            loadBodegas();
        });

        function getAntiForgeryToken() {
            return $('input[name="__RequestVerificationToken"]').val();
        }

        function loadProductos() {
            $.ajax({
                url: '?handler=Productos',
                type: 'GET',
                headers: {
                    "RequestVerificationToken": getAntiForgeryToken()
                },
                success: function (response) {
                    const select = $('#filtroProducto');
                    select.empty().append('<option value="">Todos</option>');
                    const productos = response.data || response || [];
                    productos.forEach(function (item) {
                        select.append(`<option value="${item.id}">${item.codigo} - ${item.nombre}</option>`);
                    });
                }
            });
        }

        function loadBodegas() {
            $.ajax({
                url: '?handler=Bodegas',
                type: 'GET',
                headers: {
                    "RequestVerificationToken": getAntiForgeryToken()
                },
                success: function (response) {
                    const select = $('#filtroBodega');
                    select.empty().append('<option value="">Todas</option>');
                    const bodegas = response.data || response || [];
                    bodegas.forEach(function (item) {
                        select.append(`<option value="${item.id}">${item.nombre}</option>`);
                    });
                }
            });
        }

        function loadDataTable() {
            table = $('#tableMovimientos').DataTable({
                ajax: {
                    url: '?handler=Data',
                    type: 'GET',
                    data: function (d) {
                        d.productoId = $('#filtroProducto').val();
                        d.bodegaId = $('#filtroBodega').val();
                        d.tipoMovimiento = $('#filtroTipo').val();
                        d.fechaDesde = $('#filtroFechaDesde').val();
                        d.fechaHasta = $('#filtroFechaHasta').val();
                    },
                    headers: {
                        "RequestVerificationToken": getAntiForgeryToken()
                    },
                    dataSrc: function (json) {
                        $('#tableMovimientosLoader').hide();
                        const data = json.data || json || [];
                        $('#badgeTotalMovimientos').text(data.length);
                        updateStatistics(data);

                        if (data.length > 0) {
                            $('#tableMovimientosContainer').show();
                            $('#emptyStateMovimientos').hide();
                            $('#estadisticasContainer').show();
                        } else {
                            $('#tableMovimientosContainer').hide();
                            $('#emptyStateMovimientos').show();
                        }
                        return data;
                    },
                    error: function (xhr, error, thrown) {
                        $('#tableMovimientosLoader').hide();
                        $('#tableMovimientosContainer').hide();
                        $('#emptyStateMovimientos').show();
                        $('#badgeTotalMovimientos').text('0');
                        console.error('Error loading data:', error);
                    }
                },
                columns: [
                    {
                        data: 'fecha',
                        render: function (data) {
                            return formatDateTime(data);
                        }
                    },
                    {
                        data: 'tipoMovimiento',
                        render: function (data) {
                            return getTipoMovimientoBadge(data);
                        }
                    },
                    {
                        data: 'inventario',
                        render: function (data) {
                            return data?.producto?.nombre || '-';
                        }
                    },
                    {
                        data: 'inventario',
                        render: function (data) {
                            return data?.bodega?.nombre || '-';
                        }
                    },
                    {
                        data: 'cantidad',
                        render: function (data, type, row) {
                            const isEntry = row.tipoMovimiento === 0 || row.tipoMovimiento === 2 || row.tipoMovimiento === 4;
                            const color = isEntry ? 'text-success' : 'text-danger';
                            const sign = isEntry ? '+' : '-';
                            return `<span class="${color} fw-bold">${sign}${formatNumber(Math.abs(data))}</span>`;
                        }
                    },
                    {
                        data: 'cantidadAnterior',
                        render: function (data) {
                            return formatNumber(data);
                        }
                    },
                    {
                        data: 'cantidadNueva',
                        render: function (data) {
                            return formatNumber(data);
                        }
                    },
                    {
                        data: 'referencia',
                        render: function (data) {
                            return data || '<span class="text-muted">-</span>';
                        }
                    },
                    {
                        data: 'usuarioCreacion',
                        render: function (data) {
                            return data?.email || '-';
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json'
                },
                order: [[0, 'desc']],
                pageLength: 50
            });
        }

        function getTipoMovimientoBadge(tipo) {
            const badges = {
                0: { text: 'Entrada', class: 'bg-success' },
                1: { text: 'Salida', class: 'bg-danger' },
                2: { text: 'Ajuste Positivo', class: 'bg-info' },
                3: { text: 'Ajuste Negativo', class: 'bg-warning' },
                4: { text: 'Traslado Entrada', class: 'bg-primary' },
                5: { text: 'Traslado Salida', class: 'bg-secondary' }
            };
            const badge = badges[tipo] || { text: tipo, class: 'bg-secondary' };
            return `<span class="badge ${badge.class}">${badge.text}</span>`;
        }

        function updateStatistics(data) {
            if (!data || !Array.isArray(data)) {
                $('#statTotal').text('0');
                $('#statEntradas').text('0');
                $('#statSalidas').text('0');
                $('#statAjustes').text('0');
                return;
            }

            const total = data.length;
            const entradas = data.filter(m => m.tipoMovimiento === 0 || m.tipoMovimiento === 4).length;
            const salidas = data.filter(m => m.tipoMovimiento === 1 || m.tipoMovimiento === 5).length;
            const ajustes = data.filter(m => m.tipoMovimiento === 2 || m.tipoMovimiento === 3).length;

            $('#statTotal').text(total);
            $('#statEntradas').text(entradas);
            $('#statSalidas').text(salidas);
            $('#statAjustes').text(ajustes);
        }

        function aplicarFiltros() {
            $('#tableMovimientosLoader').show();
            $('#tableMovimientosContainer').hide();
            $('#emptyStateMovimientos').hide();
            table.ajax.reload();
        }

        function limpiarFiltros() {
            $('#filtroProducto').val('');
            $('#filtroBodega').val('');
            $('#filtroTipo').val('');
            const hoy = new Date();
            const hace30 = new Date();
            hace30.setDate(hace30.getDate() - 30);
            $('#filtroFechaHasta').val(hoy.toISOString().split('T')[0]);
            $('#filtroFechaDesde').val(hace30.toISOString().split('T')[0]);
            aplicarFiltros();
        }

        function refrescarTabla() {
            $('#tableMovimientosLoader').show();
            $('#tableMovimientosContainer').hide();
            $('#emptyStateMovimientos').hide();
            table.ajax.reload();
        }

        function exportarExcel() {
            Swal.fire('Info', 'Exportación a Excel en desarrollo', 'info');
        }

        function formatNumber(num) {
            return new Intl.NumberFormat('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 4 }).format(num || 0);
        }

        function formatDateTime(dateString) {
            if (!dateString) return '-';
            const date = new Date(dateString);
            return date.toLocaleDateString('es-CR', { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' });
        }
    </script>
}
