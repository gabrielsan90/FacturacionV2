@page
@model Facturacion.Frontend.Pages.Configuracion.TipoCambioModel
@{
    ViewData["Title"] = "Tipos de Cambio";
    ViewData["Breadcrumb"] = "Tipos de Cambio";
}

<!-- Page Header -->
<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <h2><i class="fas fa-exchange-alt"></i> Tipos de Cambio</h2>
            <p class="mb-0">Consulta de tipos de cambio del Banco Central de Costa Rica (BCCR)</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-success" onclick="fetchCurrentRate()" aria-label="Obtener tipo de cambio actual">
                <i class="fas fa-sync-alt me-2"></i>Actualizar de BCCR
            </button>
        </div>
    </div>
</div>

<!-- Current Exchange Rate Card -->
<div class="row mb-4">
    <div class="col-md-12">
        <div class="card shadow-custom border-primary">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="fas fa-calendar-day me-2"></i>Tipo de Cambio del Día
                </h5>
            </div>
            <div class="card-body">
                <div id="currentRateLoader" class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="mt-3 text-muted">Consultando BCCR...</p>
                </div>

                <div id="currentRateDisplay" style="display: none;">
                    <div class="row text-center">
                        <div class="col-md-4 mb-3">
                            <div class="p-3 bg-light rounded">
                                <p class="text-muted mb-2"><i class="fas fa-calendar me-2"></i>Fecha</p>
                                <h4 id="currentDate" class="mb-0 text-primary fw-bold">-</h4>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="p-3 bg-success bg-opacity-10 rounded">
                                <p class="text-muted mb-2"><i class="fas fa-arrow-down me-2"></i>Tipo de Cambio Compra</p>
                                <h3 id="currentBuyRate" class="mb-0 text-success fw-bold">₡0.00000</h3>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="p-3 bg-danger bg-opacity-10 rounded">
                                <p class="text-muted mb-2"><i class="fas fa-arrow-up me-2"></i>Tipo de Cambio Venta</p>
                                <h3 id="currentSellRate" class="mb-0 text-danger fw-bold">₡0.00000</h3>
                            </div>
                        </div>
                    </div>
                    <div class="alert alert-info mb-0" role="alert">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Fuente:</strong> Banco Central de Costa Rica (BCCR) - Datos oficiales para facturación electrónica
                    </div>
                </div>

                <div id="currentRateError" style="display: none;">
                    <div class="alert alert-warning mb-0" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>No se pudo consultar el BCCR.</strong> Verifique su conexión a internet o intente más tarde.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Historical Exchange Rates Section -->
<div class="card shadow-custom">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
            <i class="fas fa-history me-2"></i>Consulta por Fecha
        </h5>
    </div>
    <div class="card-body">
        <!-- Date Range Filter -->
        <div class="row mb-4">
            <div class="col-md-4">
                <label for="filterFechaInicio" class="form-label fw-bold">Fecha Inicio</label>
                <input type="date" class="form-control" id="filterFechaInicio" />
            </div>
            <div class="col-md-4">
                <label for="filterFechaFin" class="form-label fw-bold">Fecha Fin</label>
                <input type="date" class="form-control" id="filterFechaFin" />
            </div>
            <div class="col-md-4">
                <label for="filterMoneda" class="form-label fw-bold">Moneda</label>
                <select class="form-select" id="filterMoneda">
                    <option value="USD" selected>Dólar Estadounidense (USD)</option>
                    <option value="EUR">Euro (EUR)</option>
                </select>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-12">
                <button class="btn btn-primary" onclick="searchByDateRange()">
                    <i class="fas fa-search me-2"></i>Buscar Rango
                </button>
                <button class="btn btn-outline-secondary ms-2" onclick="clearFilters()">
                    <i class="fas fa-times me-2"></i>Limpiar
                </button>
            </div>
        </div>

        <!-- Results Table -->
        <div id="rangeResultsLoader" class="text-center py-4" style="display: none;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-3 text-muted">Consultando tipos de cambio...</p>
        </div>

        <div id="rangeResultsContainer" style="display: none;">
            <div class="table-responsive">
                <table id="tableRates" class="table table-hover table-striped">
                    <thead class="table-light">
                        <tr>
                            <th><i class="fas fa-calendar me-2"></i>Fecha</th>
                            <th><i class="fas fa-money-bill me-2"></i>Moneda</th>
                            <th class="text-end"><i class="fas fa-arrow-down me-2"></i>Compra (₡)</th>
                            <th class="text-end"><i class="fas fa-arrow-up me-2"></i>Venta (₡)</th>
                            <th class="text-center"><i class="fas fa-info-circle me-2"></i>Fuente</th>
                        </tr>
                    </thead>
                    <tbody id="tableRatesBody">
                    </tbody>
                </table>
            </div>
        </div>

        <div id="rangeResultsEmpty" class="text-center py-5" style="display: none;">
            <i class="fas fa-search fa-4x text-muted mb-3"></i>
            <h5 class="text-muted">No hay resultados</h5>
            <p class="text-muted">Seleccione un rango de fechas y presione "Buscar Rango"</p>
        </div>
    </div>
</div>

<!-- Quick Search by Single Date -->
<div class="card shadow-custom mt-4">
    <div class="card-header">
        <h5 class="mb-0">
            <i class="fas fa-calendar-check me-2"></i>Consulta Rápida por Fecha
        </h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <label for="quickSearchDate" class="form-label fw-bold">Seleccione una Fecha</label>
                <input type="date" class="form-control" id="quickSearchDate" />
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <button class="btn btn-primary" onclick="searchByDate()">
                    <i class="fas fa-search me-2"></i>Consultar
                </button>
            </div>
        </div>

        <div id="quickSearchResult" class="mt-4" style="display: none;">
            <div class="alert alert-success" role="alert">
                <h5 class="alert-heading"><i class="fas fa-check-circle me-2"></i>Tipo de Cambio</h5>
                <hr>
                <div class="row">
                    <div class="col-md-4">
                        <strong>Fecha:</strong> <span id="quickDate">-</span>
                    </div>
                    <div class="col-md-4">
                        <strong>Compra:</strong> <span id="quickBuyRate" class="text-success fw-bold">₡0.00000</span>
                    </div>
                    <div class="col-md-4">
                        <strong>Venta:</strong> <span id="quickSellRate" class="text-danger fw-bold">₡0.00000</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Info Card -->
<div class="card shadow-custom mt-4 border-info">
    <div class="card-header bg-info text-white">
        <h5 class="mb-0">
            <i class="fas fa-question-circle me-2"></i>Información Importante
        </h5>
    </div>
    <div class="card-body">
        <ul class="mb-0">
            <li><strong>Fuente Oficial:</strong> Todos los tipos de cambio son obtenidos del Banco Central de Costa Rica (BCCR).</li>
            <li><strong>Facturación Electrónica:</strong> Es obligatorio usar el tipo de cambio oficial del BCCR para facturas en moneda extranjera.</li>
            <li><strong>Formato Costa Rica:</strong> Los tipos de cambio se muestran con 5 decimales según normativa nacional.</li>
            <li><strong>Actualización:</strong> Los tipos de cambio se actualizan diariamente por el BCCR.</li>
            <li><strong>Fines de Semana:</strong> El BCCR no publica tipos de cambio los fines de semana, se usa el del último día hábil.</li>
            <li><strong>Compra vs Venta:</strong> Use el tipo de <strong>venta</strong> para convertir de USD a CRC en facturas.</li>
        </ul>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function () {
        // Set default dates
        const today = new Date();
        const sevenDaysAgo = new Date(today);
        sevenDaysAgo.setDate(today.getDate() - 7);

        $('#filterFechaInicio').val(formatDateForInput(sevenDaysAgo));
        $('#filterFechaFin').val(formatDateForInput(today));
        $('#quickSearchDate').val(formatDateForInput(today));

        // Load current rate on page load
        fetchCurrentRate();
    });

    /**
     * Fetch current exchange rate from BCCR
     */
    function fetchCurrentRate() {
        $('#currentRateLoader').show();
        $('#currentRateDisplay').hide();
        $('#currentRateError').hide();

        $.ajax({
            url: '?handler=CurrentRate',
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function (response) {
                if (response.success && response.data) {
                    displayCurrentRate(response.data);
                } else {
                    showCurrentRateError();
                }
            },
            error: function () {
                showCurrentRateError();
            }
        });
    }

    /**
     * Display current rate
     */
    function displayCurrentRate(data) {
        $('#currentDate').text(formatDateDisplay(data.fecha));
        $('#currentBuyRate').text('₡' + parseFloat(data.compra).toFixed(5));
        $('#currentSellRate').text('₡' + parseFloat(data.venta).toFixed(5));

        $('#currentRateLoader').hide();
        $('#currentRateDisplay').show();
        $('#currentRateError').hide();
    }

    /**
     * Show error for current rate
     */
    function showCurrentRateError() {
        $('#currentRateLoader').hide();
        $('#currentRateDisplay').hide();
        $('#currentRateError').show();
    }

    /**
     * Search by single date
     */
    function searchByDate() {
        const fecha = $('#quickSearchDate').val();

        if (!fecha) {
            Swal.fire('Advertencia', 'Por favor seleccione una fecha', 'warning');
            return;
        }

        $.ajax({
            url: '?handler=RateByDate&fecha=' + fecha,
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function (response) {
                if (response.success && response.data) {
                    $('#quickDate').text(formatDateDisplay(response.data.fecha));
                    $('#quickBuyRate').text('₡' + parseFloat(response.data.compra).toFixed(5));
                    $('#quickSellRate').text('₡' + parseFloat(response.data.venta).toFixed(5));
                    $('#quickSearchResult').show();
                } else {
                    Swal.fire('Error', response.message || 'No se pudo obtener el tipo de cambio', 'error');
                    $('#quickSearchResult').hide();
                }
            },
            error: function () {
                Swal.fire('Error', 'Ocurrió un error al consultar el tipo de cambio', 'error');
                $('#quickSearchResult').hide();
            }
        });
    }

    /**
     * Search by date range
     */
    function searchByDateRange() {
        const fechaInicio = $('#filterFechaInicio').val();
        const fechaFin = $('#filterFechaFin').val();

        if (!fechaInicio || !fechaFin) {
            Swal.fire('Advertencia', 'Por favor seleccione ambas fechas', 'warning');
            return;
        }

        if (new Date(fechaInicio) > new Date(fechaFin)) {
            Swal.fire('Advertencia', 'La fecha de inicio debe ser anterior a la fecha fin', 'warning');
            return;
        }

        // Calculate days difference
        const days = Math.ceil((new Date(fechaFin) - new Date(fechaInicio)) / (1000 * 60 * 60 * 24));
        if (days > 365) {
            Swal.fire('Advertencia', 'El rango de fechas no puede ser mayor a 365 días', 'warning');
            return;
        }

        $('#rangeResultsLoader').show();
        $('#rangeResultsContainer').hide();
        $('#rangeResultsEmpty').hide();

        $.ajax({
            url: '?handler=Range',
            type: 'POST',
            contentType: 'application/json',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            data: JSON.stringify({
                fechaInicio: fechaInicio,
                fechaFin: fechaFin
            }),
            success: function (response) {
                $('#rangeResultsLoader').hide();

                if (response.success && response.data && response.data.length > 0) {
                    displayRangeResults(response.data);
                } else {
                    $('#rangeResultsEmpty').show();
                }
            },
            error: function () {
                $('#rangeResultsLoader').hide();
                Swal.fire('Error', 'Ocurrió un error al consultar los tipos de cambio', 'error');
            }
        });
    }

    /**
     * Display range results
     */
    function displayRangeResults(data) {
        const tbody = $('#tableRatesBody');
        tbody.empty();

        data.forEach(function (item) {
            const row = `
                <tr>
                    <td>${formatDateDisplay(item.fecha)}</td>
                    <td><span class="badge bg-primary">${item.moneda || 'USD'}</span></td>
                    <td class="text-end text-success fw-bold">₡${parseFloat(item.compra).toFixed(5)}</td>
                    <td class="text-end text-danger fw-bold">₡${parseFloat(item.venta).toFixed(5)}</td>
                    <td class="text-center">
                        <span class="badge bg-success">
                            <i class="fas fa-university me-1"></i>BCCR
                        </span>
                    </td>
                </tr>
            `;
            tbody.append(row);
        });

        $('#rangeResultsContainer').show();
    }

    /**
     * Clear filters
     */
    function clearFilters() {
        const today = new Date();
        const sevenDaysAgo = new Date(today);
        sevenDaysAgo.setDate(today.getDate() - 7);

        $('#filterFechaInicio').val(formatDateForInput(sevenDaysAgo));
        $('#filterFechaFin').val(formatDateForInput(today));
        $('#filterMoneda').val('USD');

        $('#rangeResultsContainer').hide();
        $('#rangeResultsEmpty').show();
    }

    /**
     * Format date for input (YYYY-MM-DD)
     */
    function formatDateForInput(date) {
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
    }

    /**
     * Format date for display (DD/MM/YYYY)
     */
    function formatDateDisplay(dateString) {
        if (!dateString) return '-';
        const date = new Date(dateString + 'T00:00:00');
        const day = String(date.getDate()).padStart(2, '0');
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const year = date.getFullYear();
        return `${day}/${month}/${year}`;
    }
</script>
}
