@page
@model Facturacion.Frontend.Pages.Configuracion.UsuariosModel
@{
    ViewData["Title"] = "Gestión de Usuarios";
    ViewData["Breadcrumb"] = "Usuarios";
}

<!-- Page Header -->
<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <h2><i class="fas fa-users"></i> Gestión de Usuarios</h2>
            <p class="mb-0">Administración de usuarios, roles y permisos del sistema</p>
        </div>
        <button class="btn btn-primary" onclick="openCreateModal()" aria-label="Crear nuevo usuario">
            <i class="fas fa-plus me-2"></i>Nuevo Usuario
        </button>
    </div>
</div>

<!-- Usuarios Table Card -->
<div class="card shadow-custom">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <i class="fas fa-table me-2 text-primary"></i>
            <strong>Listado de Usuarios</strong>
            <span class="badge bg-secondary ms-2" id="badgeTotalUsuarios">0</span>
        </div>
        <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="btn btn-outline-primary" onclick="exportarExcel()" title="Exportar a Excel">
                <i class="fas fa-file-excel"></i>
            </button>
            <button type="button" class="btn btn-outline-primary" onclick="refrescarTabla()" title="Refrescar tabla">
                <i class="fas fa-sync-alt"></i>
            </button>
        </div>
    </div>
    <div class="card-body">
        <!-- Loading State -->
        <div id="tableUsuariosLoader" class="text-center py-5">
            <div class="spinner-modern mx-auto"></div>
            <p class="text-muted mt-3">Cargando usuarios...</p>
        </div>

        <!-- Table -->
        <div class="table-responsive" id="tableUsuariosContainer" style="display:none;">
            <table id="tableUsuarios" class="table table-hover">
                <thead>
                    <tr>
                        <th>Email</th>
                        <th>Nombre Completo</th>
                        <th>Documento</th>
                        <th>Teléfono</th>
                        <th>Roles</th>
                        <th>Empresas</th>
                        <th>Estado</th>
                        <th style="width: 100px;">Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <!-- Empty State -->
        <div id="emptyStateUsuarios" class="empty-state" style="display:none;">
            <div class="empty-state-icon">
                <i class="fas fa-users"></i>
            </div>
            <h3 class="empty-state-title">No hay usuarios registrados</h3>
            <p class="empty-state-description">Comienza agregando tu primer usuario</p>
            <button class="btn btn-primary" onclick="openCreateModal()">
                <i class="fas fa-plus me-2"></i>Crear Primer Usuario
            </button>
        </div>
    </div>
</div>

<!-- Modal for Create/Edit -->
<div class="modal fade" id="modalUsuario" tabindex="-1" aria-labelledby="modalUsuarioLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalUsuarioLabel">
                    <i class="fas fa-user"></i> <span id="modalTitle">Nuevo Usuario</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formUsuario">
                <div class="modal-body">
                    <input type="hidden" id="Usuario_Id" />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="Usuario_Email" class="form-label">Correo Electrónico <span class="text-danger">*</span></label>
                                <input type="email" class="form-control" id="Usuario_Email" required />
                                <div class="invalid-feedback">Ingrese un correo electrónico válido.</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="Usuario_FullName" class="form-label">Nombre Completo <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="Usuario_FullName" maxlength="100" required />
                                <div class="invalid-feedback">El nombre completo es obligatorio.</div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="Usuario_Document" class="form-label">Documento <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="Usuario_Document" maxlength="20" required />
                                <div class="invalid-feedback">El documento es obligatorio.</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="Usuario_PhoneNumber" class="form-label">Teléfono</label>
                                <input type="tel" class="form-control" id="Usuario_PhoneNumber" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="Usuario_Password" class="form-label">
                                    Contraseña <span class="text-danger password-required">*</span>
                                </label>
                                <div class="input-group">
                                    <input type="password" class="form-control" id="Usuario_Password" />
                                    <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('Usuario_Password')">
                                        <i class="fas fa-eye" id="Usuario_Password_icon"></i>
                                    </button>
                                    <button class="btn btn-outline-primary" type="button" onclick="generateRandomPassword()" title="Generar Contraseña Aleatoria">
                                        <i class="fas fa-random"></i>
                                    </button>
                                </div>
                                <small class="form-text text-muted">
                                    Mínimo 6 caracteres. Opcional al editar (deje en blanco para mantener la actual). Use el botón <i class="fas fa-random"></i> para generar una contraseña segura.
                                </small>
                                <div class="invalid-feedback">La contraseña debe tener al menos 6 caracteres.</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="Usuario_ConfirmPassword" class="form-label">
                                    Confirmar Contraseña <span class="text-danger password-required">*</span>
                                </label>
                                <div class="input-group">
                                    <input type="password" class="form-control" id="Usuario_ConfirmPassword" />
                                    <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('Usuario_ConfirmPassword')">
                                        <i class="fas fa-eye" id="Usuario_ConfirmPassword_icon"></i>
                                    </button>
                                </div>
                                <div class="invalid-feedback">Las contraseñas deben coincidir.</div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="Usuario_Roles" class="form-label">Roles</label>
                                <select class="form-select" id="Usuario_Roles" multiple size="5">
                                </select>
                                <small class="form-text text-muted">Mantenga presionado Ctrl/Cmd para seleccionar múltiples roles.</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="Usuario_Empresas" class="form-label">Empresas</label>
                                <select class="form-select" id="Usuario_Empresas" multiple size="5">
                                </select>
                                <small class="form-text text-muted">Mantenga presionado Ctrl/Cmd para seleccionar múltiples empresas.</small>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="Usuario_EmailConfirmed" />
                                <label class="form-check-label" for="Usuario_EmailConfirmed">
                                    Email Confirmado
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check send-email-check">
                                <input class="form-check-input" type="checkbox" id="Usuario_SendEmail" checked />
                                <label class="form-check-label" for="Usuario_SendEmail">
                                    Enviar contraseña por correo
                                </label>
                                <small class="form-text text-muted d-block">
                                    Se enviará un correo con las credenciales al usuario
                                </small>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary" id="btnSave">
                        <i class="fas fa-save"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal for Delete Confirmation -->
<div class="modal fade" id="modalDeleteUsuario" tabindex="-1" aria-labelledby="modalDeleteUsuarioLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="modalDeleteUsuarioLabel">
                    <i class="fas fa-trash"></i> Eliminar Usuario
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>¿Está seguro que desea eliminar al usuario <strong id="deleteUsuarioNombre"></strong>?</p>
                <p class="text-danger"><i class="fas fa-exclamation-triangle"></i> Esta acción no se puede deshacer.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancelar
                </button>
                <button type="button" class="btn btn-danger" id="btnConfirmDelete">
                    <i class="fas fa-trash"></i> Eliminar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @Html.AntiForgeryToken()

    <script>
        let table;
        let currentUsuarioId = null;
        let isEditMode = false;

        $(document).ready(function () {
            initializeDataTable();
            loadRoles();
            loadEmpresas();
            initializeFormHandlers();
        });

        function initializeDataTable() {
            table = $('#tableUsuarios').DataTable({
                ajax: {
                    url: '/Usuarios?handler=Data',
                    type: 'GET',
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    dataSrc: function(json) {
                        $('#tableUsuariosLoader').hide();
                        const data = json.data || json || [];
                        $('#badgeTotalUsuarios').text(data.length);
                        if (data.length > 0) {
                            $('#tableUsuariosContainer').show();
                            $('#emptyStateUsuarios').hide();
                        } else {
                            $('#tableUsuariosContainer').hide();
                            $('#emptyStateUsuarios').show();
                        }
                        return data;
                    },
                    error: function(xhr, error, code) {
                        $('#tableUsuariosLoader').hide();
                        $('#tableUsuariosContainer').hide();
                        $('#emptyStateUsuarios').show();
                        $('#badgeTotalUsuarios').text('0');
                        console.error('Error loading usuarios:', error);
                    }
                },
                columns: [
                    { data: 'email' },
                    { data: 'fullName' },
                    { data: 'document' },
                    {
                        data: 'phoneNumber',
                        render: function (data) {
                            return data || '<span class="text-muted">N/A</span>';
                        }
                    },
                    {
                        data: 'roles',
                        render: function (data) {
                            if (!data || data.length === 0) {
                                return '<span class="badge bg-secondary">Sin roles</span>';
                            }
                            return data.map(role => `<span class="badge bg-info me-1">${role}</span>`).join('');
                        }
                    },
                    {
                        data: 'empresas',
                        render: function (data) {
                            if (!data || data.length === 0) {
                                return '<span class="badge bg-secondary">Sin empresas</span>';
                            }
                            return data.map(emp => `<span class="badge bg-success me-1">${emp.nombreComercial}</span>`).join('');
                        }
                    },
                    {
                        data: 'emailConfirmed',
                        render: function (data) {
                            return data
                                ? '<span class="badge bg-success"><i class="fas fa-check"></i> Confirmado</span>'
                                : '<span class="badge bg-warning"><i class="fas fa-times"></i> Pendiente</span>';
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        render: function (data, type, row) {
                            return `
                                <button class="btn btn-sm btn-warning" onclick="openEditModal('${row.id}')" title="Editar">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="btn btn-sm btn-danger" onclick="openDeleteModal('${row.id}', '${row.fullName}')" title="Eliminar">
                                    <i class="fas fa-trash"></i>
                                </button>
                            `;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json'
                },
                responsive: true,
                order: [[1, 'asc']]
            });
        }

        function loadRoles() {
            $.ajax({
                url: '?handler=Roles',
                type: 'GET',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (roles) {
                    const select = $('#Usuario_Roles');
                    select.empty();

                    roles.forEach(function (role) {
                        select.append(`<option value="${role.name}">${role.name}</option>`);
                    });
                },
                error: function (xhr) {
                    console.error('Error al cargar roles:', xhr);
                    Swal.fire('Error', 'No se pudieron cargar los roles disponibles.', 'error');
                }
            });
        }

        function loadEmpresas() {
            $.ajax({
                url: '?handler=Empresas',
                type: 'GET',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (empresas) {
                    const select = $('#Usuario_Empresas');
                    select.empty();

                    empresas.forEach(function (empresa) {
                        select.append(`<option value="${empresa.id}">${empresa.nombreComercial}</option>`);
                    });
                },
                error: function (xhr) {
                    console.error('Error al cargar empresas:', xhr);
                    Swal.fire('Error', 'No se pudieron cargar las empresas disponibles.', 'error');
                }
            });
        }

        function initializeFormHandlers() {
            $('#formUsuario').on('submit', function (e) {
                e.preventDefault();

                if (!validateForm()) {
                    return;
                }

                saveUsuario();
            });

            $('#btnConfirmDelete').on('click', function () {
                deleteUsuario(currentUsuarioId);
            });
        }

        function validateForm() {
            const form = document.getElementById('formUsuario');
            form.classList.add('was-validated');

            const email = $('#Usuario_Email').val();
            const fullName = $('#Usuario_FullName').val();
            const document = $('#Usuario_Document').val();
            const password = $('#Usuario_Password').val();
            const confirmPassword = $('#Usuario_ConfirmPassword').val();

            // Validar campos obligatorios
            if (!email || !fullName || !document) {
                Swal.fire('Error', 'Por favor complete todos los campos obligatorios.', 'error');
                return false;
            }

            // Validar email
            const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            if (!emailRegex.test(email)) {
                Swal.fire('Error', 'El formato del correo electrónico no es válido.', 'error');
                return false;
            }

            // Validar contraseña en modo creación
            if (!isEditMode) {
                if (!password) {
                    Swal.fire('Error', 'La contraseña es obligatoria al crear un usuario.', 'error');
                    return false;
                }
                if (password.length < 6) {
                    Swal.fire('Error', 'La contraseña debe tener al menos 6 caracteres.', 'error');
                    return false;
                }
            }

            // Validar coincidencia de contraseñas
            if (password && password !== confirmPassword) {
                Swal.fire('Error', 'La contraseña y la confirmación no coinciden.', 'error');
                return false;
            }

            return true;
        }

        function openCreateModal() {
            isEditMode = false;
            currentUsuarioId = null;

            $('#modalTitle').text('Nuevo Usuario');
            $('#formUsuario')[0].reset();
            $('#formUsuario').removeClass('was-validated');
            $('#Usuario_Id').val('');
            $('#Usuario_Roles').val([]);
            $('#Usuario_Empresas').val([]);

            // Hacer contraseña obligatoria
            $('#Usuario_Password').prop('required', true);
            $('#Usuario_ConfirmPassword').prop('required', true);
            $('.password-required').show();

            // Mostrar opción de enviar email (solo en creación)
            $('.send-email-check').show();
            $('#Usuario_SendEmail').prop('checked', true);

            $('#modalUsuario').modal('show');
        }

        function openEditModal(id) {
            isEditMode = true;
            currentUsuarioId = id;

            $('#modalTitle').text('Editar Usuario');
            $('#formUsuario')[0].reset();
            $('#formUsuario').removeClass('was-validated');

            // Hacer contraseña opcional
            $('#Usuario_Password').prop('required', false);
            $('#Usuario_ConfirmPassword').prop('required', false);
            $('.password-required').hide();

            // Ocultar opción de enviar email (solo aplica en creación)
            $('.send-email-check').hide();

            $.ajax({
                url: '?handler=Details&id=' + id,
                type: 'GET',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.success) {
                        const usuario = response.data;
                        $('#Usuario_Id').val(usuario.id);
                        $('#Usuario_Email').val(usuario.email);
                        $('#Usuario_FullName').val(usuario.fullName);
                        $('#Usuario_Document').val(usuario.document);
                        $('#Usuario_PhoneNumber').val(usuario.phoneNumber || '');
                        $('#Usuario_EmailConfirmed').prop('checked', usuario.emailConfirmed);

                        // Seleccionar roles
                        $('#Usuario_Roles').val(usuario.roles || []);

                        // Seleccionar empresas
                        $('#Usuario_Empresas').val(usuario.empresaIds || []);

                        $('#modalUsuario').modal('show');
                    } else {
                        Swal.fire('Error', response.message || 'No se pudo cargar la información del usuario.', 'error');
                    }
                },
                error: function (xhr) {
                    console.error('Error al cargar usuario:', xhr);
                    Swal.fire('Error', 'No se pudo cargar la información del usuario.', 'error');
                }
            });
        }

        function saveUsuario() {
            const selectedRoles = $('#Usuario_Roles').val() || [];
            const selectedEmpresas = $('#Usuario_Empresas').val() || [];

            const usuario = {
                id: $('#Usuario_Id').val() || null,
                email: $('#Usuario_Email').val(),
                fullName: $('#Usuario_FullName').val(),
                document: $('#Usuario_Document').val(),
                phoneNumber: $('#Usuario_PhoneNumber').val() || null,
                password: $('#Usuario_Password').val() || null,
                confirmPassword: $('#Usuario_ConfirmPassword').val() || null,
                emailConfirmed: $('#Usuario_EmailConfirmed').is(':checked'),
                roles: selectedRoles,
                empresaIds: selectedEmpresas,
                sendEmail: !isEditMode && $('#Usuario_SendEmail').is(':checked')
            };

            $.ajax({
                url: '?handler=Save',
                type: 'POST',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val(),
                    'Content-Type': 'application/json'
                },
                data: JSON.stringify(usuario),
                success: function (response) {
                    if (response.success) {
                        $('#modalUsuario').modal('hide');
                        Swal.fire({
                            icon: 'success',
                            title: 'Éxito',
                            text: response.message,
                            timer: 2000,
                            showConfirmButton: false
                        });
                        table.ajax.reload();
                    } else {
                        Swal.fire('Error', response.message || 'Error al guardar el usuario.', 'error');
                    }
                },
                error: function (xhr) {
                    console.error('Error al guardar usuario:', xhr);
                    let errorMessage = 'Error al guardar el usuario.';

                    if (xhr.responseText) {
                        try {
                            errorMessage = xhr.responseText;
                        } catch (e) {
                            console.error('Error parsing response:', e);
                        }
                    }

                    Swal.fire('Error', errorMessage, 'error');
                }
            });
        }

        function openDeleteModal(id, nombre) {
            currentUsuarioId = id;
            $('#deleteUsuarioNombre').text(nombre);
            $('#modalDeleteUsuario').modal('show');
        }

        function deleteUsuario(id) {
            $.ajax({
                url: '?handler=Delete&id=' + id,
                type: 'POST',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.success) {
                        $('#modalDeleteUsuario').modal('hide');
                        Swal.fire({
                            icon: 'success',
                            title: 'Éxito',
                            text: response.message,
                            timer: 2000,
                            showConfirmButton: false
                        });
                        table.ajax.reload();
                    } else {
                        Swal.fire('Error', response.message || 'Error al eliminar el usuario.', 'error');
                    }
                },
                error: function (xhr) {
                    console.error('Error al eliminar usuario:', xhr);
                    let errorMessage = 'Error al eliminar el usuario.';

                    if (xhr.responseText) {
                        errorMessage = xhr.responseText;
                    }

                    Swal.fire('Error', errorMessage, 'error');
                }
            });
        }

        function togglePassword(inputId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(inputId + '_icon');

            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }

        function generateRandomPassword() {
            const length = 12;
            const lowercase = "abcdefghijklmnopqrstuvwxyz";
            const uppercase = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
            const numbers = "0123456789";
            const symbols = "!@@#$%^&*";
            const allChars = lowercase + uppercase + numbers + symbols;

            let password = "";

            // Asegurar que tenga al menos un carácter de cada tipo
            password += lowercase.charAt(Math.floor(Math.random() * lowercase.length));
            password += uppercase.charAt(Math.floor(Math.random() * uppercase.length));
            password += numbers.charAt(Math.floor(Math.random() * numbers.length));
            password += symbols.charAt(Math.floor(Math.random() * symbols.length));

            // Completar el resto de la contraseña
            for (let i = password.length; i < length; i++) {
                password += allChars.charAt(Math.floor(Math.random() * allChars.length));
            }

            // Mezclar la contraseña
            password = password.split('').sort(() => Math.random() - 0.5).join('');

            // Establecer la contraseña en ambos campos
            $('#Usuario_Password').val(password);
            $('#Usuario_ConfirmPassword').val(password);

            // Mostrar temporalmente la contraseña
            $('#Usuario_Password').attr('type', 'text');
            $('#Usuario_ConfirmPassword').attr('type', 'text');

            // Mostrar alerta con la contraseña generada
            Swal.fire({
                icon: 'success',
                title: 'Contraseña Generada',
                html: `<p>Contraseña generada exitosamente:</p><p class="text-primary fw-bold">${password}</p><p class="text-muted small">Los campos se ocultarán automáticamente en 5 segundos.</p>`,
                timer: 5000,
                timerProgressBar: true
            }).then(() => {
                // Volver a ocultar la contraseña después de cerrar la alerta
                $('#Usuario_Password').attr('type', 'password');
                $('#Usuario_ConfirmPassword').attr('type', 'password');
            });
        }

        function refrescarTabla() {
            $('#tableUsuariosLoader').show();
            $('#tableUsuariosContainer').hide();
            $('#emptyStateUsuarios').hide();
            table.ajax.reload();
        }

        function exportarExcel() {
            Swal.fire('Info', 'Función de exportación en desarrollo', 'info');
        }

    </script>
}
