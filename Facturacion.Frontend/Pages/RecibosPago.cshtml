        $('#mediosPagoContainer').append(html);
    }

    function eliminarMedioPago(index) {
        const items = $('.medio-pago-item');
        if (items.length === 1) {
            Swal.fire('Advertencia', 'Debe tener al menos un medio de pago', 'warning');
            return;
        }
        $(`.medio-pago-item[data-index="${index}"]`).remove();
    }

    async function generarREP() {
        try {
            // Recolectar medios de pago
            const mediosPago = [];
            $('.medio-pago-item').each(function() {
                const codigo = $(this).find('.medio-pago-select').val();
                const monto = parseFloat($(this).find('.medio-pago-monto').val());
                const referencia = $(this).find('.medio-pago-ref').val();

                if (codigo && monto > 0) {
                    mediosPago.push({
                        codigoMedioPago: codigo,
                        monto: monto,
                        numeroReferencia: referencia || null
                    });
                }
            });

            // Validar que haya al menos un medio de pago
            if (mediosPago.length === 0) {
                Swal.fire('Error', 'Debe agregar al menos un medio de pago', 'error');
                return;
            }

            // Validar suma de medios de pago
            const montoPagado = parseFloat($('#REP_MontoPagado').val());
            const sumaMedios = mediosPago.reduce((sum, m) => sum + m.monto, 0);

            if (Math.abs(sumaMedios - montoPagado) > 0.01) {
                Swal.fire('Error',
                    `La suma de los medios de pago (${formatCurrency(sumaMedios, 'CRC')}) no coincide con el monto a pagar (${formatCurrency(montoPagado, 'CRC')})`,
                    'error');
                return;
            }

            // Preparar datos del REP
            const repData = {
                documentoOriginalId: $('#REP_DocumentoOriginalId').val(),
                fechaPago: $('#REP_FechaPago').val(),
                montoPagado: montoPagado,
                moneda: documentoSeleccionado.moneda,
                tipoCambio: documentoSeleccionado.tipoCambio || null,
                observaciones: $('#REP_Observaciones').val() || null,
                mediosPago: mediosPago
            };

            // Mostrar loading
            Swal.fire({
                title: 'Generando REP...',
                html: 'Generando XML, firmando y enviando a Hacienda...',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            // Enviar a la API
            const response = await fetch(`?handler=GenerarREP&empresaId=${empresaId}&terminalId=${terminalId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                body: JSON.stringify(repData)
            });

            const result = await response.json();

            if (result.exitoso) {
                Swal.fire({
                    icon: 'success',
                    title: 'REP Generado',
                    html: `
                        <p>${result.mensaje}</p>
                        <p><strong>Clave REP:</strong> <small>${result.claveREP}</small></p>
                        <p><strong>Monto Pagado:</strong> ${formatCurrency(result.montoPagado, 'CRC')}</p>
                        <p><strong>Saldo Restante:</strong> ${formatCurrency(result.saldoPendiente, 'CRC')}</p>
                    `,
                    confirmButtonText: 'Aceptar'
                });

                // Cerrar modal y recargar tablas
                bootstrap.Modal.getInstance(document.getElementById('modalGenerarREP')).hide();
                tablePendientes.ajax.reload();
                tableRecibos.ajax.reload();
                loadEstadisticas();
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error al Generar REP',
                    html: `
                        <p>${result.mensaje}</p>
                        ${result.errores && result.errores.length > 0 ?
                            '<ul class="text-start">' + result.errores.map(e => '<li>' + e + '</li>').join('') + '</ul>'
                            : ''}
                    `
                });
            }
        } catch (error) {
            console.error('Error:', error);
            Swal.fire('Error', 'Ocurrió un error al generar el REP: ' + error.message, 'error');
        }
    }

    async function verDetallePagos(documentoId) {
        try {
            const response = await fetch(`?handler=DetallePagos&documentoId=${documentoId}`, {
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                }
            });

            if (!response.ok) {
                throw new Error('Error al obtener detalle');
            }

            const detalle = await response.json();

            // Llenar resumen
            $('#Detalle_Consecutivo').text(detalle.numeroConsecutivo);
            $('#Detalle_TotalVenta').text(formatCurrency(detalle.totalVenta, 'CRC'));
            $('#Detalle_TotalPagado').text(formatCurrency(detalle.totalPagado, 'CRC'));
            $('#Detalle_SaldoPendiente').text(formatCurrency(detalle.saldoPendiente, 'CRC'));

            // Llenar tabla de pagos
            const tbody = $('#detallesPagosBody');
            tbody.empty();

            if (detalle.pagos && detalle.pagos.length > 0) {
                detalle.pagos.forEach(pago => {
                    const row = `
                        <tr>
                            <td>${new Date(pago.fechaPago).toLocaleDateString('es-CR')}</td>
                            <td>${pago.numeroConsecutivoREP}</td>
                            <td><small>${pago.claveREP}</small></td>
                            <td class="text-end">${formatCurrency(pago.montoPagado, 'CRC')}</td>
                            <td class="text-end">${formatCurrency(pago.saldoRestante, 'CRC')}</td>
                            <td>${pago.mediosPago.join(', ')}</td>
                            <td>${getEstadoBadge(pago.estado)}</td>
                        </tr>
                    `;
                    tbody.append(row);
                });
            } else {
                tbody.append('<tr><td colspan="7" class="text-center text-muted">No hay pagos registrados</td></tr>');
            }

            // Show modal
            new bootstrap.Modal(document.getElementById('modalDetallePagos')).show();
        } catch (error) {
            console.error('Error:', error);
            Swal.fire('Error', 'No se pudo cargar el detalle de pagos', 'error');
        }
    }

    async function verXMLREP(documentoREPId) {
        try {
            const response = await fetch(`?handler=XML&documentoId=${documentoREPId}`, {
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                }
            });

            if (!response.ok) {
                throw new Error('Error al obtener XML');
            }

            const data = await response.json();
            $('#xmlContent').text(data.xml);

            // Store for download
            window.currentXML = {
                xml: data.xml,
                clave: data.clave
            };

            new bootstrap.Modal(document.getElementById('modalVerXML')).show();
        } catch (error) {
            console.error('Error:', error);
            Swal.fire('Error', 'No se pudo cargar el XML', 'error');
        }
    }

    function copiarXML() {
        const xml = $('#xmlContent').text();
        navigator.clipboard.writeText(xml).then(() => {
            Swal.fire({
                icon: 'success',
                title: 'XML Copiado',
                text: 'El XML ha sido copiado al portapapeles',
                timer: 1500,
                showConfirmButton: false
            });
        });
    }

    function descargarXML() {
        if (window.currentXML) {
            const blob = new Blob([window.currentXML.xml], { type: 'text/xml' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `REP_${window.currentXML.clave}.xml`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            window.URL.revokeObjectURL(url);
        }
    }

    async function descargarPDF(documentoREPId) {
        Swal.fire('Información', 'La generación de PDF estará disponible próximamente', 'info');
    }

    function loadDocumentosPendientes() {
        tablePendientes.ajax.reload();
        loadEstadisticas();
    }

    function loadRecibosGenerados() {
        tableRecibos.ajax.reload();
    }

    function formatCurrency(amount, currency) {
        const symbol = currency === 'USD' ? '$' : '₡';
        return `${symbol} ${parseFloat(amount).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    }

    function getEstadoBadge(estado) {
        const estados = {
            'Aceptado': '<span class="badge bg-success">Aceptado</span>',
            'Procesando': '<span class="badge bg-warning">Procesando</span>',
            'Rechazado': '<span class="badge bg-danger">Rechazado</span>',
            'Pendiente': '<span class="badge bg-secondary">Pendiente</span>'
        };
        return estados[estado] || estado;
    }
</script>
