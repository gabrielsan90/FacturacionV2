        function calculateLineSubtotal() {
            const cantidad = parseFloat($('#Linea_Cantidad').val()) || 0;
            const precio = parseFloat($('#Linea_PrecioUnitario').val()) || 0;
            const descPorcentaje = parseFloat($('#Linea_DescuentoPorcentaje').val()) || 0;
            const impPorcentaje = parseFloat($('#Linea_ImpuestoPorcentaje').val()) || 0;

            const montoTotal = cantidad * precio;
            const descuento = montoTotal * (descPorcentaje / 100);
            const subtotal = montoTotal - descuento;
            const impuesto = subtotal * (impPorcentaje / 100);
            const total = subtotal + impuesto;

            $('#lblSubtotalLinea').text(formatCurrency(total));
        }

        function openLineModal(index = -1) {
            $('#formLinea')[0].reset();
            $('#formLinea').removeClass('was-validated');
            $('#Linea_Index').val(index);
            $('#Linea_ProductoId').val(null).trigger('change');

            if (index >= 0) {
                // Edit mode
                const line = documentLines[index];
                $('#modalLineaTitle').text('Editar Línea');
