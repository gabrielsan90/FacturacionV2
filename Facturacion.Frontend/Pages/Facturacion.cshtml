        function actualizarContadorErrores() {
            // Ejecutar validacion silenciosa
            ValidacionesFE.limpiarErrores();

            // Solo validar campos visibles/activos
            if (currentTipoDocumento) {
                ValidacionesFE.validarTipoDocumento();
                ValidacionesFE.validarCondicionVenta();
                ValidacionesFE.validarMedioPago();

                if ($('#ClienteId').val()) {
                    ValidacionesFE.validarReceptorNombre();
                    ValidacionesFE.validarReceptorIdentificacion();
                }

                ValidacionesFE.validarReferencias();
                ValidacionesFE.validarExportacion();
            }

            const errores = ValidacionesFE.getCantidadErrores();
            const $badge = $('#btnValidar .badge');

            if (errores > 0) {
                $badge.text(errores).removeClass('bg-success').addClass('bg-danger').show();
            } else {
                $badge.text('0').removeClass('bg-danger').addClass('bg-success').hide();
            }
        }

