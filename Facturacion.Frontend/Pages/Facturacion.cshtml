                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label for="Linea_UnidadMedida" class="form-label">Unidad de Medida <span class="text-danger">*</span></label>
                            <select class="form-select" id="Linea_UnidadMedida" required>
                                <option value="Unid">Unid - Unidad</option>
                                <option value="Kg">Kg - Kilogramo</option>
                                <option value="g">g - Gramo</option>
                                <option value="L">L - Litro</option>
                                <option value="mL">mL - Mililitro</option>
                                <option value="m">m - Metro</option>
                                <option value="m2">m² - Metro cuadrado</option>
                                <option value="m3">m³ - Metro cúbico</option>
                                <option value="Sp">Sp - Servicios profesionales</option>
                                <option value="Spe">Spe - Servicios personales</option>
                                <option value="Os">Os - Otros servicios</option>
                                <option value="Al">Al - Alquiler</option>
                                <option value="h">h - Hora</option>
                                <option value="d">d - Día</option>
                                <option value="Cm">Cm - Comisión</option>
                                <option value="Otros">Otros</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="Linea_TipoProducto" class="form-label">Tipo de Producto</label>
                            <select class="form-select" id="Linea_TipoProducto">
                                <option value="mercancia">Mercancía (Bien)</option>
                                <option value="servicio">Servicio</option>
                            </select>
                            <small class="text-muted">Se detecta automáticamente por la unidad</small>
                        </div>
                        <div class="col-md-4">
                            <label for="Linea_CodigoTarifaIVA" class="form-label">Código Tarifa IVA</label>
                            <select class="form-select" id="Linea_CodigoTarifaIVA">
                                <option value="08">08 - Tarifa general 13%</option>
                                <option value="01">01 - Tarifa 0%</option>
                                <option value="02">02 - Tarifa reducida 1%</option>
                                <option value="03">03 - Tarifa reducida 2%</option>
                                <option value="04">04 - Tarifa reducida 4%</option>
                                <option value="10">10 - Exento</option>
                            </select>
                        </div>
                    </div>

                    <!-- Campos adicionales v4.4 -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="Linea_TipoTransaccion" class="form-label">Tipo de Transacción</label>
                            <select class="form-select" id="Linea_TipoTransaccion">
                                <option value="">-- Seleccione --</option>
                                <option value="01">01 - Venta de bienes</option>
                                <option value="02">02 - Venta de servicios</option>
                                <option value="03">03 - Importación de bienes</option>
                                <option value="04">04 - Importación de servicios</option>
                                <option value="05">05 - Exportación de bienes</option>
                                <option value="06">06 - Exportación de servicios</option>
                                <option value="07">07 - Compras locales de bienes</option>
                                <option value="08">08 - Compras locales de servicios</option>
                                <option value="09">09 - Devolución de mercancías</option>
                                <option value="10">10 - Descuentos y bonificaciones</option>
                                <option value="11">11 - Anticipos</option>
                                <option value="12">12 - Arrendamiento</option>
                                <option value="13">13 - Otros</option>
                            </select>
                            <small class="text-muted">Opcional - Tipo de transacción v4.4</small>
                        </div>
                        <div class="col-md-6">
                            <label for="Linea_CodigoCabys" class="form-label">Código CAByS <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="Linea_CodigoCabys" maxlength="13" placeholder="1234567890123">
                                <button class="btn btn-outline-secondary" type="button" id="btnBuscarCabys" title="Buscar código CABYS">
                                    <i class="fas fa-search"></i>
                                </button>
                            </div>
                            <small id="lblCabysDescripcion" class="text-info fw-semibold" style="display: none;"></small>
                            <small class="text-muted">13 caracteres - Obligatorio desde 01/06/2025</small>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="Linea_FormaFarmaceutica" class="form-label">Forma Farmacéutica</label>
                            <select class="form-select" id="Linea_FormaFarmaceutica">
                                <option value="">-- Seleccione --</option>
                            </select>
                            <small class="text-muted">Solo para productos farmacéuticos</small>
                        </div>
                        <div class="col-md-6">
                            <label for="Linea_DetalleSurtido" class="form-label">Detalle Surtido</label>
                            <textarea class="form-control" id="Linea_DetalleSurtido" rows="2" maxlength="1000" placeholder="Detalle de combos/paquetes..."></textarea>
                            <small class="text-muted">Máx. 1000 caracteres - Para combos/paquetes</small>
                        </div>
                    </div>

                    <!-- Calculated Subtotal -->
                    <div class="row">
                        <div class="col-md-12">
                            <div class="alert alert-info">
                                <strong>Subtotal de Línea:</strong> <span id="lblSubtotalLinea">₡0.00</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-check"></i> Agregar Línea
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- DataTables -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>

    <!-- Select2 -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        /* Estilos para validaciones en tiempo real */
        .validation-error {
            border-color: #dc3545 !important;
            box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25) !important;
        }
        .validation-success {
            border-color: #28a745 !important;
        }
        .validation-warning {
            border-color: #ffc107 !important;
            box-shadow: 0 0 0 0.2rem rgba(255, 193, 7, 0.25) !important;
        }
        .field-error-message {
            color: #dc3545;
            font-size: 0.85em;
            margin-top: 4px;
            display: none;
        }
        .field-error-message.show {
            display: block;
        }
        .validation-summary {
            max-height: 300px;
            overflow-y: auto;
        }
        .validation-summary ul {
            margin-bottom: 0;
        }
        .validation-summary li {
            margin-bottom: 5px;
        }
        .validation-icon {
            margin-right: 5px;
        }
        .btn-validar {
            position: relative;
        }
        .btn-validar .badge {
            position: absolute;
            top: -8px;
            right: -8px;
            font-size: 0.7em;
        }
        /* Indicador de campo obligatorio */
        .campo-obligatorio::after {
            content: " *";
            color: #dc3545;
        }
        /* Animacion para errores */
        @@keyframes shake {
            0%, 100% { transform: translateX(0); }
            10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }
            20%, 40%, 60%, 80% { transform: translateX(5px); }
        }
        .shake {
            animation: shake 0.5s ease-in-out;
        }
        /* Linea con error en tabla */
        .linea-con-error {
            background-color: #f8d7da !important;
        }
    </style>

    <script>
        const empresaId = '@Model.EmpresaId';
        const documentoId = '@Model.DocumentoId';
        const isEditMode = documentoId && documentoId !== '';

        let documentLines = [];
        let sucursales = [];
        let terminales = [];
        let currentTipoDocumento = null;
        let clienteSeleccionado = null;
        let documentoEnEdicion = null;

        // ============================================
        // SISTEMA DE VALIDACIONES EN TIEMPO REAL
        // Segun especificaciones Hacienda CR v4.4
        // ============================================

        const ValidacionesFE = {
            // Configuracion de tipos de identificacion segun Hacienda v4.4
            tiposIdentificacion: {
                '1': { nombre: 'Cedula Fisica', digitos: 9, regex: /^\d{9}$/ },
                '2': { nombre: 'Cedula Juridica', digitos: 10, regex: /^\d{10}$/ },
                '3': { nombre: 'DIMEX', digitos: [11, 12], regex: /^\d{11,12}$/ },
                '4': { nombre: 'NITE', digitos: 10, regex: /^\d{10}$/ },
                '5': { nombre: 'Pasaporte', digitos: null, regex: /^.{1,20}$/ },
                '6': { nombre: 'Extranjera', digitos: null, regex: /^.{1,20}$/ }
            },

            // Condiciones de venta que son credito (no requieren medio de pago inmediato)
            condicionesCredito: ['02', '08', '10'],

            // Codigos de tarifa IVA validos segun Hacienda v4.4
            codigosTarifaIVA: {
                '01': { tarifa: 0, descripcion: 'Tarifa 0% - No sujeto' },
                '02': { tarifa: 1, descripcion: 'Tarifa 1% - Canasta basica' },
                '03': { tarifa: 2, descripcion: 'Tarifa 2% - Medicamentos' },
                '04': { tarifa: 4, descripcion: 'Tarifa 4% - Boletos aereos' },
                '05': { tarifa: 0, descripcion: 'Transitorio 0%' },
                '06': { tarifa: 1, descripcion: 'Transitorio 1%' },
                '07': { tarifa: 2, descripcion: 'Transitorio 2%' },
                '08': { tarifa: 13, descripcion: 'Tarifa 13% - General' },
                '10': { tarifa: 0, descripcion: 'Exento' }
            },

            // Codigos de referencia validos para NC/ND
            codigosReferencia: ['01', '02', '03', '04', '05', '11', '99'],

            // Almacena errores encontrados
            errores: [],

            // Limpia errores previos
            limpiarErrores: function() {
                this.errores = [];
                // Limpiar clases de error
                $('.validation-error, .validation-warning').removeClass('validation-error validation-warning');
                $('.field-error-message').removeClass('show').text('');
            },

            // Agrega un error
            agregarError: function(campo, mensaje, tipo = 'error') {
                this.errores.push({
                    campo: campo,
                    mensaje: mensaje,
                    tipo: tipo
                });
            },

            // Marca un campo como invalido
            marcarCampoInvalido: function(selector, mensaje) {
                const $campo = $(selector);
                $campo.addClass('validation-error').removeClass('validation-success');

                // Buscar o crear mensaje de error
                let $errorMsg = $campo.siblings('.field-error-message');
                if ($errorMsg.length === 0) {
                    $errorMsg = $('<div class="field-error-message"></div>');
                    $campo.after($errorMsg);
                }
                $errorMsg.text(mensaje).addClass('show');
            },

            // Marca un campo como valido
            marcarCampoValido: function(selector) {
                const $campo = $(selector);
                $campo.removeClass('validation-error validation-warning').addClass('validation-success');
                $campo.siblings('.field-error-message').removeClass('show');
            },

            // Limpia validacion de un campo
            limpiarCampo: function(selector) {
                const $campo = $(selector);
                $campo.removeClass('validation-error validation-warning validation-success');
                $campo.siblings('.field-error-message').removeClass('show');
            },

            // ========================================
            // VALIDACIONES INDIVIDUALES
            // ========================================

            // Valida tipo de documento
            validarTipoDocumento: function() {
                const tipo = $('#TipoDocumento').val();
                if (!tipo) {
                    this.marcarCampoInvalido('#TipoDocumento', 'Seleccione un tipo de documento');
                    this.agregarError('TipoDocumento', 'Tipo de documento es obligatorio');
                    return false;
                }
                this.marcarCampoValido('#TipoDocumento');
                return true;
            },

            // Valida actividad economica (6 caracteres: puede ser 6 digitos o formato XXXX.X)
            validarActividadEconomica: function(selector, nombreCampo) {
                const valor = $(selector).val();
                if (!valor) {
                    this.marcarCampoInvalido(selector, 'La actividad economica es obligatoria');
                    this.agregarError(nombreCampo, 'Actividad economica es obligatoria');
                    return false;
                }
                // Acepta: 620900 (6 digitos) o 6202.0, 7020.0 (formato con punto)
                if (!/^(\d{6}|\d{4}\.\d|\d{5}\.\d?)$/.test(valor)) {
                    this.marcarCampoInvalido(selector, 'Formato: 6 digitos o con punto (ej: 620900, 6202.0)');
                    this.agregarError(nombreCampo, 'Formato invalido: debe ser 6 caracteres (ej: 620900 o 6202.0)');
                    return false;
                }
                this.marcarCampoValido(selector);
                return true;
            },

            // Valida condicion de venta
            validarCondicionVenta: function() {
                const condicion = $('#CondicionVenta').val();
                if (!condicion) {
                    this.marcarCampoInvalido('#CondicionVenta', 'Seleccione una condicion de venta');
                    this.agregarError('CondicionVenta', 'Condicion de venta es obligatoria');
                    return false;
                }
                this.marcarCampoValido('#CondicionVenta');
                return true;
            },

            // Valida medio de pago
            validarMedioPago: function() {
                const condicion = $('#CondicionVenta').val();
                const medioPago = $('#MedioPago').val();

                // Si es credito, el medio de pago no es obligatorio
                if (this.condicionesCredito.includes(condicion)) {
                    this.limpiarCampo('#MedioPago');
                    return true;
                }

                if (!medioPago) {
                    this.marcarCampoInvalido('#MedioPago', 'Seleccione un medio de pago');
                    this.agregarError('MedioPago', 'Medio de pago es obligatorio para ventas de contado');
                    return false;
                }
                this.marcarCampoValido('#MedioPago');
                return true;
            },

            // Valida plazo de credito
            validarPlazoCredito: function() {
                const condicion = $('#CondicionVenta').val();
                const plazo = $('#PlazoCreditoDias').val();

                if (condicion === '02') { // Credito
                    if (!plazo || parseInt(plazo) < 1) {
                        this.marcarCampoInvalido('#PlazoCreditoDias', 'Ingrese el plazo de credito en dias');
                        this.agregarError('PlazoCreditoDias', 'Plazo de credito obligatorio para ventas a credito');
                        return false;
                    }
                    this.marcarCampoValido('#PlazoCreditoDias');
                }
                return true;
            },

            // Valida nombre del receptor
            validarReceptorNombre: function() {
                const tipo = $('#TipoDocumento').val();
                const nombre = $('#ClienteNombre').val();

                // Tiquetes (04) no requieren receptor obligatorio
                if (tipo === '4') {
                    this.limpiarCampo('#ClienteNombre');
                    return true;
                }

                if (!nombre || nombre.trim() === '') {
                    this.marcarCampoInvalido('#ClienteNombre', 'El nombre del receptor es obligatorio');
                    this.agregarError('ClienteNombre', 'Nombre del receptor es obligatorio para Facturas');
                    return false;
                }

                if (nombre.length > 200) {
                    this.marcarCampoInvalido('#ClienteNombre', 'Maximo 200 caracteres');
                    this.agregarError('ClienteNombre', 'Nombre excede 200 caracteres');
                    return false;
                }

                this.marcarCampoValido('#ClienteNombre');
                return true;
            },

            // Valida numero de identificacion segun tipo
            validarReceptorIdentificacion: function() {
                const tipoDoc = $('#TipoDocumento').val();
                const tipoId = $('#ClienteTipoIdentificacion').val();
                const numero = $('#ClienteIdentificacion').val();

                // Tiquetes no requieren identificacion obligatoria
                if (tipoDoc === '4') {
                    this.limpiarCampo('#ClienteIdentificacion');
                    return true;
                }

                if (!numero) {
                    this.marcarCampoInvalido('#ClienteIdentificacion', 'El numero de identificacion es obligatorio');
                    this.agregarError('ClienteIdentificacion', 'Numero de identificacion es obligatorio');
                    return false;
                }

                const config = this.tiposIdentificacion[tipoId];
                if (!config) {
                    this.limpiarCampo('#ClienteIdentificacion');
                    return true;
                }

                if (!config.regex.test(numero)) {
                    let mensaje = '';
                    if (Array.isArray(config.digitos)) {
                        mensaje = `${config.nombre} debe tener ${config.digitos[0]}-${config.digitos[1]} digitos`;
                    } else if (config.digitos) {
                        mensaje = `${config.nombre} debe tener exactamente ${config.digitos} digitos`;
                    } else {
                        mensaje = `Formato invalido para ${config.nombre}`;
                    }
                    this.marcarCampoInvalido('#ClienteIdentificacion', mensaje);
                    this.agregarError('ClienteIdentificacion', mensaje);
                    return false;
                }

                this.marcarCampoValido('#ClienteIdentificacion');
                return true;
            },

            // Valida actividad economica del receptor (obligatoria en v4.4 para Facturas)
            validarReceptorActividadEconomica: function() {
                const tipoDoc = $('#TipoDocumento').val();
                const actividad = $('#ClienteActividadEconomica').val();

                // Solo obligatorio para Facturas (no Tiquetes)
                if (tipoDoc === '4') {
                    this.limpiarCampo('#ClienteActividadEconomica');
                    return true;
                }

                // En v4.4, la actividad economica del receptor es recomendada pero no bloqueante
                // Marcamos advertencia pero no error
                if (!actividad || actividad.trim() === '') {
                    // Solo advertencia, no error
                    $('#ClienteActividadEconomica').addClass('validation-warning');
                    return true;
                }

                // Acepta: 620900 (6 digitos) o 6202.0, 7020.0 (formato con punto)
                if (!/^(\d{6}|\d{4}\.\d|\d{5}\.\d?)$/.test(actividad)) {
                    this.marcarCampoInvalido('#ClienteActividadEconomica', 'Formato: 6 digitos o con punto (ej: 6202.0)');
                    this.agregarError('ClienteActividadEconomica', 'Formato invalido de actividad economica del receptor');
                    return false;
                }

                this.marcarCampoValido('#ClienteActividadEconomica');
                return true;
            },

            // Valida que haya al menos una linea
            validarLineasMinimo: function() {
                if (documentLines.length === 0) {
                    this.agregarError('Lineas', 'Debe agregar al menos una linea de detalle');
                    return false;
                }
                return true;
            },

            // Valida una linea individual
            validarLinea: function(linea, index) {
                let valida = true;
                const numeroLinea = index + 1;

                // Codigo CABYS obligatorio (13 digitos)
                if (!linea.codigoCabys) {
                    this.agregarError(`Linea${numeroLinea}`, `Linea ${numeroLinea}: Codigo CABYS es obligatorio`);
                    valida = false;
                } else if (!/^\d{13}$/.test(linea.codigoCabys)) {
                    this.agregarError(`Linea${numeroLinea}`, `Linea ${numeroLinea}: Codigo CABYS debe tener 13 digitos`);
                    valida = false;
                }

                // Cantidad > 0
                if (!linea.cantidad || linea.cantidad <= 0) {
                    this.agregarError(`Linea${numeroLinea}`, `Linea ${numeroLinea}: Cantidad debe ser mayor a 0`);
                    valida = false;
                }

                // Precio unitario >= 0
                if (linea.precioUnitario === undefined || linea.precioUnitario === null || linea.precioUnitario < 0) {
                    this.agregarError(`Linea${numeroLinea}`, `Linea ${numeroLinea}: Precio unitario debe ser mayor o igual a 0`);
                    valida = false;
                }

                // Descripcion obligatoria
                if (!linea.descripcion || linea.descripcion.trim() === '') {
                    this.agregarError(`Linea${numeroLinea}`, `Linea ${numeroLinea}: Descripcion es obligatoria`);
                    valida = false;
                }

                return valida;
            },

            // Valida todas las lineas
            validarTodasLasLineas: function() {
                let todasValidas = true;

                // Marcar todas las filas como limpias primero
                $('#tbodyLineas tr').removeClass('linea-con-error');

                documentLines.forEach((linea, index) => {
                    if (!this.validarLinea(linea, index)) {
                        todasValidas = false;
                        // Marcar fila con error
                        $(`#tbodyLineas tr:eq(${index})`).addClass('linea-con-error');
                    }
                });

                return todasValidas;
            },

            // Valida calculos de totales
            validarCalculos: function() {
                let subtotalCalculado = 0;
                let descuentosCalculados = 0;
                let impuestosCalculados = 0;

                documentLines.forEach(linea => {
                    const montoTotal = linea.cantidad * linea.precioUnitario;
                    subtotalCalculado += montoTotal;
                    descuentosCalculados += linea.montoDescuento || 0;
                    impuestosCalculados += linea.montoImpuesto || 0;
                });

                const totalCalculado = subtotalCalculado - descuentosCalculados + impuestosCalculados;

                // Los totales se calculan automaticamente, solo verificamos coherencia
                return true;
            },

            // Valida referencias para NC/ND
            validarReferencias: function() {
                const tipoDoc = $('#TipoDocumento').val();

                // Solo obligatorio para NC (03) y ND (02)
                if (tipoDoc !== '2' && tipoDoc !== '3') {
                    return true;
                }

                const claveRef = $('#DocumentoReferenciaNumero').val();
                const codigoRef = $('#RazonReferencia').val();

                // Clave de referencia obligatoria
                if (!claveRef) {
                    this.marcarCampoInvalido('#DocumentoReferenciaNumero', 'Seleccione un documento de referencia');
                    this.agregarError('DocumentoReferencia', 'Documento de referencia es obligatorio para NC/ND');
                    return false;
                }

                // Codigo de referencia obligatorio
                if (!codigoRef) {
                    this.marcarCampoInvalido('#RazonReferencia', 'Seleccione una razon');
                    this.agregarError('RazonReferencia', 'Razon de referencia es obligatoria para NC/ND');
                    return false;
                }

                // Validar que el codigo sea valido
                if (!this.codigosReferencia.includes(codigoRef)) {
                    this.marcarCampoInvalido('#RazonReferencia', 'Codigo de referencia invalido');
                    this.agregarError('RazonReferencia', 'Codigo de referencia debe ser: 01-05, 11 o 99');
                    return false;
                }

                this.marcarCampoValido('#DocumentoReferenciaNumero');
                this.marcarCampoValido('#RazonReferencia');
                return true;
            },

            // Valida campos de exportacion
            validarExportacion: function() {
                const tipoDoc = $('#TipoDocumento').val();

                if (tipoDoc !== '9') {
                    return true;
                }

                let valido = true;

                if (!$('#Incoterm').val()) {
                    this.marcarCampoInvalido('#Incoterm', 'Seleccione un Incoterm');
                    this.agregarError('Incoterm', 'Incoterm es obligatorio para Facturas de Exportacion');
                    valido = false;
                } else {
                    this.marcarCampoValido('#Incoterm');
                }

                if (!$('#PaisDestino').val()) {
                    this.marcarCampoInvalido('#PaisDestino', 'Seleccione un pais de destino');
                    this.agregarError('PaisDestino', 'Pais de destino es obligatorio para Facturas de Exportacion');
                    valido = false;
                } else {
                    this.marcarCampoValido('#PaisDestino');
                }

                return valido;
            },

            // Valida direccion del receptor
            validarDireccionReceptor: function() {
                const tipoDoc = $('#TipoDocumento').val();
                const tipoId = $('#ClienteTipoIdentificacion').val();

                // Tiquetes no requieren direccion
                if (tipoDoc === '4') {
                    return true;
                }

                let valido = true;

                // Clientes nacionales requieren provincia, canton, distrito
                if (tipoId !== '6') {
                    if (!$('#ClienteProvincia').val()) {
                        this.marcarCampoInvalido('#ClienteProvincia', 'Seleccione una provincia');
                        this.agregarError('ClienteProvincia', 'Provincia es obligatoria');
                        valido = false;
                    } else {
                        this.marcarCampoValido('#ClienteProvincia');
                    }

                    if (!$('#ClienteCanton').val()) {
                        this.marcarCampoInvalido('#ClienteCanton', 'Seleccione un canton');
                        this.agregarError('ClienteCanton', 'Canton es obligatorio');
                        valido = false;
                    } else {
                        this.marcarCampoValido('#ClienteCanton');
                    }

                    if (!$('#ClienteDistrito').val()) {
                        this.marcarCampoInvalido('#ClienteDistrito', 'Seleccione un distrito');
                        this.agregarError('ClienteDistrito', 'Distrito es obligatorio');
                        valido = false;
                    } else {
                        this.marcarCampoValido('#ClienteDistrito');
                    }
                }

                // Otras senas siempre obligatorio segun v4.4
                if (!$('#ClienteOtrasSenas').val()) {
                    this.marcarCampoInvalido('#ClienteOtrasSenas', 'Direccion exacta es obligatoria segun Hacienda v4.4');
                    this.agregarError('ClienteOtrasSenas', 'Otras senas (direccion) es obligatorio');
                    valido = false;
                } else {
                    this.marcarCampoValido('#ClienteOtrasSenas');
                }

                return valido;
            },

            // ========================================
            // VALIDACION COMPLETA
            // ========================================

            validarTodo: function(mostrarResumen = true) {
                this.limpiarErrores();

                let esValido = true;

                // 1. Datos del documento
                if (!this.validarTipoDocumento()) esValido = false;
                if (!this.validarActividadEconomica('#EmisorActividadEconomica', 'ActividadEconomica')) esValido = false;
                if (!this.validarCondicionVenta()) esValido = false;
                if (!this.validarMedioPago()) esValido = false;
                if (!this.validarPlazoCredito()) esValido = false;

                // 2. Datos del receptor
                if (!this.validarReceptorNombre()) esValido = false;
                if (!this.validarReceptorIdentificacion()) esValido = false;
                if (!this.validarReceptorActividadEconomica()) esValido = false;
                if (!this.validarDireccionReceptor()) esValido = false;

                // 3. Lineas de detalle
                if (!this.validarLineasMinimo()) esValido = false;
                if (!this.validarTodasLasLineas()) esValido = false;

                // 4. Calculos
                if (!this.validarCalculos()) esValido = false;

                // 5. Referencias (NC/ND)
                if (!this.validarReferencias()) esValido = false;

                // 6. Exportacion
                if (!this.validarExportacion()) esValido = false;

                // Mostrar resumen si se solicita
                if (mostrarResumen) {
                    this.mostrarResumenValidacion(esValido);
                }

                return esValido;
            },

            // Muestra resumen de validacion con SweetAlert2
            mostrarResumenValidacion: function(esValido) {
                if (esValido) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Validacion Exitosa',
                        text: 'El documento cumple con todas las validaciones requeridas por Hacienda v4.4',
                        confirmButtonText: 'Excelente',
                        timer: 3000
                    });
                } else {
                    let htmlErrores = '<div class="validation-summary text-start"><ul class="list-unstyled">';

                    this.errores.forEach(error => {
                        const icono = error.tipo === 'warning'
                            ? '<i class="fas fa-exclamation-triangle text-warning validation-icon"></i>'
                            : '<i class="fas fa-times-circle text-danger validation-icon"></i>';
                        htmlErrores += `<li>${icono}${error.mensaje}</li>`;
                    });

                    htmlErrores += '</ul></div>';

                    Swal.fire({
                        icon: 'error',
                        title: 'Errores de Validacion',
                        html: htmlErrores,
                        confirmButtonText: 'Corregir Errores',
                        width: '600px'
                    });
                }
            },

            // Obtiene cantidad de errores
            getCantidadErrores: function() {
                return this.errores.length;
            }
        };

        // ============================================
        // VALIDACION DE LINEA EN MODAL
        // ============================================
        const ValidacionLinea = {
            validarCabysCodigo: function() {
                const codigo = $('#Linea_CodigoCabys').val();

                if (!codigo) {
                    ValidacionesFE.marcarCampoInvalido('#Linea_CodigoCabys', 'Codigo CABYS es obligatorio (13 digitos)');
                    return false;
                }

                if (!/^\d{13}$/.test(codigo)) {
                    ValidacionesFE.marcarCampoInvalido('#Linea_CodigoCabys', 'Debe tener exactamente 13 digitos numericos');
                    return false;
                }

                ValidacionesFE.marcarCampoValido('#Linea_CodigoCabys');
                return true;
            },

            validarCantidad: function() {
                const cantidad = parseFloat($('#Linea_Cantidad').val());

                if (!cantidad || cantidad <= 0) {
                    ValidacionesFE.marcarCampoInvalido('#Linea_Cantidad', 'Cantidad debe ser mayor a 0');
                    return false;
                }

                ValidacionesFE.marcarCampoValido('#Linea_Cantidad');
                return true;
            },

            validarPrecio: function() {
                const precio = parseFloat($('#Linea_PrecioUnitario').val());

                if (precio === undefined || precio === null || isNaN(precio) || precio < 0) {
                    ValidacionesFE.marcarCampoInvalido('#Linea_PrecioUnitario', 'Precio debe ser mayor o igual a 0');
                    return false;
                }

                ValidacionesFE.marcarCampoValido('#Linea_PrecioUnitario');
                return true;
            },

            validarDescripcion: function() {
                const descripcion = $('#Linea_Descripcion').val();

                if (!descripcion || descripcion.trim() === '') {
                    ValidacionesFE.marcarCampoInvalido('#Linea_Descripcion', 'Descripcion es obligatoria');
                    return false;
                }

                if (descripcion.length > 500) {
                    ValidacionesFE.marcarCampoInvalido('#Linea_Descripcion', 'Maximo 500 caracteres');
                    return false;
                }

                ValidacionesFE.marcarCampoValido('#Linea_Descripcion');
                return true;
            },

            validarTodo: function() {
                let valido = true;

                if (!this.validarCabysCodigo()) valido = false;
                if (!this.validarCantidad()) valido = false;
                if (!this.validarPrecio()) valido = false;
                if (!this.validarDescripcion()) valido = false;

                return valido;
            }
        };

