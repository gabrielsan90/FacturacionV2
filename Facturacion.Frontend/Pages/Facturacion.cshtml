        function addOrUpdateLine() {
            if (!$('#formLinea')[0].checkValidity()) {
                $('#formLinea').addClass('was-validated');
                return;
            }

            const index = parseInt($('#Linea_Index').val());
            const cantidad = parseFloat($('#Linea_Cantidad').val());
            const precio = parseFloat($('#Linea_PrecioUnitario').val());
            const descPorcentaje = parseFloat($('#Linea_DescuentoPorcentaje').val()) || 0;
            const impPorcentaje = parseFloat($('#Linea_ImpuestoPorcentaje').val()) || 0;

            const montoTotal = cantidad * precio;
            const descuento = montoTotal * (descPorcentaje / 100);
            const subtotal = montoTotal - descuento;
            const impuesto = subtotal * (impPorcentaje / 100);
            const total = subtotal + impuesto;

            const line = {
                codigo: $('#Linea_Codigo').val(),
                descripcion: $('#Linea_Descripcion').val(),
                cantidad: cantidad,
                precioUnitario: precio,
                descuentoPorcentaje: descPorcentaje,
                impuestoPorcentaje: impPorcentaje,
                montoDescuento: descuento,
                montoImpuesto: impuesto,
                subtotal: total
            };

            if (index >= 0) {
                // Update existing line
                documentLines[index] = line;
            } else {
                // Add new line
                documentLines.push(line);
            }

            renderLines();
            calculateTotals();
            $('#modalLinea').modal('hide');
        }

        function renderLines() {
            const tbody = $('#tbodyLineas');
            tbody.empty();

            if (documentLines.length === 0) {
                tbody.append(`
                    <tr id="emptyRow">
                        <td colspan="8" class="text-center text-muted">
                            <i class="fas fa-inbox"></i> No hay líneas agregadas. Haga clic en "Agregar Línea" para comenzar.
                        </td>
                    </tr>
                `);
                return;
            }

            documentLines.forEach(function (line, index) {
                tbody.append(`
                    <tr>
                        <td>${line.codigo || '-'}</td>
                        <td>${line.descripcion}</td>
                        <td class="text-end">${line.cantidad.toFixed(3)}</td>
                        <td class="text-end">${formatCurrency(line.precioUnitario)}</td>
                        <td class="text-end">${line.descuentoPorcentaje.toFixed(2)}%</td>
                        <td class="text-end">${line.impuestoPorcentaje.toFixed(2)}%</td>
                        <td class="text-end">${formatCurrency(line.subtotal)}</td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-warning" onclick="editLine(${index})" title="Editar">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-danger" onclick="deleteLine(${index})" title="Eliminar">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                `);
            });
        }

        function editLine(index) {
            openLineModal(index);
        }

        function deleteLine(index) {
            Swal.fire({
                title: '¿Está seguro?',
                text: '¿Desea eliminar esta línea?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    documentLines.splice(index, 1);
                    renderLines();
                    calculateTotals();
                }
            });
        }

        function calculateTotals() {
            let subtotal = 0;
            let descuentos = 0;
            let impuestos = 0;

            documentLines.forEach(function (line) {
                const montoTotal = line.cantidad * line.precioUnitario;
                subtotal += montoTotal;
                descuentos += line.montoDescuento;
                impuestos += line.montoImpuesto;
            });

            const total = subtotal - descuentos + impuestos;

            $('#lblSubtotal').text(formatCurrency(subtotal));
            $('#lblDescuentos').text(formatCurrency(descuentos));
            $('#lblImpuestos').text(formatCurrency(impuestos));
            $('#lblTotal').text(formatCurrency(total));
        }

        function saveDocument(estado) {
            // Validate form
            if (!validateForm()) {
                return;
            }

            if (documentLines.length === 0) {
                Swal.fire('Validación', 'Debe agregar al menos una línea al documento.', 'warning');
                return;
            }

            const documento = buildDocumentoObject(estado);

            Swal.fire({
                title: 'Guardando...',
                text: 'Por favor espere...',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            // Determinar si es creación o actualización
            const handlerUrl = isEditMode ? '?handler=UpdateDocument' : '?handler=CreateDocument';
            const successMessage = isEditMode ? 'Documento actualizado exitosamente.' : 'Documento guardado como borrador exitosamente.';

            $.ajax({
                url: handlerUrl,
                type: 'POST',
                contentType: 'application/json',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                data: JSON.stringify(documento),
                success: function (response) {
                    // Validate response has the expected structure
                    if (!response || !response.id) {
                        Swal.fire('Error', 'La respuesta del servidor no es válida.', 'error');
                        return;
                    }

                    if (estado === 2 && !isEditMode) {
                        // Send to Hacienda (only if document was created successfully and not editing)
                        sendToHacienda(response.id);
                    } else {
                        // For draft state or update, show success
                        Swal.fire({
                            title: 'Éxito',
                            text: successMessage,
                            icon: 'success',
                            confirmButtonText: 'OK'
                        }).then(() => {
                            // Si fue actualización, podemos redirigir a la lista de documentos
                            if (isEditMode) {
                                window.location.href = '/Documentos';
                            }
                        });
                        // Do NOT redirect for drafts in create mode - user may want to continue editing
                    }
                },
                error: function (xhr) {
                    console.error('Error saving document:', xhr);
                    const message = xhr.responseText || 'Ocurrió un error al guardar el documento.';
                    Swal.fire('Error', message, 'error');
                    // Stay on the page when there's an error
                }
            });
        }

        function validateForm() {
            const form = $('#formFacturacion')[0];

            if (!currentTipoDocumento) {
                Swal.fire('Validación', 'Seleccione un tipo de documento.', 'warning');
                return false;
            }

            if (!$('#SucursalId').val()) {
                Swal.fire('Validación', 'Seleccione una sucursal.', 'warning');
                return false;
            }

            if (!$('#TerminalId').val()) {
                Swal.fire('Validación', 'Seleccione una terminal.', 'warning');
                return false;
            }

            if (!$('#EmisorActividadEconomica').val()) {
                Swal.fire('Validación', 'La actividad económica del emisor es obligatoria.', 'warning');
                return false;
            }

            if (!$('#ClienteId').val()) {
                Swal.fire('Validación', 'Seleccione un cliente.', 'warning');
                return false;
            }

            // Validate client data (mandatory fields for electronic invoice)
            if (!$('#ClienteNombre').val()) {
                Swal.fire('Validación', 'El nombre del cliente es obligatorio.', 'warning');
                return false;
            }

            if (!$('#ClienteIdentificacion').val()) {
                Swal.fire('Validación', 'El número de identificación del cliente es obligatorio.', 'warning');
                return false;
            }

            // Validate address for national clients (not foreign)
            const tipoId = $('#ClienteTipoIdentificacion').val();
            if (tipoId !== '6') { // Not Extranjera
                if (!$('#ClienteProvincia').val()) {
                    Swal.fire('Validación', 'La provincia es obligatoria para clientes nacionales.', 'warning');
                    return false;
                }

                if (!$('#ClienteCanton').val()) {
                    Swal.fire('Validación', 'El cantón es obligatorio para clientes nacionales.', 'warning');
                    return false;
                }

                if (!$('#ClienteDistrito').val()) {
                    Swal.fire('Validación', 'El distrito es obligatorio para clientes nacionales.', 'warning');
                    return false;
                }
            } else {
                // Foreign client - require country code
                if (!$('#ClienteCodigoPais').val()) {
                    Swal.fire('Validación', 'El código de país es obligatorio para clientes extranjeros.', 'warning');
                    return false;
                }
            }

            // Validar OtrasSenas (OBLIGATORIO según XSD v4.4: minOccurs=1, maxLength=250)
            if (!$('#ClienteOtrasSenas').val()) {
                Swal.fire('Validación', 'Las otras señas (dirección exacta) son obligatorias según Hacienda v4.4.', 'warning');
                return false;
            }

            if (!$('#CondicionVenta').val()) {
                Swal.fire('Validación', 'Seleccione una condición de venta.', 'warning');
                return false;
            }

            if (!$('#MedioPago').val()) {
                Swal.fire('Validación', 'Seleccione un medio de pago.', 'warning');
                return false;
            }

            // Validate Moneda
            if (!$('#Moneda').val()) {
                Swal.fire('Validación', 'Seleccione una moneda.', 'warning');
                return false;
            }

            // Validate Tipo de Cambio
            const tipoCambio = parseFloat($('#TipoCambio').val());
            if (!tipoCambio || tipoCambio <= 0) {
                Swal.fire('Validación', 'El tipo de cambio debe ser mayor a 0.', 'warning');
                return false;
            }

            // Validate Tipo de Cambio for non-CRC currencies
            const moneda = $('#Moneda').val();
            if (moneda !== 'CRC' && !$('#TipoCambio').val()) {
                Swal.fire('Validación', 'Debe ingresar el tipo de cambio para la moneda seleccionada.', 'warning');
                return false;
            }

            // Validate NC/ND specific fields
            if ((currentTipoDocumento === '2' || currentTipoDocumento === '3')) {
                if (!$('#DocumentoReferenciaId').val()) {
                    Swal.fire('Validación', 'Seleccione un documento de referencia.', 'warning');
                    return false;
                }
                if (!$('#RazonReferencia').val()) {
                    Swal.fire('Validación', 'Seleccione una razón para la NC/ND.', 'warning');
                    return false;
                }
            }

            // Validate FEE specific fields
            if (currentTipoDocumento === '9') {
                if (!$('#Incoterm').val()) {
                    Swal.fire('Validación', 'Seleccione un Incoterm.', 'warning');
                    return false;
                }
                if (!$('#PaisDestino').val()) {
                    Swal.fire('Validación', 'Seleccione un país de destino.', 'warning');
                    return false;
                }
            }

            return true;
        }

        function buildDocumentoObject(estado) {
            const documento = {
                tipoDocumento: parseInt(currentTipoDocumento),
                empresaId: empresaId,
                sucursalId: $('#SucursalId').val(),
                terminalId: $('#TerminalId').val(),
                fecha: $('#FechaDocumentoISO').val(), // Fecha en formato ISO
                actividadEconomica: $('#EmisorActividadEconomica').val(),
                clienteId: $('#ClienteId').val(),
                condicionVenta: $('#CondicionVenta').val(),
                medioPago: $('#MedioPago').val(),
                plazoCreditoDias: $('#PlazoCreditoDias').val() ? parseInt($('#PlazoCreditoDias').val()) : null,
                observaciones: $('#Observaciones').val() || null,
                moneda: $('#Moneda').val(),
                tipoCambio: parseFloat($('#TipoCambio').val()) || 1.00,

                // Si estamos editando, incluir el ID del documento
                ...(isEditMode && { id: documentoId }),

                // Client override data (if edited) - Required for Costa Rica Electronic Invoice
                receptorNombre: $('#ClienteNombre').val(),
                receptorTipoIdentificacion: parseInt($('#ClienteTipoIdentificacion').val()),
                receptorNumeroIdentificacion: $('#ClienteIdentificacion').val(),
                receptorEmails: $('#ClienteEmail').val(),
                receptorTelefono: $('#ClienteTelefono').val(),
                receptorProvincia: $('#ClienteProvincia').val() ? parseInt($('#ClienteProvincia').val()) : null,
                receptorCanton: $('#ClienteCanton').val() ? parseInt($('#ClienteCanton').val()) : null,
                receptorDistrito: $('#ClienteDistrito').val() ? parseInt($('#ClienteDistrito').val()) : null,
                receptorOtrasSenas: $('#ClienteOtrasSenas').val(),
                receptorActividadEconomica: $('#ClienteActividadEconomica').val() || '620900', // CIIU4 del cliente

                // Lines - Estructura corregida según CreateDocumentoDetalleDTO
                detalles: documentLines.map((line, index) => {
                    const detalle = {
                        numeroLinea: index + 1,
                        codigo: line.codigo,
                        codigoCabys: '1010101010101', // TODO: Agregar campo CAByS en el modal de línea
                        descripcion: line.descripcion,
                        cantidad: line.cantidad,
                        unidadMedidaId: 1, // Default unit
                        precioUnitario: line.precioUnitario
                    };

                    // Agregar descuentos si existen
                    if (line.montoDescuento && line.montoDescuento > 0) {
                        detalle.descuentos = [{
                            naturaleza: 'Descuento comercial',
                            monto: line.montoDescuento
                        }];
                    }

                    // Agregar impuestos si existen
                    if (line.impuestoPorcentaje && line.impuestoPorcentaje > 0) {
                        detalle.impuestos = [{
                            codigoTarifa: line.impuestoPorcentaje === 13 ? '08' : '01',
                            tarifa: line.impuestoPorcentaje,
                            monto: line.montoImpuesto
                        }];
                    }

                    return detalle;
                })
            };

            // Add reference for NC/ND
            if (currentTipoDocumento === '2' || currentTipoDocumento === '3') {
                documento.referencias = [{
                    tipoReferencia: 1, // Referencia a documento anterior
                    numeroDocumento: $('#DocumentoReferenciaNumero').val(),
                    codigoReferencia: $('#RazonReferencia').val(),
                    razon: $('#RazonReferencia option:selected').text()
                }];
            }

            // Add export info for FEE
            if (currentTipoDocumento === '9') {
                documento.exportacion = {
                    incotermVenta: $('#Incoterm').val(),
                    codigoPaisDestino: $('#PaisDestino').val(),
                    nombrePaisDestino: $('#PaisDestino option:selected').text()
                };
            }

            // Add optional fields (if provided)
            // Número de Orden de Compra
            const numeroOrdenCompra = $('#NumeroOrdenCompra').val();
            if (numeroOrdenCompra && numeroOrdenCompra.trim() !== '') {
                documento.numeroOrdenCompra = numeroOrdenCompra.trim();
            }

            // Otros Cargos (if any field is filled)
            const otrosCargosTipo = $('#OtrosCargosTipoDocumento').val();
            const otrosCargosDetalle = $('#OtrosCargosDetalle').val();
            const otrosCargosPorcentaje = parseFloat($('#OtrosCargosPorcentaje').val());
            const otrosCargosMonto = parseFloat($('#OtrosCargosMonto').val());

            // Solo incluir otros cargos si al menos el tipo o detalle están completados
            if ((otrosCargosTipo && otrosCargosTipo !== '') ||
                (otrosCargosDetalle && otrosCargosDetalle.trim() !== '')) {

                documento.otrosCargos = {
                    tipoDocumento: otrosCargosTipo || null,
                    detalle: otrosCargosDetalle ? otrosCargosDetalle.trim() : null
                };

                // Agregar porcentaje o monto (priorizar monto si ambos están presentes)
                if (otrosCargosMonto && otrosCargosMonto > 0) {
                    documento.otrosCargos.monto = otrosCargosMonto;
                } else if (otrosCargosPorcentaje && otrosCargosPorcentaje > 0) {
                    documento.otrosCargos.porcentaje = otrosCargosPorcentaje;
                }
            }

            return documento;
        }

        function sendToHacienda(documentoId) {
            $.ajax({
                url: '?handler=SendToHacienda&documentoId=' + documentoId,
                type: 'POST',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response && response.success) {
                        // Only redirect when successfully sent to Hacienda
                        Swal.fire({
                            title: 'Éxito',
                            text: 'Documento guardado y enviado a Hacienda exitosamente.',
                            icon: 'success',
                            confirmButtonText: 'OK'
                        }).then(() => {
                            window.location.href = '/Documentos';
                        });
                    } else {
                        // Show error and stay on page so user can fix the issue
                        const message = response?.message || 'Error al enviar el documento a Hacienda.';
                        Swal.fire('Error', message, 'error');
                        // Do NOT redirect - user needs to see the error and may need to retry
                    }
                },
                error: function (xhr) {
                    console.error('Error sending to Hacienda:', xhr);
                    const message = xhr.responseText || 'El documento se guardó pero hubo un error al enviarlo a Hacienda.';
                    Swal.fire('Error', message, 'error');
                    // Do NOT redirect - stay on page so user can retry or check the issue
                }
            });
        }

        function loadProvincias() {
            $.ajax({
                url: '?handler=Provincias',
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.success && response.data) {
                        const select = $('#ClienteProvincia');
                        select.empty().append('<option value="">Seleccione...</option>');

                        response.data.forEach(function (item) {
                            select.append(`<option value="${item.codigo}">${item.nombre}</option>`);
                        });
                    }
                },
                error: function (xhr) {
                    console.error('Error loading provincias:', xhr);
                }
            });
        }

        function loadCantones(provinciaId) {
            $.ajax({
                url: '?handler=Cantones&provinciaId=' + provinciaId,
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.success && response.data) {
                        const select = $('#ClienteCanton');
                        select.empty().append('<option value="">Seleccione...</option>');

                        response.data.forEach(function (item) {
                            select.append(`<option value="${item.codigo}">${item.nombre}</option>`);
                        });

                        select.prop('disabled', false);

                        // Reset distrito dropdown when cantones are loaded
                        $('#ClienteDistrito').empty().append('<option value="">Seleccione cantón primero...</option>').prop('disabled', true);
                    }
                },
                error: function (xhr) {
                    console.error('Error loading cantones:', xhr);
                }
            });
        }

        function loadDistritos(provinciaId, cantonId) {
            // Extraer solo los últimos 2 dígitos del código del cantón
            // cantonId puede ser 101 (de "0101"), necesitamos solo "01"
            const cantonIdSoloDigitos = String(cantonId).padStart(4, '0').slice(-2);
            const cantonIdNumerico = parseInt(cantonIdSoloDigitos, 10);

            $.ajax({
                url: '?handler=Distritos&provinciaId=' + provinciaId + '&cantonId=' + cantonIdNumerico,
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.success && response.data) {
                        const select = $('#ClienteDistrito');
                        select.empty().append('<option value="">Seleccione...</option>');

                        response.data.forEach(function (item) {
                            select.append(`<option value="${item.codigo}">${item.nombre}</option>`);
                        });

                        select.prop('disabled', false);
                    }
                },
                error: function (xhr) {
                    console.error('Error loading distritos:', xhr);
                }
            });
        }

        function loadEmpresaData() {
            if (!empresaId) {
                console.warn('No hay empresaId disponible');
                return;
            }

            $.ajax({
                url: '?handler=EmpresaDetails&id=' + empresaId,
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (empresa) {
                    if (empresa && !empresa.error) {
                        // Mostrar indicador de ambiente
                        const ambienteIndicador = $('#ambienteIndicador');
                        if (empresa.ambiente === 'Pruebas' || empresa.ambiente === 1) {
                            ambienteIndicador.removeClass().addClass('badge fs-6 bg-warning text-dark');
                            ambienteIndicador.html('<i class="fas fa-flask"></i> Ambiente: PRUEBAS (Sandbox)');
                            ambienteIndicador.show();
                        } else if (empresa.ambiente === 'Produccion' || empresa.ambiente === 2) {
                            ambienteIndicador.removeClass().addClass('badge fs-6 bg-success');
                            ambienteIndicador.html('<i class="fas fa-check-circle"></i> Ambiente: PRODUCCIÓN');
                            ambienteIndicador.show();
                        }

                        // Cargar actividad económica principal
                        let actividadEconomica = '';

                        // Intentar obtener la actividad económica principal de la empresa
                        if (empresa.actividadesEconomicas && empresa.actividadesEconomicas.length > 0) {
                            // Buscar la actividad principal
                            const actividadPrincipal = empresa.actividadesEconomicas.find(a => a.esPrincipal);

                            if (actividadPrincipal && actividadPrincipal.actividadEconomica) {
                                actividadEconomica = actividadPrincipal.actividadEconomica.codigo ||
                                                   actividadPrincipal.actividadEconomica.codigoCIIU4 || '';
                            } else if (empresa.actividadesEconomicas[0].actividadEconomica) {
                                // Si no hay principal, tomar la primera
                                actividadEconomica = empresa.actividadesEconomicas[0].actividadEconomica.codigo ||
                                                   empresa.actividadesEconomicas[0].actividadEconomica.codigoCIIU4 || '';
                            }
                        }

                        // Si no se encontró ninguna actividad económica, usar un valor por defecto
                        if (!actividadEconomica) {
                            actividadEconomica = '620900'; // Valor por defecto
                        }

                        $('#EmisorActividadEconomica').val(actividadEconomica);
                    } else {
                        console.error('Error al cargar empresa:', empresa.error);
                        // Establecer valor por defecto en caso de error
                        $('#EmisorActividadEconomica').val('620900');
                    }
                },
                error: function (xhr) {
                    console.error('Error loading empresa:', xhr);
                    // Establecer valor por defecto en caso de error
                    $('#EmisorActividadEconomica').val('620900');
                }
            });
        }

        function loadDocumentoParaEditar(docId) {
            if (!docId) {
                console.error('No se proporcionó ID de documento para editar');
                return;
            }

            Swal.fire({
                title: 'Cargando...',
                text: 'Cargando datos del documento...',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            $.ajax({
                url: '?handler=Documento&id=' + docId,
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.success && response.data) {
                        const doc = response.data;

                        // Verificar que el documento esté en estado Borrador
                        if (doc.estado !== 'Borrador' && doc.estado !== 1) {
                            Swal.fire({
                                title: 'No Permitido',
                                text: 'Solo se pueden editar documentos en estado Borrador.',
                                icon: 'warning',
                                confirmButtonText: 'OK'
                            }).then(() => {
                                window.location.href = '/Documentos';
                            });
                            return;
                        }

                        // Cargar tipo de documento
                        currentTipoDocumento = doc.tipoDocumento ? doc.tipoDocumento.toString() : '';
                        $('#TipoDocumento').val(currentTipoDocumento).trigger('change');

                        // Mostrar Clave y Consecutivo (solo lectura)
                        if (doc.clave) {
                            $('#Clave').val(doc.clave);
                            $('#NumeroConsecutivo').val(doc.numeroConsecutivo);
                            $('#sectionClaveConsecutivo').show();
                        }

                        // Cargar datos del encabezado
                        $('#SucursalId').val(doc.sucursalId);
                        $('#TerminalId').val(doc.terminalId);
                        $('#EmisorActividadEconomica').val(doc.actividadEconomica || '620900');

                        // Cargar fecha
                        if (doc.fecha || doc.fechaEmision) {
                            const fecha = new Date(doc.fecha || doc.fechaEmision);
                            $('#FechaDocumento').val(fecha.toLocaleString('es-CR'));
                            $('#FechaDocumentoISO').val(fecha.toISOString());
                        }

                        // Cargar cliente
                        if (doc.clienteId) {
                            // Crear opción en el select2 con los datos del cliente
                            const clienteOption = new Option(
                                doc.receptorNombre || 'Cliente',
                                doc.clienteId,
                                true,
                                true
                            );
                            $('#ClienteId').append(clienteOption).trigger('change');

                            // Cargar datos del receptor (cliente)
                            $('#ClienteNombre').val(doc.receptorNombre || '');
                            $('#ClienteTipoIdentificacion').val(doc.receptorTipoIdentificacion || 1);
                            $('#ClienteIdentificacion').val(doc.receptorNumeroIdentificacion || '');
                            $('#ClienteEmail').val(doc.receptorEmails || '');
                            $('#ClienteTelefono').val(doc.receptorTelefono || '');
                            $('#ClienteFax').val(doc.receptorFax || '');
                            $('#ClienteActividadEconomica').val(doc.receptorActividadEconomica || '');
                            $('#ClienteOtrasSenas').val(doc.receptorOtrasSenas || '');

                            // Cargar dirección (provincia, cantón, distrito)
                            if (doc.receptorProvincia) {
                                $('#ClienteProvincia').val(doc.receptorProvincia.toString());
                                loadCantones(doc.receptorProvincia);

                                // Esperar a que se carguen los cantones antes de seleccionar
                                setTimeout(() => {
                                    if (doc.receptorCanton) {
                                        $('#ClienteCanton').val(doc.receptorCanton.toString());
                                        loadDistritos(doc.receptorProvincia, doc.receptorCanton);

                                        // Esperar a que se carguen los distritos antes de seleccionar
                                        setTimeout(() => {
                                            if (doc.receptorDistrito) {
                                                $('#ClienteDistrito').val(doc.receptorDistrito.toString());
                                            }
                                        }, 500);
                                    }
                                }, 500);
                            }

                            // Mostrar sección de datos del cliente
                            $('#clienteInfoSection').show();
                            $('#btnEditarCliente').prop('disabled', false);
                        }

                        // Condición de venta y medio de pago
                        $('#CondicionVenta').val(doc.condicionVenta || '01').trigger('change');
                        $('#MedioPago').val(doc.medioPago || '01');

                        if (doc.plazoCreditoDias) {
                            $('#PlazoCreditoDias').val(doc.plazoCreditoDias);
                            $('#divPlazoCreditoDias').show();
                        }

                        // Moneda y tipo de cambio
                        $('#Moneda').val(doc.moneda || 'CRC').trigger('change');
                        $('#TipoCambio').val(doc.tipoCambio || 1.00);

                        // Observaciones
                        $('#Observaciones').val(doc.observaciones || '');

                        // Cargar referencias (NC/ND)
                        if (doc.referencias && doc.referencias.length > 0) {
                            const ref = doc.referencias[0];
                            $('#DocumentoReferenciaNumero').val(ref.numeroDocumento || '');
                            $('#DocumentoReferenciaId').val(ref.documentoReferenciaId || '');
                            $('#RazonReferencia').val(ref.codigoReferencia || '');
                        }

                        // Cargar datos de exportación (FEE)
                        if (doc.exportacion) {
                            $('#Incoterm').val(doc.exportacion.incotermVenta || '');
                            $('#PaisDestino').val(doc.exportacion.codigoPaisDestino || '');
                        }

                        // Cargar información opcional
                        if (doc.numeroOrdenCompra) {
                            $('#NumeroOrdenCompra').val(doc.numeroOrdenCompra);
                        }

                        // Cargar otros cargos
                        if (doc.otrosCargos && doc.otrosCargos.length > 0) {
                            const cargo = doc.otrosCargos[0];
                            $('#OtrosCargosTipoDocumento').val(cargo.tipoDocumento || '');
                            $('#OtrosCargosDetalle').val(cargo.detalle || '');
                            $('#OtrosCargosPorcentaje').val(cargo.porcentaje || '');
                            $('#OtrosCargosMonto').val(cargo.monto || '');
                        }

                        // Cargar líneas de detalle
                        if (doc.detalles && doc.detalles.length > 0) {
                            documentLines = [];
                            doc.detalles.forEach((detalle, index) => {
                                const line = {
                                    id: detalle.id || null,
                                    numeroLinea: detalle.numeroLinea || (index + 1),
                                    codigo: detalle.codigo || '',
                                    descripcion: detalle.descripcion || '',
                                    cantidad: detalle.cantidad || 1,
                                    precioUnitario: detalle.precioUnitario || 0,
                                    montoDescuento: 0,
                                    impuestoPorcentaje: 0,
                                    montoImpuesto: 0
                                };

                                // Extraer descuento si existe
                                if (detalle.descuentos && detalle.descuentos.length > 0) {
                                    line.montoDescuento = detalle.descuentos[0].monto || 0;
                                }

                                // Extraer impuesto si existe
                                if (detalle.impuestos && detalle.impuestos.length > 0) {
                                    line.impuestoPorcentaje = detalle.impuestos[0].tarifa || 0;
                                    line.montoImpuesto = detalle.impuestos[0].monto || 0;
                                }

                                documentLines.push(line);
                            });

                            // Actualizar la tabla de líneas
                            updateLinesTable();
                        }

                        // Cerrar el loading
                        Swal.close();

                        // Mostrar mensaje de éxito
                        Swal.fire({
                            title: 'Documento Cargado',
                            text: 'Los datos del documento han sido cargados correctamente. Puede editarlos y guardar los cambios.',
                            icon: 'success',
                            timer: 3000,
                            showConfirmButton: false
                        });
                    } else {
                        Swal.fire('Error', response.message || 'No se pudo cargar el documento.', 'error');
                    }
                },
                error: function (xhr) {
                    console.error('Error loading document:', xhr);
                    const message = xhr.responseText || 'Ocurrió un error al cargar el documento.';
                    Swal.fire({
                        title: 'Error',
                        text: message,
                        icon: 'error',
                        confirmButtonText: 'OK'
                    }).then(() => {
                        window.location.href = '/Documentos';
                    });
                }
            });
        }

        function formatCurrency(value) {
            return '₡' + parseFloat(value).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,');
        }

        // Global functions for inline onclick handlers
        window.editLine = editLine;
        window.deleteLine = deleteLine;
        window.seleccionarClienteModal = seleccionarClienteModal;
        window.seleccionarDocumentoModal = seleccionarDocumentoModal;
    </script>
}
