                const esServicio = unidadesServicio.includes(unidad);

                // Auto-seleccionar tipo de producto
                $('#Linea_TipoProducto').val(esServicio ? 'servicio' : 'mercancia');

                // Auto-seleccionar tipo de transacción v4.4 si está vacío
                const tipoTransaccion = $('#Linea_TipoTransaccion').val();
