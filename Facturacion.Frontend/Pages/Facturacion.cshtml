@page
@model Facturacion.Frontend.Pages.FacturacionModel
@{
    ViewData["Title"] = "Nueva Facturación Electrónica";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3">
                    <h2 id="pageTitle" class="mb-0">
                        <i class="fas fa-file-invoice"></i>
                        @if (!string.IsNullOrEmpty(Model.DocumentoId))
                        {
                            <span>Editar Documento en Borrador</span>
                        }
                        else
                        {
                            <span>Nueva Facturación Electrónica</span>
                        }
                    </h2>
                    <!-- Indicador de Ambiente -->
                    <span id="ambienteIndicador" class="badge fs-6" style="display: none;"></span>
                </div>
                <a href="/Documentos" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Volver a Documentos
                </a>
            </div>
        </div>
    </div>

    <form id="formFacturacion">
        @Html.AntiForgeryToken()
        <!-- Hidden field for document ID (if editing) -->
        <input type="hidden" id="DocumentoId" value="@Model.DocumentoId">

        <!-- Document Type Selection Card -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="fas fa-file-alt"></i> Tipo de Documento</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <label for="TipoDocumento" class="form-label">Seleccione el Tipo de Documento <span class="text-danger">*</span></label>
                                <select class="form-select form-select-lg" id="TipoDocumento" required>
                                    <option value="">-- Seleccione un tipo --</option>
                                    <option value="1">Factura Electrónica (FE)</option>
                                    <option value="4">Tiquete Electrónico (TE)</option>
                                    <option value="2">Nota Débito Electrónica (ND)</option>
                                    <option value="3">Nota Crédito Electrónica (NC)</option>
                                    <option value="9">Factura Exportación (FEE)</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <div class="alert alert-info mb-0" style="margin-top: 32px;">
                                    <i class="fas fa-info-circle"></i> <strong>Nota:</strong> Seleccione el tipo de documento que desea crear. Los campos cambiarán según su selección.
                                </div>
                            </div>
                        </div>

                        <!-- Show Clave and Consecutivo if editing (read-only) -->
                        <div class="row mt-3" id="sectionClaveConsecutivo" style="display: none;">
                            <div class="col-md-6">
                                <label for="NumeroConsecutivo" class="form-label">Número Consecutivo</label>
                                <input type="text" class="form-control bg-light" id="NumeroConsecutivo" readonly>
                                <small class="text-muted">Ya generado (solo lectura)</small>
                            </div>
                            <div class="col-md-6">
                                <label for="Clave" class="form-label">Clave</label>
                                <input type="text" class="form-control bg-light" id="Clave" readonly>
                                <small class="text-muted">Ya generada (solo lectura)</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Document Information Card -->
        <div class="row mb-4" id="mainFormCard" style="display: none;">
            <div class="col-12">
                <div class="card shadow">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="fas fa-info-circle"></i> Información General</h5>
                    </div>
                    <div class="card-body">
                        <!-- Sucursal and Terminal -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="SucursalId" class="form-label">Sucursal <span class="text-danger">*</span></label>
                                <select class="form-select" id="SucursalId" required>
                                    <option value="">Seleccione...</option>
                                </select>
                                <div class="invalid-feedback">Seleccione una sucursal.</div>
                            </div>
                            <div class="col-md-6">
                                <label for="TerminalId" class="form-label">Terminal <span class="text-danger">*</span></label>
                                <select class="form-select" id="TerminalId" required>
                                    <option value="">Seleccione...</option>
                                </select>
                                <div class="invalid-feedback">Seleccione una terminal.</div>
                            </div>
                        </div>

                        <!-- Economic Activity (Emisor) -->
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <div class="card border-primary">
                                    <div class="card-header bg-primary text-white">
                                        <h6 class="mb-0">
                                            <i class="fas fa-building"></i> Datos del Emisor (Empresa)
                                        </h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-8">
                                                <label for="EmisorActividadEconomica" class="form-label">
                                                    Actividad Económica (CIIU4) <span class="text-danger">*</span>
                                                    <i class="fas fa-info-circle text-info" data-bs-toggle="tooltip" title="Código CIIU4 de la actividad económica principal de su empresa. Se carga automáticamente pero puede modificarse para este documento"></i>
                                                </label>
                                                <input type="text" class="form-control" id="EmisorActividadEconomica" maxlength="10" placeholder="Código CIIU4 (ej: 6202.0)" required>
                                                <small class="text-muted">Este campo se carga automáticamente desde la actividad económica principal de su empresa, pero puede editarse si es necesario para este documento específico</small>
                                                <div class="invalid-feedback">La actividad económica del emisor es obligatoria.</div>
                                            </div>
                                            <div class="col-md-4">
                                                <label for="FechaDocumento" class="form-label">
                                                    Fecha del Documento
                                                    <i class="fas fa-calendar text-info" data-bs-toggle="tooltip" title="Fecha de emisión del documento. Se establece automáticamente con la fecha actual"></i>
                                                </label>
                                                <input type="text" class="form-control bg-light" id="FechaDocumento" readonly>
                                                <input type="hidden" id="FechaDocumentoISO">
                                                <small class="text-muted">Fecha de emisión (solo lectura)</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Reference Document Section (NC/ND only) -->
                        <div class="row mb-3" id="sectionReferencia" style="display: none;">
                            <div class="col-12">
                                <div class="alert alert-warning">
                                    <i class="fas fa-exclamation-triangle"></i> <strong>Documento de Referencia:</strong>
                                    <span id="mensajeReferencia"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label for="DocumentoReferenciaNumero" class="form-label">Documento de Referencia <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input type="text" class="form-control" id="DocumentoReferenciaNumero" readonly placeholder="Seleccione un documento...">
                                    <input type="hidden" id="DocumentoReferenciaId">
                                    <button class="btn btn-outline-primary" type="button" id="btnVerTodosDocumentos" title="Ver todos los documentos">
                                        <i class="fas fa-list"></i> Seleccionar Documento
                                    </button>
                                </div>
                                <div class="invalid-feedback">Seleccione un documento de referencia.</div>
                            </div>
                            <div class="col-md-6">
                                <label for="RazonReferencia" class="form-label">Razón de la NC/ND <span class="text-danger">*</span></label>
                                <select class="form-select" id="RazonReferencia">
                                    <option value="">Seleccione...</option>
                                    <option value="01">01 - Anula Documento de Referencia</option>
                                    <option value="02">02 - Corrige texto del documento de referencia</option>
                                    <option value="03">03 - Corrige monto</option>
                                    <option value="04">04 - Referencia a otro documento</option>
                                    <option value="05">05 - Sustituye factura rechazada por el Ministerio de Hacienda</option>
                                    <option value="99">99 - Otros</option>
                                </select>
                                <div class="invalid-feedback">Seleccione una razón.</div>
                            </div>
                        </div>

                        <!-- Export Information Section (FEE only) -->
                        <div class="row mb-3" id="sectionExportacion" style="display: none;">
                            <div class="col-md-6">
                                <label for="Incoterm" class="form-label">Incoterm <span class="text-danger">*</span></label>
                                <select class="form-select" id="Incoterm">
                                    <option value="">Seleccione...</option>
                                    <option value="EXW">EXW - Ex Works</option>
                                    <option value="FCA">FCA - Free Carrier</option>
                                    <option value="CPT">CPT - Carriage Paid To</option>
                                    <option value="CIP">CIP - Carriage and Insurance Paid To</option>
                                    <option value="DAP">DAP - Delivered At Place</option>
                                    <option value="DPU">DPU - Delivered At Place Unloaded</option>
                                    <option value="DDP">DDP - Delivered Duty Paid</option>
                                    <option value="FAS">FAS - Free Alongside Ship</option>
                                    <option value="FOB">FOB - Free On Board</option>
                                    <option value="CFR">CFR - Cost and Freight</option>
                                    <option value="CIF">CIF - Cost, Insurance and Freight</option>
                                </select>
                                <div class="invalid-feedback">Seleccione un Incoterm.</div>
                            </div>
                            <div class="col-md-6">
                                <label for="PaisDestino" class="form-label">País Destino <span class="text-danger">*</span></label>
                                <select class="form-select select2" id="PaisDestino">
                                    <option value="">Seleccione...</option>
                                </select>
                                <div class="invalid-feedback">Seleccione un país de destino.</div>
                            </div>
                        </div>

                        <!-- Client Information -->
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label for="ClienteId" class="form-label">Cliente <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <select class="form-select select2" id="ClienteId" required>
                                        <option value="">Buscar cliente...</option>
                                    </select>
                                    <button class="btn btn-outline-primary" type="button" id="btnVerTodosClientes" title="Ver todos los clientes">
                                        <i class="fas fa-list"></i>
                                    </button>
                                    <button class="btn btn-outline-secondary" type="button" id="btnEditarCliente" disabled>
                                        <i class="fas fa-edit"></i> Editar Datos
                                    </button>
                                </div>
                                <div class="invalid-feedback">Seleccione un cliente.</div>
                            </div>
                        </div>

                        <!-- Client Auto-filled Information (collapsible) -->
                        <div class="row mb-3" id="clienteInfoSection" style="display: none;">
                            <div class="col-12">
                                <div class="card border-secondary">
                                    <div class="card-header bg-light">
                                        <h6 class="mb-0">
                                            <i class="fas fa-user"></i> Datos del Receptor (Editable)
                                            <small class="text-muted">- Los campos se cargan automáticamente y pueden editarse antes de guardar</small>
                                        </h6>
                                    </div>
                                    <div class="card-body">
                                        <!-- Identification Section -->
                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <label for="ClienteNombre" class="form-label">
                                                    Nombre/Razón Social <span class="text-danger">*</span>
                                                </label>
                                                <input type="text" class="form-control" id="ClienteNombre" maxlength="200" required>
                                                <div class="invalid-feedback">El nombre es obligatorio.</div>
                                            </div>
                                            <div class="col-md-3">
                                                <label for="ClienteTipoIdentificacion" class="form-label">
                                                    Tipo Identificación <span class="text-danger">*</span>
                                                </label>
                                                <select class="form-select" id="ClienteTipoIdentificacion" required>
                                                    <option value="1">01 - Cédula Física</option>
                                                    <option value="2">02 - Cédula Jurídica</option>
                                                    <option value="3">03 - DIMEX</option>
                                                    <option value="4">04 - NITE</option>
                                                    <option value="5">05 - Pasaporte</option>
                                                    <option value="6">06 - Extranjera</option>
                                                </select>
                                                <div class="invalid-feedback">Seleccione el tipo de identificación.</div>
                                            </div>
                                            <div class="col-md-3">
                                                <label for="ClienteIdentificacion" class="form-label">
                                                    Número Identificación <span class="text-danger">*</span>
                                                </label>
                                                <input type="text" class="form-control" id="ClienteIdentificacion" maxlength="20" required>
                                                <div class="invalid-feedback">El número de identificación es obligatorio.</div>
                                            </div>
                                        </div>

                                        <!-- Contact Information -->
                                        <div class="row mb-3">
                                            <div class="col-md-4">
                                                <label for="ClienteEmail" class="form-label">
                                                    Correo Electrónico
                                                    <i class="fas fa-info-circle text-info" data-bs-toggle="tooltip" title="Email para envío de factura electrónica"></i>
                                                </label>
                                                <input type="email" class="form-control" id="ClienteEmail" maxlength="100" placeholder="cliente@ejemplo.com">
                                            </div>
                                            <div class="col-md-4">
                                                <label for="ClienteTelefono" class="form-label">Teléfono</label>
                                                <input type="text" class="form-control" id="ClienteTelefono" maxlength="20" placeholder="8888-8888">
                                            </div>
                                            <div class="col-md-4">
                                                <label for="ClienteFax" class="form-label">Fax</label>
                                                <input type="text" class="form-control" id="ClienteFax" maxlength="20" placeholder="2222-2222">
                                            </div>
                                        </div>

                                        <!-- Address Section (Costa Rica) -->
                                        <div class="row mb-3" id="sectionDireccionNacional">
                                            <div class="col-md-4">
                                                <label for="ClienteProvincia" class="form-label">
                                                    Provincia <span class="text-danger">*</span>
                                                </label>
                                                <select class="form-select" id="ClienteProvincia" required>
                                                    <option value="">Seleccione...</option>
                                                </select>
                                                <div class="invalid-feedback">Seleccione una provincia.</div>
                                            </div>
                                            <div class="col-md-4">
                                                <label for="ClienteCanton" class="form-label">
                                                    Cantón <span class="text-danger">*</span>
                                                </label>
                                                <select class="form-select" id="ClienteCanton" required disabled>
                                                    <option value="">Seleccione provincia primero...</option>
                                                </select>
                                                <div class="invalid-feedback">Seleccione un cantón.</div>
                                            </div>
                                            <div class="col-md-4">
                                                <label for="ClienteDistrito" class="form-label">
                                                    Distrito <span class="text-danger">*</span>
                                                </label>
                                                <select class="form-select" id="ClienteDistrito" required disabled>
                                                    <option value="">Seleccione cantón primero...</option>
                                                </select>
                                                <div class="invalid-feedback">Seleccione un distrito.</div>
                                            </div>
                                        </div>

                                        <!-- Other Address Details -->
                                        <div class="row mb-3">
                                            <div class="col-md-12">
                                                <label for="ClienteOtrasSenas" class="form-label">
                                                    Otras Señas <span class="text-danger">*</span>
                                                    <i class="fas fa-info-circle text-info" data-bs-toggle="tooltip" title="Dirección exacta: Barrio, número de casa, referencias. OBLIGATORIO según XSD Hacienda v4.4"></i>
                                                </label>
                                                <textarea class="form-control" id="ClienteOtrasSenas" rows="2" maxlength="250" required placeholder="Ejemplo: Del Más x Menos 100 metros al norte, casa amarilla portón negro"></textarea>
                                                <div class="invalid-feedback">Las otras señas son obligatorias según Hacienda v4.4.</div>
                                                <small class="text-muted">Dirección exacta requerida (máx. 250 caracteres según XSD)</small>
                                            </div>
                                        </div>

                                        <!-- Economic Activity Section -->
                                        <div class="row mb-3">
                                            <div class="col-md-12">
                                                <label for="ClienteActividadEconomica" class="form-label">
                                                    Actividad Económica (CIIU4)
                                                    <i class="fas fa-info-circle text-info" data-bs-toggle="tooltip" title="Código CIIU4 de la actividad económica del cliente. Se carga automáticamente pero puede modificarse"></i>
                                                </label>
                                                <input type="text" class="form-control" id="ClienteActividadEconomica" maxlength="10" placeholder="Código CIIU4 (ej: 6202.0)">
                                                <small class="text-muted">Este campo se carga automáticamente desde los datos del cliente, pero puede editarse si es necesario</small>
                                            </div>
                                        </div>

                                        <!-- Foreign Client Section (Conditional) -->
                                        <div class="row mb-2" id="sectionClienteExtranjero" style="display: none;">
                                            <div class="col-md-4">
                                                <label for="ClienteCodigoPais" class="form-label">
                                                    Código País <span class="text-danger">*</span>
                                                </label>
                                                <select class="form-select" id="ClienteCodigoPais">
                                                    <option value="">Seleccione...</option>
                                                    <option value="US">Estados Unidos</option>
                                                    <option value="MX">México</option>
                                                    <option value="PA">Panamá</option>
                                                    <option value="GT">Guatemala</option>
                                                    <option value="NI">Nicaragua</option>
                                                    <option value="HN">Honduras</option>
                                                    <option value="SV">El Salvador</option>
                                                    <option value="ES">España</option>
                                                    <option value="CO">Colombia</option>
                                                    <option value="AR">Argentina</option>
                                                    <option value="CL">Chile</option>
                                                    <option value="PE">Perú</option>
                                                </select>
                                                <div class="invalid-feedback">Seleccione el país del cliente.</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Payment Conditions -->
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label for="CondicionVenta" class="form-label">Condición Venta <span class="text-danger">*</span></label>
                                <select class="form-select" id="CondicionVenta" required>
                                    <option value="">Seleccione...</option>
                                    <option value="01">01 - Contado</option>
                                    <option value="02">02 - Crédito</option>
                                    <option value="03">03 - Consignación</option>
                                    <option value="04">04 - Apartado</option>
                                    <option value="05">05 - Arrendamiento con opción de compra</option>
                                    <option value="06">06 - Arrendamiento en función financiera</option>
                                    <option value="07">07 - Cobro a favor de un tercero</option>
                                    <option value="08">08 - Servicios prestados al Estado a crédito</option>
                                    <option value="09">09 - Pago del servicios prestado al Estado</option>
                                    <option value="10">10 - Mercancía no nacionalizada</option>
                                    <option value="99">99 - Otros</option>
                                </select>
                                <div class="invalid-feedback">Seleccione una condición de venta.</div>
                            </div>
                            <div class="col-md-4">
                                <label for="MedioPago" class="form-label">Medio Pago <span class="text-danger">*</span></label>
                                <select class="form-select" id="MedioPago" required>
                                    <option value="">Seleccione...</option>
                                    <option value="01">01 - Efectivo</option>
                                    <option value="02">02 - Tarjeta</option>
                                    <option value="03">03 - Cheque</option>
                                    <option value="04">04 - Transferencia</option>
                                    <option value="05">05 - Recaudado por terceros</option>
                                    <option value="06">06 - SINPE Móvil</option>
                                    <option value="99">99 - Otros</option>
                                </select>
                                <div class="invalid-feedback">Seleccione un medio de pago.</div>
                            </div>
                            <div class="col-md-4" id="divPlazoCreditoDias" style="display: none;">
                                <label for="PlazoCreditoDias" class="form-label">Plazo Crédito (días) <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="PlazoCreditoDias" min="1" placeholder="30">
                            </div>
                        </div>

                        <!-- Currency and Exchange Rate -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="Moneda" class="form-label">Moneda <span class="text-danger">*</span></label>
                                <select class="form-select" id="Moneda" required>
                                    <option value="">Seleccione...</option>
                                    <option value="CRC" selected>CRC - Colón Costarricense</option>
                                    <option value="USD">USD - Dólar Estadounidense</option>
                                    <option value="EUR">EUR - Euro</option>
                                </select>
                                <div class="invalid-feedback">Seleccione una moneda.</div>
                            </div>
                            <div class="col-md-6">
                                <label for="TipoCambio" class="form-label">
                                    Tipo de Cambio <span class="text-danger">*</span>
                                    <i class="fas fa-info-circle text-info" data-bs-toggle="tooltip" title="El tipo de cambio es automático para Colones (CRC = 1). Para otras monedas, ingrese el tipo de cambio correspondiente."></i>
                                </label>
                                <input type="number" class="form-control" id="TipoCambio" step="0.01" min="0.01" value="1.00" required placeholder="1.00">
                                <div class="invalid-feedback">El tipo de cambio es obligatorio.</div>
                                <small class="text-muted" id="tipoCambioHelp">Tipo de cambio fijo en 1 para Colones (CRC)</small>
                            </div>
                        </div>

                        <!-- Observations -->
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label for="Observaciones" class="form-label">Observaciones</label>
                                <textarea class="form-control" id="Observaciones" rows="2" maxlength="1000" placeholder="Notas u observaciones adicionales..."></textarea>
                            </div>
                        </div>

                        <!-- Optional Fields Section (Collapsible) -->
                        <div class="row">
                            <div class="col-12">
                                <div class="card border-info">
                                    <div class="card-header bg-info bg-opacity-10" role="button" data-bs-toggle="collapse" data-bs-target="#collapseCamposOpcionales" aria-expanded="false" aria-controls="collapseCamposOpcionales">
                                        <h6 class="mb-0">
                                            <i class="fas fa-plus-circle"></i> Información Adicional (Opcional)
                                            <small class="text-muted">- Haga clic para expandir/contraer</small>
                                            <i class="fas fa-chevron-down float-end mt-1"></i>
                                        </h6>
                                    </div>
                                    <div class="collapse" id="collapseCamposOpcionales">
                                        <div class="card-body">
                                            <!-- Purchase Order Number -->
                                            <div class="row mb-3">
                                                <div class="col-md-6">
                                                    <label for="NumeroOrdenCompra" class="form-label">
                                                        Número de Orden de Compra
                                                        <i class="fas fa-info-circle text-info" data-bs-toggle="tooltip" title="Número de referencia de orden de compra del cliente (opcional)"></i>
                                                    </label>
                                                    <input type="text" class="form-control" id="NumeroOrdenCompra" maxlength="50" placeholder="Ej: OC-2025-001">
                                                    <small class="text-muted">Referencia de orden de compra del cliente (si aplica)</small>
                                                </div>
                                            </div>

                                            <!-- Otros Cargos Section -->
                                            <div class="row mb-3">
                                                <div class="col-12">
                                                    <hr>
                                                    <h6 class="mb-3">
                                                        <i class="fas fa-file-invoice-dollar"></i> Otros Cargos
                                                        <small class="text-muted">- Cargos adicionales no relacionados con líneas de detalle</small>
                                                    </h6>
                                                </div>
                                            </div>

                                            <div class="row mb-3">
                                                <div class="col-md-3">
                                                    <label for="OtrosCargosTipoDocumento" class="form-label">
                                                        Tipo Documento
                                                        <i class="fas fa-info-circle text-info" data-bs-toggle="tooltip" title="Tipo de documento de soporte del cargo adicional"></i>
                                                    </label>
