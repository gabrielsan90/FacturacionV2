                $('#Linea_PrecioUnitario').val(line.precioUnitario);
                $('#Linea_DescuentoPorcentaje').val(line.descuentoPorcentaje);
                $('#Linea_ImpuestoPorcentaje').val(line.impuestoPorcentaje);
                calculateLineSubtotal();
            } else {
                // Add mode
                $('#modalLineaTitle').text('Agregar Línea');
                $('#Linea_Cantidad').val('1.000');
                $('#Linea_DescuentoPorcentaje').val('0');
