@section Scripts {
    <!-- DataTables -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>

    <!-- Select2 -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const empresaId = '@Model.EmpresaId';
        const documentoId = '@Model.DocumentoId';
        const isEditMode = documentoId && documentoId !== '';

        let documentLines = [];
        let sucursales = [];
        let terminales = [];
        let currentTipoDocumento = null;
        let clienteSeleccionado = null;
        let documentoEnEdicion = null;

        $(document).ready(function () {
            initializeForm();
            setupEventHandlers();
            loadInitialData();

            // Si estamos en modo edición, cargar el documento
            if (isEditMode) {
                loadDocumentoParaEditar(documentoId);
            }
        });

        function initializeForm() {
            // Initialize Select2 for Cliente
            $('#ClienteId').select2({
                theme: 'bootstrap-5',
                placeholder: 'Buscar cliente...',
                allowClear: true,
                ajax: {
                    url: '?handler=Clientes&empresaId=' + empresaId,
                    headers: {
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    },
                    dataType: 'json',
                    delay: 250,
                    processResults: function (data) {
                        return {
                            results: data.map(function (item) {
                                return {
                                    id: item.id,
                                    text: `${item.numeroIdentificacion} - ${item.nombre}`,
                                    data: item
                                };
                            })
                        };
                    },
                    cache: true
                }
            });

            // Initialize Select2 for Producto in modal
            $('#Linea_ProductoId').select2({
                theme: 'bootstrap-5',
                dropdownParent: $('#modalLinea'),
                placeholder: 'Buscar producto...',
                allowClear: true,
                ajax: {
                    url: '?handler=Productos&empresaId=' + empresaId,
                    headers: {
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    },
                    dataType: 'json',
                    delay: 250,
                    processResults: function (data) {
                        return {
                            results: data.map(function (item) {
                                return {
                                    id: item.id,
                                    text: `${item.codigo} - ${item.nombre}`,
                                    data: item
                                };
                            })
                        };
                    },
                    cache: true
                }
            });

            // Initialize Select2 for País Destino (will load countries)
            $('#PaisDestino').select2({
                theme: 'bootstrap-5',
                placeholder: 'Seleccione país...',
                allowClear: true
            });

            // Initialize Bootstrap tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        }

        function setupEventHandlers() {
            // Document type change
            $('#TipoDocumento').on('change', function () {
                handleTipoDocumentoChange($(this).val());
            });

            // Cliente selection
            $('#ClienteId').on('select2:select', function (e) {
                const data = e.params.data.data;
                loadClienteData(data.id);
            });

            $('#ClienteId').on('select2:clear', function () {
                clearClienteData();
            });

            $('#btnEditarCliente').on('click', function () {
                $('#clienteInfoSection').toggle();
            });

            // Address cascading dropdowns
            $('#ClienteProvincia').on('change', function () {
                const provinciaId = $(this).val();
                if (provinciaId) {
                    loadCantones(provinciaId);
                } else {
                    $('#ClienteCanton').empty().append('<option value="">Seleccione provincia primero...</option>').prop('disabled', true);
                    $('#ClienteDistrito').empty().append('<option value="">Seleccione cantón primero...</option>').prop('disabled', true);
                }
            });

            $('#ClienteCanton').on('change', function () {
                const provinciaId = $('#ClienteProvincia').val();
                const cantonId = $(this).val();
                if (provinciaId && cantonId) {
                    loadDistritos(provinciaId, cantonId);
                } else {
                    $('#ClienteDistrito').empty().append('<option value="">Seleccione cantón primero...</option>').prop('disabled', true);
                }
            });

            // Toggle foreign client section based on TipoIdentificacion
            $('#ClienteTipoIdentificacion').on('change', function () {
                const tipo = $(this).val();
                if (tipo === '6') { // Extranjera
                    $('#sectionClienteExtranjero').show();
                    $('#ClienteCodigoPais').prop('required', true);
                    // Optional: disable Costa Rica address fields
                    $('#ClienteProvincia, #ClienteCanton, #ClienteDistrito').prop('required', false);
                } else {
                    $('#sectionClienteExtranjero').hide();
                    $('#ClienteCodigoPais').prop('required', false);
                    // Re-enable Costa Rica address fields
                    $('#ClienteProvincia, #ClienteCanton, #ClienteDistrito').prop('required', true);
                }
            });

            // Condición venta change
            $('#CondicionVenta').on('change', function () {
                if ($(this).val() === '02') {
                    $('#divPlazoCreditoDias').show();
                    $('#PlazoCreditoDias').prop('required', true);
                } else {
                    $('#divPlazoCreditoDias').hide();
                    $('#PlazoCreditoDias').prop('required', false);
                }
            });

            // Moneda change - Control Tipo de Cambio
            $('#Moneda').on('change', function () {
                const moneda = $(this).val();
                if (moneda === 'CRC') {
                    // Si es Colones, tipo de cambio = 1 y campo readonly
                    $('#TipoCambio').val('1.00').prop('readonly', true);
                    $('#tipoCambioHelp').text('Tipo de cambio fijo en 1 para Colones (CRC)').removeClass('text-danger').addClass('text-muted');
                } else if (moneda) {
                    // Si es otra moneda, habilitar campo y poner valor vacío
                    $('#TipoCambio').val('').prop('readonly', false).focus();
                    $('#tipoCambioHelp').text('Ingrese el tipo de cambio correspondiente a ' + moneda).removeClass('text-muted').addClass('text-info');
                } else {
                    // Si no hay moneda seleccionada, deshabilitar
                    $('#TipoCambio').val('').prop('readonly', true);
                    $('#tipoCambioHelp').text('Seleccione primero una moneda').removeClass('text-info').addClass('text-muted');
                }
            });

            // Sucursal change
            $('#SucursalId').on('change', function () {
                loadTerminalesBySucursal($(this).val());
            });

            // Ver todos los clientes button
            $('#btnVerTodosClientes').on('click', function () {
                openClientesModal();
            });

            // Filtrar clientes en modal
            $('#btnFiltrarClientes').on('click', function () {
                filterClientesModal();
            });

            // Filtro con Enter
            $('#filtroClienteNombre, #filtroClienteIdentificacion').on('keypress', function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    filterClientesModal();
                }
            });

            // Ver todos los documentos button (para documento de referencia)
            $('#btnVerTodosDocumentos').on('click', function () {
                openDocumentosModal();
            });

            // Add line button
            $('#btnAgregarLinea').on('click', function () {
                openLineModal();
            });

            // Producto selection in modal
            $('#Linea_ProductoId').on('select2:select', function (e) {
                const producto = e.params.data.data;
                loadProductoData(producto);
            });

            // Auto-calculate line subtotal
            $('#Linea_Cantidad, #Linea_PrecioUnitario, #Linea_DescuentoPorcentaje, #Linea_ImpuestoPorcentaje').on('input', function () {
                calculateLineSubtotal();
            });

            // Form line submission
            $('#formLinea').on('submit', function (e) {
                e.preventDefault();
                addOrUpdateLine();
            });

            // Save buttons
            $('#btnGuardarBorrador').on('click', function () {
                saveDocument(1); // Estado: Borrador
            });

            $('#btnGuardarYEnviar').on('click', function () {
                saveDocument(2); // Estado: Pendiente, then send
            });
        }

        function loadInitialData() {
            loadSucursales();
            loadTerminales();
            loadPaises();
            loadProvincias();
            loadEmpresaData();
            setFechaDocumento();
        }

        function setFechaDocumento() {
            const ahora = new Date();
            const dia = String(ahora.getDate()).padStart(2, '0');
            const mes = String(ahora.getMonth() + 1).padStart(2, '0');
            const anio = ahora.getFullYear();
            const hora = String(ahora.getHours()).padStart(2, '0');
            const minutos = String(ahora.getMinutes()).padStart(2, '0');

            // Formato legible para mostrar en Costa Rica (dd/MM/yyyy HH:mm)
            const fechaFormateada = `${dia}/${mes}/${anio} ${hora}:${minutos}`;
            $('#FechaDocumento').val(fechaFormateada);

            // Formato ISO para enviar al backend (si es necesario)
            $('#FechaDocumentoISO').val(ahora.toISOString());
        }

        function handleTipoDocumentoChange(tipo) {
            currentTipoDocumento = tipo;

            if (!tipo) {
                $('#mainFormCard, #lineasCard, #actionButtons').hide();
                return;
            }

            // Show main sections
            $('#mainFormCard, #lineasCard, #actionButtons').show();

            // Hide all conditional sections
            $('#sectionReferencia, #sectionExportacion').hide();
            $('#DocumentoReferenciaId, #RazonReferencia, #Incoterm, #PaisDestino').prop('required', false);

            // Show specific sections based on document type
            if (tipo === '2' || tipo === '3') {
                // Nota Débito or Nota Crédito
                $('#sectionReferencia').show();
                $('#DocumentoReferenciaId, #RazonReferencia').prop('required', true);

                const tipoNombre = tipo === '2' ? 'Nota Débito' : 'Nota Crédito';
                $('#mensajeReferencia').text(`Esta ${tipoNombre} modificará el documento seleccionado.`);
            } else if (tipo === '9') {
                // Factura Exportación
                $('#sectionExportacion').show();
                $('#Incoterm, #PaisDestino').prop('required', true);
            }
        }

