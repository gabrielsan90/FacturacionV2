        function loadProductoData(producto) {
            $('#Linea_Codigo').val(producto.codigo);
            $('#Linea_Descripcion').val(producto.nombre);
            $('#Linea_PrecioUnitario').val(producto.precioVenta.toFixed(2));

            // Limpiar impuestos existentes y agregar el del producto
            currentLine.impuestos = [];
            $('#tbodyImpuestos').html('');

            // Si el producto tiene impuesto, agregarlo
            if (producto.impuesto && producto.impuesto.tarifa) {
                // Determinar código de tarifa basado en el porcentaje
                let codigoTarifa = '08'; // Default 13%
                if (producto.impuesto.tarifa === 0) {
                    codigoTarifa = '01'; // 0%
                } else if (producto.impuesto.tarifa === 1) {
                    codigoTarifa = '02';
                } else if (producto.impuesto.tarifa === 2) {
                    codigoTarifa = '03';
                } else if (producto.impuesto.tarifa === 4) {
                    codigoTarifa = '04';
                } else if (producto.impuesto.tarifa === 8) {
                    codigoTarifa = '07';
                } else if (producto.impuesto.tarifa === 13) {
                    codigoTarifa = '08';
                }

                currentLine.impuestos.push({
                    codigoImpuesto: '01', // IVA
                    codigoTarifa: codigoTarifa,
                    tarifa: producto.impuesto.tarifa,
                    montoBase: 0,
                    montoImpuesto: 0,
                    tieneExoneracion: false,
                    exoneracion: null
                });

                renderTaxRow(0);
            } else {
                // Si no tiene impuesto, agregar uno por defecto
                addTaxToLine();
            }

            calculateLineTotal();
        }

