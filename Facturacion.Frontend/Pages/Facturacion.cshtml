        // ==================== CÁLCULOS DE LÍNEA ====================

        function calculateLineTotal() {
            const cantidad = parseFloat($('#Linea_Cantidad').val() || 0);
            const precioUnitario = parseFloat($('#Linea_PrecioUnitario').val() || 0);

            // 1. Monto Total
            currentLine.cantidad = cantidad;
            currentLine.precioUnitario = precioUnitario;
            currentLine.montoTotal = cantidad * precioUnitario;

            // 2. Calcular descuentos múltiples
            currentLine.montoDescuento = 0;
            currentLine.descuentos.forEach((desc, idx) => {
                if (desc.tipo === 'porcentaje') {
                    desc.monto = currentLine.montoTotal * (desc.valor / 100);
                } else {
                    desc.monto = desc.valor;
                }
                currentLine.montoDescuento += desc.monto;

                // Actualizar UI de la fila
                const row = $(`tr[data-discount-index="${idx}"]`);
                if (row.length) {
                    row.find('input[type="text"]').eq(1).val(formatCurrency(desc.monto));
                }
            });

            // 3. Subtotal (base para impuestos)
            currentLine.subtotal = currentLine.montoTotal - currentLine.montoDescuento;

            // 4. Calcular impuestos (con exoneraciones)
            currentLine.montoImpuesto = 0;
            currentLine.impuestos.forEach((tax, idx) => {
                tax.montoBase = currentLine.subtotal;
                tax.montoImpuestoSinExoneracion = tax.montoBase * (tax.tarifa / 100);

                // Aplicar exoneración
                if (tax.tieneExoneracion && tax.exoneracion) {
                    tax.exoneracion.monto = tax.montoImpuestoSinExoneracion * (tax.exoneracion.porcentaje / 100);
                    tax.montoImpuesto = tax.montoImpuestoSinExoneracion - tax.exoneracion.monto;
                } else {
                    tax.montoImpuesto = tax.montoImpuestoSinExoneracion;
                }

                currentLine.montoImpuesto += tax.montoImpuesto;

                // Actualizar UI de la fila (solo fila principal, no la de exoneración)
                const row = $(`tr[data-tax-index="${idx}"]`).first();
                if (row.length > 0) {
                    row.find('input[type="text"]').eq(0).val(formatCurrency(tax.montoBase));
                    row.find('input[type="text"]').eq(1).val(formatCurrency(tax.montoImpuesto));
                }
            });

            // 5. Total Línea
            currentLine.montoTotalLinea = currentLine.subtotal + currentLine.montoImpuesto;

            // Actualizar UI del modal (si existe el label)
            if ($('#lblSubtotalLinea').length > 0) {
                $('#lblSubtotalLinea').text(formatCurrency(currentLine.montoTotalLinea));
            }
        }

        // Mantener compatibilidad con código existente
        function calculateLineSubtotal() {
            calculateLineTotal();
        }

