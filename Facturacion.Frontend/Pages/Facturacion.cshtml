        // Resetear línea actual
        function resetCurrentLine() {
            currentLine = {
                numeroLinea: 0,
                productoId: null,
                codigo: '',
                descripcion: '',
                cantidad: 0,
                precioUnitario: 0,
                tipoTransaccion: '01',
                cabys: '',
                descuentos: [],
                impuestos: [],
                montoTotal: 0,
                montoDescuento: 0,
                subtotal: 0,
                montoImpuesto: 0,
