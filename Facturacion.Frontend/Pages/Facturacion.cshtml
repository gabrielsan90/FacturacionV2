                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (data) {
                    // Filtrar solo documentos aceptados (estado = 4)
                    todosLosDocumentos = data.filter(d => d.estado === 4);
                    initializeDocumentosDataTable();
                },
                error: function (xhr) {
                    console.error('Error loading documentos:', xhr);
                    tbody.html(`
                        <tr>
                            <td colspan="6" class="text-center text-danger">
                                <i class="fas fa-exclamation-triangle"></i> Error al cargar documentos
                            </td>
                        </tr>
                    `);
                }
            });
        }

        function initializeDocumentosDataTable() {
            // Destruir DataTable existente si existe
            if (tableDocumentos) {
                tableDocumentos.destroy();
            }

            const tiposDocumento = {
                1: 'FE',
                2: 'ND',
                3: 'NC',
                4: 'TE',
                9: 'FEE'
            };

            tableDocumentos = $('#tablaDocumentosModal').DataTable({
                data: todosLosDocumentos,
                columns: [
                    {
                        data: 'numeroConsecutivo',
                        render: function(data) {
                            return `<strong>${data}</strong>`;
                        }
                    },
                    {
                        data: 'tipoDocumento',
                        render: function(data) {
                            const tipo = tiposDocumento[data] || 'Desconocido';
                            return `<span class="badge bg-primary">${tipo}</span>`;
                        }
                    },
                    {
                        data: 'receptorNombre',
                        render: function(data) {
                            return data || '<span class="text-muted">Sin nombre</span>';
                        }
                    },
                    {
                        data: 'fecha',
                        render: function(data) {
                            if (!data) return '-';
                            const date = new Date(data);
                            return date.toLocaleDateString('es-CR');
                        }
                    },
                    {
                        data: 'totalComprobante',
                        className: 'text-end',
                        render: function(data) {
                            return formatCurrency(data || 0);
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        className: 'text-center',
                        render: function(data, type, row) {
                            return `
                                <button type="button" class="btn btn-sm btn-success" onclick="seleccionarDocumentoModal('${row.id}')">
                                    <i class="fas fa-check"></i> Seleccionar
                                </button>
                            `;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'
                },
                responsive: true,
                order: [[3, 'desc']], // Ordenar por fecha descendente
                pageLength: 10,
                dom: 'frtip' // Incluir búsqueda
            });
        }

        function seleccionarDocumentoModal(documentoId) {
            // Cerrar el modal
            $('#modalDocumentos').modal('hide');

            // Buscar el documento seleccionado
            const documento = todosLosDocumentos.find(d => d.id === documentoId);
