<div class="modal fade" id="modalLinea" tabindex="-1" aria-labelledby="modalLineaLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="modalLineaLabel">
                    <i class="fas fa-plus"></i> <span id="modalLineaTitle">Agregar Línea</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formLinea">
                <div class="modal-body">
                    <input type="hidden" id="Linea_Index" value="-1">

                    <!-- Product Selector -->
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label for="Linea_ProductoId" class="form-label">Producto/Servicio</label>
                            <select class="form-select select2" id="Linea_ProductoId">
                                <option value="">Buscar producto o servicio...</option>
                            </select>
                            <small class="text-muted">Seleccione un producto para auto-completar los campos</small>
                        </div>
                    </div>

                    <!-- Product Details -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label for="Linea_Codigo" class="form-label">Código</label>
                            <input type="text" class="form-control" id="Linea_Codigo" maxlength="50" placeholder="Código">
                        </div>
                        <div class="col-md-8">
                            <label for="Linea_Descripcion" class="form-label">Descripción <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="Linea_Descripcion" maxlength="500" required placeholder="Descripción del producto/servicio">
                        </div>
                    </div>

                    <!-- Quantities and Prices -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="Linea_Cantidad" class="form-label">Cantidad <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="Linea_Cantidad" step="0.001" min="0.001" required placeholder="1.000">
                        </div>
                        <div class="col-md-6">
                            <label for="Linea_PrecioUnitario" class="form-label">Precio Unitario <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="Linea_PrecioUnitario" step="0.01" min="0" required placeholder="0.00">
                        </div>
                    </div>

                    <!-- Tabla de Descuentos Múltiples -->
                    <div class="form-group mb-3">
                        <label>Descuentos</label>
                        <table class="table table-sm table-bordered" id="tableDescuentos">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 200px;">Naturaleza del Descuento</th>
                                    <th style="width: 120px;">Tipo</th>
                                    <th style="width: 120px;">Valor</th>
                                    <th style="width: 120px;">Monto Descuento</th>
                                    <th style="width: 40px;"></th>
                                </tr>
                            </thead>
                            <tbody id="tbodyDescuentos">
                                <!-- Filas dinámicas -->
                            </tbody>
                        </table>
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="addDiscountToLine()">
                            <i class="fas fa-plus"></i> Agregar Descuento
                        </button>
                    </div>

                    <!-- Tabla de Impuestos Múltiples -->
                    <div class="form-group mb-3">
                        <label>Impuestos (v4.4)</label>
                        <table class="table table-sm table-bordered" id="tableImpuestos">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 150px;">Código Impuesto</th>
                                    <th style="width: 200px;">Código Tarifa</th>
                                    <th style="width: 80px;">Tarifa %</th>
                                    <th style="width: 120px;">Monto Base</th>
                                    <th style="width: 120px;">Monto Impuesto</th>
                                    <th style="width: 80px;">Exoneración</th>
                                    <th style="width: 40px;"></th>
                                </tr>
                            </thead>
                            <tbody id="tbodyImpuestos">
                                <!-- Filas dinámicas -->
                            </tbody>
                        </table>
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="addTaxToLine()">
                            <i class="fas fa-plus"></i> Agregar Impuesto
                        </button>
                        <small class="text-muted d-block mt-1">Puede agregar múltiples impuestos según v4.4 (IVA, Selectivo, Servicios, etc.)</small>
                    </div>

                    <!-- Campos adicionales v4.4 -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="Linea_TipoTransaccion" class="form-label">Tipo de Transacción</label>
                            <select class="form-select" id="Linea_TipoTransaccion">
                                <option value="">-- Seleccione --</option>
                                <option value="01">01 - Venta de bienes</option>
                                <option value="02">02 - Venta de servicios</option>
                                <option value="03">03 - Importación de bienes</option>
                                <option value="04">04 - Importación de servicios</option>
                                <option value="05">05 - Exportación de bienes</option>
                                <option value="06">06 - Exportación de servicios</option>
                                <option value="07">07 - Compras locales de bienes</option>
                                <option value="08">08 - Compras locales de servicios</option>
                                <option value="09">09 - Devolución de mercancías</option>
                                <option value="10">10 - Descuentos y bonificaciones</option>
                                <option value="11">11 - Anticipos</option>
                                <option value="12">12 - Arrendamiento</option>
                                <option value="13">13 - Otros</option>
                            </select>
                            <small class="text-muted">Opcional - Tipo de transacción v4.4</small>
                        </div>
                        <div class="col-md-6">
                            <label for="Linea_CodigoCabys" class="form-label">Código CAByS <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="Linea_CodigoCabys" maxlength="13" placeholder="1234567890123">
                            <small class="text-muted">13 caracteres - Obligatorio desde 01/06/2025</small>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="Linea_FormaFarmaceutica" class="form-label">Forma Farmacéutica</label>
                            <select class="form-select" id="Linea_FormaFarmaceutica">
                                <option value="">-- Seleccione --</option>
                            </select>
                            <small class="text-muted">Solo para productos farmacéuticos</small>
                        </div>
                        <div class="col-md-6">
                            <label for="Linea_DetalleSurtido" class="form-label">Detalle Surtido</label>
                            <textarea class="form-control" id="Linea_DetalleSurtido" rows="2" maxlength="1000" placeholder="Detalle de combos/paquetes..."></textarea>
                            <small class="text-muted">Máx. 1000 caracteres - Para combos/paquetes</small>
                        </div>
                    </div>

                    <!-- Calculated Subtotal -->
                    <div class="row">
                        <div class="col-md-12">
                            <div class="alert alert-info">
                                <strong>Subtotal de Línea:</strong> <span id="lblSubtotalLinea">₡0.00</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-check"></i> Agregar Línea
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- DataTables -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>

    <!-- Select2 -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const empresaId = '@Model.EmpresaId';
        const documentoId = '@Model.DocumentoId';
        const isEditMode = documentoId && documentoId !== '';

        let documentLines = [];
        let otrosCargos = [];
        let sucursales = [];
        let terminales = [];
        let currentTipoDocumento = null;

        // Estructura global de línea actual (para edición en modal)
        let currentLine = {
            numeroLinea: 0,
            productoId: null,
            codigo: '',
            descripcion: '',
            cantidad: 0,
            precioUnitario: 0,
            tipoTransaccion: '01',
            cabys: '',
            descuentos: [],
            impuestos: [],
            // Totales calculados
            montoTotal: 0,
            montoDescuento: 0,
            subtotal: 0,
            montoImpuesto: 0,
            montoTotalLinea: 0
        };

        // Catálogo de tarifas IVA (según v4.4)
        const tarifasIVA = {
            '01': { nombre: '0% (Art. 32)', tarifa: 0 },
            '02': { nombre: '1% Reducida', tarifa: 1 },
            '03': { nombre: '2% Reducida', tarifa: 2 },
            '04': { nombre: '4% Reducida', tarifa: 4 },
            '05': { nombre: '0% Transitorio', tarifa: 0 },
            '06': { nombre: '4% Transitorio', tarifa: 4 },
            '07': { nombre: '8% Transitorio', tarifa: 8 },
            '08': { nombre: '13% General', tarifa: 13 },
            '09': { nombre: '0.5% Reducida', tarifa: 0.5 },
            '10': { nombre: 'Exento', tarifa: 0 },
            '11': { nombre: '0% Sin crédito', tarifa: 0 }
        };
        let clienteSeleccionado = null;
        let documentoEnEdicion = null;

        $(document).ready(function () {
            initializeForm();
            setupEventHandlers();
            loadInitialData();

            // Si estamos en modo edición, cargar el documento
            if (isEditMode) {
                loadDocumentoParaEditar(documentoId);
            }
        });

        function initializeForm() {
            // Initialize Select2 for Cliente
            $('#ClienteId').select2({
                theme: 'bootstrap-5',
                placeholder: 'Buscar cliente...',
                allowClear: true,
                ajax: {
                    url: '?handler=Clientes&empresaId=' + empresaId,
                    headers: {
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    },
                    dataType: 'json',
                    delay: 250,
                    processResults: function (data) {
                        return {
                            results: data.map(function (item) {
                                return {
                                    id: item.id,
                                    text: `${item.numeroIdentificacion} - ${item.nombre}`,
                                    data: item
                                };
                            })
                        };
                    },
                    cache: true
                }
            });

            // Initialize Select2 for Producto in modal
            $('#Linea_ProductoId').select2({
                theme: 'bootstrap-5',
                dropdownParent: $('#modalLinea'),
                placeholder: 'Buscar producto...',
                allowClear: true,
                ajax: {
                    url: '?handler=Productos&empresaId=' + empresaId,
                    headers: {
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    },
                    dataType: 'json',
                    delay: 250,
                    processResults: function (data) {
                        return {
                            results: data.map(function (item) {
                                return {
                                    id: item.id,
                                    text: `${item.codigo} - ${item.nombre}`,
                                    data: item
                                };
                            })
                        };
                    },
