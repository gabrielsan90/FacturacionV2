            currentLine.formaFarmaceutica = $('#Linea_FormaFarmaceutica').val() || null;
            currentLine.detalleSurtido = $('#Linea_DetalleSurtido').val() || null;

            // Ya calculados por calculateLineTotal()
            // currentLine.montoTotal, subtotal, montoImpuesto, descuentos, impuestos, etc.

            // Agregar o actualizar en array
            const index = parseInt($('#Linea_Index').val());
