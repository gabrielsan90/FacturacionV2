            // CABYS search button
            $('#btnBuscarCabys').on('click', function () {
                const codigo = $('#Linea_CodigoCabys').val().trim();
                if (codigo.length >= 3) {
                    buscarCabysPorCodigo(codigo);
                } else {
                    showWarning('Ingrese al menos 3 caracteres del código CABYS');
                }
            });

            // Form line submission
            $('#formLinea').on('submit', function (e) {
                e.preventDefault();
                addOrUpdateLine();
            });

            // Boton Validar
            $('#btnValidar').on('click', function () {
                const esValido = ValidacionesFE.validarTodo(true);

                // Actualizar resumen inline
                if (!esValido) {
                    mostrarErroresInline();
                } else {
                    $('#validationSummaryInline').hide();
                }
            });

            // Save buttons
            $('#btnGuardarBorrador').on('click', function () {
                saveDocument(1); // Estado: Borrador
            });

            $('#btnGuardarYEnviar').on('click', function () {
                // Validar antes de enviar a Hacienda
                if (!ValidacionesFE.validarTodo(true)) {
                    mostrarErroresInline();
                    return;
                }
                saveDocument(2); // Estado: Pendiente, then send
            });
        }

        // Mostrar errores de validacion en panel inline
        function mostrarErroresInline() {
            const $lista = $('#listaErroresInline');
            $lista.empty();

            ValidacionesFE.errores.forEach(error => {
                const iconClass = error.tipo === 'warning' ? 'text-warning fa-exclamation-triangle' : 'text-danger fa-times-circle';
                $lista.append(`<li><i class="fas ${iconClass} me-1"></i>${error.mensaje}</li>`);
            });

            if (ValidacionesFE.errores.length > 0) {
                $('#validationSummaryInline').show();

                // Scroll al resumen de errores
                $('html, body').animate({
                    scrollTop: $('#validationSummaryInline').offset().top - 100
                }, 500);
            } else {
                $('#validationSummaryInline').hide();
            }
        }

        function loadInitialData() {
            loadSucursales();
            loadTerminales();
            loadPaises();
            loadProvincias();
            loadEmpresaData();
            loadFormasFarmaceuticas();
            setFechaDocumento();
