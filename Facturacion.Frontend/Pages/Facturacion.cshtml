        function filterClientesModal() {
            const nombre = $('#filtroClienteNombre').val().toLowerCase().trim();
            const identificacion = $('#filtroClienteIdentificacion').val().toLowerCase().trim();
            const tipo = $('#filtroClienteTipo').val();

            let filtrados = todosLosClientes.filter(function (cliente) {
                let cumple = true;

                if (nombre && !cliente.nombre.toLowerCase().includes(nombre)) {
                    cumple = false;
                }

                if (identificacion && !cliente.numeroIdentificacion.toLowerCase().includes(identificacion)) {
                    cumple = false;
                }

                if (tipo && cliente.tipoIdentificacion != tipo) {
                    cumple = false;
                }

                return cumple;
            });

            renderClientesModal(filtrados);
        }

        function renderClientesModal(clientes) {
            const tbody = $('#tbodyClientesModal');

            if (!clientes || clientes.length === 0) {
                tbody.html(`
                    <tr>
                        <td colspan="5" class="text-center text-muted">
                            <i class="fas fa-info-circle"></i> No se encontraron clientes
                        </td>
                    </tr>
                `);
                return;
            }

            const tiposIdentificacion = {
                1: 'Física',
                2: 'Jurídica',
                3: 'DIMEX',
                4: 'NITE',
                5: 'Pasaporte',
                6: 'Extranjera'
            };

            let html = '';
            clientes.forEach(function (cliente) {
                const tipoNombre = tiposIdentificacion[cliente.tipoIdentificacion] || 'Desconocido';
                html += `
                    <tr>
                        <td>
                            <span class="badge bg-secondary">${tipoNombre}</span><br>
                            <strong>${cliente.numeroIdentificacion}</strong>
                        </td>
                        <td>${cliente.nombre}</td>
                        <td>${cliente.emailPrincipal || '<span class="text-muted">-</span>'}</td>
                        <td>${cliente.telefonoPrincipal || '<span class="text-muted">-</span>'}</td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-success" onclick="seleccionarClienteModal('${cliente.id}')">
                                <i class="fas fa-check"></i> Seleccionar
                            </button>
                        </td>
                    </tr>
                `;
            });

            tbody.html(html);
        }

