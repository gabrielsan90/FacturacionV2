<!-- Modal: Add/Edit Line -->
<div class="modal fade" id="modalLinea" tabindex="-1" aria-labelledby="modalLineaLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="modalLineaLabel">
                    <i class="fas fa-plus"></i> <span id="modalLineaTitle">Agregar Línea</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formLinea">
                <div class="modal-body">
                    <input type="hidden" id="Linea_Index" value="-1">

                    <!-- Product Selector -->
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label for="Linea_ProductoId" class="form-label">Producto/Servicio</label>
                            <select class="form-select select2" id="Linea_ProductoId">
                                <option value="">Buscar producto o servicio...</option>
                            </select>
                            <small class="text-muted">Seleccione un producto para auto-completar los campos</small>
                        </div>
                    </div>

                    <!-- Product Details -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label for="Linea_Codigo" class="form-label">Código</label>
                            <input type="text" class="form-control" id="Linea_Codigo" maxlength="50" placeholder="Código">
                        </div>
                        <div class="col-md-8">
                            <label for="Linea_Descripcion" class="form-label">Descripción <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="Linea_Descripcion" maxlength="500" required placeholder="Descripción del producto/servicio">
                        </div>
                    </div>

                    <!-- Quantities and Prices -->
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label for="Linea_Cantidad" class="form-label">Cantidad <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="Linea_Cantidad" step="0.001" min="0.001" required placeholder="1.000">
                        </div>
                        <div class="col-md-3">
                            <label for="Linea_PrecioUnitario" class="form-label">Precio Unitario <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="Linea_PrecioUnitario" step="0.01" min="0" required placeholder="0.00">
                        </div>
                        <div class="col-md-3">
                            <label for="Linea_DescuentoPorcentaje" class="form-label">Descuento %</label>
                            <input type="number" class="form-control" id="Linea_DescuentoPorcentaje" step="0.01" min="0" max="100" value="0" placeholder="0">
                        </div>
                        <div class="col-md-3">
                            <label for="Linea_ImpuestoPorcentaje" class="form-label">Impuesto %</label>
                            <input type="number" class="form-control" id="Linea_ImpuestoPorcentaje" step="0.01" min="0" value="13" placeholder="13">
                        </div>
                    </div>

