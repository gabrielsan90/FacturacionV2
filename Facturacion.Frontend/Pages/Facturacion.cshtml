        function loadProductoData(producto) {
            $('#Linea_Codigo').val(producto.codigo);
            $('#Linea_Descripcion').val(producto.nombre);
            $('#Linea_PrecioUnitario').val(producto.precioVenta.toFixed(2));

            // Load impuesto percentage if available
            if (producto.impuesto && producto.impuesto.tarifa) {
                $('#Linea_ImpuestoPorcentaje').val(producto.impuesto.tarifa);
            }

            // Load CABYS code and description if available
            if (producto.cabys && producto.cabys.codigo) {
                $('#Linea_CodigoCabys').val(producto.cabys.codigo);
                $('#lblCabysDescripcion').text(producto.cabys.descripcion).show();
            } else if (producto.cabysId) {
                // If only cabysId is available, search for the CABYS description
                buscarCabysPorCodigo($('#Linea_CodigoCabys').val());
            } else {
                $('#Linea_CodigoCabys').val('');
                $('#lblCabysDescripcion').hide();
            }

            calculateLineSubtotal();
        }

        function calculateLineSubtotal() {
            const cantidad = parseFloat($('#Linea_Cantidad').val()) || 0;
            const precio = parseFloat($('#Linea_PrecioUnitario').val()) || 0;
            const descPorcentaje = parseFloat($('#Linea_DescuentoPorcentaje').val()) || 0;
            const impPorcentaje = parseFloat($('#Linea_ImpuestoPorcentaje').val()) || 0;

            const montoTotal = cantidad * precio;
            const descuento = montoTotal * (descPorcentaje / 100);
            const subtotal = montoTotal - descuento;
            const impuesto = subtotal * (impPorcentaje / 100);
            const total = subtotal + impuesto;

            $('#lblSubtotalLinea').text(formatCurrency(total));
        }

        function buscarCabysPorCodigo(codigo) {
            if (!codigo || codigo.length < 3) {
                $('#lblCabysDescripcion').hide();
                return;
            }

            $.ajax({
                url: '?handler=BuscarCabys&codigo=' + encodeURIComponent(codigo),
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success && response.data) {
                        $('#lblCabysDescripcion').text(response.data.descripcion).show();
                    } else {
                        $('#lblCabysDescripcion').text('Código no encontrado').show();
                    }
                },
                error: function() {
                    $('#lblCabysDescripcion').hide();
                }
            });
        }

