@page
@model Facturacion.Frontend.Pages.MonedasModel
@{
    ViewData["Title"] = "Monedas";
    ViewData["Breadcrumb"] = "Monedas";
}

<!-- Page Header -->
<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h2><i class="fas fa-money-bill-wave"></i> Monedas</h2>
            <p class="mb-0">Configuración de monedas y tipos de cambio - Catálogo Ministerio de Hacienda</p>
        </div>
        <span class="badge bg-info fs-6 px-3 py-2">
            <i class="fas fa-lock me-2"></i>Solo Lectura
        </span>
    </div>
</div>

<div class="card shadow-custom">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
            <i class="fas fa-coins me-2"></i>Listado de Monedas
            <span class="badge bg-primary ms-2" id="badgeTotalMonedas">0</span>
        </h5>
    </div>
    <div class="card-body">
        <div class="alert alert-info" role="alert">
            <i class="fas fa-info-circle me-2"></i>
            Este catálogo es proporcionado por el Ministerio de Hacienda de Costa Rica y es de solo lectura.
        </div>

        <!-- Loading State -->
        <div id="tableMonedasLoader" class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-3 text-muted">Cargando monedas...</p>
        </div>

        <!-- Table Container -->
        <div id="tableMonedasContainer" style="display: none;">
            <table id="tableMonedas" class="table table-hover">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <!-- Empty State -->
        <div id="emptyStateMonedas" class="text-center py-5" style="display: none;">
            <i class="fas fa-money-bill-wave fa-4x text-muted mb-3"></i>
            <h5 class="text-muted">No hay monedas disponibles</h5>
            <p class="text-muted">El catálogo de monedas está vacío o no se pudo cargar.</p>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let table;

    $(document).ready(function() {
        loadDataTable();
    });

    function loadDataTable() {
        // Show loading state
        $('#tableMonedasLoader').show();
        $('#tableMonedasContainer').hide();
        $('#emptyStateMonedas').hide();

        table = initDataTable('#tableMonedas', {
            ajax: {
                url: '?handler=Data',
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                dataSrc: function(json) {
                    // Hide loader and show appropriate state
                    $('#tableMonedasLoader').hide();

                    if (json.data && json.data.length > 0) {
                        $('#tableMonedasContainer').show();
                        $('#emptyStateMonedas').hide();
                        // Update badge with total count
                        $('#badgeTotalMonedas').text(json.data.length);
                    } else {
                        $('#tableMonedasContainer').hide();
                        $('#emptyStateMonedas').show();
                        $('#badgeTotalMonedas').text('0');
                    }

                    return json.data;
                }
            },
            columns: [
                { data: 'codigo' },
                { data: 'nombre' }
            ],
            order: [[0, 'asc']]
        });
    }
</script>
}
