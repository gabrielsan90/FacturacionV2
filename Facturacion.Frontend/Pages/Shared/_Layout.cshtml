    <script>
        // Toggle Sidebar Function
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('show');
        }

        // Logout Function
        function logout() {
            Swal.fire({
                title: '¿Cerrar sesión?',
                text: '¿Está seguro que desea salir del sistema?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Sí, cerrar sesión',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#667eea',
                cancelButtonColor: '#6c757d',
                customClass: {
                    popup: 'swal-custom-popup'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '/Auth/Logout';
                }
            });
        }

        // Show "Coming Soon" message
        function showComingSoon() {
            Swal.fire({
                icon: 'info',
                title: 'Próximamente',
                text: 'Esta funcionalidad estará disponible próximamente.',
                confirmButtonText: 'Entendido',
                confirmButtonColor: '#667eea'
            });
        }

        // Active menu highlighting and group expansion
        $(document).ready(function() {
            var currentPath = window.location.pathname.toLowerCase();

            // Remove any existing active classes
            $('.sidebar-nav .nav-link').removeClass('active');

            // Find and activate the current menu item
            $('.sidebar-nav .nav-link').each(function() {
                var linkPath = $(this).attr('href');

                // Skip group toggles
                if ($(this).hasClass('nav-group-toggle')) return;

                // Check if this is an external link or page link
                if (linkPath) {
                    var normalizedLinkPath = linkPath.toLowerCase();
                    if (normalizedLinkPath === currentPath ||
                        (normalizedLinkPath !== '/' && currentPath.startsWith(normalizedLinkPath))) {
                        $(this).addClass('active');

                        // Expand all parent groups (handles nested subgroups too)
                        var parentGroups = $(this).parents('.nav-group-items');
                        parentGroups.each(function() {
                            $(this).addClass('show');
                            $(this).prev('.nav-group-toggle').attr('aria-expanded', 'true');
                        });
                    }
                }
            });

            // Bootstrap handles the collapse toggle automatically via data-bs-toggle="collapse"
            // We just need to update aria-expanded when Bootstrap events fire
            $('.nav-group-items').on('show.bs.collapse', function() {
                $(this).prev('.nav-group-toggle').attr('aria-expanded', 'true');
            }).on('hide.bs.collapse', function() {
                $(this).prev('.nav-group-toggle').attr('aria-expanded', 'false');
            });

            // Close sidebar when clicking outside on mobile
            $(document).on('click', function(event) {
                if (window.innerWidth < 992) {
                    var sidebar = $('#sidebar');
                    var toggler = $('.header-toggler');

                    if (!sidebar.is(event.target) && sidebar.has(event.target).length === 0 &&
                        !toggler.is(event.target) && toggler.has(event.target).length === 0) {
                        sidebar.removeClass('show');
                    }
                }
            });

            // Load user companies for company selector
            function loadUserCompanies() {
                $.ajax({
                    url: '/Shared/CompanySelector?handler=Companies',
                    type: 'GET',
                    success: function(response) {
                        const companyList = $('#companyList');
                        companyList.empty();

                        if (response.companies && response.companies.length > 0) {
                            response.companies.forEach(function(company) {
                                const isActive = company.id === response.currentEmpresaId;
                                const icon = isActive ? 'fas fa-check' : 'far fa-circle';
                                const activeClass = isActive ? 'active' : '';

                                const displayName = company.cedulaJuridica
                                    ? company.nombreComercial + ' (' + company.cedulaJuridica + ')'
                                    : company.nombreComercial;

                                const item = $('<li>').append(
                                    $('<a>')
                                        .addClass('dropdown-item ' + activeClass)
                                        .attr('href', '#')
                                        .attr('data-empresa-id', company.id)
                                        .attr('data-empresa-nombre', company.nombreComercial)
                                        .html('<i class="' + icon + ' me-2"></i> ' + displayName)
                                        .on('click', function(e) {
                                            e.preventDefault();
                                            if (!isActive) {
                                                switchCompany(company.id, company.nombreComercial);
                                            }
                                        })
                                );

                                companyList.append(item);
                            });

                            // Add divider and manage link
                            companyList.append('<li><hr class="dropdown-divider"></li>');
                            companyList.append(
                                $('<li>').append(
                                    $('<a>')
                                        .addClass('dropdown-item')
                                        .attr('href', '/Configuracion/Empresas')
                                        .html('<i class="fas fa-cog me-2"></i> Administrar Empresas')
                                )
                            );
                        } else {
                            companyList.append(
                                $('<li>').addClass('px-3 py-2 text-muted small').text('No hay empresas disponibles')
                            );
                        }
                    },
                    error: function() {
                        const companyList = $('#companyList');
                        companyList.empty();
                        companyList.append(
                            $('<li>').addClass('px-3 py-2 text-danger small').text('Error al cargar empresas')
                        );
                    }
                });
            }

            // Switch to a different company
            function switchCompany(empresaId, empresaNombre) {
                Swal.fire({
                    title: 'Cambiando empresa...',
                    text: 'Por favor espere',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                $.ajax({
                    url: '/Shared/CompanySelector?handler=SwitchCompany',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ empresaId: empresaId }),
                    beforeSend: function(xhr) {
                        xhr.setRequestHeader('RequestVerificationToken', $('input[name="__RequestVerificationToken"]').val());
                    },
                    success: function(response) {
                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Empresa cambiada',
                                text: 'La empresa ha sido cambiada exitosamente',
                                timer: 1500,
                                showConfirmButton: false
                            }).then(() => {
                                // Reload the page to refresh all data
                                window.location.reload();
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message || 'No se pudo cambiar de empresa',
                                confirmButtonColor: '#667eea'
                            });
                        }
                    },
                    error: function() {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Error al cambiar de empresa. Intente nuevamente.',
                            confirmButtonColor: '#667eea'
                        });
                    }
                });
            }

            // Load companies when page loads
            @if (User.Identity?.IsAuthenticated == true)
            {
                <text>
                loadUserCompanies();
                </text>
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
