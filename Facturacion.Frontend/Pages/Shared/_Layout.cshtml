<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Facturación Electrónica</title>

    <!-- Google Fonts - Poppins -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- FontAwesome 6 -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">

    <!-- DataTables -->
    <link href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.dataTables.min.css" rel="stylesheet">

    <!-- Select2 -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet">

    <!-- SweetAlert2 -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">

    <!-- Modern Theme - Blue Professional -->
    <link href="~/css/modern-theme.css" rel="stylesheet" asp-append-version="true" />

    <!-- Site CSS -->
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @Html.AntiForgeryToken()
    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
        <!-- Brand Logo -->
        <div class="sidebar-brand">
            <div class="brand-icon">
                <i class="fas fa-receipt"></i>
            </div>
            <div class="brand-text">
                Facturación CR
                <span class="brand-version">Versión 4.4</span>
            </div>
        </div>

        <!-- Navigation Menu -->
        @{
            var isSuperUser = User.IsInRole("SuperUser");
            var isAdmin = User.IsInRole("Administrador de Empresa");
            var isContador = User.IsInRole("Contador");
            var isFacturador = User.IsInRole("Facturador");
            var isVendedor = User.IsInRole("Vendedor");
            var isInventarista = User.IsInRole("Inventarista");
            var isConsultor = User.IsInRole("Consultor");

            var fullAccess = isSuperUser || isAdmin;
            var canInvoice = fullAccess || isFacturador || isVendedor || isContador || isConsultor;
            var canSell = fullAccess || isVendedor || isFacturador || isConsultor;
            var canBuy = fullAccess || isContador || isConsultor;
            var canCatalog = true; // Todos ven catálogo
            var canInventory = fullAccess || isInventarista || isConsultor;
            var canAccounting = fullAccess || isContador || isConsultor;
            var canCxC = fullAccess || isFacturador || isVendedor || isContador || isConsultor;
            var canCxP = fullAccess || isContador || isConsultor;
            var canHR = fullAccess;
            var canAssets = fullAccess || isContador || isConsultor;
            var canBudgets = fullAccess || isContador || isConsultor;
            var canReports = true; // Todos ven reportes
            var canSystem = fullAccess;
        }
        <ul class="sidebar-nav" data-simplebar>
            <!-- Dashboard -->
            <li class="nav-item">
                <a class="nav-link" asp-page="/Index">
                    <i class="fas fa-chart-line nav-icon"></i>
                    Dashboard
                </a>
            </li>

            @if (canInvoice)
            {
            <!-- ========== FACTURACIÓN ========== -->
            <li class="nav-group">
                <a class="nav-link nav-group-toggle" data-bs-toggle="collapse" data-bs-target="#facturacionGroup" aria-expanded="false">
                    <i class="fas fa-file-invoice-dollar nav-icon"></i>
                    FACTURACIÓN
                    <i class="fas fa-chevron-down nav-arrow"></i>
                </a>
                <ul class="nav-group-items collapse" id="facturacionGroup">
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/DocumentosElectronicos/CrearDocumento">
                            <i class="fas fa-file-invoice"></i>
                            Nueva Factura
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/DocumentosElectronicos/Documentos">
                            <i class="fas fa-file-alt"></i>
                            Documentos
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/DocumentosElectronicos/MensajesReceptor">
                            <i class="fas fa-envelope-open-text"></i>
                            Mensajes Receptor
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/DocumentosElectronicos/DocumentosRecibidos">
                            <i class="fas fa-file-import"></i>
                            Documentos Recibidos
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Pagos/RecibosPago">
                            <i class="fas fa-money-check-alt"></i>
                            Recibo Electrónico de Pago
                            <span class="badge bg-success text-white ms-auto" style="font-size: 0.65rem;">v4.4</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Stock/Recepciones">
                            <i class="fas fa-inbox"></i>
                            Recepciones
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Gastos/Gasto">
                            <i class="fas fa-receipt"></i>
                            Gastos
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Gastos/CategoriasGasto">
                            <i class="fas fa-folder-open"></i>
                            Categorías de Gastos
                        </a>
                    </li>
                </ul>
            </li>
            }

            @if (canSell)
            {
            <!-- ========== VENTAS ========== -->
            <li class="nav-group">
                <a class="nav-link nav-group-toggle" data-bs-toggle="collapse" data-bs-target="#ventasGroup" aria-expanded="false">
                    <i class="fas fa-shopping-cart nav-icon"></i>
                    VENTAS
                    <i class="fas fa-chevron-down nav-arrow"></i>
                </a>
                <ul class="nav-group-items collapse" id="ventasGroup">
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Ventas/Cotizaciones">
                            <i class="fas fa-file-signature"></i>
                            Cotizaciones
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Ventas/PedidosVenta">
                            <i class="fas fa-clipboard-list"></i>
                            Pedidos de Venta
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Ventas/HistorialVentas">
                            <i class="fas fa-history"></i>
                            Historial de Ventas
                        </a>
                    </li>
                </ul>
            </li>
            }

            @if (canBuy)
            {
            <!-- ========== COMPRAS ========== -->
            <li class="nav-group">
                <a class="nav-link nav-group-toggle" data-bs-toggle="collapse" data-bs-target="#comprasGroup" aria-expanded="false">
                    <i class="fas fa-truck-loading nav-icon"></i>
                    COMPRAS
                    <i class="fas fa-chevron-down nav-arrow"></i>
                </a>
                <ul class="nav-group-items collapse" id="comprasGroup">
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Compras/Requisiciones">
                            <i class="fas fa-file-alt"></i>
                            Requisiciones
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Compras/CotizacionesProveedor">
                            <i class="fas fa-balance-scale"></i>
                            Cotizaciones Proveedor
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Compras/OrdenesCompra">
                            <i class="fas fa-clipboard-list"></i>
                            Órdenes de Compra
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Compras/RecepcionesCompra">
                            <i class="fas fa-dolly"></i>
                            Recepciones de Compra
                        </a>
                    </li>
                </ul>
            </li>
            }

            <!-- ========== CATÁLOGO ========== -->
            <li class="nav-group">
                <a class="nav-link nav-group-toggle" data-bs-toggle="collapse" data-bs-target="#catalogoGroup" aria-expanded="false">
                    <i class="fas fa-folder-open nav-icon"></i>
                    CATÁLOGO
                    <i class="fas fa-chevron-down nav-arrow"></i>
                </a>
                <ul class="nav-group-items collapse" id="catalogoGroup">
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Maestros/Clientes">
                            <i class="fas fa-user-tie"></i>
                            Clientes
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Maestros/Productos">
                            <i class="fas fa-box"></i>
                            Productos
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Maestros/Proveedores">
                            <i class="fas fa-truck"></i>
                            Proveedores
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Maestros/Categorias">
                            <i class="fas fa-tags"></i>
                            Categorías
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Maestros/Exoneraciones">
                            <i class="fas fa-file-contract"></i>
                            Exoneraciones
                        </a>
                    </li>
                    <!-- Catálogos Hacienda Sub-group -->
                    <li class="nav-group nav-subgroup">
                        <a class="nav-link nav-group-toggle" data-bs-toggle="collapse" data-bs-target="#catalogosHaciendaGroup" aria-expanded="false">
                            <i class="fas fa-book"></i>
                            Catálogos Hacienda
                            <i class="fas fa-chevron-down nav-arrow"></i>
                        </a>
                        <ul class="nav-group-items collapse" id="catalogosHaciendaGroup">
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Catalogos/Monedas">
                                    <i class="fas fa-coins"></i>
                                    Monedas
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Catalogos/FormasPago">
                                    <i class="fas fa-credit-card"></i>
                                    Formas de Pago
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Catalogos/TiposDocumentos">
                                    <i class="fas fa-file-alt"></i>
                                    Tipos de Documentos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Catalogos/TiposReferencias">
                                    <i class="fas fa-link"></i>
                                    Tipos de Referencias
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Catalogos/TiposOtrosCargos">
                                    <i class="fas fa-plus-circle"></i>
                                    Tipos de Otros Cargos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Catalogos/TiposCodigosProducto">
                                    <i class="fas fa-barcode"></i>
                                    Tipos de Códigos Producto
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Catalogos/CondicionesVenta">
                                    <i class="fas fa-handshake"></i>
                                    Condiciones de Venta
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Maestros/UnidadesMedidaPage">
                                    <i class="fas fa-ruler"></i>
                                    Unidades de Medida
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Catalogos/TiposIdentificacion">
                                    <i class="fas fa-id-card"></i>
                                    Tipos de Identificación
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Maestros/ImpuestosPage">
                                    <i class="fas fa-percent"></i>
                                    Impuestos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Catalogos/CodigosTarifasIVA">
                                    <i class="fas fa-percentage"></i>
                                    Códigos de Tarifas IVA
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Catalogos/TiposExoneracion">
                                    <i class="fas fa-file-contract"></i>
                                    Tipos de Exoneración
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Catalogos/ActividadesEconomicas">
                                    <i class="fas fa-briefcase"></i>
                                    Actividades Económicas
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Catalogos/Cabys">
                                    <i class="fas fa-barcode"></i>
                                    Códigos CABYS
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </li>

            @if (canInventory)
            {
            <!-- ========== INVENTARIO ========== -->
            <li class="nav-group">
                <a class="nav-link nav-group-toggle" data-bs-toggle="collapse" data-bs-target="#inventarioGroup" aria-expanded="false">
                    <i class="fas fa-warehouse nav-icon"></i>
                    INVENTARIO
                    <i class="fas fa-chevron-down nav-arrow"></i>
                </a>
                <ul class="nav-group-items collapse" id="inventarioGroup">
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Stock/Inventario">
                            <i class="fas fa-boxes"></i>
                            Stock Actual
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Stock/Bodegas">
                            <i class="fas fa-warehouse"></i>
                            Bodegas
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Stock/MovimientosInventario">
                            <i class="fas fa-exchange-alt"></i>
                            Movimientos
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Stock/Kardex">
                            <i class="fas fa-clipboard-list"></i>
                            Kardex
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Stock/Traspasos">
                            <i class="fas fa-truck-moving"></i>
                            Traspasos
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Stock/AjustesInventario">
                            <i class="fas fa-sliders-h"></i>
                            Ajustes de Inventario
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Maestros/AsignarProductosSucursal">
                            <i class="fas fa-cubes"></i>
                            Asignar Productos a Sucursal
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Catalogos/MantenimientoCabys">
                            <i class="fas fa-tools"></i>
                            Mantenimiento CABYS
                        </a>
                    </li>
                </ul>
            </li>
            }

            @if (canAccounting)
            {
            <!-- ========== CONTABILIDAD ========== -->
            <li class="nav-group">
                <a class="nav-link nav-group-toggle" data-bs-toggle="collapse" data-bs-target="#contabilidadGroup" aria-expanded="false">
                    <i class="fas fa-calculator nav-icon"></i>
                    CONTABILIDAD
                    <i class="fas fa-chevron-down nav-arrow"></i>
                </a>
                <ul class="nav-group-items collapse" id="contabilidadGroup">
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Contabilidad/PlanCuentas">
                            <i class="fas fa-sitemap"></i>
                            Plan de Cuentas
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Contabilidad/PeriodosContables">
                            <i class="fas fa-calendar-alt"></i>
                            Períodos Contables
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Contabilidad/AsientosContables">
                            <i class="fas fa-book"></i>
                            Asientos Contables
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Contabilidad/MayoresContables">
                            <i class="fas fa-balance-scale"></i>
                            Mayores Contables
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Contabilidad/PlantillasAsiento">
                            <i class="fas fa-file-alt"></i>
                            Plantillas de Asientos
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Contabilidad/CuentasIntegracion">
                            <i class="fas fa-plug"></i>
                            Cuentas de Integración
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Contabilidad/ConfiguracionContable">
                            <i class="fas fa-cog"></i>
                            Configuración
                        </a>
                    </li>
                </ul>
            </li>
            }

            @if (canAccounting)
            {
            <!-- ========== BANCOS ========== -->
            <li class="nav-group">
                <a class="nav-link nav-group-toggle" data-bs-toggle="collapse" data-bs-target="#bancosGroup" aria-expanded="false">
                    <i class="fas fa-university nav-icon"></i>
                    BANCOS
                    <i class="fas fa-chevron-down nav-arrow"></i>
                </a>
                <ul class="nav-group-items collapse" id="bancosGroup">
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Bancos/Bancos">
                            <i class="fas fa-building-columns"></i>
                            Catálogo de Bancos
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Bancos/CuentasBancarias">
                            <i class="fas fa-credit-card"></i>
                            Cuentas Bancarias
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Bancos/MovimientosBancarios">
                            <i class="fas fa-exchange-alt"></i>
                            Movimientos
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Bancos/ConciliacionesBancarias">
                            <i class="fas fa-check-double"></i>
                            Conciliaciones
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Bancos/ExtractosBancarios">
                            <i class="fas fa-file-invoice-dollar"></i>
                            Extractos Bancarios
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Bancos/ReglasConciliacion">
                            <i class="fas fa-magic"></i>
                            Reglas de Conciliación
                        </a>
                    </li>
                </ul>
            </li>
            }

            @if (canCxC)
            {
            <!-- ========== CUENTAS POR COBRAR ========== -->
            <li class="nav-group">
                <a class="nav-link nav-group-toggle" data-bs-toggle="collapse" data-bs-target="#cxcGroup" aria-expanded="false">
                    <i class="fas fa-hand-holding-usd nav-icon"></i>
                    CUENTAS POR COBRAR
                    <i class="fas fa-chevron-down nav-arrow"></i>
                </a>
                <ul class="nav-group-items collapse" id="cxcGroup">
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/CxC/CuentasPorCobrar">
                            <i class="fas fa-file-invoice-dollar"></i>
                            Cuentas por Cobrar
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/CxC/EstadoCuenta">
                            <i class="fas fa-user-clock"></i>
                            Estado de Cuenta Cliente
                        </a>
                    </li>
                </ul>
            </li>
            }

            @if (canCxP)
            {
            <!-- ========== CUENTAS POR PAGAR ========== -->
            <li class="nav-group">
                <a class="nav-link nav-group-toggle" data-bs-toggle="collapse" data-bs-target="#cxpGroup" aria-expanded="false">
                    <i class="fas fa-money-check-alt nav-icon"></i>
                    CUENTAS POR PAGAR
                    <i class="fas fa-chevron-down nav-arrow"></i>
                </a>
                <ul class="nav-group-items collapse" id="cxpGroup">
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/CxP/CuentasPorPagar">
                            <i class="fas fa-file-invoice"></i>
                            Cuentas por Pagar
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/CxP/EstadoCuentaProveedor">
                            <i class="fas fa-truck"></i>
                            Estado de Cuenta Proveedor
                        </a>
                    </li>
                </ul>
            </li>
            }

            @if (canHR)
            {
            <!-- ========== RECURSOS HUMANOS ========== -->
            <li class="nav-group">
                <a class="nav-link nav-group-toggle" data-bs-toggle="collapse" data-bs-target="#rrhhGroup" aria-expanded="false">
                    <i class="fas fa-users nav-icon"></i>
                    RECURSOS HUMANOS
                    <i class="fas fa-chevron-down nav-arrow"></i>
                </a>
                <ul class="nav-group-items collapse" id="rrhhGroup">
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/RRHH/Empleados">
                            <i class="fas fa-id-badge"></i>
                            Empleados
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/RRHH/Departamentos">
                            <i class="fas fa-sitemap"></i>
                            Departamentos
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/RRHH/Puestos">
                            <i class="fas fa-briefcase"></i>
                            Puestos
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/RRHH/Planillas">
                            <i class="fas fa-money-bill-wave"></i>
                            Planillas
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/RRHH/Vacaciones">
                            <i class="fas fa-umbrella-beach"></i>
                            Vacaciones
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/RRHH/Incapacidades">
                            <i class="fas fa-notes-medical"></i>
                            Incapacidades
                        </a>
                    </li>
                </ul>
            </li>
            }

            @if (canAssets)
            {
            <!-- ========== ACTIVOS FIJOS ========== -->
            <li class="nav-group">
