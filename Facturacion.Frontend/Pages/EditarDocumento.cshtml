@page
@model Facturacion.Frontend.Pages.EditarDocumentoModel
@{
    ViewData["Title"] = "Editar Documento Electrónico";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2><i class="fas fa-edit"></i> Editar Documento Electrónico</h2>
                <div class="btn-group">
                    <a href="/Documentos" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Volver a Lista
                    </a>
                    <button class="btn btn-info" id="btnVerDetalle">
                        <i class="fas fa-eye"></i> Ver Detalle
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-warning">
                    <h5 class="mb-0"><i class="fas fa-info-circle"></i> Información</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <h4><i class="fas fa-exclamation-circle"></i> Funcionalidad en Desarrollo</h4>
                        <p class="mb-0">
                            La edición completa de documentos electrónicos se implementará en el siguiente sprint.
                            Esta funcionalidad incluirá:
                        </p>
                        <ul class="mt-2">
                            <li>Agregar y editar líneas de detalle (productos/servicios)</li>
                            <li>Configurar impuestos por línea (IVA, otros impuestos)</li>
                            <li>Aplicar descuentos a nivel de línea y documento</li>
                            <li>Agregar referencias a otros documentos (para ND/NC)</li>
                            <li>Configurar múltiples medios de pago</li>
                            <li>Información de exportación (para FEE)</li>
                            <li>Cálculos automáticos de totales</li>
                            <li>Validaciones según normativa de Hacienda v4.4</li>
                        </ul>
                        <p class="mt-3 mb-0">
                            Por ahora, puede ver los detalles del documento en modo lectura.
                        </p>
                    </div>

                    <div class="text-center mt-4">
                        <button class="btn btn-primary btn-lg" onclick="redirectToDetalle()">
                            <i class="fas fa-arrow-right"></i> Ir a Ver Detalle del Documento
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Roadmap Card -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-road"></i> Roadmap - Próximas Funcionalidades</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6><i class="fas fa-check-circle text-success"></i> Sprint Actual (Completado)</h6>
                            <ul>
                                <li>Lista de documentos con filtros avanzados</li>
                                <li>Visualización de documentos en modo lectura</li>
                                <li>Creación básica de documentos (estado Borrador)</li>
                                <li>Eliminación de documentos en Borrador</li>
                                <li>Badges y estados según normativa Hacienda</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h6><i class="fas fa-clock text-warning"></i> Siguiente Sprint</h6>
                            <ul>
                                <li><strong>Edición completa de documentos</strong></li>
                                <li>Gestión de líneas de detalle</li>
                                <li>Configuración de impuestos y descuentos</li>
                                <li>Referencias entre documentos</li>
                                <li>Validaciones de negocio</li>
                                <li>Generación de PDF</li>
                            </ul>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <h6><i class="fas fa-calendar-alt text-info"></i> Sprint +2</h6>
                            <ul>
                                <li>Integración con Hacienda (envío XML)</li>
                                <li>Firma digital de documentos</li>
                                <li>Procesamiento de respuestas de Hacienda</li>
                                <li>Modo contingencia</li>
                                <li>Reenvío de documentos</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h6><i class="fas fa-star text-primary"></i> Sprint +3</h6>
                            <ul>
                                <li>Mensajes receptores (aceptación/rechazo)</li>
                                <li>Reportes y estadísticas</li>
                                <li>Exportación masiva</li>
                                <li>Plantillas de documentos</li>
                                <li>Integración con inventario</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <script>
        const documentoId = '@Model.DocumentoId';

        $(document).ready(function () {
            if (!documentoId || documentoId === '') {
                Swal.fire({
                    title: 'Error',
                    text: 'ID de documento no especificado.',
                    icon: 'error'
                }).then(() => {
                    window.location.href = '/Documentos';
                });
                return;
            }

            // Set button click handler
            $('#btnVerDetalle').on('click', function () {
                redirectToDetalle();
            });

            // Auto-redirect after 3 seconds
            setTimeout(function () {
                showRedirectMessage();
            }, 2000);
        });

        function redirectToDetalle() {
            window.location.href = `/DocumentoDetalle?id=${documentoId}`;
        }

        function showRedirectMessage() {
            Swal.fire({
                title: 'Edición no disponible',
                text: 'La edición completa se implementará en el siguiente sprint. ¿Desea ver el detalle del documento?',
                icon: 'info',
                showCancelButton: true,
                confirmButtonText: 'Sí, ver detalle',
                cancelButtonText: 'Volver a lista',
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#6c757d'
            }).then((result) => {
                if (result.isConfirmed) {
                    redirectToDetalle();
                } else {
                    window.location.href = '/Documentos';
                }
            });
        }
    </script>
}
