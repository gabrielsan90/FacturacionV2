@page
@model Facturacion.Frontend.Pages.Compras.RecepcionesCompraModel
@{
    ViewData["Title"] = "Recepciones de Compra";
    ViewData["Breadcrumb"] = "Recepciones de Compra";
}

<!-- Page Header -->
<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <h2><i class="fas fa-truck-loading"></i> Recepciones de Compra</h2>
            <p class="mb-0">Registro de entrada de mercadería al inventario</p>
        </div>
        <button class="btn btn-primary" onclick="openCreateModal()" aria-label="Crear nueva recepción">
            <i class="fas fa-plus me-2"></i>Nueva Recepción
        </button>
    </div>
</div>

<!-- Filters Card -->
<div class="card shadow-custom mb-4">
    <div class="card-header">
        <i class="fas fa-filter me-2 text-primary"></i>
        <strong>Filtros</strong>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-3 mb-3">
                <label class="form-label">Estado</label>
                <select class="form-select" id="filterEstado">
                    <option value="">Todos</option>
                    <option value="APL">Aplicada</option>
                    <option value="ANU">Anulada</option>
                </select>
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">Fecha Desde</label>
                <input type="date" class="form-control" id="filterFechaDesde" />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">Fecha Hasta</label>
                <input type="date" class="form-control" id="filterFechaHasta" />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">&nbsp;</label>
                <button type="button" class="btn btn-primary w-100" onclick="aplicarFiltros()">
                    <i class="fas fa-search me-2"></i>Buscar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Recepciones Table Card -->
<div class="card shadow-custom">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <i class="fas fa-table me-2 text-primary"></i>
            <strong>Listado de Recepciones</strong>
            <span class="badge bg-secondary ms-2" id="badgeTotalRecepciones">0</span>
        </div>
        <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="btn btn-outline-primary" onclick="refrescarTabla()" title="Refrescar tabla">
                <i class="fas fa-sync-alt"></i>
            </button>
        </div>
    </div>
    <div class="card-body">
        <!-- Loading State -->
        <div id="tableRecepcionesLoader" class="text-center py-5">
            <div class="spinner-modern mx-auto"></div>
            <p class="text-muted mt-3">Cargando recepciones...</p>
        </div>

        <!-- Table -->
        <div class="table-responsive" id="tableRecepcionesContainer" style="display:none;">
            <table id="tableRecepciones" class="table table-hover">
                <thead>
                    <tr>
                        <th>Número</th>
                        <th>Fecha</th>
                        <th>Orden de Compra</th>
                        <th>Proveedor</th>
                        <th>Bodega</th>
                        <th>Factura Proveedor</th>
                        <th>Estado</th>
                        <th style="width: 120px;">Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <!-- Empty State -->
        <div id="emptyStateRecepciones" class="empty-state" style="display:none;">
            <div class="empty-state-icon">
                <i class="fas fa-truck-loading"></i>
            </div>
            <h3 class="empty-state-title">No hay recepciones registradas</h3>
            <p class="empty-state-description">Comienza registrando tu primera recepción de compra</p>
            <button class="btn btn-primary" onclick="openCreateModal()">
                <i class="fas fa-plus me-2"></i>Crear Primera Recepción
            </button>
        </div>
    </div>
</div>

<!-- Modal Create -->
<div class="modal fade" id="modalRecepcion" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Nueva Recepción de Compra</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="formRecepcion" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="Recepcion_Id" value="00000000-0000-0000-0000-000000000000" />

                    <!-- Información General -->
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Orden de Compra <span class="text-danger">*</span></label>
                            <select class="form-select" id="Recepcion_OrdenCompraId" required onchange="cargarOrdenCompra()">
                                <option value="">Seleccione...</option>
                            </select>
                            <div class="invalid-feedback">Seleccione una orden de compra.</div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Fecha <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="Recepcion_Fecha" required />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Bodega <span class="text-danger">*</span></label>
                            <select class="form-select" id="Recepcion_BodegaId" required>
                                <option value="">Seleccione...</option>
                            </select>
                            <div class="invalid-feedback">Seleccione una bodega.</div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Número Factura Proveedor</label>
                            <input type="text" class="form-control" id="Recepcion_NumeroFacturaProveedor" maxlength="50" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Fecha Factura Proveedor</label>
                            <input type="date" class="form-control" id="Recepcion_FechaFacturaProveedor" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Observaciones</label>
                            <textarea class="form-control" id="Recepcion_Observaciones" rows="2" maxlength="500"></textarea>
                        </div>
                    </div>

                    <hr />
                    <h6 class="text-primary mb-3"><i class="fas fa-list me-2"></i>Detalles de la Recepción</h6>

                    <!-- Información de OC -->
                    <div id="infoOrdenCompra" class="alert alert-info" style="display: none;">
                        <strong>Orden de Compra:</strong>
                        <span id="infoOrdenNumero"></span> -
                        <strong>Proveedor:</strong>
                        <span id="infoOrdenProveedor"></span>
                    </div>

                    <!-- Tabla de Detalles -->
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered" id="tableDetalles">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 40%;">Producto</th>
                                    <th style="width: 15%;">Cantidad OC</th>
                                    <th style="width: 15%;">Ya Recibido</th>
                                    <th style="width: 15%;">Cantidad a Recibir</th>
                                    <th style="width: 15%;">Precio Unit.</th>
                                </tr>
                            </thead>
                            <tbody id="detallesBody">
                                <tr>
                                    <td colspan="5" class="text-center text-muted">
                                        <i>Seleccione una orden de compra</i>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-1"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Guardar Recepción
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Ver Detalle -->
<div class="modal fade" id="modalVerDetalle" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fas fa-eye me-2"></i>Detalle de Recepción</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalVerDetalleBody">
                <!-- Contenido dinámico -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i> Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let table;
    const empresaId = '@Model.EmpresaId';
    let detalles = [];
    let ordenCompraActual = null;

    $(document).ready(function() {
        loadDataTable();
        setupFormSubmit();
        loadOrdenesCompra();
        loadBodegas();
        setDefaultDate();
    });

    function setDefaultDate() {
        const today = new Date().toISOString().split('T')[0];
        $('#Recepcion_Fecha').val(today);
    }

    function loadDataTable() {
        table = $('#tableRecepciones').DataTable({
            ajax: {
                url: '?handler=Data',
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                data: function(d) {
                    const estado = $('#filterEstado').val();
                    const fechaDesde = $('#filterFechaDesde').val();
                    const fechaHasta = $('#filterFechaHasta').val();
                    if (estado) d.estado = estado;
                    if (fechaDesde) d.fechaDesde = fechaDesde;
                    if (fechaHasta) d.fechaHasta = fechaHasta;
                },
                dataSrc: function(json) {
                    $('#tableRecepcionesLoader').hide();
                    const data = json.data || json || [];
                    $('#badgeTotalRecepciones').text(data.length);

                    if (data.length > 0) {
                        $('#tableRecepcionesContainer').show();
                        $('#emptyStateRecepciones').hide();
                    } else {
                        $('#tableRecepcionesContainer').hide();
                        $('#emptyStateRecepciones').show();
                    }

                    return data;
                },
                error: function(xhr, error, code) {
                    $('#tableRecepcionesLoader').hide();
                    $('#tableRecepcionesContainer').hide();
                    $('#emptyStateRecepciones').show();
                    $('#badgeTotalRecepciones').text('0');
                    console.error('Error loading recepciones:', error);
                }
            },
            columns: [
                { data: 'numero' },
                {
                    data: 'fecha',
                    render: function(data) {
                        return formatDate(data);
                    }
                },
                {
                    data: 'ordenCompra',
                    render: function(data) {
                        return data ? data.numero : '<span class="text-muted">-</span>';
                    }
                },
                {
                    data: 'ordenCompra',
                    render: function(data) {
                        return data && data.proveedor ? data.proveedor.nombre : '<span class="text-muted">-</span>';
                    }
                },
                {
                    data: 'bodega',
                    render: function(data) {
                        return data ? data.nombre : '<span class="text-muted">-</span>';
                    }
                },
                {
                    data: 'numeroFacturaProveedor',
                    render: function(data) {
                        return data || '<span class="text-muted">-</span>';
                    }
                },
                {
                    data: 'estado',
                    render: function(data) {
                        return getBadgeEstado(data);
                    }
                },
                {
                    data: 'id',
                    orderable: false,
                    render: function(data, type, row) {
                        let buttons = `
                            <button class="btn btn-sm btn-info" onclick="verDetalle('${data}')" title="Ver detalle">
                                <i class="fas fa-eye"></i>
                            </button>
                        `;

                        if (row.estado === 'APL') {
                            buttons += `
                                <button class="btn btn-sm btn-danger" onclick="anular('${data}')" title="Anular">
                                    <i class="fas fa-ban"></i>
                                </button>
                            `;
                        }

                        return buttons;
                    }
                }
            ],
            language: {
                url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'
            },
            responsive: true,
            order: [[1, 'desc']],
            pageLength: 25
        });
    }

    function setupFormSubmit() {
        $('#formRecepcion').on('submit', function(e) {
            e.preventDefault();
            if (this.checkValidity() && detalles.length > 0) {
                save();
            } else {
                if (detalles.length === 0) {
                    showError('Debe tener al menos un detalle para recibir');
                }
                $(this).addClass('was-validated');
            }
        });
    }

    function loadOrdenesCompra() {
        $.ajax({
            url: '?handler=OrdenesCompraAprobadas',
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(data) {
                const select = $('#Recepcion_OrdenCompraId');
                select.empty().append('<option value="">Seleccione...</option>');
                data.forEach(item => {
                    const proveedor = item.proveedor ? item.proveedor.nombre : '';
                    select.append(`<option value="${item.id}">${item.numero} - ${proveedor}</option>`);
                });
            }
        });
    }

    function loadBodegas() {
        $.ajax({
            url: '?handler=Bodegas',
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(data) {
                const select = $('#Recepcion_BodegaId');
                select.empty().append('<option value="">Seleccione...</option>');
                data.forEach(item => {
                    select.append(`<option value="${item.id}">${item.nombre}</option>`);
                });
            }
        });
    }

    function cargarOrdenCompra() {
        const ordenId = $('#Recepcion_OrdenCompraId').val();
        if (!ordenId) {
            $('#infoOrdenCompra').hide();
            detalles = [];
            renderDetalles();
            return;
        }

        $.ajax({
            url: '?handler=OrdenCompraDetails&id=' + ordenId,
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success) {
                    ordenCompraActual = response.data;
                    $('#infoOrdenNumero').text(ordenCompraActual.numero);
                    $('#infoOrdenProveedor').text(ordenCompraActual.proveedor ? ordenCompraActual.proveedor.nombre : '-');
                    $('#infoOrdenCompra').show();

                    // Set bodega from OC
                    if (ordenCompraActual.bodegaDestinoId) {
                        $('#Recepcion_BodegaId').val(ordenCompraActual.bodegaDestinoId);
                    }

                    // Load detalles
                    detalles = [];
                    if (ordenCompraActual.detalles && ordenCompraActual.detalles.length > 0) {
                        ordenCompraActual.detalles.forEach(detalle => {
                            const cantidadPendiente = detalle.cantidad - (detalle.cantidadRecibida || 0);
                            if (cantidadPendiente > 0) {
                                detalles.push({
                                    id: '00000000-0000-0000-0000-000000000000',
                                    ordenCompraDetalleId: detalle.id,
                                    productoId: detalle.productoId,
                                    productoNombre: detalle.producto ? detalle.producto.nombre : 'Producto',
                                    cantidadOrdenada: detalle.cantidad,
                                    cantidadRecibida: detalle.cantidadRecibida || 0,
                                    cantidadARecibir: cantidadPendiente,
                                    precioUnitario: detalle.precioUnitario
                                });
                            }
                        });
                    }

                    renderDetalles();
                } else {
                    showError(response.message);
                }
            }
        });
    }

    function renderDetalles() {
        const tbody = $('#detallesBody');
        tbody.empty();

        if (detalles.length === 0) {
            tbody.append(`
                <tr>
                    <td colspan="5" class="text-center text-muted">
                        <i>Seleccione una orden de compra</i>
                    </td>
                </tr>
            `);
            return;
        }

        const moneda = ordenCompraActual ? (ordenCompraActual.moneda || 'CRC') : 'CRC';

        detalles.forEach((detalle, index) => {
            tbody.append(`
                <tr>
                    <td>${detalle.productoNombre}</td>
                    <td class="text-end">${detalle.cantidadOrdenada.toFixed(3)}</td>
                    <td class="text-end">${detalle.cantidadRecibida.toFixed(3)}</td>
                    <td>
                        <input type="number" step="0.001" class="form-control form-control-sm text-end"
                               value="${detalle.cantidadARecibir.toFixed(3)}"
                               min="0" max="${detalle.cantidadARecibir}"
                               onchange="updateCantidad(${index}, this.value)" />
                    </td>
                    <td class="text-end">${formatCurrency(detalle.precioUnitario, moneda)}</td>
                </tr>
            `);
        });
    }

    function updateCantidad(index, value) {
        const cantidad = parseFloat(value) || 0;
        const maxCantidad = detalles[index].cantidadOrdenada - detalles[index].cantidadRecibida;

        if (cantidad > maxCantidad) {
            showError('La cantidad no puede ser mayor a la pendiente de recibir');
            detalles[index].cantidadARecibir = maxCantidad;
            renderDetalles();
        } else {
            detalles[index].cantidadARecibir = cantidad;
        }
    }

    function openCreateModal() {
        $('#formRecepcion')[0].reset();
        $('#formRecepcion').removeClass('was-validated');
        $('#Recepcion_Id').val('00000000-0000-0000-0000-000000000000');
        $('#infoOrdenCompra').hide();
        detalles = [];
        ordenCompraActual = null;
        renderDetalles();
        setDefaultDate();
        $('#modalRecepcion').modal('show');
    }

    function verDetalle(id) {
        $.ajax({
            url: '?handler=Details&id=' + id,
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success) {
                    const rec = response.data;
                    let html = `
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>Número:</strong> ${rec.numero}</p>
                                <p><strong>Fecha:</strong> ${formatDate(rec.fecha)}</p>
                                <p><strong>Orden de Compra:</strong> ${rec.ordenCompra ? rec.ordenCompra.numero : '-'}</p>
                                <p><strong>Bodega:</strong> ${rec.bodega ? rec.bodega.nombre : '-'}</p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>Estado:</strong> ${getBadgeEstado(rec.estado)}</p>
                                <p><strong>Factura Proveedor:</strong> ${rec.numeroFacturaProveedor || '-'}</p>
                                <p><strong>Fecha Factura:</strong> ${rec.fechaFacturaProveedor ? formatDate(rec.fechaFacturaProveedor) : '-'}</p>
                                <p><strong>Observaciones:</strong> ${rec.observaciones || '-'}</p>
                            </div>
                        </div>
                        <hr>
                        <h6>Detalles Recibidos:</h6>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>Producto</th>
                                        <th>Cantidad Recibida</th>
                                        <th>Precio Unit.</th>
                                    </tr>
                                </thead>
                                <tbody>
                    `;

                    if (rec.detalles && rec.detalles.length > 0) {
                        rec.detalles.forEach(detalle => {
                            html += `
                                <tr>
                                    <td>${detalle.producto ? detalle.producto.nombre : '-'}</td>
                                    <td class="text-end">${detalle.cantidad.toFixed(3)}</td>
                                    <td class="text-end">${formatCurrency(detalle.precioUnitario, 'CRC')}</td>
                                </tr>
                            `;
                        });
                    } else {
                        html += '<tr><td colspan="3" class="text-center">No hay detalles</td></tr>';
                    }

                    html += `
                                </tbody>
                            </table>
                        </div>
                    `;

                    $('#modalVerDetalleBody').html(html);
                    $('#modalVerDetalle').modal('show');
                } else {
                    showError(response.message);
                }
            }
        });
    }

    function save() {
        const recepcionData = {
            id: '00000000-0000-0000-0000-000000000000',
            empresaId: empresaId,
            ordenCompraId: $('#Recepcion_OrdenCompraId').val(),
            bodegaId: $('#Recepcion_BodegaId').val(),
            fecha: $('#Recepcion_Fecha').val() + 'T00:00:00',
            numeroFacturaProveedor: $('#Recepcion_NumeroFacturaProveedor').val() || null,
            fechaFacturaProveedor: $('#Recepcion_FechaFacturaProveedor').val() ? $('#Recepcion_FechaFacturaProveedor').val() + 'T00:00:00' : null,
            observaciones: $('#Recepcion_Observaciones').val() || null,
            estado: 'APL',
            detalles: detalles.filter(d => d.cantidadARecibir > 0).map(d => ({
                id: '00000000-0000-0000-0000-000000000000',
                ordenCompraDetalleId: d.ordenCompraDetalleId,
                productoId: d.productoId,
                cantidad: d.cantidadARecibir,
                precioUnitario: d.precioUnitario
            }))
        };

        if (recepcionData.detalles.length === 0) {
            showError('Debe recibir al menos un producto');
            return;
        }

        $.ajax({
            url: '?handler=Save',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(recepcionData),
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success) {
                    showSuccess(response.message);
                    $('#modalRecepcion').modal('hide');
                    table.ajax.reload();
                } else {
                    showError(response.message);
                }
            }
        });
    }

    function anular(id) {
        confirmDelete('¿Está seguro de anular esta recepción? Esta acción no se puede revertir', function() {
            $.ajax({
                url: '?handler=Anular&id=' + id,
                type: 'POST',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        showSuccess(response.message);
                        table.ajax.reload();
                    } else {
                        showError(response.message);
                    }
                }
            });
        });
    }

    function aplicarFiltros() {
        $('#tableRecepcionesLoader').show();
        $('#tableRecepcionesContainer').hide();
        $('#emptyStateRecepciones').hide();
        table.ajax.reload();
    }

    function refrescarTabla() {
        $('#tableRecepcionesLoader').show();
        $('#tableRecepcionesContainer').hide();
        $('#emptyStateRecepciones').hide();
        table.ajax.reload();
    }

    function getBadgeEstado(estado) {
        const badges = {
            'APL': '<span class="badge bg-success">Aplicada</span>',
            'ANU': '<span class="badge bg-danger">Anulada</span>'
        };
        return badges[estado] || `<span class="badge bg-secondary">${estado}</span>`;
    }
</script>
}
