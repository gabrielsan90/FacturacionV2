@page
@model Facturacion.Frontend.Pages.Compras.OrdenesCompraModel
@{
    ViewData["Title"] = "Órdenes de Compra";
    ViewData["Breadcrumb"] = "Órdenes de Compra";
}

<!-- Page Header -->
<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <h2><i class="fas fa-shopping-cart"></i> Órdenes de Compra</h2>
            <p class="mb-0">Gestión de órdenes de compra a proveedores</p>
        </div>
        <button class="btn btn-primary" onclick="openCreateModal()" aria-label="Crear nueva orden de compra">
            <i class="fas fa-plus me-2"></i>Nueva Orden de Compra
        </button>
    </div>
</div>

<!-- Filters Card -->
<div class="card shadow-custom mb-4">
    <div class="card-header">
        <i class="fas fa-filter me-2 text-primary"></i>
        <strong>Filtros</strong>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-3 mb-3">
                <label class="form-label">Estado</label>
                <select class="form-select" id="filterEstado">
                    <option value="">Todos</option>
                    <option value="BOR">Borrador</option>
                    <option value="PEN">Pendiente</option>
                    <option value="APR">Aprobada</option>
                    <option value="PAR">Parcial</option>
                    <option value="COM">Completada</option>
                    <option value="ANU">Anulada</option>
                </select>
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">&nbsp;</label>
                <button type="button" class="btn btn-primary w-100" onclick="aplicarFiltros()">
                    <i class="fas fa-search me-2"></i>Buscar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Órdenes de Compra Table Card -->
<div class="card shadow-custom">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <i class="fas fa-table me-2 text-primary"></i>
            <strong>Listado de Órdenes de Compra</strong>
            <span class="badge bg-secondary ms-2" id="badgeTotalOrdenes">0</span>
        </div>
        <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="btn btn-outline-primary" onclick="refrescarTabla()" title="Refrescar tabla">
                <i class="fas fa-sync-alt"></i>
            </button>
        </div>
    </div>
    <div class="card-body">
        <!-- Loading State -->
        <div id="tableOrdenesLoader" class="text-center py-5">
            <div class="spinner-modern mx-auto"></div>
            <p class="text-muted mt-3">Cargando órdenes de compra...</p>
        </div>

        <!-- Table -->
        <div class="table-responsive" id="tableOrdenesContainer" style="display:none;">
            <table id="tableOrdenes" class="table table-hover">
                <thead>
                    <tr>
                        <th>Número</th>
                        <th>Fecha</th>
                        <th>Proveedor</th>
                        <th>Monto Total</th>
                        <th>Estado</th>
                        <th style="width: 180px;">Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <!-- Empty State -->
        <div id="emptyStateOrdenes" class="empty-state" style="display:none;">
            <div class="empty-state-icon">
                <i class="fas fa-shopping-cart"></i>
            </div>
            <h3 class="empty-state-title">No hay órdenes de compra registradas</h3>
            <p class="empty-state-description">Comienza agregando tu primera orden de compra</p>
            <button class="btn btn-primary" onclick="openCreateModal()">
                <i class="fas fa-plus me-2"></i>Crear Primera Orden
            </button>
        </div>
    </div>
</div>

<!-- Modal Create/Edit -->
<div class="modal fade" id="modalOrden" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitle">Nueva Orden de Compra</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="formOrden" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="Orden_Id" value="00000000-0000-0000-0000-000000000000" />
                    <input type="hidden" id="Orden_Estado" value="BOR" />

                    <!-- Información General -->
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Proveedor <span class="text-danger">*</span></label>
                            <select class="form-select" id="Orden_ProveedorId" required>
                                <option value="">Seleccione...</option>
                            </select>
                            <div class="invalid-feedback">Seleccione un proveedor.</div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Sucursal <span class="text-danger">*</span></label>
                            <select class="form-select" id="Orden_SucursalId" required>
                                <option value="">Seleccione...</option>
                            </select>
                            <div class="invalid-feedback">Seleccione una sucursal.</div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Bodega Destino <span class="text-danger">*</span></label>
                            <select class="form-select" id="Orden_BodegaDestinoId" required>
                                <option value="">Seleccione...</option>
                            </select>
                            <div class="invalid-feedback">Seleccione una bodega.</div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Fecha <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="Orden_Fecha" required />
                            <div class="invalid-feedback">La fecha es obligatoria.</div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Fecha Entrega Esperada</label>
                            <input type="date" class="form-control" id="Orden_FechaEntregaEsperada" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Moneda</label>
                            <select class="form-select" id="Orden_Moneda">
                                <option value="CRC">CRC - Colón</option>
                                <option value="USD">USD - Dólar</option>
                                <option value="EUR">EUR - Euro</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Condición de Pago</label>
                            <select class="form-select" id="Orden_CondicionPago">
                                <option value="CON">Contado</option>
                                <option value="CRE">Crédito</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Días de Crédito</label>
                            <input type="number" class="form-control" id="Orden_DiasCredito" value="0" min="0" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Tipo de Cambio</label>
                            <input type="number" step="0.01" class="form-control" id="Orden_TipoCambio" value="1.00" min="0" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Observaciones</label>
                            <textarea class="form-control" id="Orden_Observaciones" rows="2" maxlength="500"></textarea>
                        </div>
                    </div>

                    <hr />
                    <h6 class="text-primary mb-3"><i class="fas fa-list me-2"></i>Detalles de la Orden</h6>

                    <!-- Agregar Producto -->
                    <div class="row mb-3">
                        <div class="col-md-5">
                            <label class="form-label">Producto</label>
                            <select class="form-select" id="DetalleProductoId">
                                <option value="">Seleccione un producto...</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Cantidad</label>
                            <input type="number" step="0.001" class="form-control" id="DetalleCantidad" value="1" min="0.001" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Precio Unit.</label>
                            <input type="number" step="0.01" class="form-control" id="DetallePrecioUnitario" value="0" min="0" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">% IVA</label>
                            <input type="number" step="0.01" class="form-control" id="DetallePorcentajeIVA" value="13" min="0" max="100" />
                        </div>
                        <div class="col-md-1 d-flex align-items-end">
                            <button type="button" class="btn btn-success w-100" onclick="agregarDetalle()">
                                <i class="fas fa-plus"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Tabla de Detalles -->
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered" id="tableDetalles">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 40%;">Producto</th>
                                    <th style="width: 12%;">Cantidad</th>
                                    <th style="width: 15%;">Precio Unit.</th>
                                    <th style="width: 10%;">% IVA</th>
                                    <th style="width: 15%;">Total Línea</th>
                                    <th style="width: 8%;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="detallesBody">
                                <tr>
                                    <td colspan="6" class="text-center text-muted">
                                        <i>No hay productos agregados</i>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Totales -->
                    <div class="row mt-3">
                        <div class="col-md-8"></div>
                        <div class="col-md-4">
                            <table class="table table-sm">
                                <tr>
                                    <td class="text-end"><strong>Subtotal:</strong></td>
                                    <td class="text-end" id="labelSubtotal">₡0.00</td>
                                </tr>
                                <tr>
                                    <td class="text-end"><strong>Impuesto:</strong></td>
                                    <td class="text-end" id="labelImpuesto">₡0.00</td>
                                </tr>
                                <tr class="table-primary">
                                    <td class="text-end"><strong>TOTAL:</strong></td>
                                    <td class="text-end"><strong id="labelTotal">₡0.00</strong></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-1"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Ver Detalle -->
<div class="modal fade" id="modalVerDetalle" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fas fa-eye me-2"></i>Detalle de Orden de Compra</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalVerDetalleBody">
                <!-- Contenido dinámico -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i> Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let table;
    const empresaId = '@Model.EmpresaId';
    let detalles = [];
    let productos = [];
    let proveedores = [];
    let sucursales = [];
    let bodegas = [];

    $(document).ready(function() {
        loadDataTable();
        setupFormSubmit();
        loadProveedores();
        loadProductos();
        loadSucursales();
        loadBodegas();
        setDefaultDate();
    });

    function setDefaultDate() {
        const today = new Date().toISOString().split('T')[0];
        $('#Orden_Fecha').val(today);
    }

    function loadDataTable() {
        table = $('#tableOrdenes').DataTable({
            ajax: {
                url: '?handler=Data',
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                data: function(d) {
                    const estado = $('#filterEstado').val();
                    if (estado) {
                        d.estado = estado;
                    }
                },
                dataSrc: function(json) {
                    $('#tableOrdenesLoader').hide();
                    const data = json.data || json || [];
                    $('#badgeTotalOrdenes').text(data.length);

                    if (data.length > 0) {
                        $('#tableOrdenesContainer').show();
                        $('#emptyStateOrdenes').hide();
                    } else {
                        $('#tableOrdenesContainer').hide();
                        $('#emptyStateOrdenes').show();
                    }

                    return data;
                },
                error: function(xhr, error, code) {
                    $('#tableOrdenesLoader').hide();
                    $('#tableOrdenesContainer').hide();
                    $('#emptyStateOrdenes').show();
                    $('#badgeTotalOrdenes').text('0');
                    console.error('Error loading ordenes:', error);
                }
            },
            columns: [
                { data: 'numero' },
                {
                    data: 'fecha',
                    render: function(data) {
                        return formatDate(data);
                    }
                },
                {
                    data: 'proveedor',
                    render: function(data) {
                        return data ? data.nombre : '<span class="text-muted">-</span>';
                    }
                },
                {
                    data: 'total',
                    render: function(data, type, row) {
                        return formatCurrency(data, row.moneda || 'CRC');
                    }
                },
                {
                    data: 'estado',
                    render: function(data) {
                        return getBadgeEstado(data);
                    }
                },
                {
                    data: 'id',
                    orderable: false,
                    render: function(data, type, row) {
                        let buttons = `
                            <button class="btn btn-sm btn-info" onclick="verDetalle('${data}')" title="Ver detalle">
                                <i class="fas fa-eye"></i>
                            </button>
                        `;

                        // Solo editar si está en borrador
                        if (row.estado === 'BOR') {
                            buttons += `
                                <button class="btn btn-sm btn-warning" onclick="edit('${data}')" title="Editar">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="btn btn-sm btn-success" onclick="enviarAprobacion('${data}')" title="Enviar para aprobación">
                                    <i class="fas fa-paper-plane"></i>
                                </button>
                            `;
                        }

                        // Aprobar si está pendiente
                        if (row.estado === 'PEN') {
                            buttons += `
                                <button class="btn btn-sm btn-primary" onclick="aprobar('${data}')" title="Aprobar">
                                    <i class="fas fa-check"></i>
                                </button>
                            `;
                        }

                        // Eliminar solo si está en borrador
                        if (row.estado === 'BOR') {
                            buttons += `
                                <button class="btn btn-sm btn-danger" onclick="deleteRecord('${data}')" title="Eliminar">
                                    <i class="fas fa-trash"></i>
                                </button>
                            `;
                        }

                        return buttons;
                    }
                }
            ],
            language: {
                url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'
            },
            responsive: true,
            order: [[1, 'desc']],
            pageLength: 25
        });
    }

    function setupFormSubmit() {
        $('#formOrden').on('submit', function(e) {
            e.preventDefault();
            if (this.checkValidity() && detalles.length > 0) {
                save();
            } else {
                if (detalles.length === 0) {
                    showError('Debe agregar al menos un producto a la orden');
                }
                $(this).addClass('was-validated');
            }
        });
    }

    function loadProveedores() {
        $.ajax({
            url: '?handler=Proveedores',
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(data) {
                proveedores = data;
                const select = $('#Orden_ProveedorId');
                select.empty().append('<option value="">Seleccione...</option>');
                data.forEach(item => {
                    select.append(`<option value="${item.id}">${item.nombre}</option>`);
                });
            },
            error: function(xhr) {
                console.error('Error loading proveedores:', xhr);
            }
        });
    }

    function loadProductos() {
        $.ajax({
            url: '?handler=Productos',
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(data) {
                productos = data;
                const select = $('#DetalleProductoId');
                select.empty().append('<option value="">Seleccione un producto...</option>');
                data.forEach(item => {
                    select.append(`<option value="${item.id}">${item.nombre} - ${item.codigo || ''}</option>`);
                });
            },
            error: function(xhr) {
                console.error('Error loading productos:', xhr);
            }
        });
    }

    function loadSucursales() {
        $.ajax({
            url: '?handler=Sucursales',
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(data) {
                sucursales = data;
                const select = $('#Orden_SucursalId');
                select.empty().append('<option value="">Seleccione...</option>');
                data.forEach(item => {
                    select.append(`<option value="${item.id}">${item.nombre}</option>`);
                });
            },
            error: function(xhr) {
                console.error('Error loading sucursales:', xhr);
            }
        });
    }

    function loadBodegas() {
        $.ajax({
            url: '?handler=Bodegas',
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(data) {
                bodegas = data;
                const select = $('#Orden_BodegaDestinoId');
                select.empty().append('<option value="">Seleccione...</option>');
                data.forEach(item => {
                    select.append(`<option value="${item.id}">${item.nombre}</option>`);
                });
            },
            error: function(xhr) {
                console.error('Error loading bodegas:', xhr);
            }
        });
    }

    function openCreateModal() {
        $('#formOrden')[0].reset();
        $('#formOrden').removeClass('was-validated');
        $('#Orden_Id').val('00000000-0000-0000-0000-000000000000');
        $('#Orden_Estado').val('BOR');
        $('#Orden_Moneda').val('CRC');
        $('#Orden_CondicionPago').val('CON');
        $('#Orden_DiasCredito').val(0);
        $('#Orden_TipoCambio').val(1.00);
        detalles = [];
        renderDetalles();
        setDefaultDate();
        $('#modalTitle').text('Nueva Orden de Compra');
        $('#modalOrden').modal('show');
    }

    function agregarDetalle() {
        const productoId = $('#DetalleProductoId').val();
        const cantidad = parseFloat($('#DetalleCantidad').val()) || 0;
        const precioUnitario = parseFloat($('#DetallePrecioUnitario').val()) || 0;
        const porcentajeIVA = parseFloat($('#DetallePorcentajeIVA').val()) || 0;

        if (!productoId) {
            showError('Seleccione un producto');
            return;
        }

        if (cantidad <= 0) {
            showError('La cantidad debe ser mayor a cero');
            return;
        }

        if (precioUnitario <= 0) {
            showError('El precio unitario debe ser mayor a cero');
            return;
        }

        const producto = productos.find(p => p.id === productoId);
        if (!producto) {
            showError('Producto no encontrado');
            return;
        }

        // Calcular totales
        const subtotal = cantidad * precioUnitario;
        const impuesto = subtotal * (porcentajeIVA / 100);
        const totalLinea = subtotal + impuesto;

        const detalle = {
            id: '00000000-0000-0000-0000-000000000000',
            productoId: productoId,
            productoNombre: producto.nombre,
            cantidad: cantidad,
            precioUnitario: precioUnitario,
            porcentajeIVA: porcentajeIVA,
            impuesto: impuesto,
            subtotal: subtotal,
            totalLinea: totalLinea,
            descuento: 0,
            porcentajeDescuento: 0,
            cantidadRecibida: 0,
            numeroLinea: detalles.length + 1
        };

        detalles.push(detalle);
        renderDetalles();

        // Limpiar campos
        $('#DetalleProductoId').val('');
        $('#DetalleCantidad').val(1);
        $('#DetallePrecioUnitario').val(0);
        $('#DetallePorcentajeIVA').val(13);
    }

    function removeDetalle(index) {
        detalles.splice(index, 1);
        renderDetalles();
    }

    function renderDetalles() {
        const tbody = $('#detallesBody');
        tbody.empty();

        if (detalles.length === 0) {
            tbody.append(`
                <tr>
                    <td colspan="6" class="text-center text-muted">
                        <i>No hay productos agregados</i>
                    </td>
                </tr>
            `);
            actualizarTotales();
            return;
        }

        const moneda = $('#Orden_Moneda').val() || 'CRC';

        detalles.forEach((detalle, index) => {
            tbody.append(`
                <tr>
                    <td>${detalle.productoNombre}</td>
                    <td class="text-end">${detalle.cantidad.toFixed(3)}</td>
                    <td class="text-end">${formatCurrency(detalle.precioUnitario, moneda)}</td>
                    <td class="text-end">${detalle.porcentajeIVA.toFixed(2)}%</td>
                    <td class="text-end">${formatCurrency(detalle.totalLinea, moneda)}</td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-danger" onclick="removeDetalle(${index})">
                            <i class="fas fa-trash"></i>
                        </button>
                    </td>
                </tr>
            `);
        });

        actualizarTotales();
    }

    function actualizarTotales() {
        let subtotal = 0;
        let impuesto = 0;
        let total = 0;

        detalles.forEach(detalle => {
            subtotal += detalle.subtotal;
            impuesto += detalle.impuesto;
            total += detalle.totalLinea;
        });

        const moneda = $('#Orden_Moneda').val() || 'CRC';
        $('#labelSubtotal').text(formatCurrency(subtotal, moneda));
        $('#labelImpuesto').text(formatCurrency(impuesto, moneda));
        $('#labelTotal').text(formatCurrency(total, moneda));
    }

    function verDetalle(id) {
        $.ajax({
            url: '?handler=Details&id=' + id,
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success) {
                    const orden = response.data;
                    let html = `
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>Número:</strong> ${orden.numero}</p>
                                <p><strong>Fecha:</strong> ${formatDate(orden.fecha)}</p>
                                <p><strong>Proveedor:</strong> ${orden.proveedor ? orden.proveedor.nombre : '-'}</p>
                                <p><strong>Sucursal:</strong> ${orden.sucursal ? orden.sucursal.nombre : '-'}</p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>Estado:</strong> ${getBadgeEstado(orden.estado)}</p>
                                <p><strong>Moneda:</strong> ${orden.moneda}</p>
                                <p><strong>Total:</strong> ${formatCurrency(orden.total, orden.moneda)}</p>
                                <p><strong>Observaciones:</strong> ${orden.observaciones || '-'}</p>
                            </div>
                        </div>
                        <hr>
                        <h6>Detalles:</h6>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>Producto</th>
                                        <th>Cantidad</th>
                                        <th>Precio Unit.</th>
                                        <th>Total Línea</th>
                                    </tr>
                                </thead>
                                <tbody>
                    `;

                    if (orden.detalles && orden.detalles.length > 0) {
                        orden.detalles.forEach(detalle => {
                            html += `
                                <tr>
                                    <td>${detalle.producto ? detalle.producto.nombre : '-'}</td>
                                    <td class="text-end">${detalle.cantidad.toFixed(3)}</td>
                                    <td class="text-end">${formatCurrency(detalle.precioUnitario, orden.moneda)}</td>
                                    <td class="text-end">${formatCurrency(detalle.totalLinea, orden.moneda)}</td>
                                </tr>
                            `;
                        });
                    } else {
                        html += '<tr><td colspan="4" class="text-center">No hay detalles</td></tr>';
                    }

                    html += `
                                </tbody>
                            </table>
                        </div>
                    `;

                    $('#modalVerDetalleBody').html(html);
                    $('#modalVerDetalle').modal('show');
                } else {
                    showError(response.message);
                }
            },
            error: function(xhr) {
                showError('Error al cargar el detalle de la orden');
            }
        });
    }

    function edit(id) {
        $.ajax({
            url: '?handler=Details&id=' + id,
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success) {
                    const orden = response.data;
                    $('#Orden_Id').val(orden.id);
                    $('#Orden_ProveedorId').val(orden.proveedorId);
                    $('#Orden_SucursalId').val(orden.sucursalId);
                    $('#Orden_BodegaDestinoId').val(orden.bodegaDestinoId);
                    $('#Orden_Fecha').val(orden.fecha.split('T')[0]);
                    $('#Orden_FechaEntregaEsperada').val(orden.fechaEntregaEsperada ? orden.fechaEntregaEsperada.split('T')[0] : '');
                    $('#Orden_Moneda').val(orden.moneda || 'CRC');
                    $('#Orden_CondicionPago').val(orden.condicionPago || 'CON');
                    $('#Orden_DiasCredito').val(orden.diasCredito || 0);
                    $('#Orden_TipoCambio').val(orden.tipoCambio || 1.00);
                    $('#Orden_Observaciones').val(orden.observaciones || '');
                    $('#Orden_Estado').val(orden.estado);

                    // Cargar detalles
                    detalles = [];
                    if (orden.detalles && orden.detalles.length > 0) {
                        orden.detalles.forEach(detalle => {
                            detalles.push({
                                id: detalle.id,
                                productoId: detalle.productoId,
                                productoNombre: detalle.producto ? detalle.producto.nombre : 'Producto',
                                cantidad: detalle.cantidad,
                                precioUnitario: detalle.precioUnitario,
                                porcentajeIVA: detalle.porcentajeIVA,
                                impuesto: detalle.impuesto,
                                subtotal: detalle.subtotal,
                                totalLinea: detalle.totalLinea,
                                descuento: detalle.descuento,
                                porcentajeDescuento: detalle.porcentajeDescuento,
                                cantidadRecibida: detalle.cantidadRecibida,
                                numeroLinea: detalle.numeroLinea
                            });
                        });
                    }

                    renderDetalles();
                    $('#modalTitle').text('Editar Orden de Compra');
                    $('#formOrden').removeClass('was-validated');
                    $('#modalOrden').modal('show');
                } else {
                    showError(response.message);
                }
            },
            error: function(xhr) {
                showError('Error al cargar la orden de compra');
            }
        });
    }

    function save() {
        const ordenData = {
            id: $('#Orden_Id').val() === '00000000-0000-0000-0000-000000000000' ? '00000000-0000-0000-0000-000000000000' : $('#Orden_Id').val(),
            empresaId: empresaId,
            proveedorId: $('#Orden_ProveedorId').val(),
            sucursalId: $('#Orden_SucursalId').val(),
            bodegaDestinoId: $('#Orden_BodegaDestinoId').val(),
            fecha: $('#Orden_Fecha').val() + 'T00:00:00',
            fechaEntregaEsperada: $('#Orden_FechaEntregaEsperada').val() ? $('#Orden_FechaEntregaEsperada').val() + 'T00:00:00' : null,
            moneda: $('#Orden_Moneda').val() || 'CRC',
            condicionPago: $('#Orden_CondicionPago').val(),
            diasCredito: parseInt($('#Orden_DiasCredito').val()) || 0,
            tipoCambio: parseFloat($('#Orden_TipoCambio').val()) || 1.00,
            observaciones: $('#Orden_Observaciones').val() || null,
            estado: $('#Orden_Estado').val() || 'BOR',
            detalles: detalles
        };

        // Calcular totales
        let subtotal = 0;
        let impuesto = 0;
        let total = 0;

        detalles.forEach(detalle => {
            subtotal += detalle.subtotal;
            impuesto += detalle.impuesto;
            total += detalle.totalLinea;
        });

        ordenData.subtotal = subtotal;
        ordenData.impuesto = impuesto;
        ordenData.total = total;
        ordenData.descuento = 0;

        $.ajax({
            url: '?handler=Save',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(ordenData),
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success) {
                    showSuccess(response.message);
                    $('#modalOrden').modal('hide');
                    table.ajax.reload();
                } else {
                    showError(response.message);
                }
            },
            error: function(xhr) {
                showError('Error al guardar la orden de compra');
            }
        });
    }

