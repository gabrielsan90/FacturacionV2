        table.ajax.reload();
    }

    function getBadgeEstado(estado) {
        const badges = {
            'BOR': '<span class="badge bg-secondary">Borrador</span>',
            'PEN': '<span class="badge bg-warning text-dark">Pendiente</span>',
            'APR': '<span class="badge bg-success">Aprobada</span>',
            'PAR': '<span class="badge bg-info">Parcial</span>',
            'COM': '<span class="badge bg-primary">Completada</span>',
            'ANU': '<span class="badge bg-danger">Anulada</span>'
        };
        return badges[estado] || `<span class="badge bg-secondary">${estado}</span>`;
    }
</script>
