@page
@model Facturacion.Frontend.Pages.Seguridad.RolesModel
@{
    ViewData["Title"] = "Roles del Sistema";
    ViewData["Breadcrumb"] = "Seguridad > Roles";
}

@Html.AntiForgeryToken()

<!-- Page Header -->
<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h2><i class="fas fa-user-tag"></i> Roles del Sistema</h2>
            <p class="mb-0">Gestión de roles y asignación de privilegios</p>
        </div>
        <button class="btn btn-primary" onclick="openCreateModal()">
            <i class="fas fa-plus me-2"></i>Nuevo Rol
        </button>
    </div>
</div>

<div class="card shadow-custom">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <strong>Listado de Roles</strong>
                <span class="badge bg-secondary ms-2" id="badgeTotal">0</span>
            </div>
        </div>
    </div>
    <div class="card-body">
        <!-- Loading State -->
        <div id="tableLoader" class="text-center py-5">
            <div class="spinner-modern mx-auto"></div>
            <p class="text-muted mt-3">Cargando roles...</p>
        </div>

        <!-- Table Container -->
        <div id="tableContainer" style="display: none;">
            <table id="tableRoles" class="table table-hover">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Tipo</th>
                        <th>Estado</th>
                        <th>Fecha Creación</th>
                        <th style="width: 180px;">Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <!-- Empty State -->
        <div id="emptyState" class="empty-state" style="display: none;">
            <div class="empty-state-icon">
                <i class="fas fa-user-tag"></i>
            </div>
            <h3 class="empty-state-title">No hay roles registrados</h3>
            <p class="empty-state-description">Crea roles para organizar los permisos del sistema</p>
            <button class="btn btn-primary" onclick="openCreateModal()">
                <i class="fas fa-plus me-2"></i>Crear Primer Rol
            </button>
        </div>
    </div>
</div>

<!-- Modal Create/Edit Rol -->
<div class="modal fade" id="modalRol" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">
                    <i class="fas fa-user-tag me-2 text-primary"></i>Nuevo Rol
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="formRol">
                <div class="modal-body">
                    <input type="hidden" id="Rol_Id" value="" />

                    <div class="mb-3">
                        <label class="form-label">Nombre <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="Rol_Nombre" maxlength="100" required />
                        <div class="invalid-feedback">El nombre es obligatorio.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Descripción</label>
                        <textarea class="form-control" id="Rol_Descripcion" rows="3" maxlength="500"></textarea>
                        <small class="text-muted">Descripción opcional del rol.</small>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="Rol_Activo" checked />
                        <label class="form-check-label" for="Rol_Activo">
                            Rol Activo
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-1"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Asignar Privilegios -->
<div class="modal fade" id="modalPrivilegios" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-shield-alt me-2 text-primary"></i>Asignar Privilegios
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="Privilegios_RolId" />
                <p class="mb-3">Selecciona los privilegios para el rol: <strong id="Privilegios_RolName"></strong></p>

                <div class="accordion" id="privilegiosAccordion">
                    <!-- Privilegios grouped by module will be loaded dynamically -->
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i> Cancelar
                </button>
                <button type="button" class="btn btn-primary" onclick="savePrivilegios()">
                    <i class="fas fa-save me-1"></i> Guardar Privilegios
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let table;
    let allPrivilegios = [];

    $(document).ready(function() {
        loadDataTable();
        loadPrivilegios();
        setupFormSubmit();
    });

    function loadDataTable() {
        table = initDataTable('#tableRoles', {
            ajax: {
                url: '?handler=Data',
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                dataSrc: function(json) {
                    $('#tableLoader').hide();
                    const data = json.data || json || [];
                    $('#badgeTotal').text(data.length);

                    if (data.length > 0) {
                        $('#tableContainer').show();
                        $('#emptyState').hide();
                    } else {
                        $('#tableContainer').hide();
                        $('#emptyState').show();
                    }
                    return data;
                },
                error: function(xhr, error, code) {
                    $('#tableLoader').hide();
                    $('#tableContainer').hide();
                    $('#emptyState').show();
                    $('#badgeTotal').text('0');
                    console.error('Error loading roles:', error);
                    handleAjaxError(xhr);
                }
            },
            columns: [
                { data: 'nombre' },
                {
                    data: 'descripcion',
                    render: function(data) {
                        return data || '<span class="text-muted">-</span>';
                    }
                },
                {
                    data: 'esSistema',
                    render: function(data) {
                        return data
                            ? '<span class="badge bg-warning">Sistema</span>'
                            : '<span class="badge bg-info">Personalizado</span>';
                    }
                },
                {
                    data: 'activo',
                    render: function(data) {
                        return data
                            ? '<span class="badge bg-success">Activo</span>'
                            : '<span class="badge bg-secondary">Inactivo</span>';
                    }
                },
                {
                    data: 'fechaCreacion',
                    render: function(data) {
                        return data ? new Date(data).toLocaleDateString('es-CR') : '-';
                    }
                },
                {
                    data: 'id',
                    orderable: false,
                    render: function(data, type, row) {
                        let actions = `
                            <button class="btn btn-sm btn-info" onclick="edit('${data}')" title="Editar">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-sm btn-primary" onclick="asignarPrivilegios('${data}', '${row.nombre}')" title="Privilegios">
                                <i class="fas fa-shield-alt"></i>
                            </button>`;

                        if (!row.esSistema) {
                            actions += `
                            <button class="btn btn-sm btn-danger" onclick="deleteRecord('${data}', '${row.nombre}')" title="Eliminar">
                                <i class="fas fa-trash"></i>
                            </button>`;
                        }

                        return actions;
                    }
                }
            ],
            order: [[0, 'asc']]
        });
    }

    async function loadPrivilegios() {
        try {
            const response = await $.ajax({
                url: '?handler=Privilegios',
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                }
            });
            allPrivilegios = response || [];
        } catch (error) {
            console.error('Error loading privilegios:', error);
        }
    }

    function setupFormSubmit() {
        $('#formRol').on('submit', function(e) {
            e.preventDefault();
            if (this.checkValidity()) {
                save();
            } else {
                $(this).addClass('was-validated');
            }
        });
    }

    function openCreateModal() {
        $('#formRol')[0].reset();
        $('#formRol').removeClass('was-validated');
        $('#Rol_Id').val('');
        $('#Rol_Activo').prop('checked', true);
        $('#modalTitle').html('<i class="fas fa-user-tag me-2 text-primary"></i>Nuevo Rol');
        $('#modalRol').modal('show');
    }

    function edit(id) {
        $.ajax({
            url: '?handler=Details&id=' + id,
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success && response.data) {
                    const data = response.data;
                    $('#Rol_Id').val(data.id);
                    $('#Rol_Nombre').val(data.nombre);
                    $('#Rol_Descripcion').val(data.descripcion || '');
                    $('#Rol_Activo').prop('checked', data.activo || false);
                    $('#modalTitle').html('<i class="fas fa-user-tag me-2 text-primary"></i>Editar Rol');
                    $('#formRol').removeClass('was-validated');
                    $('#modalRol').modal('show');
                } else {
                    showError('Error al cargar el rol');
                }
            },
            error: function(xhr) {
                handleAjaxError(xhr);
            }
        });
    }

    function save() {
        const data = {
            id: $('#Rol_Id').val() || null,
            nombre: $('#Rol_Nombre').val(),
            descripcion: $('#Rol_Descripcion').val() || null,
            activo: $('#Rol_Activo').is(':checked')
        };

        $.ajax({
            url: '?handler=Save',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(data),
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success) {
                    showSuccess(response.message);
                    $('#modalRol').modal('hide');
                    table.ajax.reload();
                } else {
                    showError(response.message || 'Error al guardar el rol');
                }
            },
            error: function(xhr) {
                handleAjaxError(xhr);
            }
        });
    }

    function asignarPrivilegios(rolId, rolName) {
        $('#Privilegios_RolId').val(rolId);
        $('#Privilegios_RolName').text(rolName);

        // Load role's assigned privilege IDs
        $.ajax({
            url: '?handler=RolPrivilegios&id=' + rolId,
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(assignedIds) {
                const rolePrivilegioIds = assignedIds || [];

                // allPrivilegios is module-grouped: [{moduloId, nombreModulo, privilegios: [...]}]
                $('#privilegiosAccordion').empty();
                allPrivilegios.forEach((modulo, moduleIndex) => {
                    const moduleName = modulo.nombreModulo || 'Sin Módulo';
                    const privileges = modulo.privilegios || [];
                    const accordionId = 'module_' + moduleIndex;

                    let privilegiosHtml = '';
                    privileges.forEach(priv => {
                        const checked = rolePrivilegioIds.includes(priv.id) ? 'checked' : '';
                        privilegiosHtml += `
                            <div class="form-check mb-2">
                                <input class="form-check-input privilegio-checkbox" type="checkbox" value="${priv.id}" ${checked} id="priv_${priv.id}">
                                <label class="form-check-label" for="priv_${priv.id}">
                                    <strong>${priv.nombre}</strong> - ${priv.accion}
                                    ${priv.descripcion ? '<small class="text-muted d-block">' + priv.descripcion + '</small>' : ''}
                                </label>
                            </div>
                        `;
                    });

                    $('#privilegiosAccordion').append(`
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="heading${accordionId}">
                                <button class="accordion-button ${moduleIndex > 0 ? 'collapsed' : ''}" type="button" data-bs-toggle="collapse" data-bs-target="#collapse${accordionId}">
                                    ${modulo.icono ? '<i class="' + modulo.icono + ' me-2"></i>' : '<i class="fas fa-folder me-2"></i>'}
                                    ${moduleName}
                                    <span class="badge bg-secondary ms-2">${privileges.length}</span>
                                </button>
                            </h2>
                            <div id="collapse${accordionId}" class="accordion-collapse collapse ${moduleIndex === 0 ? 'show' : ''}" data-bs-parent="#privilegiosAccordion">
                                <div class="accordion-body">
                                    ${privilegiosHtml}
                                </div>
                            </div>
                        </div>
                    `);
                });

                $('#modalPrivilegios').modal('show');
            },
            error: function(xhr) {
                handleAjaxError(xhr);
            }
        });
    }

    function savePrivilegios() {
        const rolId = $('#Privilegios_RolId').val();
        const selectedPrivilegios = [];
        $('.privilegio-checkbox:checked').each(function() {
            selectedPrivilegios.push(parseInt($(this).val()));
        });

        $.ajax({
            url: '?handler=AsignarPrivilegios&roleId=' + rolId,
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(selectedPrivilegios),
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success) {
                    showSuccess(response.message);
                    $('#modalPrivilegios').modal('hide');
                    table.ajax.reload();
                } else {
                    showError(response.message || 'Error al asignar privilegios');
                }
            },
            error: function(xhr) {
                handleAjaxError(xhr);
            }
        });
    }

    function deleteRecord(id, nombre) {
        confirmDelete(`¿Está seguro de eliminar el rol "${nombre}"?`, function() {
            $.ajax({
                url: '?handler=Delete&id=' + id,
                type: 'POST',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        showSuccess(response.message);
                        table.ajax.reload();
                    } else {
                        showError(response.message || 'Error al eliminar el rol');
                    }
                },
                error: function(xhr) {
                    handleAjaxError(xhr);
                }
            });
        });
    }
</script>
}
