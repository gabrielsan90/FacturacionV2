@page
@model Facturacion.Frontend.Pages.Seguridad.UsuariosModel
@{
    ViewData["Title"] = "Usuarios del Sistema";
    ViewData["Breadcrumb"] = "Usuarios";
}

@Html.AntiForgeryToken()

<!-- Page Header -->
<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h2><i class="fas fa-users"></i> Usuarios del Sistema</h2>
            <p class="mb-0">Gestión de usuarios, roles y permisos de acceso</p>
        </div>
        <button class="btn btn-primary" onclick="openCreateModal()">
            <i class="fas fa-plus me-2"></i>Nuevo Usuario
        </button>
    </div>
</div>

<div class="card shadow-custom">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <strong>Listado de Usuarios</strong>
                <span class="badge bg-secondary ms-2" id="badgeTotal">0</span>
            </div>
        </div>
    </div>
    <div class="card-body">
        <!-- Loading State -->
        <div id="tableLoader" class="text-center py-5">
            <div class="spinner-modern mx-auto"></div>
            <p class="text-muted mt-3">Cargando usuarios...</p>
        </div>

        <!-- Table Container -->
        <div id="tableContainer" style="display: none;">
            <table id="tableUsuarios" class="table table-hover">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Email</th>
                        <th>Documento</th>
                        <th>Roles</th>
                        <th>Estado</th>
                        <th>Última Conexión</th>
                        <th style="width: 220px;">Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <!-- Empty State -->
        <div id="emptyState" class="empty-state" style="display: none;">
            <div class="empty-state-icon">
                <i class="fas fa-users"></i>
            </div>
            <h3 class="empty-state-title">No hay usuarios registrados</h3>
            <p class="empty-state-description">Crea el primer usuario del sistema</p>
            <button class="btn btn-primary" onclick="openCreateModal()">
                <i class="fas fa-plus me-2"></i>Crear Primer Usuario
            </button>
        </div>
    </div>
</div>

<!-- Modal Create/Edit Usuario -->
<div class="modal fade" id="modalUsuario" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">
                    <i class="fas fa-user me-2 text-primary"></i>Nuevo Usuario
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="formUsuario">
                <div class="modal-body">
                    <input type="hidden" id="Usuario_Id" value="" />

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Nombre Completo <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="Usuario_FullName" maxlength="100" required />
                            <div class="invalid-feedback">El nombre es obligatorio.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Documento <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="Usuario_Document" maxlength="20" required />
                            <div class="invalid-feedback">El documento es obligatorio.</div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Email <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" id="Usuario_Email" maxlength="256" required />
                            <div class="invalid-feedback">El email es obligatorio y debe ser válido.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Teléfono</label>
                            <input type="tel" class="form-control" id="Usuario_PhoneNumber" maxlength="20" />
                        </div>
                    </div>

                    <div class="form-check mb-3" id="generatePasswordSection" style="display: none;">
                        <input class="form-check-input" type="checkbox" id="Usuario_GeneratePassword">
                        <label class="form-check-label" for="Usuario_GeneratePassword">
                            <i class="fas fa-random me-1"></i> Generar contraseña aleatoria y enviar por correo
                        </label>
                        <small class="text-muted d-block">Se generará una contraseña segura y se enviará al correo del usuario</small>
                    </div>

                    <div class="row mb-3" id="passwordSection">
                        <div class="col-md-6">
                            <label class="form-label">Contraseña <span class="text-danger">*</span></label>
                            <input type="password" class="form-control" id="Usuario_Password" minlength="6" />
                            <small class="text-muted">Mínimo 6 caracteres</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Confirmar Contraseña <span class="text-danger">*</span></label>
                            <input type="password" class="form-control" id="Usuario_ConfirmPassword" minlength="6" />
                        </div>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="Usuario_Activo" checked />
                        <label class="form-check-label" for="Usuario_Activo">
                            Usuario Activo
                        </label>
                    </div>

                    <!-- Roles y Empresas Multiselect -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Roles</label>
                            <select id="Usuario_Roles" class="form-select" multiple size="4">
                            </select>
                            <small class="text-muted">Ctrl+Click para seleccionar varios</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Empresas</label>
                            <select id="Usuario_Empresas" class="form-select" multiple size="4">
                            </select>
                            <small class="text-muted">Ctrl+Click para seleccionar varios</small>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-1"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Asignar Roles -->
<div class="modal fade" id="modalRoles" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-user-tag me-2 text-primary"></i>Asignar Roles
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="Roles_UserId" />
                <p class="mb-3">Selecciona los roles para el usuario: <strong id="Roles_UserName"></strong></p>

                <div id="rolesCheckboxContainer" class="list-group">
                    <!-- Roles will be loaded dynamically -->
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i> Cancelar
                </button>
                <button type="button" class="btn btn-primary" onclick="saveRoles()">
                    <i class="fas fa-save me-1"></i> Guardar Roles
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Asignar Empresas -->
<div class="modal fade" id="modalEmpresas" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-building me-2 text-primary"></i>Asignar Empresas
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="Empresas_UserId" />
                <p class="mb-3">Selecciona las empresas para el usuario: <strong id="Empresas_UserName"></strong></p>

                <div id="empresasCheckboxContainer" class="list-group">
                    <!-- Empresas will be loaded dynamically -->
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i> Cancelar
                </button>
                <button type="button" class="btn btn-primary" onclick="saveEmpresas()">
                    <i class="fas fa-save me-1"></i> Guardar Empresas
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let table;
    let allRoles = [];
    let allEmpresas = [];

    $(document).ready(function() {
        loadDataTable();
        loadRoles();
        loadEmpresas();
        setupFormSubmit();
    });

    function loadDataTable() {
        table = initDataTable('#tableUsuarios', {
            ajax: {
                url: '?handler=Data',
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                dataSrc: function(json) {
                    $('#tableLoader').hide();
                    const data = json.data || json || [];
                    $('#badgeTotal').text(data.length);

                    if (data.length > 0) {
                        $('#tableContainer').show();
                        $('#emptyState').hide();
                    } else {
                        $('#tableContainer').hide();
                        $('#emptyState').show();
                    }
                    return data;
                },
                error: function(xhr, error, code) {
                    $('#tableLoader').hide();
                    $('#tableContainer').hide();
                    $('#emptyState').show();
                    $('#badgeTotal').text('0');
                    console.error('Error loading usuarios:', error);
                    handleAjaxError(xhr);
                }
            },
            columns: [
                { data: 'fullName' },
                { data: 'email' },
                { data: 'document' },
                {
                    data: 'roles',
                    render: function(data) {
                        if (!data || data.length === 0) {
                            return '<span class="text-muted">Sin roles</span>';
                        }
                        return data.map(r => `<span class="badge bg-info me-1">${r}</span>`).join('');
                    }
                },
                {
                    data: null,
                    render: function(data, type, row) {
                        if (row.isLockedOut) {
                            return '<span class="badge bg-danger"><i class="fas fa-lock me-1"></i>Bloqueado</span>';
                        }
                        return row.activo !== false
                            ? '<span class="badge bg-success">Activo</span>'
                            : '<span class="badge bg-secondary">Inactivo</span>';
                    }
                },
                {
                    data: 'ultimaConexion',
                    render: function(data) {
                        return data ? new Date(data).toLocaleString('es-CR') : '<span class="text-muted">Nunca</span>';
                    }
                },
                {
                    data: 'id',
                    orderable: false,
                    render: function(data, type, row) {
                        let unlockBtn = '';
                        if (row.isLockedOut) {
                            unlockBtn = `<button class="btn btn-sm btn-outline-danger" onclick="unlockUser('${data}')" title="Desbloquear usuario">
                                <i class="fas fa-unlock"></i>
                            </button>`;
                        }
                        return `
                            <button class="btn btn-sm btn-info" onclick="edit('${data}')" title="Editar">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-sm btn-primary" onclick="asignarRoles('${data}', '${row.fullName}')" title="Roles">
                                <i class="fas fa-user-tag"></i>
                            </button>
                            <button class="btn btn-sm btn-success" onclick="asignarEmpresas('${data}', '${row.fullName}')" title="Empresas">
                                <i class="fas fa-building"></i>
                            </button>
                            <button class="btn btn-sm btn-warning" onclick="resetPassword('${data}')" title="Restablecer Contraseña">
                                <i class="fas fa-key"></i>
                            </button>
                            ${unlockBtn}
                            <button class="btn btn-sm btn-danger" onclick="deleteRecord('${data}', '${row.fullName}')" title="Eliminar">
                                <i class="fas fa-trash"></i>
                            </button>
                        `;
                    }
                }
            ],
            order: [[0, 'asc']]
        });
    }

    async function loadRoles() {
        try {
            const response = await $.ajax({
                url: '?handler=Roles',
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                }
            });
            allRoles = response || [];
            // Populate roles multiselect (value = role ID for precise assignment)
            const $select = $('#Usuario_Roles');
            $select.empty();
            allRoles.forEach(rol => {
                const suffix = rol.esSistema ? ' (Sistema)' : '';
                $select.append(`<option value="${rol.id}">${rol.nombre}${suffix}</option>`);
            });
        } catch (error) {
            console.error('Error loading roles:', error);
        }
    }

    async function loadEmpresas() {
        try {
            const response = await $.ajax({
                url: '?handler=Empresas',
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                }
            });
            allEmpresas = response || [];
            // Populate empresas multiselect
            const $select = $('#Usuario_Empresas');
            $select.empty();
            allEmpresas.forEach(empresa => {
                $select.append(`<option value="${empresa.id}">${empresa.nombreComercial || empresa.nombre || ''}</option>`);
            });
        } catch (error) {
            console.error('Error loading empresas:', error);
        }
    }

    function setupFormSubmit() {
        // Toggle password fields when generate password checkbox changes
        $('#Usuario_GeneratePassword').on('change', function() {
            if ($(this).is(':checked')) {
                $('#passwordSection').hide();
                $('#Usuario_Password').prop('required', false).val('');
                $('#Usuario_ConfirmPassword').prop('required', false).val('');
            } else {
                $('#passwordSection').show();
                $('#Usuario_Password').prop('required', true);
                $('#Usuario_ConfirmPassword').prop('required', true);
            }
        });

        $('#formUsuario').on('submit', function(e) {
            e.preventDefault();

            const password = $('#Usuario_Password').val();
            const confirmPassword = $('#Usuario_ConfirmPassword').val();
            const isNew = !$('#Usuario_Id').val();
            const generatePassword = $('#Usuario_GeneratePassword').is(':checked');

            if (isNew && !generatePassword && (!password || password.length < 6)) {
                showError('La contraseña debe tener al menos 6 caracteres');
                return;
            }

            if (!generatePassword && password && password !== confirmPassword) {
                showError('Las contraseñas no coinciden');
                return;
            }

            if (this.checkValidity()) {
                save();
            } else {
                $(this).addClass('was-validated');
            }
        });
    }

    function openCreateModal() {
        $('#formUsuario')[0].reset();
        $('#formUsuario').removeClass('was-validated');
        $('#Usuario_Id').val('');
        $('#Usuario_Activo').prop('checked', true);
        $('#generatePasswordSection').show();
        $('#Usuario_GeneratePassword').prop('checked', false);
        $('#passwordSection').show();
        $('#Usuario_Password').prop('required', true);
        $('#Usuario_ConfirmPassword').prop('required', true);
        $('#Usuario_Roles').val([]);
        $('#Usuario_Empresas').val([]);
        $('#modalTitle').html('<i class="fas fa-user me-2 text-primary"></i>Nuevo Usuario');
        $('#modalUsuario').modal('show');
    }

    function edit(id) {
        $.ajax({
            url: '?handler=Details&id=' + id,
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success && response.data) {
                    const data = response.data;
                    $('#Usuario_Id').val(data.id);
                    $('#Usuario_FullName').val(data.fullName);
                    $('#Usuario_Document').val(data.document);
                    $('#Usuario_Email').val(data.email);
                    $('#Usuario_PhoneNumber').val(data.phoneNumber || '');
                    $('#Usuario_Activo').prop('checked', data.emailConfirmed || false);
                    $('#generatePasswordSection').hide();
                    $('#Usuario_GeneratePassword').prop('checked', false);
                    $('#passwordSection').hide();
                    $('#Usuario_Password').prop('required', false).val('');
                    $('#Usuario_ConfirmPassword').prop('required', false).val('');

                    // Preselect roles by ID
                    const userRoleIds = data.roleIds || [];
                    $('#Usuario_Roles').val(userRoleIds);

                    // Preselect empresas
                    const userEmpresaIds = (data.empresaIds || []).map(e => e.toString());
                    $('#Usuario_Empresas').val(userEmpresaIds);

                    $('#modalTitle').html('<i class="fas fa-user me-2 text-primary"></i>Editar Usuario');
                    $('#formUsuario').removeClass('was-validated');
                    $('#modalUsuario').modal('show');
                } else {
                    showError('Error al cargar el usuario');
                }
            },
            error: function(xhr) {
                handleAjaxError(xhr);
            }
        });
    }

    function save() {
        const isNew = !$('#Usuario_Id').val();
        const generatePassword = isNew && $('#Usuario_GeneratePassword').is(':checked');

        const data = {
            id: $('#Usuario_Id').val() || null,
            fullName: $('#Usuario_FullName').val(),
            document: $('#Usuario_Document').val(),
            email: $('#Usuario_Email').val(),
            phoneNumber: $('#Usuario_PhoneNumber').val() || null,
            password: generatePassword ? null : ($('#Usuario_Password').val() || null),
            confirmPassword: generatePassword ? null : ($('#Usuario_ConfirmPassword').val() || null),
            emailConfirmed: $('#Usuario_Activo').is(':checked'),
            generateRandomPassword: generatePassword,
            roles: Array.from($('#Usuario_Roles').val() || []),
            empresaIds: Array.from($('#Usuario_Empresas').val() || [])
        };

        $.ajax({
            url: '?handler=Save',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(data),
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success) {
                    $('#modalUsuario').modal('hide');

                    // Si se generó contraseña y no se pudo enviar el email, mostrarla
                    if (response.passwordGenerated && response.generatedPassword) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Contraseña Generada',
                            html: `<p>${response.message}</p>
                                   <p>Copie la contraseña y compártala manualmente:</p>
                                   <div class="input-group mb-2">
                                       <input type="text" class="form-control" value="${response.generatedPassword}" id="generatedPwdField" readonly>
                                       <button class="btn btn-outline-secondary" type="button" onclick="navigator.clipboard.writeText('${response.generatedPassword}'); Swal.showValidationMessage('Copiado!');">
                                           <i class="fas fa-copy"></i>
                                       </button>
                                   </div>`,
                            confirmButtonText: 'Entendido'
                        });
                    } else {
                        showSuccess(response.message);
                    }

                    table.ajax.reload();
                } else {
                    showError(response.message || 'Error al guardar el usuario');
                }
            },
            error: function(xhr) {
                handleAjaxError(xhr);
            }
        });
    }

    function asignarRoles(userId, userName) {
        $('#Roles_UserId').val(userId);
        $('#Roles_UserName').text(userName);

        // Load user's current roles
        $.ajax({
            url: '?handler=Details&id=' + userId,
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success && response.data) {
                    const userRoleIds = response.data.roleIds || [];

                    $('#rolesCheckboxContainer').empty();
                    allRoles.forEach(rol => {
                        const checked = userRoleIds.includes(rol.id) ? 'checked' : '';
                        const badge = rol.esSistema
                            ? '<span class="badge bg-warning ms-1">Sistema</span>'
                            : '<span class="badge bg-info ms-1">Personalizado</span>';
                        $('#rolesCheckboxContainer').append(`
                            <div class="list-group-item">
                                <div class="form-check">
                                    <input class="form-check-input role-checkbox" type="checkbox" value="${rol.id}" ${checked} id="role_${rol.id}">
                                    <label class="form-check-label" for="role_${rol.id}">
                                        ${rol.nombre} ${badge}
                                        ${rol.descripcion ? '<small class="text-muted d-block">' + rol.descripcion + '</small>' : ''}
                                    </label>
                                </div>
                            </div>
                        `);
                    });

                    $('#modalRoles').modal('show');
                }
            },
            error: function(xhr) {
                handleAjaxError(xhr);
            }
        });
    }

    function saveRoles() {
        const userId = $('#Roles_UserId').val();
        const selectedRoles = [];
        $('.role-checkbox:checked').each(function() {
            selectedRoles.push($(this).val());
        });

        $.ajax({
            url: '?handler=AsignarRoles&userId=' + userId,
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(selectedRoles),
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success) {
                    showSuccess(response.message);
                    $('#modalRoles').modal('hide');
                    table.ajax.reload();
                } else {
                    showError(response.message || 'Error al asignar roles');
                }
            },
            error: function(xhr) {
                handleAjaxError(xhr);
            }
        });
    }

    function asignarEmpresas(userId, userName) {
        $('#Empresas_UserId').val(userId);
        $('#Empresas_UserName').text(userName);

        // Load user's current empresas
        $.ajax({
            url: '?handler=Details&id=' + userId,
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success && response.data) {
                    const userEmpresas = response.data.empresas || [];

                    $('#empresasCheckboxContainer').empty();
                    allEmpresas.forEach(empresa => {
                        const checked = userEmpresas.some(e => e.id === empresa.id) ? 'checked' : '';
                        $('#empresasCheckboxContainer').append(`
                            <div class="list-group-item">
                                <div class="form-check">
                                    <input class="form-check-input empresa-checkbox" type="checkbox" value="${empresa.id}" ${checked} id="empresa_${empresa.id}">
                                    <label class="form-check-label" for="empresa_${empresa.id}">
                                        ${empresa.nombreComercial || empresa.nombre || ''}
                                        <small class="text-muted d-block">${empresa.numeroIdentificacion || ''}</small>
                                    </label>
                                </div>
                            </div>
                        `);
                    });

                    $('#modalEmpresas').modal('show');
                }
            },
            error: function(xhr) {
                handleAjaxError(xhr);
            }
        });
    }

    function saveEmpresas() {
        const userId = $('#Empresas_UserId').val();
        const selectedEmpresas = [];
        $('.empresa-checkbox:checked').each(function() {
            selectedEmpresas.push($(this).val());
        });

        $.ajax({
            url: '?handler=AsignarEmpresas&userId=' + userId,
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(selectedEmpresas),
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success) {
                    showSuccess(response.message);
                    $('#modalEmpresas').modal('hide');
                    table.ajax.reload();
                } else {
                    showError(response.message || 'Error al asignar empresas');
                }
            },
            error: function(xhr) {
                handleAjaxError(xhr);
            }
        });
    }

    function resetPassword(userId) {
        Swal.fire({
            title: '¿Restablecer contraseña?',
            text: 'Se generará una nueva contraseña y se enviará por correo.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#0ea5e9',
            cancelButtonColor: '#64748b',
            confirmButtonText: 'Sí, restablecer',
            cancelButtonText: 'Cancelar'
        }).then((result) => {
            if (!result.isConfirmed) return;
            $.ajax({
                url: '?handler=ResetPassword&userId=' + userId,
                type: 'POST',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        if (response.generatedPassword) {
                            Swal.fire({
                                icon: 'warning',
                                title: 'Contraseña restablecida',
                                html: `<p>No se pudo enviar el correo. Comparta la contraseña manualmente:</p>
                                       <div class="input-group mt-3">
                                       <input type="text" class="form-control" value="${response.generatedPassword}" id="resetPwdField" readonly>
                                       <button class="btn btn-outline-secondary" type="button" onclick="navigator.clipboard.writeText('${response.generatedPassword}'); Swal.showValidationMessage('Copiado!');">
                                       <i class="fas fa-copy"></i>
                                       </button>
                                       </div>`,
                                confirmButtonText: 'Cerrar'
                            });
                        } else {
                            showSuccess(response.message);
                        }
                    } else {
                        showError(response.message || 'Error al restablecer contraseña');
                    }
                },
                error: function(xhr) {
                    handleAjaxError(xhr);
                }
            });
        });
    }

    function deleteRecord(id, nombre) {
        confirmDelete(`¿Está seguro de eliminar el usuario "${nombre}"?`, function() {
            $.ajax({
                url: '?handler=Delete&id=' + id,
                type: 'POST',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        showSuccess(response.message);
                        table.ajax.reload();
                    } else {
                        showError(response.message || 'Error al eliminar el usuario');
                    }
                },
                error: function(xhr) {
                    handleAjaxError(xhr);
                }
            });
        });
    }

    function unlockUser(userId) {
        Swal.fire({
            title: '¿Desbloquear este usuario?',
            text: 'Se restablecerá el acceso del usuario.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#0ea5e9',
            cancelButtonColor: '#64748b',
            confirmButtonText: 'Sí, desbloquear',
            cancelButtonText: 'Cancelar'
        }).then((result) => {
            if (!result.isConfirmed) return;
            $.ajax({
                url: '?handler=Unlock&userId=' + userId,
                type: 'POST',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        showSuccess(response.message);
                        table.ajax.reload();
                    } else {
                        showError(response.message || 'Error al desbloquear el usuario');
                    }
                },
                error: function(xhr) {
                    handleAjaxError(xhr);
                }
            });
        });
    }
</script>
}
