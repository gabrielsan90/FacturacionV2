@page
@model Facturacion.Frontend.Pages.ReporteDocumentosRecibidosModel
@{
    ViewData["Title"] = "Reporte: Documentos Recibidos";
    ViewData["Breadcrumb"] = "Reporte: Documentos Recibidos";
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">
            <i class="fas fa-file-import me-2"></i>Reporte: Documentos Recibidos
        </h5>
    </div>
    <div class="card-body">
        <!-- Filters -->
        <div class="row mb-4">
            <div class="col-md-3">
                <label class="form-label">Fecha Inicio</label>
                <input type="date" class="form-control" id="fechaInicio" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Fecha Fin</label>
                <input type="date" class="form-control" id="fechaFin" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Estado Respuesta</label>
                <select class="form-select" id="estadoRespuesta">
                    <option value="">Todos</option>
                    <option value="1">Aceptado</option>
                    <option value="2">Parcialmente Aceptado</option>
                    <option value="3">Rechazado</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-primary me-2" onclick="filtrar()">
                    <i class="fas fa-filter me-1"></i> Filtrar
                </button>
                <button class="btn btn-outline-secondary" onclick="limpiarFiltros()">
                    <i class="fas fa-eraser me-1"></i> Limpiar
                </button>
            </div>
        </div>

        <!-- Summary Cards -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card bg-primary text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-0">Total Recibidos</h6>
                                <h4 class="mb-0" id="totalRecibidos">0</h4>
                            </div>
                            <i class="fas fa-inbox fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-success text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-0">Respondidos</h6>
                                <h4 class="mb-0" id="totalRespondidos">0</h4>
                            </div>
                            <i class="fas fa-reply fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-warning text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-0">Sin Responder</h6>
                                <h4 class="mb-0" id="totalSinResponder">0</h4>
                            </div>
                            <i class="fas fa-question-circle fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-info text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-0">Total Monto</h6>
                                <h4 class="mb-0" id="totalMonto">₡0.00</h4>
                            </div>
                            <i class="fas fa-dollar-sign fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Export Buttons -->
        <div class="mb-3">
            <button class="btn btn-success btn-sm" onclick="exportarExcel()">
                <i class="fas fa-file-excel me-1"></i> Exportar a Excel
            </button>
            <button class="btn btn-danger btn-sm" onclick="exportarPDF()">
                <i class="fas fa-file-pdf me-1"></i> Exportar a PDF
            </button>
        </div>

        <!-- DataTable -->
        <table id="tableReporte" class="table table-hover">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Tipo</th>
                    <th>Número</th>
                    <th>Emisor</th>
                    <th>Monto</th>
                    <th>Estado Respuesta</th>
                    <th>Fecha Respuesta</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    let table;

    $(document).ready(function() {
        // Set default dates (last 30 days)
        const hoy = new Date();
        const hace30Dias = new Date();
        hace30Dias.setDate(hace30Dias.getDate() - 30);

        $('#fechaFin').val(hoy.toISOString().split('T')[0]);
        $('#fechaInicio').val(hace30Dias.toISOString().split('T')[0]);

        loadDataTable();
        cargarResumen();
    });

    function loadDataTable() {
        const fechaInicio = $('#fechaInicio').val();
        const fechaFin = $('#fechaFin').val();
        const estadoRespuesta = $('#estadoRespuesta').val();

        table = initDataTable('#tableReporte', {
            ajax: {
                url: `?handler=Data&fechaInicio=${fechaInicio}&fechaFin=${fechaFin}&estadoRespuesta=${estadoRespuesta}`,
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                dataSrc: 'data'
            },
            columns: [
                {
                    data: 'fecha',
                    render: function(data) {
                        return moment(data).format('DD/MM/YYYY HH:mm');
                    }
                },
                { data: 'tipoDocumento' },
                { data: 'numero' },
                { data: 'emisorNombre' },
                {
                    data: 'total',
                    render: function(data) {
                        return formatCurrency(data);
                    }
                },
                {
                    data: 'estadoRespuesta',
                    render: function(data) {
                        if (data === 'Aceptado') return '<span class="badge bg-success">Aceptado</span>';
                        if (data === 'Rechazado') return '<span class="badge bg-danger">Rechazado</span>';
                        if (data === 'Parcialmente Aceptado') return '<span class="badge bg-warning">Parcialmente</span>';
                        return '<span class="badge bg-secondary">Sin Responder</span>';
                    }
                },
                {
                    data: 'fechaRespuesta',
                    render: function(data) {
                        return data ? moment(data).format('DD/MM/YYYY HH:mm') : '-';
                    }
                }
            ],
            order: [[0, 'desc']],
            buttons: ['excel', 'pdf']
        });
    }

    function filtrar() {
        if (table) {
            table.destroy();
        }
        loadDataTable();
        cargarResumen();
    }

    function limpiarFiltros() {
        $('#fechaInicio').val('');
        $('#fechaFin').val('');
        $('#estadoRespuesta').val('');
        filtrar();
    }

    function cargarResumen() {
        const fechaInicio = $('#fechaInicio').val();
        const fechaFin = $('#fechaFin').val();
        const estadoRespuesta = $('#estadoRespuesta').val();

        $.ajax({
            url: `?handler=Resumen&fechaInicio=${fechaInicio}&fechaFin=${fechaFin}&estadoRespuesta=${estadoRespuesta}`,
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(data) {
                $('#totalRecibidos').text(data.totalRecibidos);
                $('#totalRespondidos').text(data.totalRespondidos);
                $('#totalSinResponder').text(data.totalSinResponder);
                $('#totalMonto').text(formatCurrency(data.totalMonto));
            }
        });
    }

    function exportarExcel() {
        table.button('.buttons-excel').trigger();
    }

    function exportarPDF() {
        table.button('.buttons-pdf').trigger();
    }
</script>
}
