@page
@model Facturacion.Frontend.Pages.Auth.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Iniciar Sesión";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Facturación Electrónica</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        :root {
            --primary-blue: #0052cc;
            --primary-dark: #003d99;
            --primary-light: #0065ff;
            --accent-blue: #2563eb;
            --success-color: #059669;
            --danger-color: #dc2626;
            --warning-color: #f59e0b;
            --info-color: #0891b2;
            --gray-50: #f8fafc;
            --gray-100: #f1f5f9;
            --gray-200: #e2e8f0;
            --gray-300: #cbd5e1;
            --gray-600: #475569;
            --gray-700: #334155;
            --gray-900: #0f172a;
        }

        body {
            background: linear-gradient(135deg, #0052cc 0%, #2563eb 50%, #0891b2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            position: relative;
            overflow: hidden;
        }

        /* Animated background pattern */
        body::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image:
                radial-gradient(circle at 20% 50%, rgba(255, 255, 255, 0.05) 0%, transparent 50%),
                radial-gradient(circle at 80% 80%, rgba(255, 255, 255, 0.05) 0%, transparent 50%);
            animation: backgroundShift 20s ease-in-out infinite alternate;
        }

        @@keyframes backgroundShift {
            0% { transform: translate(0, 0); }
            100% { transform: translate(50px, 50px); }
        }

        .login-container {
            width: 100%;
            max-width: 480px;
            padding: 20px;
            position: relative;
            z-index: 1;
        }

        .login-card {
            background: white;
            border-radius: 24px;
            box-shadow:
                0 20px 60px rgba(0, 0, 0, 0.3),
                0 0 0 1px rgba(255, 255, 255, 0.1);
            overflow: hidden;
            animation: slideIn 0.5s ease-out;
        }

        @@keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .login-header {
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--accent-blue) 100%);
            color: white;
            padding: 40px 30px 35px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .login-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background:
                radial-gradient(circle at 30% 20%, rgba(255, 255, 255, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 70% 80%, rgba(255, 255, 255, 0.08) 0%, transparent 50%);
        }

        .login-header h1 {
            font-size: 26px;
            font-weight: 700;
            margin: 0 0 10px 0;
            position: relative;
            z-index: 1;
            letter-spacing: -0.5px;
        }

        .login-header p {
            margin: 0;
            opacity: 0.95;
            font-size: 14px;
            font-weight: 500;
            position: relative;
            z-index: 1;
        }

        .logo-container {
            width: 90px;
            height: 90px;
            background: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 25px auto;
            box-shadow:
                0 8px 20px rgba(0, 0, 0, 0.15),
                0 0 0 4px rgba(255, 255, 255, 0.2);
            position: relative;
            z-index: 1;
            animation: logoFloat 3s ease-in-out infinite;
        }

        @@keyframes logoFloat {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-5px); }
        }

        .logo-container i {
            font-size: 44px;
            background: linear-gradient(135deg, var(--primary-blue), var(--accent-blue));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .login-body {
            padding: 45px 40px;
            background: white;
        }

        .form-label {
            font-weight: 600;
            color: var(--gray-700);
            margin-bottom: 10px;
            font-size: 14px;
            display: block;
        }

        .form-control {
            border: 2px solid var(--gray-200);
            border-radius: 12px;
            padding: 13px 16px;
            font-size: 15px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            background: var(--gray-50);
        }

        .form-control:hover {
            border-color: var(--gray-300);
            background: white;
        }

        .form-control:focus {
            border-color: var(--primary-blue);
            background: white;
            box-shadow: 0 0 0 4px rgba(0, 82, 204, 0.1);
            outline: none;
        }

        .form-select {
            border: 2px solid var(--gray-200);
            border-radius: 12px;
            padding: 13px 16px;
            font-size: 15px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            background: var(--gray-50);
        }

        .form-select:hover {
            border-color: var(--gray-300);
            background: white;
        }

        .form-select:focus {
            border-color: var(--primary-blue);
            background: white;
            box-shadow: 0 0 0 4px rgba(0, 82, 204, 0.1);
            outline: none;
        }

        .input-group-text {
            background: var(--gray-50);
            border: 2px solid var(--gray-200);
            border-right: 0;
            color: var(--primary-blue);
            border-radius: 12px 0 0 12px;
            padding: 13px 16px;
            transition: all 0.3s;
        }

        .input-group .form-control {
            border-left: 0;
            border-radius: 0 12px 12px 0;
            padding-left: 0;
        }

        .input-group:hover .input-group-text {
            border-color: var(--gray-300);
            background: white;
        }

        .input-group:focus-within .input-group-text {
            border-color: var(--primary-blue);
            background: white;
        }

        .btn-login {
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--accent-blue) 100%);
            border: none;
            border-radius: 12px;
            padding: 15px 24px;
            font-size: 16px;
            font-weight: 600;
            color: white;
            width: 100%;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            margin-top: 10px;
            box-shadow: 0 4px 12px rgba(0, 82, 204, 0.3);
            position: relative;
            overflow: hidden;
        }

        .btn-login::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s;
        }

        .btn-login:hover:not(:disabled)::before {
            left: 100%;
        }

        .btn-login:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 82, 204, 0.4);
        }

        .btn-login:active:not(:disabled) {
            transform: translateY(0);
        }

        .btn-login:disabled {
            opacity: 0.7;
            cursor: not-allowed;
            transform: none !important;
        }

        .spinner-border-sm {
            width: 1rem;
            height: 1rem;
            border-width: 0.15em;
        }

        .text-danger {
            font-size: 13px;
            margin-top: 8px;
            color: var(--danger-color);
        }

        .alert {
            border-radius: 12px;
            border: none;
            padding: 14px 18px;
            font-size: 14px;
            display: flex;
            align-items: center;
        }

        .alert-danger {
            background: #fee;
            color: var(--danger-color);
        }

        .alert-success {
            background: #d1fae5;
            color: var(--success-color);
        }

        .alert i {
            font-size: 18px;
            margin-right: 10px;
        }

        .form-check {
            margin-top: 15px;
        }

        .form-check-label {
            font-size: 14px;
            color: var(--gray-600);
        }

        .btn-link {
            color: var(--primary-blue);
            text-decoration: none;
            font-weight: 600;
            transition: all 0.2s;
        }

        .btn-link:hover {
            color: var(--primary-dark);
            transform: translateX(-2px);
        }

        .security-badge {
            text-align: center;
            margin-top: 24px;
            padding: 12px 20px;
            background: rgba(255, 255, 255, 0.15);
            border-radius: 12px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .security-badge p {
            color: white;
            font-size: 13px;
            margin: 0;
            font-weight: 500;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .security-badge i {
            font-size: 16px;
        }

        #userEmailDisplay {
            color: var(--gray-600);
            font-size: 14px;
            font-weight: 500;
        }

        .mb-3 {
            margin-bottom: 24px !important;
        }

        @@media (max-width: 576px) {
            .login-container {
                padding: 15px;
            }

            .login-body {
                padding: 35px 25px;
            }

            .login-header {
                padding: 35px 25px 30px;
            }

            .login-header h1 {
                font-size: 22px;
            }

            .logo-container {
                width: 75px;
                height: 75px;
            }

            .logo-container i {
                font-size: 36px;
            }

            .login-card {
                border-radius: 20px;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            * {
                animation: none !important;
                transition: none !important;
            }
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <div class="logo-container">
                    <i class="bi bi-receipt"></i>
                </div>
                <h1>Sistema de Facturación Electrónica</h1>
                <p>Versión 4.4 - Costa Rica</p>
            </div>
            <div class="login-body">
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        @TempData["ErrorMessage"]
                    </div>
                }

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        @TempData["SuccessMessage"]
                    </div>
                }

                <form method="post" id="loginForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Input.PreAuthToken" id="preAuthToken" />
                    <!-- Step 1: Email and Password -->
                    <div id="step1">
                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label">Correo Electrónico</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-envelope"></i>
                                </span>
                                <input asp-for="Input.Email" class="form-control" placeholder="correo@ejemplo.com" autofocus />
                            </div>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label">Contraseña</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-lock"></i>
                                </span>
                                <input asp-for="Input.Password" class="form-control" placeholder="Ingrese su contraseña" type="password" />
                            </div>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>

                        <button type="button" class="btn btn-login" id="btnValidate">
                            <span id="btnValidateText">Continuar</span>
                            <span id="btnValidateSpinner" class="d-none">
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                Validando...
                            </span>
                        </button>
                    </div>

                    <!-- Step 2: Company Selection -->
                    <div id="step2" class="d-none">
                        <div class="mb-3">
                            <div class="d-flex align-items-center mb-3">
                                <button type="button" class="btn btn-link p-0 me-2" id="btnBack">
                                    <i class="bi bi-arrow-left fs-5"></i>
                                </button>
                                <span class="text-muted small" id="userEmailDisplay"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.EmpresaId" class="form-label">Seleccione la Empresa</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-building"></i>
                                </span>
                                <select asp-for="Input.EmpresaId" class="form-select" id="empresaSelect">
                                    <option value="">Seleccione una empresa...</option>
                                </select>
                            </div>
                            <span class="text-danger" id="empresaError"></span>
                        </div>

                        <button type="submit" class="btn btn-login" id="btnLogin">
                            <span id="btnText">Iniciar Sesión</span>
                            <span id="btnSpinner" class="d-none">
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                Iniciando sesión...
                            </span>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="security-badge">
            <p>
                <i class="bi bi-shield-check"></i>
                <span>Conexión segura y encriptada</span>
            </p>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            let validatedEmail = '';
            let validatedPassword = '';
            let validatedPreAuthToken = '';
            let empresas = [];

            // Auto-focus on email field
            $('#Input_Email').focus();

            // Validate credentials (Step 1)
            $('#btnValidate').on('click', function () {
                const email = $('#Input_Email').val().trim();
                const password = $('#Input_Password').val();

                // Basic validation
                if (!email) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Campo requerido',
                        text: 'Por favor ingrese su correo electrónico',
                        confirmButtonColor: '#0052cc'
                    });
                    $('#Input_Email').focus();
                    return;
                }

                if (!password || password.length < 6) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Campo requerido',
                        text: 'La contraseña debe tener al menos 6 caracteres',
                        confirmButtonColor: '#0052cc'
                    });
                    $('#Input_Password').focus();
                    return;
                }

                // Show spinner
                $('#btnValidate').prop('disabled', true);
                $('#btnValidateText').addClass('d-none');
                $('#btnValidateSpinner').removeClass('d-none');

                // Validate credentials via AJAX
                $.ajax({
                    url: '/Auth/Login?handler=ValidateCredentials',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ email: email, password: password }),
                    beforeSend: function(xhr) {
                        xhr.setRequestHeader('RequestVerificationToken', $('input[name="__RequestVerificationToken"]').val());
                    },
                    success: function (response) {
                        if (response.isValid) {
                            validatedEmail = email;
                            validatedPassword = password;
                            validatedPreAuthToken = response.preAuthToken || '';
                            empresas = response.empresas || [];

                            if (empresas.length === 0) {
                                // No empresas - show error
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Sin acceso',
                                    text: 'No tiene empresas asignadas. Contacte al administrador.',
                                    confirmButtonColor: '#0052cc'
                                });
                            } else if (empresas.length === 1) {
                                // Only one empresa - login directly
                                $('#empresaSelect').val(empresas[0].id);
                                submitLogin();
                            } else {
                                // Multiple empresas - show selection
                                showStep2();
                            }
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error de autenticación',
                                text: response.message || 'Credenciales inválidas',
                                confirmButtonColor: '#0052cc'
                            });
                        }
                    },
                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Error al conectar con el servidor. Intente nuevamente.',
                            confirmButtonColor: '#0052cc'
                        });
                    },
                    complete: function () {
                        $('#btnValidate').prop('disabled', false);
                        $('#btnValidateText').removeClass('d-none');
                        $('#btnValidateSpinner').addClass('d-none');
                    }
                });
            });

            function showStep2() {
                // Populate empresa select
                const select = $('#empresaSelect');
                select.empty().append('<option value="">Seleccione una empresa...</option>');
                empresas.forEach(function (empresa) {
                    const text = empresa.cedulaJuridica
                        ? empresa.nombreComercial + ' (' + empresa.cedulaJuridica + ')'
                        : empresa.nombreComercial;
                    select.append(new Option(text, empresa.id));
                });

                // Show user email
                $('#userEmailDisplay').text(validatedEmail);

                // Switch to step 2
                $('#step1').addClass('d-none');
                $('#step2').removeClass('d-none');
                $('#empresaSelect').focus();
            }

            // Back button
            $('#btnBack').on('click', function () {
                $('#step2').addClass('d-none');
                $('#step1').removeClass('d-none');
                $('#Input_Password').val('');
                validatedPassword = '';
                validatedPreAuthToken = '';
                $('#Input_Email').focus();
            });

            // Form submit (Step 2)
            $('#loginForm').on('submit', function (e) {
                e.preventDefault();

                const empresaId = $('#empresaSelect').val();
                if (!empresaId) {
                    $('#empresaError').text('Debe seleccionar una empresa');
                    $('#empresaSelect').addClass('is-invalid');
                    return false;
                }

                $('#empresaSelect').removeClass('is-invalid');
                $('#empresaError').text('');
                // El select ya tiene el valor correcto, no necesita copiarse

                submitLogin();
            });

            function submitLogin() {
                // Disable button and show spinner
                $('#btnLogin').prop('disabled', true);
                $('#btnText').addClass('d-none');
                $('#btnSpinner').removeClass('d-none');

                // Set the email, password, and pre-auth token from validated values
                $('#Input_Email').val(validatedEmail);
                $('#Input_Password').val(validatedPassword);
                $('#preAuthToken').val(validatedPreAuthToken);

                // Submit the form
                document.getElementById('loginForm').submit();
            }

            // Enter key support for step 1
            $('#Input_Email, #Input_Password').on('keypress', function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    $('#btnValidate').click();
                }
            });

            // Enter key support for step 2
            $('#empresaSelect').on('keypress', function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    $('#loginForm').submit();
                }
            });

            // Check for error in ModelState
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <text>
                var errorMessages = [];
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <text>
                    errorMessages.push('@Html.Raw(error.ErrorMessage)');
                    </text>
                }

                if (errorMessages.length > 0) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error de validación',
                        html: errorMessages.join('<br>'),
                        confirmButtonText: 'Entendido',
                        confirmButtonColor: '#0052cc'
                    });
                }
                </text>
            }
        });
    </script>
</body>
</html>
