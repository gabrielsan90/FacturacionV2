@page
@model Facturacion.Frontend.Pages.Auth.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Iniciar Sesión";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Facturación Electrónica</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        :root {
            --primary-color: #4e73df;
            --secondary-color: #858796;
            --success-color: #1cc88a;
            --danger-color: #e74a3b;
            --warning-color: #f6c23e;
            --info-color: #36b9cc;
        }

        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .login-container {
            width: 100%;
            max-width: 450px;
            padding: 15px;
        }

        .login-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
            overflow: hidden;
        }

        .login-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 30px;
            text-align: center;
        }

        .login-header h1 {
            font-size: 24px;
            font-weight: 600;
            margin: 0 0 10px 0;
        }

        .login-header p {
            margin: 0;
            opacity: 0.9;
            font-size: 14px;
        }

        .logo-container {
            width: 80px;
            height: 80px;
            background: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px auto;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }

        .logo-container i {
            font-size: 40px;
            color: #667eea;
        }

        .login-body {
            padding: 40px;
        }

        .form-label {
            font-weight: 600;
            color: #4a5568;
            margin-bottom: 8px;
            font-size: 14px;
        }

        .form-control {
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            padding: 12px 15px;
            font-size: 14px;
            transition: all 0.3s;
        }

        .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

        .input-group-text {
            background: transparent;
            border: 2px solid #e2e8f0;
            border-right: 0;
            color: #667eea;
        }

        .input-group .form-control {
            border-left: 0;
        }

        .input-group:focus-within .input-group-text {
            border-color: #667eea;
        }

        .btn-login {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            border-radius: 8px;
            padding: 14px;
            font-size: 16px;
            font-weight: 600;
            color: white;
            width: 100%;
            transition: all 0.3s;
            margin-top: 10px;
        }

        .btn-login:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

        .btn-login:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .spinner-border-sm {
            width: 1rem;
            height: 1rem;
            border-width: 0.15em;
        }

        .text-danger {
            font-size: 13px;
            margin-top: 5px;
        }

        .alert {
            border-radius: 8px;
            border: none;
        }

        .form-check {
            margin-top: 15px;
        }

        .form-check-label {
            font-size: 14px;
            color: #4a5568;
        }

        @@media (max-width: 576px) {
            .login-container {
                padding: 10px;
            }

            .login-body {
                padding: 25px 20px;
            }

            .login-header {
                padding: 25px;
            }

            .login-header h1 {
                font-size: 20px;
            }

            .logo-container {
                width: 60px;
                height: 60px;
            }

            .logo-container i {
                font-size: 30px;
            }
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <div class="logo-container">
                    <i class="bi bi-receipt"></i>
                </div>
                <h1>Sistema de Facturación Electrónica</h1>
                <p>Versión 4.4 - Costa Rica</p>
            </div>
            <div class="login-body">
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        @TempData["ErrorMessage"]
                    </div>
                }

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        @TempData["SuccessMessage"]
                    </div>
                }

                <form method="post" id="loginForm">
                    @Html.AntiForgeryToken()
                    <!-- Step 1: Email and Password -->
                    <div id="step1">
                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label">Correo Electrónico</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-envelope"></i>
                                </span>
                                <input asp-for="Input.Email" class="form-control" placeholder="correo@ejemplo.com" autofocus />
                            </div>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label">Contraseña</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-lock"></i>
                                </span>
                                <input asp-for="Input.Password" class="form-control" placeholder="Ingrese su contraseña" type="password" />
                            </div>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>

                        <button type="button" class="btn btn-login" id="btnValidate">
                            <span id="btnValidateText">Continuar</span>
                            <span id="btnValidateSpinner" class="d-none">
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                Validando...
                            </span>
                        </button>
                    </div>

                    <!-- Step 2: Company Selection -->
                    <div id="step2" class="d-none">
                        <div class="mb-3">
                            <div class="d-flex align-items-center mb-3">
                                <button type="button" class="btn btn-link p-0 me-2" id="btnBack">
                                    <i class="bi bi-arrow-left fs-5"></i>
                                </button>
                                <span class="text-muted small" id="userEmailDisplay"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.EmpresaId" class="form-label">Seleccione la Empresa</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-building"></i>
                                </span>
                                <select asp-for="Input.EmpresaId" class="form-select" id="empresaSelect">
                                    <option value="">Seleccione una empresa...</option>
                                </select>
                            </div>
                            <span class="text-danger" id="empresaError"></span>
                        </div>

                        <button type="submit" class="btn btn-login" id="btnLogin">
                            <span id="btnText">Iniciar Sesión</span>
                            <span id="btnSpinner" class="d-none">
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                Iniciando sesión...
                            </span>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="text-center mt-3">
            <p class="text-white small mb-0">
                <i class="bi bi-shield-check"></i>
                Conexión segura y encriptada
            </p>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            let validatedEmail = '';
            let validatedPassword = '';
            let empresas = [];

            // Auto-focus on email field
            $('#Input_Email').focus();

            // Validate credentials (Step 1)
            $('#btnValidate').on('click', function () {
                const email = $('#Input_Email').val().trim();
                const password = $('#Input_Password').val();

                // Basic validation
                if (!email) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Campo requerido',
                        text: 'Por favor ingrese su correo electrónico',
                        confirmButtonColor: '#667eea'
                    });
                    $('#Input_Email').focus();
                    return;
                }

                if (!password || password.length < 6) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Campo requerido',
                        text: 'La contraseña debe tener al menos 6 caracteres',
                        confirmButtonColor: '#667eea'
                    });
                    $('#Input_Password').focus();
                    return;
                }

                // Show spinner
                $('#btnValidate').prop('disabled', true);
                $('#btnValidateText').addClass('d-none');
                $('#btnValidateSpinner').removeClass('d-none');

                // Validate credentials via AJAX
                $.ajax({
                    url: '/Auth/Login?handler=ValidateCredentials',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ email: email, password: password }),
                    beforeSend: function(xhr) {
                        xhr.setRequestHeader('RequestVerificationToken', $('input[name="__RequestVerificationToken"]').val());
                    },
                    success: function (response) {
                        if (response.isValid) {
                            validatedEmail = email;
                            validatedPassword = password;
                            empresas = response.empresas || [];

                            if (empresas.length === 0) {
                                // No empresas - show error
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Sin acceso',
                                    text: 'No tiene empresas asignadas. Contacte al administrador.',
                                    confirmButtonColor: '#667eea'
                                });
                            } else if (empresas.length === 1) {
                                // Only one empresa - login directly
                                $('#Input_EmpresaId').val(empresas[0].id);
                                submitLogin();
                            } else {
                                // Multiple empresas - show selection
                                showStep2();
                            }
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error de autenticación',
                                text: response.message || 'Credenciales inválidas',
                                confirmButtonColor: '#667eea'
                            });
                        }
                    },
                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Error al conectar con el servidor. Intente nuevamente.',
                            confirmButtonColor: '#667eea'
                        });
                    },
                    complete: function () {
                        $('#btnValidate').prop('disabled', false);
                        $('#btnValidateText').removeClass('d-none');
                        $('#btnValidateSpinner').addClass('d-none');
                    }
                });
            });

            function showStep2() {
                // Populate empresa select
                const select = $('#empresaSelect');
                select.empty().append('<option value="">Seleccione una empresa...</option>');
                empresas.forEach(function (empresa) {
                    const text = empresa.cedulaJuridica
                        ? empresa.nombreComercial + ' (' + empresa.cedulaJuridica + ')'
                        : empresa.nombreComercial;
                    select.append(new Option(text, empresa.id));
                });

                // Show user email
                $('#userEmailDisplay').text(validatedEmail);

                // Switch to step 2
                $('#step1').addClass('d-none');
                $('#step2').removeClass('d-none');
                $('#empresaSelect').focus();
            }

            // Back button
            $('#btnBack').on('click', function () {
                $('#step2').addClass('d-none');
                $('#step1').removeClass('d-none');
                $('#Input_Password').val('');
                validatedPassword = '';
                $('#Input_Email').focus();
            });

            // Form submit (Step 2)
            $('#loginForm').on('submit', function (e) {
                e.preventDefault();

                const empresaId = $('#empresaSelect').val();
                if (!empresaId) {
                    $('#empresaError').text('Debe seleccionar una empresa');
                    $('#empresaSelect').addClass('is-invalid');
                    return false;
                }

                $('#empresaSelect').removeClass('is-invalid');
                $('#empresaError').text('');
                $('#Input_EmpresaId').val(empresaId);

                submitLogin();
            });

            function submitLogin() {
                // Disable button and show spinner
                $('#btnLogin').prop('disabled', true);
                $('#btnText').addClass('d-none');
                $('#btnSpinner').removeClass('d-none');

                // Set the email and password from validated values
                $('#Input_Email').val(validatedEmail);
                $('#Input_Password').val(validatedPassword);

                // Submit the form
                document.getElementById('loginForm').submit();
            }

            // Enter key support for step 1
            $('#Input_Email, #Input_Password').on('keypress', function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    $('#btnValidate').click();
                }
            });

            // Enter key support for step 2
            $('#empresaSelect').on('keypress', function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    $('#loginForm').submit();
                }
            });

            // Check for error in ModelState
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <text>
                var errorMessages = [];
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <text>
                    errorMessages.push('@Html.Raw(error.ErrorMessage)');
                    </text>
                }

                if (errorMessages.length > 0) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error de validación',
                        html: errorMessages.join('<br>'),
                        confirmButtonText: 'Entendido',
                        confirmButtonColor: '#667eea'
                    });
                }
                </text>
            }
        });
    </script>
</body>
</html>
