@page
@model Facturacion.Frontend.Pages.Presupuestos.PresupuestosModel
@{
    ViewData["Title"] = "Presupuestos";
    ViewData["Breadcrumb"] = "Presupuestos";
}

<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <h2><i class="fas fa-file-invoice"></i> Presupuestos</h2>
            <p class="mb-0">Gestión de presupuestos anuales y mensuales</p>
        </div>
        <button class="btn btn-primary" onclick="openCreateModal()">
            <i class="fas fa-plus me-2"></i>Nuevo Presupuesto
        </button>
    </div>
</div>

<div class="card shadow-custom">
    <div class="card-header">
        <i class="fas fa-table me-2 text-primary"></i>
        <strong>Presupuestos</strong>
    </div>
    <div class="card-body">
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>
            <strong>Módulo en desarrollo.</strong> Esta funcionalidad estará disponible próximamente.
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openCreateModal() {
            Swal.fire('Información', 'Esta funcionalidad estará disponible próximamente.', 'info');
        }
    </script>
}
