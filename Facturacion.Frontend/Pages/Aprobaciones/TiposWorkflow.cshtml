@page
@model Facturacion.Frontend.Pages.Aprobaciones.TiposWorkflowModel
@{
    ViewData["Title"] = "Tipos de Workflow";
    ViewData["Breadcrumb"] = "Tipos de Workflow";
}

<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <h2><i class="fas fa-project-diagram"></i> Tipos de Workflow</h2>
            <p class="mb-0">Configuración de flujos de aprobación</p>
        </div>
        <button class="btn btn-primary" onclick="openCreateModal()">
            <i class="fas fa-plus me-2"></i>Nuevo Tipo
        </button>
    </div>
</div>

<!-- Tabla de Tipos -->
<div class="card shadow-custom">
    <div class="card-header">
        <i class="fas fa-table me-2 text-primary"></i>
        <strong>Tipos de Workflow</strong>
    </div>
    <div class="card-body">
        <table id="tblTipos" class="table table-striped table-hover" style="width:100%">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>Req. Aprob.</th>
                    <th>Monto Mín.</th>
                    <th>Notificaciones</th>
                    <th>Niveles</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<!-- Modal Crear/Editar -->
<div class="modal fade" id="modalTipo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Nuevo Tipo de Workflow</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formTipo">
                    <input type="hidden" id="tipoId" value="">

                    <!-- Identificación -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Código <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="codigo" required maxlength="20" placeholder="Ej: OC, REQ, ASI">
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Nombre <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="nombre" required maxlength="100">
                        </div>
                    </div>

                    <!-- Descripción -->
                    <div class="row g-3 mb-3">
                        <div class="col-12">
                            <label class="form-label">Descripción</label>
                            <textarea class="form-control" id="descripcion" rows="2" maxlength="500"></textarea>
                        </div>
                    </div>

                    <!-- Configuración de Aprobación -->
                    <div class="card bg-light mb-3">
                        <div class="card-header">
                            <i class="fas fa-check-circle me-2"></i>
                            Configuración de Aprobación
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="requiereAprobacion" checked onchange="toggleAprobacionConfig()">
                                        <label class="form-check-label" for="requiereAprobacion">Requiere Aprobación</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Monto Mínimo Aprobación</label>
                                    <div class="input-group">
                                        <span class="input-group-text">₡</span>
                                        <input type="number" class="form-control" id="montoMinimoAprobacion" step="0.01" min="0">
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Monto Máx. sin Aprobación</label>
                                    <div class="input-group">
                                        <span class="input-group-text">₡</span>
                                        <input type="number" class="form-control" id="montoMaximoSinAprobacion" step="0.01" min="0">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Notificaciones y Escalamiento -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="card bg-light h-100">
                                <div class="card-header">
                                    <i class="fas fa-bell me-2"></i>
                                    Notificaciones
                                </div>
                                <div class="card-body">
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" id="notificarEmail" checked>
                                        <label class="form-check-label" for="notificarEmail">Notificar por Email</label>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="notificarSistema" checked>
                                        <label class="form-check-label" for="notificarSistema">Notificar en Sistema</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card bg-light h-100">
                                <div class="card-header">
                                    <i class="fas fa-arrow-up me-2"></i>
                                    Escalamiento
                                </div>
                                <div class="card-body">
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" id="escalamientoAutomatico" onchange="toggleEscalamientoConfig()">
                                        <label class="form-check-label" for="escalamientoAutomatico">Escalamiento Automático</label>
                                    </div>
                                    <div class="mt-2">
                                        <label class="form-label">Días para Escalamiento</label>
                                        <input type="number" class="form-control" id="diasEscalamiento" min="1" max="30" disabled>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Estado -->
                    <div class="row g-3">
                        <div class="col-md-6 d-flex align-items-center">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="activo" checked>
                                <label class="form-check-label" for="activo">Tipo Activo</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Cancelar
                </button>
                <button type="button" class="btn btn-primary" onclick="saveTipo()">
                    <i class="fas fa-save me-2"></i>Guardar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;
        let tiposData = [];

        $(document).ready(function() {
            initDataTable();
        });

        function initDataTable() {
            table = $('#tblTipos').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'
                },
                ajax: {
                    url: '?handler=Data',
                    dataSrc: function(json) {
                        tiposData = json;
                        return json;
                    }
                },
                columns: [
                    { data: 'codigo' },
                    { data: 'nombre' },
                    {
                        data: 'requiereAprobacion',
                        render: function(data) {
                            return data
                                ? '<i class="fas fa-check text-success"></i> Sí'
                                : '<i class="fas fa-times text-muted"></i> No';
                        }
                    },
                    {
                        data: 'montoMinimoAprobacion',
                        render: function(data) {
                            if (data == null) return '-';
                            return '₡' + parseFloat(data).toLocaleString('es-CR', { minimumFractionDigits: 2 });
                        }
                    },
                    {
                        data: null,
                        render: function(data) {
                            let badges = [];
                            if (data.notificarEmail) badges.push('<span class="badge bg-info">Email</span>');
                            if (data.notificarSistema) badges.push('<span class="badge bg-secondary">Sistema</span>');
                            return badges.length > 0 ? badges.join(' ') : '-';
                        }
                    },
                    {
                        data: 'niveles',
                        render: function(data) {
                            const count = data ? data.length : 0;
                            return `<span class="badge bg-primary">${count}</span>`;
                        }
                    },
                    {
                        data: 'activo',
                        render: function(data) {
                            return data
                                ? '<span class="badge bg-success">Activo</span>'
                                : '<span class="badge bg-secondary">Inactivo</span>';
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        render: function(data) {
                            return `
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-primary" onclick="editTipo('${data.id}')" title="Editar">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <a class="btn btn-outline-info" href="/Aprobaciones/NivelesAprobacion?tipoId=${data.id}" title="Configurar Niveles">
                                        <i class="fas fa-layer-group"></i>
                                    </a>
                                    <button class="btn btn-outline-danger" onclick="deleteTipo('${data.id}')" title="Eliminar">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            `;
                        }
                    }
                ],
                order: [[0, 'asc']],
                responsive: true
            });
        }

        function toggleAprobacionConfig() {
            const requiere = $('#requiereAprobacion').is(':checked');
            $('#montoMinimoAprobacion').prop('disabled', !requiere);
            $('#montoMaximoSinAprobacion').prop('disabled', !requiere);
        }

        function toggleEscalamientoConfig() {
            const escala = $('#escalamientoAutomatico').is(':checked');
            $('#diasEscalamiento').prop('disabled', !escala);
            if (!escala) $('#diasEscalamiento').val('');
        }

        function openCreateModal() {
            resetForm();
            $('#modalTitle').text('Nuevo Tipo de Workflow');
            $('#modalTipo').modal('show');
        }

        function resetForm() {
            $('#tipoId').val('');
            $('#codigo').val('');
            $('#nombre').val('');
            $('#descripcion').val('');
            $('#requiereAprobacion').prop('checked', true);
            $('#montoMinimoAprobacion').val('');
            $('#montoMaximoSinAprobacion').val('');
            $('#notificarEmail').prop('checked', true);
            $('#notificarSistema').prop('checked', true);
            $('#escalamientoAutomatico').prop('checked', false);
            $('#diasEscalamiento').val('').prop('disabled', true);
            $('#activo').prop('checked', true);
            toggleAprobacionConfig();
        }

        function editTipo(id) {
            const tipo = tiposData.find(t => t.id === id);
            if (!tipo) return;

            $('#tipoId').val(tipo.id);
            $('#codigo').val(tipo.codigo);
            $('#nombre').val(tipo.nombre);
            $('#descripcion').val(tipo.descripcion || '');
            $('#requiereAprobacion').prop('checked', tipo.requiereAprobacion);
            $('#montoMinimoAprobacion').val(tipo.montoMinimoAprobacion || '');
            $('#montoMaximoSinAprobacion').val(tipo.montoMaximoSinAprobacion || '');
            $('#notificarEmail').prop('checked', tipo.notificarEmail);
            $('#notificarSistema').prop('checked', tipo.notificarSistema);
            $('#escalamientoAutomatico').prop('checked', tipo.escalamientoAutomatico);
            $('#diasEscalamiento').val(tipo.diasEscalamiento || '');

            toggleAprobacionConfig();
            toggleEscalamientoConfig();

            $('#activo').prop('checked', tipo.activo);

            $('#modalTitle').text('Editar Tipo de Workflow');
            $('#modalTipo').modal('show');
        }

        function saveTipo() {
            if (!$('#formTipo')[0].checkValidity()) {
                $('#formTipo')[0].reportValidity();
                return;
            }

            const tipo = {
                id: $('#tipoId').val() || '00000000-0000-0000-0000-000000000000',
                codigo: $('#codigo').val(),
                nombre: $('#nombre').val(),
                descripcion: $('#descripcion').val() || null,
                requiereAprobacion: $('#requiereAprobacion').is(':checked'),
                montoMinimoAprobacion: $('#montoMinimoAprobacion').val() ? parseFloat($('#montoMinimoAprobacion').val()) : null,
                montoMaximoSinAprobacion: $('#montoMaximoSinAprobacion').val() ? parseFloat($('#montoMaximoSinAprobacion').val()) : null,
                notificarEmail: $('#notificarEmail').is(':checked'),
                notificarSistema: $('#notificarSistema').is(':checked'),
                diasEscalamiento: $('#diasEscalamiento').val() ? parseInt($('#diasEscalamiento').val()) : null,
                escalamientoAutomatico: $('#escalamientoAutomatico').is(':checked'),
                activo: $('#activo').is(':checked')
            };

            $.ajax({
                url: '?handler=Save',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(tipo),
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    $('#modalTipo').modal('hide');
                    table.ajax.reload();
                    Swal.fire('Éxito', 'El tipo de workflow ha sido guardado correctamente.', 'success');
                },
                error: function(xhr) {
                    Swal.fire('Error', xhr.responseText || 'Error al guardar el tipo de workflow.', 'error');
                }
            });
        }

        function deleteTipo(id) {
            const tipo = tiposData.find(t => t.id === id);
            if (!tipo) return;

            Swal.fire({
                title: '¿Eliminar tipo de workflow?',
                html: `¿Está seguro que desea eliminar el tipo <strong>${tipo.nombre}</strong>?<br><small class="text-muted">También se eliminarán los niveles de aprobación asociados.</small>`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: `?handler=Delete&id=${id}`,
                        type: 'POST',
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            table.ajax.reload();
                            Swal.fire('Eliminado', 'El tipo de workflow ha sido eliminado.', 'success');
                        },
                        error: function(xhr) {
                            Swal.fire('Error', xhr.responseText || 'Error al eliminar el tipo de workflow.', 'error');
                        }
                    });
                }
            });
        }
    </script>
}
