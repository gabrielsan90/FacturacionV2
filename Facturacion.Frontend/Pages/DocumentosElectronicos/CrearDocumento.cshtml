        function loadProductoData(producto) {
            // Handle both camelCase and PascalCase property names
            const productoId = producto.id || producto.Id || null;
            const codigo = producto.codigo || producto.Codigo || '';
            const nombre = producto.nombre || producto.Nombre || '';
            const precioVenta = producto.precioVenta ?? producto.PrecioVenta ?? 0;
            const tipoRaw = producto.tipo ?? producto.Tipo ?? 0;
            // El enum TipoProducto puede venir como string ("Producto"/"Servicio") o número (0/1)
            const esServicio = tipoRaw === 1 || tipoRaw === 'Servicio';
            console.log("tipo:", tipoRaw, "esServicio:", esServicio);
            // Guardar el ID del producto para identificar que es mercancía (no servicio manual)
            currentLine.productoId = productoId;

            $('#Linea_Codigo').val(codigo);
            $('#Linea_Descripcion').val(nombre);
            $('#Linea_PrecioUnitario').val(precioVenta.toFixed(2));

            // ====== UNIDAD DE MEDIDA ======
            const unidadMedida = producto.unidadMedida || producto.UnidadMedida;
            if (unidadMedida) {
                const unidadCodigo = unidadMedida.codigo || unidadMedida.Codigo || 'Unid';
                // Try to set the value in the select
                const $selectUnidad = $('#Linea_UnidadMedida');
                if ($selectUnidad.find(`option[value="${unidadCodigo}"]`).length > 0) {
                    $selectUnidad.val(unidadCodigo).trigger('change');
                } else {
                    $selectUnidad.val(esServicio ? 'Sp' : 'Unid').trigger('change');
                }
            } else {
                $('#Linea_UnidadMedida').val(esServicio ? 'Sp' : 'Unid').trigger('change');
            }

            // ====== TIPO DE PRODUCTO ======
            $('#Linea_TipoProducto').val(esServicio ? 'servicio' : 'mercancia');

            // ====== TIPO DE TRANSACCIÓN v4.4 ======
            $('#Linea_TipoTransaccion').val(esServicio ? '02' : '01'); // 02 = Venta de servicios, 01 = Venta de bienes

            // Limpiar impuestos existentes y agregar el del producto
            currentLine.impuestos = [];
            $('#tbodyImpuestos').html('');

            // Si el producto tiene impuesto, agregarlo
            const impuesto = producto.impuesto || producto.Impuesto;
            // Use porcentaje (entity property) or tarifa
            const tarifa = impuesto?.porcentaje ?? impuesto?.Porcentaje ?? impuesto?.tarifa ?? impuesto?.Tarifa ?? null;

            if (impuesto && tarifa !== null) {
                // Determinar código de tarifa basado en el porcentaje
                let codigoTarifa = '08'; // Default 13%
                if (tarifa === 0) {
                    codigoTarifa = '01'; // 0%
                } else if (tarifa === 1) {
                    codigoTarifa = '02';
                } else if (tarifa === 2) {
                    codigoTarifa = '03';
                } else if (tarifa === 4) {
                    codigoTarifa = '04';
                } else if (tarifa === 8) {
                    codigoTarifa = '07';
                } else if (tarifa === 13) {
                    codigoTarifa = '08';
                }

                currentLine.impuestos.push({
                    codigoImpuesto: '01', // IVA
                    codigoTarifa: codigoTarifa,
                    tarifa: tarifa,
                    montoBase: 0,
                    montoImpuesto: 0,
                    tieneExoneracion: false,
                    exoneracion: null
                });

                renderTaxRow(0);

                // ====== CÓDIGO TARIFA IVA (dropdown principal) ======
                $('#Linea_CodigoTarifaIVA').val(codigoTarifa);
            } else {
                // Si no tiene impuesto, agregar uno por defecto (13%)
                addTaxToLine();
                $('#Linea_CodigoTarifaIVA').val('08');
            }

            // ====== CÓDIGO CABYS ======
            const cabys = producto.cabys || producto.Cabys || producto.CAByS;
            if (cabys) {
                const cabysCode = cabys.codigo || cabys.Codigo || '';
                const cabysDesc = cabys.descripcion || cabys.Descripcion || '';
                $('#Linea_CodigoCabys').val(cabysCode);
                if (cabysDesc) {
                    $('#lblCabysDescripcion').text(cabysDesc).show();
                } else {
                    $('#lblCabysDescripcion').hide();
                }
            } else if (producto.cabysId || producto.CabysId) {
                // If only cabysId is available, clear the field (user can search manually)
                $('#Linea_CodigoCabys').val('');
                $('#lblCabysDescripcion').hide();
            } else {
                $('#Linea_CodigoCabys').val('');
                $('#lblCabysDescripcion').hide();
            }

            calculateLineSubtotal();
        }

        // ==================== FUNCIONES DE GESTIÓN DE IMPUESTOS ====================

