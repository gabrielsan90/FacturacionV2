        function filtrarProductosModal() {
            const filtro = $('#filtroProductoNombre').val().toLowerCase().trim();
            const tipo = $('#filtroProductoTipo').val();

            let filtrados = todosLosProductosModal.filter(function (producto) {
                let cumple = true;

                // Filtrar por nombre o código
                if (filtro) {
                    const codigo = (producto.codigo || producto.Codigo || '').toLowerCase();
                    const nombre = (producto.nombre || producto.Nombre || '').toLowerCase();
                    if (!codigo.includes(filtro) && !nombre.includes(filtro)) {
                        cumple = false;
                    }
                }

                // Filtrar por tipo (el enum puede venir como número 0/1 o string "Producto"/"Servicio")
                if (tipo !== '') {
                    const productoTipo = producto.tipo ?? producto.Tipo;
                    const esServicioProducto = productoTipo === 1 || productoTipo === 'Servicio';
                    const esServicioFiltro = tipo === '1';
                    if (esServicioProducto !== esServicioFiltro) {
                        cumple = false;
                    }
                }

                return cumple;
            });

            renderProductosModal(filtrados);
        }

