        function renderProductosModal(productos) {
            const tbody = $('#tbodyProductosModal');

            if (!productos || productos.length === 0) {
                tbody.html(`
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            <i class="fas fa-info-circle me-2"></i>No se encontraron productos
                        </td>
                    </tr>
                `);
                return;
            }

            let html = '';
            productos.forEach(function (producto, index) {
                // Handle both camelCase and PascalCase
                const id = producto.id || producto.Id;
                const codigo = producto.codigo || producto.Codigo || '-';
                const nombre = producto.nombre || producto.Nombre || '-';
                const tipo = producto.tipo ?? producto.Tipo;
                const esServicio = tipo === 1 || tipo === 'Servicio';
                const tipoNombre = esServicio ? 'Servicio' : 'Producto';
                const tipoBadge = esServicio ? 'bg-info' : 'bg-primary';
                const precioVenta = producto.precioVenta || producto.PrecioVenta || 0;

                // Impuesto
                let impuestoTexto = '-';
                const impuesto = producto.impuesto || producto.Impuesto;
                if (impuesto) {
                    const porcentaje = impuesto.porcentaje ?? impuesto.Porcentaje ?? impuesto.tarifa ?? impuesto.Tarifa ?? 0;
                    impuestoTexto = `${porcentaje}%`;
