<!-- Modal: Add/Edit Line -->
<div class="modal fade" id="modalLinea" tabindex="-1" aria-labelledby="modalLineaLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalLineaLabel">
                    <i class="fas fa-plus me-2 text-success"></i><span id="modalLineaTitle">Agregar Línea</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formLinea">
                <div class="modal-body">
                    <input type="hidden" id="Linea_Index" value="-1">

                    <!-- Product Selector -->
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label for="Linea_ProductoId" class="form-label">Producto/Servicio</label>
                            <div class="input-group">
                                <select class="form-select select2" id="Linea_ProductoId" style="flex: 1;">
                                    <option value="">Buscar producto o servicio...</option>
                                </select>
                                <button type="button" class="btn btn-outline-primary" onclick="openProductosModal()" title="Buscar en lista de productos">
                                    <i class="fas fa-search"></i> Buscar
                                </button>
                            </div>
                            <small class="text-muted">Seleccione un producto para auto-completar los campos</small>
                        </div>
                    </div>

                    <!-- Product Details -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label for="Linea_Codigo" class="form-label">Código</label>
                            <input type="text" class="form-control" id="Linea_Codigo" maxlength="50" placeholder="Código">
                        </div>
                        <div class="col-md-8">
                            <label for="Linea_Descripcion" class="form-label">Descripción <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="Linea_Descripcion" maxlength="500" required placeholder="Descripción del producto/servicio">
                        </div>
                    </div>

                    <!-- Quantities and Prices -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="Linea_Cantidad" class="form-label">Cantidad <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="Linea_Cantidad" step="0.001" min="0.001" required placeholder="1.000">
                        </div>
                        <div class="col-md-6">
                            <label for="Linea_PrecioUnitario" class="form-label">Precio Unitario <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="Linea_PrecioUnitario" step="0.01" min="0" required placeholder="0.00">
                        </div>
                    </div>

                    <!-- Tabla de Descuentos Múltiples -->
                    <div class="form-group mb-3">
                        <label>Descuentos</label>
                        <table class="table table-sm table-bordered" id="tableDescuentos">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 200px;">Naturaleza del Descuento</th>
                                    <th style="width: 120px;">Tipo</th>
                                    <th style="width: 120px;">Valor</th>
                                    <th style="width: 120px;">Monto Descuento</th>
                                    <th style="width: 40px;"></th>
                                </tr>
                            </thead>
                            <tbody id="tbodyDescuentos">
                                <!-- Filas dinámicas -->
                            </tbody>
                        </table>
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="addDiscountToLine()">
                            <i class="fas fa-plus"></i> Agregar Descuento
                        </button>
                    </div>

                    <!-- Tabla de Impuestos Múltiples -->
                    <div class="form-group mb-3">
                        <label>Impuestos (v4.4)</label>
                        <table class="table table-sm table-bordered" id="tableImpuestos">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 150px;">Código Impuesto</th>
                                    <th style="width: 200px;">Código Tarifa</th>
                                    <th style="width: 80px;">Tarifa %</th>
                                    <th style="width: 120px;">Monto Base</th>
                                    <th style="width: 120px;">Monto Impuesto</th>
                                    <th style="width: 80px;">Exoneración</th>
                                    <th style="width: 40px;"></th>
                                </tr>
                            </thead>
                            <tbody id="tbodyImpuestos">
                                <!-- Filas dinámicas -->
                            </tbody>
                        </table>
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="addTaxToLine()">
                            <i class="fas fa-plus"></i> Agregar Impuesto
                        </button>
                        <small class="text-muted d-block mt-1">Puede agregar múltiples impuestos según v4.4 (IVA, Selectivo, Servicios, etc.)</small>
                    </div>

                    <!-- Unidad de medida y Tipo -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label for="Linea_UnidadMedida" class="form-label">Unidad de Medida <span class="text-danger">*</span></label>
                            <select class="form-select" id="Linea_UnidadMedida" required>
                                <option value="Unid">Unid - Unidad</option>
                                <option value="Kg">Kg - Kilogramo</option>
                                <option value="g">g - Gramo</option>
                                <option value="L">L - Litro</option>
                                <option value="mL">mL - Mililitro</option>
                                <option value="m">m - Metro</option>
                                <option value="m2">m² - Metro cuadrado</option>
                                <option value="m3">m³ - Metro cúbico</option>
                                <option value="Sp">Sp - Servicios profesionales</option>
                                <option value="Spe">Spe - Servicios personales</option>
                                <option value="Os">Os - Otros servicios</option>
                                <option value="Al">Al - Alquiler</option>
                                <option value="h">h - Hora</option>
                                <option value="d">d - Día</option>
                                <option value="Cm">Cm - Comisión</option>
                                <option value="Otros">Otros</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="Linea_TipoProducto" class="form-label">Tipo de Producto</label>
                            <select class="form-select" id="Linea_TipoProducto">
                                <option value="mercancia">Mercancía (Bien)</option>
                                <option value="servicio">Servicio</option>
                            </select>
                            <small class="text-muted">Se detecta automáticamente por la unidad</small>
                        </div>
                        <div class="col-md-4">
                            <label for="Linea_CodigoTarifaIVA" class="form-label">Código Tarifa IVA</label>
                            <select class="form-select" id="Linea_CodigoTarifaIVA">
                                <option value="08">08 - Tarifa general 13%</option>
                                <option value="01">01 - Tarifa 0%</option>
                                <option value="02">02 - Tarifa reducida 1%</option>
                                <option value="03">03 - Tarifa reducida 2%</option>
                                <option value="04">04 - Tarifa reducida 4%</option>
                                <option value="05">05 - 0% Transitorio</option>
                                <option value="06">06 - 4% Transitorio</option>
                                <option value="07">07 - 8% Transitorio</option>
                                <option value="09">09 - 0.5% Reducida</option>
                                <option value="10">10 - Exento</option>
                                <option value="11">11 - 0% Sin crédito</option>
                            </select>
                        </div>
                    </div>

                    <!-- Campos adicionales v4.4 -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="Linea_TipoTransaccion" class="form-label">Tipo de Transacción</label>
                            <select class="form-select" id="Linea_TipoTransaccion">
                                <option value="">-- Seleccione --</option>
                                <option value="01">01 - Venta de bienes</option>
                                <option value="02">02 - Venta de servicios</option>
                                <option value="03">03 - Importación de bienes</option>
                                <option value="04">04 - Importación de servicios</option>
                                <option value="05">05 - Exportación de bienes</option>
                                <option value="06">06 - Exportación de servicios</option>
                                <option value="07">07 - Compras locales de bienes</option>
                                <option value="08">08 - Compras locales de servicios</option>
                                <option value="09">09 - Devolución de mercancías</option>
                                <option value="10">10 - Descuentos y bonificaciones</option>
                                <option value="11">11 - Anticipos</option>
                                <option value="12">12 - Arrendamiento</option>
                                <option value="13">13 - Otros</option>
                            </select>
                            <small class="text-muted">Opcional - Tipo de transacción v4.4</small>
                        </div>
                        <div class="col-md-6">
                            <label for="Linea_CodigoCabys" class="form-label">Código CAByS <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="Linea_CodigoCabys" maxlength="13" placeholder="1234567890123">
                                <button class="btn btn-outline-secondary" type="button" id="btnBuscarCabys" title="Buscar código CABYS">
                                    <i class="fas fa-search"></i>
                                </button>
                            </div>
                            <small id="lblCabysDescripcion" class="text-info fw-semibold" style="display: none;"></small>
                            <small class="text-muted">13 caracteres - Obligatorio desde 01/06/2025</small>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="Linea_FormaFarmaceutica" class="form-label">Forma Farmacéutica</label>
                            <select class="form-select" id="Linea_FormaFarmaceutica">
                                <option value="">-- Seleccione --</option>
                            </select>
                            <small class="text-muted">Solo para productos farmacéuticos</small>
                        </div>
                        <div class="col-md-6">
                            <label for="Linea_DetalleSurtido" class="form-label">Detalle Surtido</label>
