        function loadTerminalesBySucursal(sucursalId) {
            const select = $('#TerminalId');
            select.empty().append('<option value="">Seleccione...</option>');

            if (!sucursalId) return;

            // Comparar GUIDs como strings en minúsculas
            const sucursalIdLower = sucursalId.toLowerCase();
            const filteredTerminales = terminales.filter(t =>
                t.sucursalId && t.sucursalId.toLowerCase() === sucursalIdLower
            );

            filteredTerminales.forEach(function (item) {
                select.append(`<option value="${item.id}">${item.codigo} - ${item.nombre || item.descripcion}</option>`);
            });

            // Si solo hay una terminal, seleccionarla automáticamente
            if (filteredTerminales.length === 1) {
                select.val(filteredTerminales[0].id);
            }
        }

