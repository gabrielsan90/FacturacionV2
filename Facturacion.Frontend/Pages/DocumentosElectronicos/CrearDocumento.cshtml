        }

        // Eliminar impuesto
        function removeTax(taxIndex) {
            currentLine.impuestos.splice(taxIndex, 1);
            $('#tbodyImpuestos').html('');
            currentLine.impuestos.forEach((tax, idx) => renderTaxRow(idx));
