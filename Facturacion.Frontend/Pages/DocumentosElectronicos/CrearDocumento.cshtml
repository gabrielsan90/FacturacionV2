                if (line.descuentos && line.descuentos.length > 0) {
                    currentLine.descuentos = JSON.parse(JSON.stringify(line.descuentos)); // Deep copy
                    // TODO: Renderizar descuentos en la tabla si existe UI para múltiples descuentos
