        function loadClienteData(clienteId) {
            $.ajax({
                url: '?handler=ClienteDetails&id=' + clienteId,
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (cliente) {
                    clienteSeleccionado = cliente;

                    // Fill identification fields
                    $('#ClienteNombre').val(cliente.nombre);

                    // Map TipoIdentificacion: puede venir como número (1,2,3...) o como string del enum ("Fisica","Juridica",...)
                    var tipoIdMap = { 'Fisica': '1', 'Juridica': '2', 'DIMEX': '3', 'NITE': '4', 'Pasaporte': '5', 'Extranjera': '6' };
                    var tipoIdVal = cliente.tipoIdentificacion;
                    if (typeof tipoIdVal === 'string' && tipoIdMap[tipoIdVal]) {
                        tipoIdVal = tipoIdMap[tipoIdVal];
                    }
                    $('#ClienteTipoIdentificacion').val(String(tipoIdVal)).trigger('change');
                    $('#ClienteIdentificacion').val(cliente.numeroIdentificacion);

                    // Fill contact fields
                    $('#ClienteEmail').val(cliente.emailPrincipal || '');
                    $('#ClienteTelefono').val(cliente.telefonoPrincipal || '');
                    $('#ClienteFax').val(''); // If you have fax in backend, populate it

                    // Fill address fields
                    $('#ClienteOtrasSenas').val(cliente.otrasSenas || '');
                    $('#ClienteActividadEconomica').val(cliente.actividadEconomicaCIIU4 || '');

                    // Load provincia first, then cascade to canton and distrito
                    if (cliente.provincia) {
                        $('#ClienteProvincia').val(cliente.provincia).trigger('change');

                        // Wait for cantones to load, then set canton
                        if (cliente.canton) {
                            setTimeout(function() {
                                $('#ClienteCanton').val(cliente.canton).trigger('change');

                                // Wait for distritos to load, then set distrito
                                if (cliente.distrito) {
                                    setTimeout(function() {
                                        $('#ClienteDistrito').val(cliente.distrito);
                                    }, 300);
                                }
                            }, 300);
                        }
                    }

                    // Auto-fill Condicion de Venta (TipoVenta from Cliente)
                    if (cliente.tipoVenta) {
                        // Convert TipoVenta (int) to the format expected by the dropdown (string with leading zero)
                        const condicionVenta = String(cliente.tipoVenta).padStart(2, '0');
                        $('#CondicionVenta').val(condicionVenta).trigger('change');
                    }

                    // Auto-fill Medio de Pago (TipoPago from Cliente)
                    if (cliente.tipoPago) {
                        // Convert TipoPago (int) to the format expected by the dropdown (string with leading zero)
                        const medioPago = String(cliente.tipoPago).padStart(2, '0');
                        $('#MedioPago').val(medioPago);
                    }

                    // Auto-fill Moneda del Cliente
                    if (cliente.moneda) {
                        // Puede venir como string del enum ("CRC","USD","EUR") o como número (1,2,3)
                        var monedaMap = { 1: 'CRC', 2: 'USD', 3: 'EUR' };
                        var monedaVal = cliente.moneda;
                        if (typeof monedaVal === 'number' && monedaMap[monedaVal]) {
                            monedaVal = monedaMap[monedaVal];
                        }
                        $('#Moneda').val(monedaVal).trigger('change');
                    }

                    $('#clienteInfoSection').show();
                    $('#btnEditarCliente').prop('disabled', false);
                },
                error: function (xhr) {
                    console.error('Error loading cliente:', xhr);
                    Swal.fire('Error', 'No se pudieron cargar los datos del cliente.', 'error');
                }
            });
        }

