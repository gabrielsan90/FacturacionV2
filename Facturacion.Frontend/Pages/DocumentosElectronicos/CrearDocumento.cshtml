        function seleccionarDocumentoModal(documentoId) {
            // Cerrar el modal
            $('#modalDocumentos').modal('hide');

            // Mostrar loading
            Swal.fire({
                title: 'Cargando documento...',
                text: 'Obteniendo datos completos del documento',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            // Obtener el documento completo con detalles desde el backend
            $.ajax({
                url: '?handler=DocumentoCompleto&id=' + documentoId,
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(documento) {
                    Swal.close();

                    if (!documento || documento.error) {
                        Swal.fire('Error', documento?.error || 'No se pudo cargar el documento', 'error');
                        return;
                    }

                    // Actualizar los campos de referencia
                    $('#DocumentoReferenciaId').val(documento.id);
                    $('#DocumentoReferenciaNumero').val(documento.numeroConsecutivo);

                    // Actualizar mensaje de referencia
                    updateMensajeReferencia(documento);
                    console.log(documento);
                    // Cargar datos del receptor en el formulario
                    cargarDatosReceptorDesdeDocumento(documento);

                    // Cargar las líneas del documento
                    cargarLineasDesdeDocumento(documento);

                    console.log('Documento completo cargado:', documento);
                },
                error: function(xhr) {
                    Swal.close();
                    console.error('Error al cargar documento completo:', xhr);

                    // Fallback: usar datos básicos del listado
                    const docBasico = todosLosDocumentos.find(d => d.id === documentoId);
                    if (docBasico) {
                        $('#DocumentoReferenciaId').val(docBasico.id);
                        $('#DocumentoReferenciaNumero').val(docBasico.numeroConsecutivo);
                        updateMensajeReferencia(docBasico);
                        cargarDatosReceptorDesdeDocumento(docBasico);
                    }

                    Swal.fire('Advertencia', 'Se cargaron datos básicos. Las líneas no pudieron cargarse.', 'warning');
                }
            });
        }

        function cargarDatosReceptorDesdeDocumento(documento) {
            // Mapeo de tipo de identificación (string a número)
            const tipoIdMap = {
                'Fisica': 1, 'Cedula': 1, 'CedulaFisica': 1,
                'Juridica': 2, 'CedulaJuridica': 2,
                'DIMEX': 3, 'Dimex': 3,
                'NITE': 4, 'Nite': 4,
                'Pasaporte': 5,
                'Extranjera': 6, 'IdentificacionExtranjera': 6
            };

            // Nombre
            $('#ClienteNombre').val(documento.receptorNombre || '');

            // Tipo de identificación
            const tipoId = tipoIdMap[documento.receptorTipoIdentificacion] || documento.receptorTipoIdentificacion || 1;
            $('#ClienteTipoIdentificacion').val(tipoId);

            // Número de identificación
            $('#ClienteIdentificacion').val(documento.receptorNumeroIdentificacion || '');

            // Email
            $('#ClienteEmail').val(documento.receptorEmails || documento.receptorEmail || '');

            // Teléfono
            $('#ClienteTelefono').val(documento.receptorTelefono || '');

            // Actividad económica
            $('#ClienteActividadEconomica').val(documento.receptorActividadEconomica || '');

            // Otras señas
            $('#ClienteOtrasSenas').val(documento.receptorOtrasSenas || '');

            // Cargar ubicación geográfica (provincia, cantón, distrito)
            if (documento.receptorProvincia) {
                $('#ClienteProvincia').val(documento.receptorProvincia.toString());
                loadCantones(documento.receptorProvincia);

                // Esperar a que se carguen los cantones antes de seleccionar
                setTimeout(function() {
                    if (documento.receptorCanton) {
                        $('#ClienteCanton').val(documento.receptorCanton.toString());
                        loadDistritos(documento.receptorProvincia, documento.receptorCanton);

                        // Esperar a que se carguen los distritos antes de seleccionar
                        setTimeout(function() {
                            if (documento.receptorDistrito) {
                                $('#ClienteDistrito').val(documento.receptorDistrito.toString());
                            }
                        }, 500);
                    }
                }, 500);
            }

            // Si tiene clienteId, cargarlo en Select2
            if (documento.clienteId) {
                // Verificar si ya existe la opción
                if ($('#ClienteId option[value="' + documento.clienteId + '"]').length === 0) {
                    // Crear opción para Select2 con los datos del receptor
                    const clienteOption = new Option(
                        documento.receptorNombre || 'Cliente',
                        documento.clienteId,
                        true,  // defaultSelected
                        true   // selected
                    );
                    // Agregar datos adicionales para evitar que se recargue
                    clienteOption.dataset.fromDocument = 'true';
                    $('#ClienteId').append(clienteOption);
                }
                // Seleccionar usando la API de Select2 (sin disparar select2:select)
                $('#ClienteId').val(documento.clienteId).trigger('change.select2');
            }

            // Mostrar la sección de información del cliente siempre que hay datos de receptor
            $('#clienteInfoSection').show();
            $('#btnEditarCliente').prop('disabled', false);

            // Forzar visibilidad con timeout por si hay algún conflicto
            setTimeout(function() {
                $('#clienteInfoSection').show();
            }, 100);

            console.log('Datos del receptor cargados desde documento:', documento.numeroConsecutivo);
        }

        function cargarLineasDesdeDocumento(documento) {
            // Limpiar líneas existentes (usar la variable correcta: documentLines)
            documentLines = [];
            renderLines();

            // Cargar condición de venta
            if (documento.condicionVenta) {
                $('#CondicionVenta').val(documento.condicionVenta);
            }

            // Cargar medio de pago
            if (documento.medioPago) {
                $('#MedioPago').val(documento.medioPago);
            }

            // Cargar plazo de crédito si aplica
            if (documento.plazoCredito) {
                $('#PlazoCredito').val(documento.plazoCredito);
            }

            // Verificar que el documento tenga detalles
            if (!documento.detalles || documento.detalles.length === 0) {
                console.log('El documento no tiene detalles/líneas');
                return;
            }

            // Cargar cada línea del documento
            documento.detalles.forEach(function(detalle, index) {
                // Calcular subtotal y monto de descuento
                const cantidad = detalle.cantidad || 1;
                const precioUnitario = detalle.precioUnitario || 0;
                const subtotal = detalle.subTotal || (cantidad * precioUnitario);

                // Calcular monto total de descuentos
                let montoDescuento = 0;
                const descuentos = (detalle.descuentos || []).map(d => {
                    const desc = {
                        naturaleza: d.naturalezaDescuento || 'Descuento',
                        tipo: d.tipoDescuento || 'porcentaje',
                        valor: d.porcentajeDescuento || d.montoDescuento || 0,
                        monto: d.montoDescuento || 0
                    };
                    montoDescuento += desc.monto;
                    return desc;
                });

                // Mapear impuestos
                const impuestos = (detalle.impuestos || []).map(imp => ({
                    codigoImpuesto: imp.codigoImpuesto || '01',
                    codigoTarifa: imp.codigoTarifa || '08',
                    tarifa: imp.tarifa || 0,
                    montoBase: imp.montoBase || subtotal,
                    montoImpuesto: imp.monto || imp.montoImpuesto || 0,
                    exoneracion: imp.exoneracion ? {
                        tipoDocumento: imp.exoneracion.tipoDocumento,
                        numeroDocumento: imp.exoneracion.numeroDocumento,
                        nombreInstitucion: imp.exoneracion.nombreInstitucion,
                        fechaEmision: imp.exoneracion.fechaEmision,
                        porcentaje: imp.exoneracion.porcentajeExoneracion,
                        montoExoneracion: imp.exoneracion.montoExoneracion
                    } : null
                }));

                // Si no hay impuestos, crear uno por defecto
                if (impuestos.length === 0) {
                    impuestos.push({
                        codigoImpuesto: '01',
                        codigoTarifa: detalle.codigoTarifaIva || '08',
                        tarifa: detalle.tarifaIva || 0,
                        montoBase: subtotal,
                        montoImpuesto: detalle.montoImpuesto || 0,
                        exoneracion: null
                    });
                }

                // Obtener código de unidad de medida (puede venir como objeto o string)
                let unidadMedidaCodigo = 'Unid';
                if (detalle.unidadMedida && detalle.unidadMedida.codigo) {
                    unidadMedidaCodigo = detalle.unidadMedida.codigo;
                } else if (detalle.unidadMedidaComercial) {
                    unidadMedidaCodigo = detalle.unidadMedidaComercial;
                } else if (typeof detalle.unidadMedida === 'string') {
                    unidadMedidaCodigo = detalle.unidadMedida;
                }

                // Obtener código CABYS
                const codigoCabys = detalle.codigoCabys || detalle.cabys || '';

                const linea = {
                    index: index,
                    productoId: detalle.productoId || null,
                    codigo: detalle.codigoComercial || detalle.codigo || '',
                    descripcion: detalle.detalle || detalle.descripcion || '',
                    cantidad: cantidad,
                    precioUnitario: precioUnitario,
                    unidadMedida: unidadMedidaCodigo,
                    unidadMedidaDescripcion: detalle.unidadMedida?.descripcion || 'Unidad',
                    tipoProducto: detalle.esServicio ? '02' : '01',
                    tipoTransaccion: detalle.tipoTransaccion || '01',
                    codigoCabys: codigoCabys,
                    subtotal: subtotal,
                    montoDescuento: montoDescuento,
                    montoTotalLinea: detalle.montoTotalLinea || detalle.totalLinea || 0,
                    descuentos: descuentos,
                    impuestos: impuestos
                };

                documentLines.push(linea);
            });

            // Asegurar que las secciones del formulario estén visibles
            $('#mainFormCard, #lineasCard, #actionButtons').show();

            // Renderizar todas las líneas y calcular totales
            renderLines();
            calculateTotals();

