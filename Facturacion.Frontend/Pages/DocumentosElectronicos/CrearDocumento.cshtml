                html += `
                    <tr style="cursor: pointer;" ondblclick="seleccionarProductoDesdeModal(${index})">
                        <td><code>${codigo}</code></td>
                        <td>${nombre}</td>
                        <td><span class="badge ${tipoBadge}">${tipoNombre}</span></td>
