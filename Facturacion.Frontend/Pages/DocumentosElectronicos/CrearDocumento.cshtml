        function actualizarContadorErrores() {
            // Ejecutar validacion silenciosa
            ValidacionesFE.limpiarErrores();

            // Solo validar campos visibles/activos
            if (currentTipoDocumento) {
                ValidacionesFE.validarTipoDocumento();
