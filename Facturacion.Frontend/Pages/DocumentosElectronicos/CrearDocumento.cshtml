        }

        // Cuando cambia el código de tarifa
        function onTarifaCodeChange(taxIndex, codigoTarifa) {
            currentLine.impuestos[taxIndex].codigoTarifa = codigoTarifa;
            currentLine.impuestos[taxIndex].tarifa = tarifasIVA[codigoTarifa].tarifa;
            calculateLineTotal();
