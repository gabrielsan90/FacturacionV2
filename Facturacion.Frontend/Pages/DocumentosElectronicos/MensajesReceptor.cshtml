@page
@model Facturacion.Frontend.Pages.DocumentosElectronicos.MensajesReceptorModel
@{
    ViewData["Title"] = "Mensajes Receptor - Hacienda v4.4";
}

<form method="post">
    @Html.AntiForgeryToken()
</form>

<div class="container-fluid">
    <!-- Page Header -->
    <div class="page-header mb-4">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <h2><i class="fas fa-comments"></i> Mensajes Receptor</h2>
                <p class="mb-0">Respuestas de Hacienda a documentos electrónicos recibidos - Aceptación/Rechazo</p>
            </div>
            <div class="btn-group" role="group">
                <a href="/DocumentosElectronicos/Documentos" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-1"></i> Volver a Documentos
                </a>
            </div>
        </div>
    </div>

    <!-- Filters Card -->
    <div class="card shadow mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="fas fa-filter"></i> Filtros de Búsqueda</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label for="filterFechaInicio" class="form-label">Fecha Inicio</label>
                    <input type="date" id="filterFechaInicio" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label for="filterFechaFin" class="form-label">Fecha Fin</label>
                    <input type="date" id="filterFechaFin" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label for="filterTipoMensaje" class="form-label">Tipo de Mensaje</label>
                    <select id="filterTipoMensaje" class="form-select">
                        <option value="">Todos</option>
                        <option value="1">Aceptación</option>
                        <option value="2">Aceptación Parcial</option>
                        <option value="3">Rechazo</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="filterEstado" class="form-label">Estado</label>
                    <select id="filterEstado" class="form-select">
                        <option value="">Todos</option>
                        <option value="Pendiente">Pendiente</option>
                        <option value="Aceptado">Aceptado</option>
                        <option value="Rechazado">Rechazado</option>
                    </select>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-12">
                    <button type="button" class="btn btn-primary" onclick="applyFilters()">
                        <i class="fas fa-search"></i> Buscar
                    </button>
                    <button type="button" class="btn btn-secondary" onclick="clearFilters()">
                        <i class="fas fa-eraser"></i> Limpiar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Messages Table -->
    <div class="card shadow">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0"><i class="fas fa-list"></i> Lista de Mensajes Receptor</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="tableMensajesReceptor" class="table table-striped table-hover table-bordered w-100">
                    <thead class="table-dark">
                        <tr>
                            <th>Clave Mensaje</th>
                            <th>Clave Documento</th>
                            <th>Tipo Mensaje</th>
                            <th>Fecha Emisión</th>
                            <th>Estado</th>
                            <th>Mensaje Hacienda</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- DataTable will populate this -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal: View Message Details -->
<div class="modal fade" id="modalDetalles" tabindex="-1" aria-labelledby="modalDetallesLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalDetallesLabel">
                    <i class="fas fa-info-circle"></i> Detalle del Mensaje Receptor
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Message Information -->
                <div class="card mb-3">
                    <div class="card-header bg-info text-white">
                        <h6 class="mb-0"><i class="fas fa-file-alt"></i> Información del Mensaje</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>Clave Mensaje:</strong> <span id="detalleClaveMensaje" class="font-monospace small"></span></p>
                                <p><strong>Consecutivo:</strong> <span id="detalleConsecutivo"></span></p>
                                <p><strong>Tipo Mensaje:</strong> <span id="detalleTipoMensaje" class="badge"></span></p>
                                <p><strong>Código Mensaje:</strong> <span id="detalleCodigoMensaje"></span></p>
                                <p><strong>Fecha Emisión:</strong> <span id="detalleFechaEmision"></span></p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>Estado:</strong> <span id="detalleEstado" class="badge"></span></p>
                                <p><strong>Fecha Envío Hacienda:</strong> <span id="detalleFechaEnvio"></span></p>
                                <p><strong>Fecha Respuesta Hacienda:</strong> <span id="detalleFechaRespuesta"></span></p>
                                <p><strong>Monto Aceptado:</strong> <span id="detalleMontoAceptado"></span></p>
                                <p><strong>Impuesto Aceptado:</strong> <span id="detalleImpuestoAceptado"></span></p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <p><strong>Detalle Mensaje:</strong></p>
                                <div class="alert alert-secondary" id="detalleDetalleMensaje"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Hacienda Response -->
                <div class="card mb-3">
                    <div class="card-header bg-success text-white">
                        <h6 class="mb-0"><i class="fas fa-reply"></i> Respuesta de Hacienda</h6>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-info" id="detalleMensajeHacienda"></div>
                    </div>
                </div>

                <!-- Related Document -->
                <div class="card">
                    <div class="card-header bg-warning text-dark">
                        <h6 class="mb-0"><i class="fas fa-file-invoice"></i> Documento Relacionado</h6>
                    </div>
                    <div class="card-body">
                        <p><strong>Clave Documento:</strong> <span id="detalleClaveDocumento" class="font-monospace small"></span></p>
                        <a id="linkVerDocumento" href="#" class="btn btn-sm btn-primary" target="_blank">
                            <i class="fas fa-external-link-alt"></i> Ver Documento Original
                        </a>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cerrar
                </button>
                <button type="button" class="btn btn-primary" onclick="downloadXML()">
                    <i class="fas fa-download"></i> Descargar XML
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;
        let currentMensajeId = null;
        const empresaId = '@Model.EmpresaId';

        $(document).ready(function () {
            loadDataTable();
            initializeDateFilters();
        });

        function initializeDateFilters() {
            // Set default date range (last 30 days)
            const today = new Date();
            const thirtyDaysAgo = new Date(today);
            thirtyDaysAgo.setDate(today.getDate() - 30);

            $('#filterFechaFin').val(today.toISOString().split('T')[0]);
            $('#filterFechaInicio').val(thirtyDaysAgo.toISOString().split('T')[0]);
        }

        function loadDataTable() {
            if (table) {
                table.destroy();
            }

            table = $('#tableMensajesReceptor').DataTable({
                ajax: {
                    url: '?handler=Data',
                    type: 'GET',
                    headers: {
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    },
                    data: function (d) {
                        d.empresaId = empresaId;
                        d.fechaInicio = $('#filterFechaInicio').val();
                        d.fechaFin = $('#filterFechaFin').val();
                        d.tipoMensaje = $('#filterTipoMensaje').val();
                        d.estado = $('#filterEstado').val();
                    },
                    dataSrc: 'data'
                },
                columns: [
                    {
                        data: 'claveMensaje',
                        render: function (data) {
                            return '<span class="font-monospace small">' + (data || '') + '</span>';
                        }
                    },
                    {
                        data: 'documentoOriginal',
                        render: function (data) {
                            if (data && data.clave) {
                                return '<span class="font-monospace small">' + data.clave + '</span>';
                            }
                            return '<span class="text-muted">N/A</span>';
                        }
                    },
                    {
                        data: 'tipoMensaje',
                        render: function (data) {
                            return getTipoMensajeBadge(data);
                        }
                    },
                    {
                        data: 'fechaEmision',
                        render: function (data) {
                            if (data) {
                                return new Date(data).toLocaleString('es-CR');
                            }
                            return '<span class="text-muted">N/A</span>';
                        }
                    },
                    {
                        data: 'estado',
                        render: function (data) {
                            return getEstadoBadge(data);
                        }
                    },
                    {
                        data: 'mensajeHacienda',
                        render: function (data) {
                            if (data && data.length > 50) {
                                return data.substring(0, 50) + '...';
                            }
                            return data || '<span class="text-muted">Sin mensaje</span>';
                        }
                    },
                    {
                        data: 'id',
                        orderable: false,
                        render: function (data, type, row) {
                            let buttons = `
                                <button class="btn btn-sm btn-info" onclick="viewDetails('${data}')" title="Ver Detalles">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button class="btn btn-sm btn-primary" onclick="downloadXMLById('${data}')" title="Descargar XML">
                                    <i class="fas fa-download"></i>
                                </button>
                            `;

                            // Add resend button if message was rejected
                            if (row.estado === 'Rechazado') {
                                buttons += `
                                    <button class="btn btn-sm btn-warning" onclick="resendMessage('${data}')" title="Reenviar">
                                        <i class="fas fa-redo"></i>
                                    </button>
                                `;
                            }

                            // Add verify status button if message is processing
                            if (row.estado === 'Procesando') {
                                buttons += `
                                    <button class="btn btn-sm btn-info" onclick="verificarEstado('${data}')" title="Verificar estado en Hacienda">
                                        <i class="fas fa-sync-alt"></i>
                                    </button>
                                `;
                            }

                            return buttons;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'
                },
                responsive: true,
                order: [[3, 'desc']], // Order by fecha emisión descending
                pageLength: 25,
                processing: true
            });
        }

        function getTipoMensajeBadge(tipo) {
            switch (tipo) {
                case 1:
                    return '<span class="badge bg-success"><i class="fas fa-check"></i> Aceptación</span>';
                case 2:
                    return '<span class="badge bg-warning text-dark"><i class="fas fa-exclamation-triangle"></i> Aceptación Parcial</span>';
                case 3:
                    return '<span class="badge bg-danger"><i class="fas fa-times"></i> Rechazo</span>';
                default:
                    return '<span class="badge bg-secondary">Desconocido</span>';
            }
        }

        function getEstadoBadge(estado) {
            switch (estado) {
                case 'Aceptado':
                    return '<span class="badge bg-success"><i class="fas fa-check-circle"></i> Aceptado</span>';
                case 'Rechazado':
                    return '<span class="badge bg-danger"><i class="fas fa-times-circle"></i> Rechazado</span>';
                case 'Pendiente':
                    return '<span class="badge bg-warning text-dark"><i class="fas fa-clock"></i> Pendiente</span>';
                default:
                    return '<span class="badge bg-secondary">' + (estado || 'Desconocido') + '</span>';
            }
        }

        function applyFilters() {
            table.ajax.reload();
        }

        function clearFilters() {
            $('#filterFechaInicio').val('');
            $('#filterFechaFin').val('');
            $('#filterTipoMensaje').val('');
            $('#filterEstado').val('');
            initializeDateFilters();
            table.ajax.reload();
        }

        function viewDetails(id) {
            currentMensajeId = id;

            $.ajax({
                url: '?handler=Details&id=' + id,
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.success && response.data) {
                        const msg = response.data;

                        // Fill modal with data
                        $('#detalleClaveMensaje').text(msg.claveMensaje || 'N/A');
                        $('#detalleConsecutivo').text(msg.numeroConsecutivo || 'N/A');
                        $('#detalleTipoMensaje').html(getTipoMensajeBadge(msg.tipoMensaje));
                        $('#detalleCodigoMensaje').text(msg.codigoMensaje || 'N/A');
                        $('#detalleFechaEmision').text(msg.fechaEmision ? new Date(msg.fechaEmision).toLocaleString('es-CR') : 'N/A');
                        $('#detalleEstado').html(getEstadoBadge(msg.estado));
                        $('#detalleFechaEnvio').text(msg.fechaEnvioHacienda ? new Date(msg.fechaEnvioHacienda).toLocaleString('es-CR') : 'N/A');
                        $('#detalleFechaRespuesta').text(msg.fechaRespuestaHacienda ? new Date(msg.fechaRespuestaHacienda).toLocaleString('es-CR') : 'N/A');
                        $('#detalleMontoAceptado').text(msg.montoTotalAceptado ? formatCurrency(msg.montoTotalAceptado) : 'N/A');
                        $('#detalleImpuestoAceptado').text(msg.montoTotalImpuestoAceptado ? formatCurrency(msg.montoTotalImpuestoAceptado) : 'N/A');
                        $('#detalleDetalleMensaje').text(msg.detalleMensaje || 'Sin detalle');
                        $('#detalleMensajeHacienda').text(msg.mensajeHacienda || 'Sin respuesta de Hacienda');

                        // Related document
                        if (msg.documentoOriginal) {
                            $('#detalleClaveDocumento').text(msg.documentoOriginal.clave || 'N/A');
                            $('#linkVerDocumento').attr('href', '/DocumentosElectronicos/DocumentoDetalle?id=' + msg.documentoOriginalId);
                        } else {
                            $('#detalleClaveDocumento').text('N/A');
                            $('#linkVerDocumento').hide();
                        }

                        $('#modalDetalles').modal('show');
                    } else {
                        Swal.fire('Error', response.message || 'No se pudo obtener los detalles del mensaje', 'error');
                    }
                },
                error: function () {
                    Swal.fire('Error', 'Ocurrió un error al obtener los detalles', 'error');
                }
            });
        }

        function downloadXML() {
            if (currentMensajeId) {
                downloadXMLById(currentMensajeId);
            }
        }

        function downloadXMLById(id) {
            window.location.href = '?handler=Xml&id=' + id;
        }

        function verificarEstado(id) {
            $.ajax({
                url: '?handler=VerificarEstado&id=' + id,
                type: 'POST',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                beforeSend: function() {
                    Swal.fire({ title: 'Consultando Hacienda...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                },
                success: function (response) {
                    Swal.close();
                    var estado = response.estado || 'Desconocido';
                    var msg = response.mensaje || 'Consulta completada';
                    if (estado === 'Aceptado') {
                        Swal.fire('Aceptado', msg, 'success');
                    } else if (estado === 'Rechazado') {
                        Swal.fire('Rechazado', msg, 'error');
                    } else {
                        Swal.fire('En Proceso', msg, 'info');
                    }
                    table.ajax.reload();
                },
                error: function () {
                    Swal.close();
                    showError('Error al consultar estado en Hacienda');
                }
            });
        }

        function resendMessage(id) {
            Swal.fire({
                title: '¿Reenviar mensaje?',
                text: "Se volverá a enviar este mensaje receptor a Hacienda",
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Sí, reenviar',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#6c757d'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '?handler=Reenviar&id=' + id,
                        type: 'POST',
                        headers: {
                            "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire('Éxito', response.message, 'success');
                                table.ajax.reload();
                            } else {
                                Swal.fire('Error', response.message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Error', 'Ocurrió un error al reenviar el mensaje', 'error');
                        }
                    });
                }
            });
        }

        function formatCurrency(value) {
            return new Intl.NumberFormat('es-CR', {
                style: 'currency',
                currency: 'CRC',
                minimumFractionDigits: 2
            }).format(value);
        }
    </script>
}
