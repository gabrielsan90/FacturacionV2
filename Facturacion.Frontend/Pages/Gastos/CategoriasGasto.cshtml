@page
@model Facturacion.Frontend.Pages.Gastos.CategoriasGastoModel
@{
    ViewData["Title"] = "Categorías de Gasto";
    ViewData["Breadcrumb"] = "Categorías de Gasto";
}

@Html.AntiForgeryToken()

<!-- Page Header -->
<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h2><i class="fas fa-folder-open"></i> Categorías de Gasto</h2>
            <p class="mb-0">Organiza tus gastos en categorías para mejor control y clasificación</p>
        </div>
        <button class="btn btn-primary" onclick="openCreateModal()">
            <i class="fas fa-plus me-2"></i>Nueva Categoría
        </button>
    </div>
</div>

<div class="card shadow-custom">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <strong>Listado de Categorías de Gasto</strong>
                <span class="badge bg-secondary ms-2" id="badgeTotalCategorias">0</span>
            </div>
            <div class="btn-group btn-group-sm" role="group">
                <button type="button" class="btn btn-outline-success" onclick="descargarPlantilla()" title="Descargar plantilla Excel">
                    <i class="fas fa-download"></i> Plantilla
                </button>
                <button type="button" class="btn btn-outline-success" onclick="$('#fileImport').click()" title="Importar desde Excel">
                    <i class="fas fa-file-import"></i> Importar
                </button>
                <input type="file" id="fileImport" accept=".xlsx,.xls" style="display:none;" onchange="importarExcel(this)" />
            </div>
        </div>
    </div>
    <div class="card-body">
        <!-- Loading State -->
        <div id="tableCategoriasLoader" class="text-center py-5">
            <div class="spinner-modern mx-auto"></div>
            <p class="text-muted mt-3">Cargando categorías...</p>
        </div>

        <!-- Table Container -->
        <div id="tableCategoriasContainer" style="display: none;">
            <table id="tableCategoriasGasto" class="table table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Estado</th>
                        <th style="width: 120px;">Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <!-- Empty State -->
        <div id="emptyStateCategorias" class="empty-state" style="display: none;">
            <div class="empty-state-icon">
                <i class="fas fa-folder-open"></i>
            </div>
            <h3 class="empty-state-title">No hay categorías de gasto registradas</h3>
            <p class="empty-state-description">Crea categorías para clasificar y organizar tus gastos empresariales</p>
            <button class="btn btn-primary" onclick="openCreateModal()">
                <i class="fas fa-plus me-2"></i>Crear Primera Categoría
            </button>
        </div>
    </div>
</div>

<!-- Modal Create/Edit -->
<div class="modal fade" id="modalCategoriaGasto" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">
                    <i class="fas fa-folder-open me-2 text-primary"></i>Nueva Categoría de Gasto
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="formCategoriaGasto">
                <div class="modal-body">
                    <input type="hidden" id="CategoriaGasto_Id" value="0" />

                    <div class="mb-3">
                        <label class="form-label">Nombre <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="CategoriaGasto_Nombre" maxlength="100" required />
                        <div class="invalid-feedback">El nombre es obligatorio.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Descripción</label>
                        <textarea class="form-control" id="CategoriaGasto_Descripcion" rows="3" maxlength="500"></textarea>
                        <small class="text-muted">Descripción opcional de la categoría (máximo 500 caracteres).</small>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="CategoriaGasto_Activa" checked />
                        <label class="form-check-label" for="CategoriaGasto_Activa">
                            Categoría Activa
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-1"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let table;

    $(document).ready(function() {
        loadDataTable();
        setupFormSubmit();
    });

    function loadDataTable() {
        table = initDataTable('#tableCategoriasGasto', {
            ajax: {
                url: '?handler=Data',
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                dataSrc: function(json) {
                    // Hide loader
                    $('#tableCategoriasLoader').hide();

                    // Get data array
                    const data = json.data || json || [];

                    // Update badge count
                    $('#badgeTotalCategorias').text(data.length);

                    // Show appropriate state
                    if (data.length > 0) {
                        $('#tableCategoriasContainer').show();
                        $('#emptyStateCategorias').hide();
                    } else {
                        $('#tableCategoriasContainer').hide();
                        $('#emptyStateCategorias').show();
                    }

                    return data;
                },
                error: function(xhr, error, code) {
                    $('#tableCategoriasLoader').hide();
                    $('#tableCategoriasContainer').hide();
                    $('#emptyStateCategorias').show();
                    $('#badgeTotalCategorias').text('0');
                    console.error('Error loading categorías de gasto:', error);
                    handleAjaxError(xhr);
                }
            },
            columns: [
                { data: 'id', visible: false },
                { data: 'nombre' },
                {
                    data: 'descripcion',
                    render: function(data) {
                        return data || '<span class="text-muted">-</span>';
                    }
                },
                {
                    data: 'activa',
                    render: function(data) {
                        return data
                            ? '<span class="badge bg-success">Activa</span>'
                            : '<span class="badge bg-secondary">Inactiva</span>';
                    }
                },
                {
                    data: 'id',
                    orderable: false,
                    render: function(data, type, row) {
                        return `
                            <button class="btn btn-sm btn-info" onclick="edit(${data})" title="Editar">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-sm btn-danger" onclick="deleteRecord(${data}, '${escapeHtml(row.nombre)}')" title="Eliminar">
                                <i class="fas fa-trash"></i>
                            </button>
                        `;
                    }
                }
            ],
            order: [[1, 'asc']]
        });
    }

    function setupFormSubmit() {
        $('#formCategoriaGasto').on('submit', function(e) {
            e.preventDefault();
            if (this.checkValidity()) {
                save();
            } else {
                $(this).addClass('was-validated');
            }
        });
    }

    function openCreateModal() {
        $('#formCategoriaGasto')[0].reset();
        $('#formCategoriaGasto').removeClass('was-validated');
        $('#CategoriaGasto_Id').val('0');
        $('#CategoriaGasto_Activa').prop('checked', true);
        $('#modalTitle').html('<i class="fas fa-folder-open me-2 text-primary"></i>Nueva Categoría de Gasto');
        $('#modalCategoriaGasto').modal('show');
    }

    function edit(id) {
        $.ajax({
            url: '?handler=Details&id=' + id,
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success && response.data) {
                    $('#CategoriaGasto_Id').val(response.data.id);
                    $('#CategoriaGasto_Nombre').val(response.data.nombre);
                    $('#CategoriaGasto_Descripcion').val(response.data.descripcion || '');
                    $('#CategoriaGasto_Activa').prop('checked', response.data.activa);
                    $('#modalTitle').html('<i class="fas fa-folder-open me-2 text-primary"></i>Editar Categoría de Gasto');
                    $('#formCategoriaGasto').removeClass('was-validated');
                    $('#modalCategoriaGasto').modal('show');
                } else {
                    showError(response.message || 'Error al cargar la categoría');
                }
            },
            error: function(xhr) {
                handleAjaxError(xhr);
            }
        });
    }

    function save() {
        const data = {
            id: parseInt($('#CategoriaGasto_Id').val()) || 0,
            nombre: $('#CategoriaGasto_Nombre').val(),
            descripcion: $('#CategoriaGasto_Descripcion').val() || null,
            activa: $('#CategoriaGasto_Activa').is(':checked')
        };

        $.ajax({
            url: '?handler=Save',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(data),
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success) {
                    showSuccess(response.message);
                    $('#modalCategoriaGasto').modal('hide');
                    table.ajax.reload();
                } else {
                    showError(response.message || 'Error al guardar la categoría');
                }
            },
            error: function(xhr) {
                handleAjaxError(xhr);
            }
        });
    }

    function deleteRecord(id, nombre) {
        confirmDelete(`¿Está seguro de eliminar la categoría de gasto "${nombre}"?`, function() {
            $.ajax({
                url: '?handler=Delete&id=' + id,
                type: 'POST',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        showSuccess(response.message);
                        table.ajax.reload();
                    } else {
                        showError(response.message || 'Error al eliminar la categoría');
                    }
                },
                error: function(xhr) {
                    handleAjaxError(xhr);
                }
            });
        });
    }

    // Helper function to escape HTML in strings
    function escapeHtml(text) {
        if (!text) return '';
        var map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return text.replace(/[&<>"']/g, function(m) { return map[m]; });
    }

    function descargarPlantilla() {
        window.location.href = '?handler=Plantilla';
    }

    function importarExcel(input) {
        if (input.files && input.files[0]) {
            const file = input.files[0];
            const formData = new FormData();
            formData.append('file', file);

            Swal.fire({
                title: 'Importando...',
                html: 'Por favor espere mientras se procesan los datos.',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            $.ajax({
                url: '?handler=Importar',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    Swal.close();
                    if (response.success) {
                        let message = response.message;
                        if (response.totalImportados > 0) {
                            message += `<br><br><strong>Importados:</strong> ${response.totalImportados}`;
                        }
                        if (response.totalErrores > 0) {
                            message += `<br><strong>Errores:</strong> ${response.totalErrores}`;
                            if (response.errores && response.errores.length > 0) {
                                message += '<br><br><strong>Detalle de errores:</strong><ul class="text-start small">';
                                response.errores.slice(0, 10).forEach(function(err) {
                                    message += `<li>${err}</li>`;
                                });
                                if (response.errores.length > 10) {
                                    message += `<li>... y ${response.errores.length - 10} errores más</li>`;
                                }
                                message += '</ul>';
                            }
                        }
                        Swal.fire({
                            icon: response.totalErrores > 0 ? 'warning' : 'success',
                            title: response.totalErrores > 0 ? 'Importación con advertencias' : 'Importación exitosa',
                            html: message
                        });
                        table.ajax.reload();
                    } else {
                        showError(response.message || 'Error al importar los datos');
                    }
                },
                error: function(xhr) {
                    Swal.close();
                    handleAjaxError(xhr);
                },
                complete: function() {
                    input.value = '';
                }
            });
        }
    }
</script>
}
