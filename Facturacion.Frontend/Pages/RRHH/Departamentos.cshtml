@page
@model Facturacion.Frontend.Pages.RRHH.DepartamentosModel
@{
    ViewData["Title"] = "Departamentos";
    ViewData["Breadcrumb"] = "Departamentos";
}

<!-- Page Header -->
<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <h2><i class="fas fa-sitemap"></i> Departamentos</h2>
            <p class="mb-0">Gestión de departamentos organizacionales</p>
        </div>
        <button class="btn btn-primary" onclick="openCreateModal()" aria-label="Crear nuevo departamento">
            <i class="fas fa-plus me-2"></i>Nuevo Departamento
        </button>
    </div>
</div>

<!-- Departamentos Table Card -->
<div class="card shadow-custom">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <i class="fas fa-table me-2 text-primary"></i>
            <strong>Listado de Departamentos</strong>
            <span class="badge bg-secondary ms-2" id="badgeTotalDepartamentos">0</span>
        </div>
        <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="btn btn-outline-success" onclick="generarCatalogo()" title="Generar catálogo predefinido">
                <i class="fas fa-magic"></i> Generar Catálogo
            </button>
            <button type="button" class="btn btn-outline-primary" onclick="refrescarTabla()" title="Refrescar tabla">
                <i class="fas fa-sync-alt"></i>
            </button>
        </div>
    </div>
    <div class="card-body">
        <!-- Loading State -->
        <div id="tableDepartamentosLoader" class="text-center py-5">
            <div class="spinner-modern mx-auto"></div>
            <p class="text-muted mt-3">Cargando departamentos...</p>
        </div>

        <!-- Table -->
        <div class="table-responsive" id="tableDepartamentosContainer" style="display:none;">
            <table id="tableDepartamentos" class="table table-hover">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Empleados</th>
                        <th>Estado</th>
                        <th style="width: 120px;">Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <!-- Empty State -->
        <div id="emptyStateDepartamentos" class="empty-state" style="display:none;">
            <div class="empty-state-icon">
                <i class="fas fa-sitemap"></i>
            </div>
            <h3 class="empty-state-title">No hay departamentos registrados</h3>
            <p class="empty-state-description">Comienza agregando tu primer departamento</p>
            <button class="btn btn-primary" onclick="openCreateModal()">
                <i class="fas fa-plus me-2"></i>Crear Primer Departamento
            </button>
        </div>
    </div>
</div>

<!-- Modal Create/Edit -->
<div class="modal fade" id="modalDepartamento" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitle">Nuevo Departamento</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="formDepartamento" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="Departamento_Id" value="00000000-0000-0000-0000-000000000000" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Código <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="Departamento_Codigo" maxlength="10" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Nombre <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="Departamento_Nombre" maxlength="100" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Descripción</label>
                        <textarea class="form-control" id="Departamento_Descripcion" rows="3" maxlength="500"></textarea>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="Departamento_Activo" checked />
                        <label class="form-check-label" for="Departamento_Activo">
                            Departamento Activo
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-1"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let table;
    const empresaId = '@Model.EmpresaId';

    $(document).ready(function() {
        loadDataTable();
        setupFormSubmit();
    });

    function loadDataTable() {
        table = initDataTable('#tableDepartamentos', {
            ajax: {
                url: '?handler=Data',
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                dataSrc: function(json) {
                    $('#tableDepartamentosLoader').hide();
                    const data = json.data || json || [];
                    $('#badgeTotalDepartamentos').text(data.length);

                    if (data.length > 0) {
                        $('#tableDepartamentosContainer').show();
                        $('#emptyStateDepartamentos').hide();
                    } else {
                        $('#tableDepartamentosContainer').hide();
                        $('#emptyStateDepartamentos').show();
                    }
                    return data;
                },
                error: function(xhr, error, code) {
                    $('#tableDepartamentosLoader').hide();
                    $('#tableDepartamentosContainer').hide();
                    $('#emptyStateDepartamentos').show();
                    $('#badgeTotalDepartamentos').text('0');
                }
            },
            columns: [
                { data: 'codigo' },
                { data: 'nombre' },
                {
                    data: 'descripcion',
                    render: function(data) {
                        return data || '<span class="text-muted">-</span>';
                    }
                },
                {
                    data: 'empleados',
                    render: function(data) {
                        const count = data ? data.length : 0;
                        return `<span class="badge bg-info">${count}</span>`;
                    }
                },
                {
                    data: 'activo',
                    render: function(data) {
                        return data
                            ? '<span class="badge bg-success">Activo</span>'
                            : '<span class="badge bg-secondary">Inactivo</span>';
                    }
                },
                {
                    data: 'id',
                    orderable: false,
                    render: function(data) {
                        return `
                            <button class="btn btn-sm btn-info" onclick="edit('${data}')" title="Editar">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-sm btn-danger" onclick="deleteRecord('${data}')" title="Eliminar">
                                <i class="fas fa-trash"></i>
                            </button>
                        `;
                    }
                }
            ],
            order: [[1, 'asc']]
        });
    }

    function setupFormSubmit() {
        $('#formDepartamento').on('submit', function(e) {
            e.preventDefault();
            if (this.checkValidity()) {
                save();
            } else {
                $(this).addClass('was-validated');
            }
        });
    }

    function openCreateModal() {
        $('#formDepartamento')[0].reset();
        $('#formDepartamento').removeClass('was-validated');
        $('#Departamento_Id').val('00000000-0000-0000-0000-000000000000');
        $('#Departamento_Activo').prop('checked', true);
        $('#modalTitle').text('Nuevo Departamento');
        $('#modalDepartamento').modal('show');
    }

    function edit(id) {
        $.ajax({
            url: '?handler=Details&id=' + id,
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success) {
                    const data = response.data;
                    $('#Departamento_Id').val(data.id);
                    $('#Departamento_Codigo').val(data.codigo);
                    $('#Departamento_Nombre').val(data.nombre);
                    $('#Departamento_Descripcion').val(data.descripcion || '');
                    $('#Departamento_Activo').prop('checked', data.activo);

                    $('#modalTitle').text('Editar Departamento');
                    $('#formDepartamento').removeClass('was-validated');
                    $('#modalDepartamento').modal('show');
                } else {
                    Swal.fire('Error', response.message, 'error');
                }
            }
        });
    }

    function save() {
        const departamentoData = {
            id: $('#Departamento_Id').val(),
            empresaId: empresaId,
            codigo: $('#Departamento_Codigo').val(),
            nombre: $('#Departamento_Nombre').val(),
            descripcion: $('#Departamento_Descripcion').val() || null,
            activo: $('#Departamento_Activo').is(':checked')
        };

        $.ajax({
            url: '?handler=Save',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(departamentoData),
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success) {
                    showSuccess(response.message);
                    $('#modalDepartamento').modal('hide');
                    table.ajax.reload();
                } else {
                    showError(response.message);
                }
            },
            error: function(xhr) {
                handleAjaxError(xhr);
            }
        });
    }

    function deleteRecord(id) {
        confirmDelete('Esta acción no se puede revertir', function() {
            $.ajax({
                url: '?handler=Delete&id=' + id,
                type: 'POST',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        showSuccess(response.message);
                        table.ajax.reload();
                    } else {
                        showError(response.message);
                    }
                },
                error: function(xhr) {
                    handleAjaxError(xhr);
                }
            });
        });
    }

    function refrescarTabla() {
        $('#tableDepartamentosLoader').show();
        $('#tableDepartamentosContainer').hide();
        $('#emptyStateDepartamentos').hide();
        table.ajax.reload();
    }

    function generarCatalogo() {
        Swal.fire({
            title: 'Generar Catálogo Predefinido',
            html: '<p>Esta acción creará <strong>15 departamentos</strong> predefinidos:</p>' +
                  '<ul class="text-start small">' +
                  '<li>Gerencia General, Administración, Finanzas</li>' +
                  '<li>Recursos Humanos, Ventas, Mercadeo</li>' +
                  '<li>Operaciones, Tecnología, Legal</li>' +
                  '<li>Control de Calidad, Compras, Bodega</li>' +
                  '<li>Mantenimiento, Seguridad, Atención al Cliente</li>' +
                  '</ul>' +
                  '<p class="text-warning mb-0"><i class="fas fa-exclamation-triangle me-1"></i>Solo funciona si no hay departamentos existentes.</p>',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#28a745',
            cancelButtonColor: '#6c757d',
            confirmButtonText: '<i class="fas fa-magic me-1"></i> Generar',
            cancelButtonText: 'Cancelar'
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({
                    title: 'Generando catálogo...',
                    allowOutsideClick: false,
                    didOpen: () => { Swal.showLoading(); }
                });

                $.ajax({
                    url: '?handler=GenerarCatalogo',
                    type: 'POST',
                    headers: {
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        Swal.close();
                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Catálogo Generado',
                                text: response.message
                            });
                            table.ajax.reload();
                        } else {
                            showError(response.message);
                        }
                    },
                    error: function(xhr) {
                        Swal.close();
                        handleAjaxError(xhr);
                    }
                });
            }
        });
    }
</script>
}
