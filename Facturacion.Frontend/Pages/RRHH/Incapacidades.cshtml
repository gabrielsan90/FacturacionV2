@page
@model Facturacion.Frontend.Pages.RRHH.IncapacidadesModel
@{
    ViewData["Title"] = "Incapacidades";
    ViewData["Breadcrumb"] = "Incapacidades";
}

<!-- Page Header -->
<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <h2><i class="fas fa-file-medical"></i> Incapacidades</h2>
            <p class="mb-0">Registro y control de incapacidades médicas</p>
        </div>
        <button class="btn btn-primary" onclick="openCreateModal()" aria-label="Registrar incapacidad">
            <i class="fas fa-plus me-2"></i>Registrar Incapacidad
        </button>
    </div>
</div>

<!-- Incapacidades Table Card -->
<div class="card shadow-custom">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <i class="fas fa-table me-2 text-primary"></i>
            <strong>Listado de Incapacidades</strong>
            <span class="badge bg-secondary ms-2" id="badgeTotalIncapacidades">0</span>
        </div>
        <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="btn btn-outline-primary" onclick="refrescarTabla()" title="Refrescar tabla">
                <i class="fas fa-sync-alt"></i>
            </button>
        </div>
    </div>
    <div class="card-body">
        <!-- Loading State -->
        <div id="tableIncapacidadesLoader" class="text-center py-5">
            <div class="spinner-modern mx-auto"></div>
            <p class="text-muted mt-3">Cargando incapacidades...</p>
        </div>

        <!-- Table -->
        <div class="table-responsive" id="tableIncapacidadesContainer" style="display:none;">
            <table id="tableIncapacidades" class="table table-hover">
                <thead>
                    <tr>
                        <th>Empleado</th>
                        <th>Fecha Inicio</th>
                        <th>Fecha Fin</th>
                        <th>Días</th>
                        <th>Tipo</th>
                        <th>Núm. Referencia</th>
                        <th style="width: 120px;">Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <!-- Empty State -->
        <div id="emptyStateIncapacidades" class="empty-state" style="display:none;">
            <div class="empty-state-icon">
                <i class="fas fa-file-medical"></i>
            </div>
            <h3 class="empty-state-title">No hay incapacidades registradas</h3>
            <p class="empty-state-description">Comienza registrando una incapacidad</p>
            <button class="btn btn-primary" onclick="openCreateModal()">
                <i class="fas fa-plus me-2"></i>Registrar Primera Incapacidad
            </button>
        </div>
    </div>
</div>

<!-- Modal Create/Edit -->
<div class="modal fade" id="modalIncapacidad" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitle">Registrar Incapacidad</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="formIncapacidad" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="Incapacidad_Id" value="00000000-0000-0000-0000-000000000000" />

                    <div class="mb-3">
                        <label class="form-label">Empleado <span class="text-danger">*</span></label>
                        <select class="form-select" id="Incapacidad_EmpleadoId" required></select>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Tipo <span class="text-danger">*</span></label>
                            <select class="form-select" id="Incapacidad_Tipo" required>
                                <option value="ENF">Enfermedad</option>
                                <option value="MAT">Maternidad</option>
                                <option value="PAT">Paternidad</option>
                                <option value="RIE">Riesgo de Trabajo</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Fecha Inicio <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="Incapacidad_FechaInicio" required />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Fecha Fin <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="Incapacidad_FechaFin" required />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Días</label>
                            <input type="number" class="form-control" id="Incapacidad_Dias" readonly />
                            <small class="text-muted">Se calculará automáticamente</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Número de Referencia</label>
                            <input type="text" class="form-control" id="Incapacidad_NumeroDocumento" maxlength="50" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Institución Emisora</label>
                        <input type="text" class="form-control" id="Incapacidad_InstitucionEmisora" maxlength="200" placeholder="CCSS, INS, etc." />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Diagnóstico</label>
                        <textarea class="form-control" id="Incapacidad_Diagnostico" rows="2" maxlength="500"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Observaciones</label>
                        <textarea class="form-control" id="Incapacidad_Observaciones" rows="3" maxlength="1000"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-1"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let table;
    const empresaId = '@Model.EmpresaId';

    $(document).ready(function() {
        loadDataTable();
        setupFormSubmit();
        loadEmpleados();
        setupDateCalculation();
    });

    function loadDataTable() {
        table = initDataTable('#tableIncapacidades', {
            ajax: {
                url: '?handler=Data',
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                dataSrc: function(json) {
                    $('#tableIncapacidadesLoader').hide();
                    const data = json.data || json || [];
                    $('#badgeTotalIncapacidades').text(data.length);

                    if (data.length > 0) {
                        $('#tableIncapacidadesContainer').show();
                        $('#emptyStateIncapacidades').hide();
                    } else {
                        $('#tableIncapacidadesContainer').hide();
                        $('#emptyStateIncapacidades').show();
                    }
                    return data;
                },
                error: function(xhr, error, code) {
                    $('#tableIncapacidadesLoader').hide();
                    $('#tableIncapacidadesContainer').hide();
                    $('#emptyStateIncapacidades').show();
                    $('#badgeTotalIncapacidades').text('0');
                }
            },
            columns: [
                {
                    data: 'empleado',
                    render: function(data) {
                        return data ? data.nombreCompleto : '-';
                    }
                },
                {
                    data: 'fechaInicio',
                    render: function(data) {
                        return new Date(data).toLocaleDateString('es-CR', {day: '2-digit', month: '2-digit', year: 'numeric'});
                    }
                },
                {
                    data: 'fechaFin',
                    render: function(data) {
                        return new Date(data).toLocaleDateString('es-CR', {day: '2-digit', month: '2-digit', year: 'numeric'});
                    }
                },
                {
                    data: 'dias',
                    render: function(data) {
                        return `<span class="badge bg-warning">${data} días</span>`;
                    }
                },
                {
                    data: 'tipo',
                    render: function(data) {
                        const tipos = {
                            'ENF': '<span class="badge bg-danger">Enfermedad</span>',
                            'MAT': '<span class="badge bg-info">Maternidad</span>',
                            'PAT': '<span class="badge bg-primary">Paternidad</span>',
                            'RIE': '<span class="badge bg-warning">Riesgo Trabajo</span>'
                        };
                        return tipos[data] || data;
                    }
                },
                {
                    data: 'numeroDocumento',
                    render: function(data) {
                        return data || '<span class="text-muted">-</span>';
                    }
                },
                {
                    data: 'id',
                    orderable: false,
                    render: function(data) {
                        return `
                            <button class="btn btn-sm btn-info" onclick="edit('${data}')" title="Editar">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-sm btn-danger" onclick="deleteRecord('${data}')" title="Eliminar">
                                <i class="fas fa-trash"></i>
                            </button>
                        `;
                    }
                }
            ],
            order: [[1, 'desc']]
        });
    }

    function setupFormSubmit() {
        $('#formIncapacidad').on('submit', function(e) {
            e.preventDefault();
            if (this.checkValidity()) {
                save();
            } else {
                $(this).addClass('was-validated');
            }
        });
    }

    function setupDateCalculation() {
        $('#Incapacidad_FechaInicio, #Incapacidad_FechaFin').on('change', function() {
            calculateDays();
        });
    }

    function calculateDays() {
        const inicio = new Date($('#Incapacidad_FechaInicio').val());
        const fin = new Date($('#Incapacidad_FechaFin').val());

        if (inicio && fin && fin >= inicio) {
            const diffTime = Math.abs(fin - inicio);
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;
            $('#Incapacidad_Dias').val(diffDays);
        } else {
            $('#Incapacidad_Dias').val(0);
        }
    }

    function loadEmpleados() {
        $.ajax({
            url: '?handler=Empleados',
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                const select = $('#Incapacidad_EmpleadoId');
                select.empty().append('<option value="">Seleccione...</option>');
                const data = response.data || response;
                data.forEach(item => {
                    select.append(`<option value="${item.id}">${item.nombreCompleto || item.nombre}</option>`);
                });
            }
        });
    }

    function openCreateModal() {
        $('#formIncapacidad')[0].reset();
        $('#formIncapacidad').removeClass('was-validated');
        $('#Incapacidad_Id').val('00000000-0000-0000-0000-000000000000');
        $('#Incapacidad_Tipo').val('ENF');
        $('#modalTitle').text('Registrar Incapacidad');
        $('#modalIncapacidad').modal('show');
    }

    function edit(id) {
        $.ajax({
            url: '?handler=Details&id=' + id,
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success) {
                    const data = response.data;
                    $('#Incapacidad_Id').val(data.id);
                    $('#Incapacidad_EmpleadoId').val(data.empleadoId);
                    $('#Incapacidad_Tipo').val(data.tipo);
                    $('#Incapacidad_FechaInicio').val(data.fechaInicio.split('T')[0]);
                    $('#Incapacidad_FechaFin').val(data.fechaFin.split('T')[0]);
                    $('#Incapacidad_Dias').val(data.dias);
                    $('#Incapacidad_NumeroDocumento').val(data.numeroDocumento || '');
                    $('#Incapacidad_InstitucionEmisora').val(data.institucionEmisora || '');
                    $('#Incapacidad_Diagnostico').val(data.diagnostico || '');
                    $('#Incapacidad_Observaciones').val(data.observaciones || '');

                    $('#modalTitle').text('Editar Incapacidad');
                    $('#formIncapacidad').removeClass('was-validated');
                    $('#modalIncapacidad').modal('show');
                } else {
                    Swal.fire('Error', response.message, 'error');
                }
            }
        });
    }

    function save() {
        const incapacidadData = {
            id: $('#Incapacidad_Id').val(),
            empleadoId: $('#Incapacidad_EmpleadoId').val(),
            tipo: $('#Incapacidad_Tipo').val(),
            fechaInicio: $('#Incapacidad_FechaInicio').val(),
            fechaFin: $('#Incapacidad_FechaFin').val(),
            dias: parseInt($('#Incapacidad_Dias').val()),
            numeroDocumento: $('#Incapacidad_NumeroDocumento').val() || null,
            institucionEmisora: $('#Incapacidad_InstitucionEmisora').val() || null,
            diagnostico: $('#Incapacidad_Diagnostico').val() || null,
            observaciones: $('#Incapacidad_Observaciones').val() || null
        };

        $.ajax({
            url: '?handler=Save',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(incapacidadData),
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success) {
                    showSuccess(response.message);
                    $('#modalIncapacidad').modal('hide');
                    table.ajax.reload();
                } else {
                    showError(response.message);
                }
            },
            error: function(xhr) {
                handleAjaxError(xhr);
            }
        });
    }

    function deleteRecord(id) {
        confirmDelete('Esta acción no se puede revertir', function() {
            $.ajax({
                url: '?handler=Delete&id=' + id,
                type: 'POST',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        showSuccess(response.message);
                        table.ajax.reload();
                    } else {
                        showError(response.message);
                    }
                },
                error: function(xhr) {
                    handleAjaxError(xhr);
                }
            });
        });
    }

    function refrescarTabla() {
        $('#tableIncapacidadesLoader').show();
        $('#tableIncapacidadesContainer').hide();
        $('#emptyStateIncapacidades').hide();
        table.ajax.reload();
    }
</script>
}
