@page
@model Facturacion.Frontend.Pages.RRHH.PlanillasModel
@{
    ViewData["Title"] = "Planillas";
    ViewData["Breadcrumb"] = "Planillas";
}

<!-- Page Header -->
<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <h2><i class="fas fa-file-invoice-dollar"></i> Planillas</h2>
            <p class="mb-0">Gestión de planillas de pago</p>
        </div>
        <button class="btn btn-primary" onclick="openCreateModal()" aria-label="Generar nueva planilla">
            <i class="fas fa-plus me-2"></i>Generar Planilla
        </button>
    </div>
</div>

<!-- Planillas Table Card -->
<div class="card shadow-custom">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <i class="fas fa-table me-2 text-primary"></i>
            <strong>Listado de Planillas</strong>
            <span class="badge bg-secondary ms-2" id="badgeTotalPlanillas">0</span>
        </div>
        <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="btn btn-outline-primary" onclick="refrescarTabla()" title="Refrescar tabla">
                <i class="fas fa-sync-alt"></i>
            </button>
        </div>
    </div>
    <div class="card-body">
        <!-- Loading State -->
        <div id="tablePlanillasLoader" class="text-center py-5">
            <div class="spinner-modern mx-auto"></div>
            <p class="text-muted mt-3">Cargando planillas...</p>
        </div>

        <!-- Table -->
        <div class="table-responsive" id="tablePlanillasContainer" style="display:none;">
            <table id="tablePlanillas" class="table table-hover">
                <thead>
                    <tr>
                        <th>Período</th>
                        <th>Tipo</th>
                        <th>Empleados</th>
                        <th>Total Bruto</th>
                        <th>Total Deducciones</th>
                        <th>Total Neto</th>
                        <th>Cargas Patronales</th>
                        <th>Estado</th>
                        <th style="width: 150px;">Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <!-- Empty State -->
        <div id="emptyStatePlanillas" class="empty-state" style="display:none;">
            <div class="empty-state-icon">
                <i class="fas fa-file-invoice-dollar"></i>
            </div>
            <h3 class="empty-state-title">No hay planillas registradas</h3>
            <p class="empty-state-description">Comienza generando tu primera planilla</p>
            <button class="btn btn-primary" onclick="openCreateModal()">
                <i class="fas fa-plus me-2"></i>Generar Primera Planilla
            </button>
        </div>
    </div>
</div>

<!-- Modal Create -->
<div class="modal fade" id="modalPlanilla" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Generar Nueva Planilla</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="formPlanilla" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Año <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="Planilla_Anio" required />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Mes <span class="text-danger">*</span></label>
                            <select class="form-select" id="Planilla_Mes" required>
                                <option value="1">Enero</option>
                                <option value="2">Febrero</option>
                                <option value="3">Marzo</option>
                                <option value="4">Abril</option>
                                <option value="5">Mayo</option>
                                <option value="6">Junio</option>
                                <option value="7">Julio</option>
                                <option value="8">Agosto</option>
                                <option value="9">Septiembre</option>
                                <option value="10">Octubre</option>
                                <option value="11">Noviembre</option>
                                <option value="12">Diciembre</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Período <span class="text-danger">*</span></label>
                            <select class="form-select" id="Planilla_Periodo" required>
                                <option value="1">Primera Quincena</option>
                                <option value="2">Segunda Quincena</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Tipo <span class="text-danger">*</span></label>
                            <select class="form-select" id="Planilla_TipoPlanilla" required>
                                <option value="ORD">Ordinaria</option>
                                <option value="EXT">Extraordinaria</option>
                                <option value="AGU">Aguinaldo</option>
                                <option value="LIQ">Liquidación</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Descripción</label>
                            <input type="text" class="form-control" id="Planilla_Descripcion" maxlength="100" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Fecha Inicio <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="Planilla_FechaInicio" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Fecha Fin <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="Planilla_FechaFin" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-1"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-calculator me-1"></i> Generar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal View Details -->
<div class="modal fade" id="modalDetallePlanilla" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">Detalle de Planilla</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="detallesPlanillaContent"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i> Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let table;
    const empresaId = '@Model.EmpresaId';

    $(document).ready(function() {
        loadDataTable();
        setupFormSubmit();
        setDefaultDates();
    });

    function setDefaultDates() {
        const today = new Date();
        $('#Planilla_Anio').val(today.getFullYear());
        $('#Planilla_Mes').val(today.getMonth() + 1);
    }

    function loadDataTable() {
        table = initDataTable('#tablePlanillas', {
            ajax: {
                url: '?handler=Data',
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                dataSrc: function(json) {
                    $('#tablePlanillasLoader').hide();
                    const data = json.data || json || [];
                    $('#badgeTotalPlanillas').text(data.length);

                    if (data.length > 0) {
                        $('#tablePlanillasContainer').show();
                        $('#emptyStatePlanillas').hide();
                    } else {
                        $('#tablePlanillasContainer').hide();
                        $('#emptyStatePlanillas').show();
                    }
                    return data;
                },
                error: function(xhr, error, code) {
                    $('#tablePlanillasLoader').hide();
                    $('#tablePlanillasContainer').hide();
                    $('#emptyStatePlanillas').show();
                    $('#badgeTotalPlanillas').text('0');
                }
            },
            columns: [
                {
                    data: null,
                    render: function(data) {
                        const meses = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];
                        return `${meses[data.mes - 1]} ${data.anio} - P${data.periodo}`;
                    }
                },
                {
                    data: 'tipoPlanilla',
                    render: function(data) {
                        const tipos = {
                            'ORD': '<span class="badge bg-primary">Ordinaria</span>',
                            'EXT': '<span class="badge bg-info">Extraordinaria</span>',
                            'AGU': '<span class="badge bg-success">Aguinaldo</span>',
                            'LIQ': '<span class="badge bg-warning">Liquidación</span>'
                        };
                        return tipos[data] || data;
                    }
                },
                {
                    data: 'cantidadEmpleados',
                    render: function(data) {
                        return `<span class="badge bg-info">${data || 0}</span>`;
                    }
                },
                {
                    data: 'totalSalarioBruto',
                    render: function(data) {
                        return '₡' + parseFloat(data).toLocaleString('es-CR', {minimumFractionDigits: 2, maximumFractionDigits: 2});
                    }
                },
                {
                    data: 'totalDeducciones',
                    render: function(data) {
                        return '₡' + parseFloat(data).toLocaleString('es-CR', {minimumFractionDigits: 2, maximumFractionDigits: 2});
                    }
                },
                {
                    data: 'totalSalarioNeto',
                    render: function(data) {
                        return '<strong>₡' + parseFloat(data).toLocaleString('es-CR', {minimumFractionDigits: 2, maximumFractionDigits: 2}) + '</strong>';
                    }
                },
                {
                    data: 'totalCargasSociales',
                    render: function(data) {
                        return '₡' + parseFloat(data || 0).toLocaleString('es-CR', {minimumFractionDigits: 2, maximumFractionDigits: 2});
                    }
                },
                {
                    data: 'estado',
                    render: function(data) {
                        const estados = {
                            'BOR': '<span class="badge bg-secondary">Borrador</span>',
                            'CAL': '<span class="badge bg-info">Calculada</span>',
                            'APR': '<span class="badge bg-success">Aprobada</span>',
                            'PAG': '<span class="badge bg-primary">Pagada</span>',
                            'ANU': '<span class="badge bg-danger">Anulada</span>'
                        };
                        return estados[data] || data;
                    }
                },
                {
                    data: 'id',
                    orderable: false,
                    render: function(data, type, row) {
                        let buttons = `
                            <button class="btn btn-sm btn-info" onclick="viewDetails('${data}')" title="Ver Detalle">
                                <i class="fas fa-eye"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-success" onclick="exportarCCSS('${data}')" title="Exportar CCSS (SICERE)">
                                <i class="fas fa-file-excel"></i>
                            </button>
                        `;

                        if (row.estado === 'BOR' || row.estado === 'CAL') {
                            buttons += `
                                <button class="btn btn-sm btn-success" onclick="aprobarPlanilla('${data}')" title="Aprobar">
                                    <i class="fas fa-check"></i>
                                </button>
                            `;
                        }

                        if (row.estado === 'APR') {
                            buttons += `
                                <button class="btn btn-sm btn-primary" onclick="pagarPlanilla('${data}')" title="Marcar como Pagada">
                                    <i class="fas fa-money-bill-wave"></i>
                                </button>
                            `;
                        }

                        if (row.estado === 'BOR') {
                            buttons += `
                                <button class="btn btn-sm btn-danger" onclick="deleteRecord('${data}')" title="Eliminar">
                                    <i class="fas fa-trash"></i>
                                </button>
                            `;
                        }

                        return buttons;
                    }
                }
            ],
            order: [[0, 'desc']]
        });
    }

    function setupFormSubmit() {
        $('#formPlanilla').on('submit', function(e) {
            e.preventDefault();
            if (this.checkValidity()) {
                save();
            } else {
                $(this).addClass('was-validated');
            }
        });
    }

    function openCreateModal() {
        $('#formPlanilla')[0].reset();
        $('#formPlanilla').removeClass('was-validated');
        setDefaultDates();
        $('#Planilla_TipoPlanilla').val('ORD');
        $('#Planilla_Periodo').val('1');
        $('#modalPlanilla').modal('show');
    }

    function save() {
        const planillaData = {
            empresaId: empresaId,
            anio: parseInt($('#Planilla_Anio').val()),
            mes: parseInt($('#Planilla_Mes').val()),
            periodo: parseInt($('#Planilla_Periodo').val()),
            tipoPlanilla: $('#Planilla_TipoPlanilla').val(),
            descripcion: $('#Planilla_Descripcion').val() || null,
            fechaInicio: $('#Planilla_FechaInicio').val(),
            fechaFin: $('#Planilla_FechaFin').val()
        };

        $.ajax({
            url: '?handler=Save',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(planillaData),
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success) {
                    showSuccess(response.message);
                    $('#modalPlanilla').modal('hide');
                    table.ajax.reload();
                } else {
                    showError(response.message);
                }
            },
            error: function(xhr) {
                handleAjaxError(xhr);
            }
        });
    }

    function viewDetails(id) {
        $.ajax({
            url: '?handler=Details&id=' + id,
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success) {
                    renderDetallePlanilla(response.data);
                    $('#modalDetallePlanilla').modal('show');
                } else {
                    Swal.fire('Error', response.message, 'error');
                }
            }
        });
    }

    function fmtMoney(val) {
        return '₡' + parseFloat(val || 0).toLocaleString('es-CR', {minimumFractionDigits: 2});
    }

    function renderDetallePlanilla(planilla) {
        const detalles = planilla.detalles || [];
        let html = `
            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Período:</strong> ${planilla.anio}-${String(planilla.mes).padStart(2, '0')} P${planilla.periodo}
                </div>
                <div class="col-md-6">
                    <strong>Estado:</strong> ${planilla.estadoDescripcion || planilla.estado}
                </div>
            </div>
            <div class="table-responsive">
            <table class="table table-sm table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>Empleado</th>
                        <th class="text-end">Sal. Bruto</th>
                        <th class="text-end">CCSS (9.67%)</th>
                        <th class="text-end">B. Popular (1%)</th>
                        <th class="text-end">Renta</th>
                        <th class="text-end">Otras Ded.</th>
                        <th class="text-end">Total Ded.</th>
                        <th class="text-end">Sal. Neto</th>
                    </tr>
                </thead>
                <tbody>
        `;

        let sumBruto = 0, sumCCSS = 0, sumBP = 0, sumRenta = 0, sumOtras = 0, sumTotalDed = 0, sumNeto = 0;

        detalles.forEach(d => {
            const otrasDed = (d.deduccionPensionAlimenticia || 0) + (d.deduccionEmbargo || 0) +
                             (d.deduccionPrestamo || 0) + (d.otrasDeducciones || 0);
            sumBruto += d.salarioBruto || 0;
            sumCCSS += d.deduccionCCSS || 0;
            sumBP += d.deduccionBancoPopular || 0;
            sumRenta += d.deduccionRenta || 0;
            sumOtras += otrasDed;
            sumTotalDed += d.totalDeducciones || 0;
            sumNeto += d.salarioNeto || 0;

            const otrasTitle = otrasDed > 0
                ? `title="Pensión: ${fmtMoney(d.deduccionPensionAlimenticia)} | Embargo: ${fmtMoney(d.deduccionEmbargo)} | Préstamo: ${fmtMoney(d.deduccionPrestamo)} | Otras: ${fmtMoney(d.otrasDeducciones)}"`
                : '';

            html += `
                <tr>
                    <td>${d.empleado ? d.empleado.nombreCompleto : (d.empleadoNombre || '-')}</td>
                    <td class="text-end">${fmtMoney(d.salarioBruto)}</td>
                    <td class="text-end">${fmtMoney(d.deduccionCCSS)}</td>
                    <td class="text-end">${fmtMoney(d.deduccionBancoPopular)}</td>
                    <td class="text-end">${fmtMoney(d.deduccionRenta)}</td>
                    <td class="text-end" ${otrasTitle} style="cursor:${otrasDed > 0 ? 'help' : 'default'}">${fmtMoney(otrasDed)}</td>
                    <td class="text-end"><strong>${fmtMoney(d.totalDeducciones)}</strong></td>
                    <td class="text-end"><strong>${fmtMoney(d.salarioNeto)}</strong></td>
                </tr>
            `;
        });

        html += `
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <th>TOTALES</th>
                        <th class="text-end">${fmtMoney(sumBruto)}</th>
                        <th class="text-end">${fmtMoney(sumCCSS)}</th>
                        <th class="text-end">${fmtMoney(sumBP)}</th>
                        <th class="text-end">${fmtMoney(sumRenta)}</th>
                        <th class="text-end">${fmtMoney(sumOtras)}</th>
                        <th class="text-end"><strong>${fmtMoney(sumTotalDed)}</strong></th>
                        <th class="text-end"><strong>${fmtMoney(sumNeto)}</strong></th>
                    </tr>
                </tfoot>
            </table>
            </div>
        `;

        // Cargas Sociales Patronales
        let sumCCSSPat = 0, sumOtrasInst = 0, sumINS = 0, sumAguinaldo = 0, sumVacaciones = 0, sumCesantia = 0, sumTotalCargas = 0;
        detalles.forEach(d => {
            sumCCSSPat += d.cargaCCSSPatronal || 0;
            sumOtrasInst += d.cargaOtrasInstituciones || 0;
            sumINS += d.cargaINS || 0;
            sumAguinaldo += d.cargaAguinaldo || 0;
            sumVacaciones += d.cargaVacaciones || 0;
            sumCesantia += d.cargaCesantia || 0;
            sumTotalCargas += d.totalCargasSociales || 0;
        });

        html += `
            <h6 class="mt-4 mb-2"><i class="fas fa-building me-1"></i> Cargas Sociales Patronales</h6>
            <div class="table-responsive">
            <table class="table table-sm table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>Empleado</th>
                        <th class="text-end">CCSS Patr. (14.50%)</th>
                        <th class="text-end">Otras Inst. (7.25%)</th>
                        <th class="text-end">INS (1.21%)</th>
                        <th class="text-end">Prov. Aguinaldo (8.33%)</th>
                        <th class="text-end">Prov. Vacaciones (4.16%)</th>
                        <th class="text-end">Prov. Cesantía (5.33%)</th>
                        <th class="text-end">Total Cargas</th>
                    </tr>
                </thead>
                <tbody>
        `;

        detalles.forEach(d => {
            html += `
                <tr>
                    <td>${d.empleado ? d.empleado.nombreCompleto : (d.empleadoNombre || '-')}</td>
                    <td class="text-end">${fmtMoney(d.cargaCCSSPatronal)}</td>
                    <td class="text-end">${fmtMoney(d.cargaOtrasInstituciones)}</td>
                    <td class="text-end">${fmtMoney(d.cargaINS)}</td>
                    <td class="text-end">${fmtMoney(d.cargaAguinaldo)}</td>
                    <td class="text-end">${fmtMoney(d.cargaVacaciones)}</td>
                    <td class="text-end">${fmtMoney(d.cargaCesantia)}</td>
                    <td class="text-end"><strong>${fmtMoney(d.totalCargasSociales)}</strong></td>
                </tr>
            `;
        });

        html += `
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <th>TOTALES</th>
                        <th class="text-end">${fmtMoney(sumCCSSPat)}</th>
                        <th class="text-end">${fmtMoney(sumOtrasInst)}</th>
                        <th class="text-end">${fmtMoney(sumINS)}</th>
                        <th class="text-end">${fmtMoney(sumAguinaldo)}</th>
                        <th class="text-end">${fmtMoney(sumVacaciones)}</th>
                        <th class="text-end">${fmtMoney(sumCesantia)}</th>
                        <th class="text-end"><strong>${fmtMoney(sumTotalCargas)}</strong></th>
                    </tr>
                </tfoot>
            </table>
            </div>
        `;

        // Resumen de costo total
        const costoTotal = sumBruto + sumTotalCargas;
        html += `
            <div class="row mt-3">
                <div class="col-md-4">
                    <div class="card border-primary">
                        <div class="card-body text-center py-2">
                            <small class="text-muted">Total Salario Neto</small>
                            <h5 class="text-primary mb-0">${fmtMoney(sumNeto)}</h5>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-warning">
                        <div class="card-body text-center py-2">
                            <small class="text-muted">Total Cargas Patronales</small>
                            <h5 class="text-warning mb-0">${fmtMoney(sumTotalCargas)}</h5>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-danger">
                        <div class="card-body text-center py-2">
                            <small class="text-muted">Costo Total Empleador</small>
                            <h5 class="text-danger mb-0">${fmtMoney(costoTotal)}</h5>
                        </div>
                    </div>
                </div>
            </div>
        `;

        $('#detallesPlanillaContent').html(html);
    }

    function aprobarPlanilla(id) {
        confirmDialog('Una vez aprobada, la planilla no podrá ser modificada.', '¿Aprobar Planilla?', function() {
            $.ajax({
                url: '?handler=Aprobar&id=' + id,
                type: 'POST',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        showSuccess(response.message);
                        table.ajax.reload();
                    } else {
                        showError(response.message);
                    }
                },
                error: function(xhr) {
                    handleAjaxError(xhr);
                }
            });
        });
    }

    function pagarPlanilla(id) {
        confirmDialog('Esto marcará la planilla como pagada y generará el asiento contable correspondiente.', '¿Marcar como Pagada?', function() {
            $.ajax({
                url: '?handler=Pagar&id=' + id,
                type: 'POST',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        showSuccess(response.message);
                        table.ajax.reload();
                    } else {
                        showError(response.message);
                    }
                },
                error: function(xhr) {
                    handleAjaxError(xhr);
                }
            });
        });
    }

    function deleteRecord(id) {
        confirmDelete('Esta acción no se puede revertir', function() {
            $.ajax({
                url: '?handler=Delete&id=' + id,
                type: 'POST',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        showSuccess(response.message);
                        table.ajax.reload();
                    } else {
                        showError(response.message);
                    }
                },
                error: function(xhr) {
                    handleAjaxError(xhr);
                }
            });
        });
    }

    function exportarCCSS(planillaId) {
        window.location.href = `?handler=ExportarCCSS&planillaId=${planillaId}`;
    }

    function refrescarTabla() {
        $('#tablePlanillasLoader').show();
        $('#tablePlanillasContainer').hide();
