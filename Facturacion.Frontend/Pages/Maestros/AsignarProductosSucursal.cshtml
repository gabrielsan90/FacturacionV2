@page
@model Facturacion.Frontend.Pages.Maestros.AsignarProductosSucursalModel
@{
    ViewData["Title"] = "Asignar Productos a Sucursal";
    ViewData["Breadcrumb"] = "Asignar Productos a Sucursal";
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">
            <i class="fas fa-cubes me-2"></i>Asignar Productos a Sucursal
        </h5>
    </div>
    <div class="card-body">
        <!-- Sucursal Selector -->
        <div class="row mb-4">
            <div class="col-md-6">
                <label class="form-label">Sucursal <span class="text-danger">*</span></label>
                <select class="form-select" id="sucursalId">
                    <option value="">Seleccione una sucursal...</option>
                </select>
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <button class="btn btn-primary" onclick="cargarProductosAsignados()">
                    <i class="fas fa-search me-1"></i> Cargar Productos
                </button>
            </div>
        </div>

        <div id="productsSection" style="display: none;">
            <hr />

            <div class="row mb-3">
                <div class="col-md-12">
                    <h6>Productos Disponibles</h6>
                    <p class="text-muted">Seleccione los productos y asigne cantidades iniciales</p>
                </div>
            </div>

            <!-- Search and Filter -->
            <div class="row mb-3">
                <div class="col-md-5">
                    <div class="input-group">
                        <input type="text" class="form-control" id="searchProducto" placeholder="Buscar producto..." />
                        <button class="btn btn-outline-primary" type="button" onclick="openProductSearchModal()" title="Buscar en lista de productos">
                            <i class="fas fa-list"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select" id="filterCategoria">
                        <option value="">Todas las categorías</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <button class="btn btn-success w-100" onclick="asignarSeleccionados()">
                        <i class="fas fa-check me-1"></i> Asignar Seleccionados
                    </button>
                </div>
            </div>

            <!-- Products Table -->
            <table id="tableProductos" class="table table-hover">
                <thead>
                    <tr>
                        <th style="width: 50px;">
                            <input type="checkbox" id="selectAll" onchange="toggleSelectAll()" />
                        </th>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Categoría</th>
                        <th>Precio Venta</th>
                        <th>Asignado</th>
                        <th>Stock Actual</th>
                        <th style="width: 150px;">Cantidad Inicial</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>

            <hr />

            <div class="row">
                <div class="col-md-12">
                    <h6>Productos Asignados a esta Sucursal</h6>
                    <table id="tableAsignados" class="table table-sm table-striped">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th>Stock</th>
                                <th>Stock Mínimo</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Product Search Modal -->
<div class="modal fade" id="modalProductSearch" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-search me-2 text-primary"></i>Buscar Producto
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <input type="text" class="form-control" id="modalSearchInput" placeholder="Escriba para filtrar..." />
                </div>
                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-hover table-sm" id="tableModalProductos">
                        <thead class="sticky-top bg-white">
                            <tr>
                                <th style="width: 50px;">Sel.</th>
                                <th>Código</th>
                                <th>Nombre</th>
                                <th>Categoría</th>
                            </tr>
                        </thead>
                        <tbody id="modalProductosBody">
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <span class="me-auto text-muted" id="modalSelectedCount">0 productos seleccionados</span>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancelar
                </button>
                <button type="button" class="btn btn-primary" onclick="selectProductsFromModal()">
                    <i class="fas fa-check me-1"></i>Seleccionar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let table;
    let sucursalSeleccionada = null;
    let allProductsForModal = [];

    $(document).ready(function() {
        cargarSucursales();
        cargarCategorias();
        setupSearchFilter();
    });

    function cargarSucursales() {
        $.ajax({
            url: '?handler=Sucursales',
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(data) {
                const select = $('#sucursalId');
                select.empty().append('<option value="">Seleccione una sucursal...</option>');
                data.forEach(suc => {
                    select.append(`<option value="${suc.id}">${suc.nombre}</option>`);
                });
            }
        });
    }

    function cargarCategorias() {
        $.ajax({
            url: '?handler=Categorias',
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(data) {
                const select = $('#filterCategoria');
                select.empty().append('<option value="">Todas las categorías</option>');
                data.forEach(cat => {
                    select.append(`<option value="${cat.id}">${cat.nombre}</option>`);
                });
            }
        });
    }

    function cargarProductosAsignados() {
        sucursalSeleccionada = $('#sucursalId').val();
        if (!sucursalSeleccionada) {
            showError('Debe seleccionar una sucursal');
            return;
        }

        $('#productsSection').show();
        loadDataTable();
        cargarListaAsignados();
    }

    function loadDataTable() {
        if (table) {
            table.destroy();
        }

        table = initDataTable('#tableProductos', {
            ajax: {
                url: `?handler=ProductosDisponibles&sucursalId=${sucursalSeleccionada}`,
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                dataSrc: 'data'
            },
            columns: [
                {
                    data: 'id',
                    orderable: false,
                    render: function(data) {
                        return `<input type="checkbox" class="producto-checkbox" value="${data}" />`;
                    }
                },
                { data: 'codigo' },
                { data: 'nombre' },
                {
                    data: 'categoria',
                    render: function(data) {
                        return data ? data.nombre : '-';
                    }
                },
                {
                    data: 'precioVenta',
                    render: function(data) {
                        return formatCurrency(data);
                    }
                },
                {
                    data: 'asignado',
                    render: function(data) {
                        return data
                            ? '<span class="badge bg-success">Sí</span>'
                            : '<span class="badge bg-secondary">No</span>';
                    }
                },
                {
                    data: 'stockActual',
                    render: function(data) {
                        return data || 0;
                    }
                },
                {
                    data: 'id',
                    orderable: false,
                    render: function(data) {
                        return `<input type="number" class="form-control form-control-sm cantidad-input"
                                       data-producto-id="${data}" min="0" step="0.01" value="0" />`;
                    }
                }
            ],
            paging: true,
            searching: false,
            order: [[1, 'asc']]
        });
    }

    function cargarListaAsignados() {
        $.ajax({
            url: `?handler=ProductosAsignados&sucursalId=${sucursalSeleccionada}`,
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(data) {
                const tbody = $('#tableAsignados tbody');
                tbody.empty();

                if (data.length === 0) {
                    tbody.append('<tr><td colspan="4" class="text-center">No hay productos asignados</td></tr>');
                } else {
                    data.forEach(item => {
                        tbody.append(`
                            <tr>
                                <td>${item.producto.nombre}</td>
                                <td>${item.stock}</td>
                                <td>${item.stockMinimo || '-'}</td>
                                <td>
                                    <button class="btn btn-sm btn-danger" onclick="desasignar('${item.id}')">
                                        <i class="fas fa-times"></i> Desasignar
                                    </button>
                                </td>
                            </tr>
                        `);
                    });
                }
            }
        });
    }

    function setupSearchFilter() {
        $('#searchProducto, #filterCategoria').on('keyup change', function() {
            if (table) {
                table.search($('#searchProducto').val()).draw();
            }
        });
    }

    function toggleSelectAll() {
        const checked = $('#selectAll').prop('checked');
        $('.producto-checkbox').prop('checked', checked);
    }

    function asignarSeleccionados() {
        const productosSeleccionados = [];

        $('.producto-checkbox:checked').each(function() {
            const productoId = $(this).val();
            const cantidad = $(`.cantidad-input[data-producto-id="${productoId}"]`).val();

            productosSeleccionados.push({
                productoId: productoId,
                cantidadInicial: parseFloat(cantidad) || 0
            });
        });

        if (productosSeleccionados.length === 0) {
            showError('Debe seleccionar al menos un producto');
            return;
        }

        const asignacionData = {
            sucursalId: sucursalSeleccionada,
            productos: productosSeleccionados
        };

        $.ajax({
            url: '?handler=Asignar',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(asignacionData),
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success) {
                    showSuccess(response.message);
                    $('#selectAll').prop('checked', false);
                    table.ajax.reload();
                    cargarListaAsignados();
                } else {
                    showError(response.message);
                }
            },
            error: function() {
                showError('Error al asignar productos');
            }
        });
    }

    function desasignar(asignacionId) {
        confirmDelete('¿Desea desasignar este producto de la sucursal?', function() {
            $.ajax({
                url: `?handler=Desasignar&asignacionId=${asignacionId}`,
                type: 'POST',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        showSuccess(response.message);
                        table.ajax.reload();
                        cargarListaAsignados();
                    } else {
                        showError(response.message);
                    }
                },
                error: function() {
                    showError('Error al desasignar producto');
                }
            });
        });
    }

    // Product Search Modal Functions
    function openProductSearchModal() {
        if (!sucursalSeleccionada) {
            showError('Primero debe seleccionar una sucursal y cargar los productos');
            return;
        }

        // Load products for modal
        $.ajax({
            url: `?handler=ProductosDisponibles&sucursalId=${sucursalSeleccionada}`,
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                const data = response.data || response || [];
                allProductsForModal = data;
                renderModalProducts(data);
                $('#modalSearchInput').val('');
                $('#modalProductSearch').modal('show');
            },
            error: function() {
                showError('Error al cargar productos');
            }
        });
    }

    function renderModalProducts(products) {
        const tbody = $('#modalProductosBody');
        tbody.empty();

        if (products.length === 0) {
            tbody.append('<tr><td colspan="4" class="text-center text-muted">No hay productos disponibles</td></tr>');
            return;
        }

        products.forEach(p => {
            const codigo = p.codigo || p.Codigo || '';
            const nombre = p.nombre || p.Nombre || '';
            const categoria = p.categoria ? (p.categoria.nombre || p.categoria.Nombre || '-') : '-';

            tbody.append(`
                <tr>
                    <td>
                        <input type="checkbox" class="modal-producto-check" value="${p.id}" data-codigo="${codigo}" />
                    </td>
                    <td>${codigo}</td>
                    <td>${nombre}</td>
                    <td>${categoria}</td>
                </tr>
            `);
        });

        // Update selected count
        updateModalSelectedCount();

        // Add change listener
        $('.modal-producto-check').on('change', function() {
            updateModalSelectedCount();
        });
    }

    function updateModalSelectedCount() {
        const count = $('.modal-producto-check:checked').length;
        $('#modalSelectedCount').text(`${count} producto(s) seleccionado(s)`);
    }

    // Filter products in modal
    $('#modalSearchInput').on('keyup', function() {
        const searchTerm = $(this).val().toLowerCase();
        const filtered = allProductsForModal.filter(p => {
            const codigo = (p.codigo || p.Codigo || '').toLowerCase();
            const nombre = (p.nombre || p.Nombre || '').toLowerCase();
            return codigo.includes(searchTerm) || nombre.includes(searchTerm);
        });
        renderModalProducts(filtered);
    });

    function selectProductsFromModal() {
        const selectedIds = [];
        $('.modal-producto-check:checked').each(function() {
            selectedIds.push($(this).val());
        });

        if (selectedIds.length === 0) {
            showWarning('Debe seleccionar al menos un producto');
            return;
        }

        // Check the corresponding checkboxes in the main table
        selectedIds.forEach(id => {
            const checkbox = $(`.producto-checkbox[value="${id}"]`);
            if (checkbox.length) {
                checkbox.prop('checked', true);
            }
        });

        $('#modalProductSearch').modal('hide');
        showSuccess(`${selectedIds.length} producto(s) seleccionado(s)`);
    }
</script>
}
