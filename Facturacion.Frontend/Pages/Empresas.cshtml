        function saveConsecutivo() {
            const terminalId = $('#Consecutivo_TerminalIdSelect').val();
            const tipoDocumento = $('#Consecutivo_TipoDocumento').val();
            const ambiente = $('#Consecutivo_Ambiente').val();
            const numeroActual = parseInt($('#Consecutivo_NumeroActual').val()) || 0;

            // Validation
            if (!terminalId) {
                Swal.fire('Error', 'Debe seleccionar un terminal', 'error');
                return;
            }

            if (!tipoDocumento) {
                Swal.fire('Error', 'Debe seleccionar un tipo de documento', 'error');
                return;
            }

            if (!ambiente) {
                Swal.fire('Error', 'Debe seleccionar un ambiente (Pruebas o Producción)', 'error');
                return;
            }

            if (numeroActual < 0) {
                Swal.fire('Error', 'El número actual no puede ser negativo', 'error');
                return;
            }

            // Get terminal and sucursal to generate claveNumeracion
            const terminal = terminalesData.find(t => t.id === terminalId);
            const sucursal = terminal ? sucursalesData.find(s => s.id === terminal.sucursalId) : null;
            const codigoSucursal = (sucursal?.codigo || '001').toString().padStart(3, '0');
            const codigoTerminal = terminal ? terminal.codigo.toString().padStart(5, '0') : '00001';

            // Auto-generate claveNumeracion (include ambiente to make it unique per ambiente)
            const ambienteCode = ambiente === '1' ? 'stag' : 'prod';
            const claveNumeracion = `${codigoSucursal}-${codigoTerminal}-${tipoDocumento}-${ambienteCode}`;

            const data = {
                id: $('#Consecutivo_Id').val(),
                terminalId: terminalId,
                tipoDocumento: tipoDocumento,
                ambiente: parseInt(ambiente),
                descripcion: null,
                claveNumeracion: claveNumeracion,
                numeroInicio: 1,
                numeroFin: 9999999999,
                numeroActual: numeroActual,
                activo: $('#Consecutivo_Activo').is(':checked')
            };

            $.ajax({
                url: '?handler=SaveConsecutivo',
                type: 'POST',
                data: JSON.stringify(data),
                contentType: 'application/json',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Éxito',
                            text: response.message,
                            confirmButtonColor: '#4e73df',
                            timer: 1500
                        });
                        $('#modalConsecutivo').modal('hide');
                        loadConsecutivos(currentEmpresaId);
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.message,
                            confirmButtonColor: '#e74a3b'
                        });
                    }
                },
                error: function(xhr) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Ocurrió un error al guardar el consecutivo',
                        confirmButtonColor: '#e74a3b'
                    });
                }
            });
        }

        function deleteConsecutivo(id) {
            Swal.fire({
                title: '¿Está seguro?',
                text: "Esta acción eliminará el consecutivo.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar',
