        function updateConsecutivoPreview() {
            const terminalId = $('#Consecutivo_TerminalIdSelect').val();
            const tipoDocumento = $('#Consecutivo_TipoDocumento').val();
            const numeroActual = parseInt($('#Consecutivo_NumeroActual').val()) || 0;

            if (!terminalId || !tipoDocumento) {
                $('#consecutivoPreviewText').text('---');
                return;
            }

            // Get terminal and sucursal info
            const terminal = terminalesData.find(t => t.id === terminalId);
            if (!terminal) {
                $('#consecutivoPreviewText').text('---');
                return;
            }

            const sucursal = sucursalesData.find(s => s.id === terminal.sucursalId);
            const codigoSucursal = (sucursal?.codigo || '001').toString().padStart(3, '0');
            const codigoTerminal = terminal.codigo.toString().padStart(5, '0');
            const siguienteNumero = (numeroActual + 1).toString().padStart(10, '0');

            const consecutivoFormateado = `${codigoSucursal}-${codigoTerminal}-${tipoDocumento}-${siguienteNumero}`;
            $('#consecutivoPreviewText').text(consecutivoFormateado);
        }

        function loadConsecutivos(empresaId) {
            $.ajax({
                url: '?handler=ConsecutivosByEmpresa&empresaId=' + empresaId,
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        consecutivosData = response.data || [];
                        renderConsecutivosTable();
                    }
                },
                error: function(xhr) {
                    console.error('Error loading consecutivos:', xhr);
                }
            });
        }

        function renderConsecutivosTable() {
            const tbody = $('#tableConsecutivosBody');
            tbody.empty();

            let filteredData = consecutivosData;
            const filterTerminalId = $('#filterTerminal').val();
            if (filterTerminalId) {
                filteredData = consecutivosData.filter(c => c.terminalId === filterTerminalId);
            }

            if (filteredData.length === 0) {
                tbody.append('<tr><td colspan="7" class="text-center text-muted">No hay consecutivos registrados</td></tr>');
                return;
            }

            filteredData.forEach(consecutivo => {
                const terminal = terminalesData.find(t => t.id === consecutivo.terminalId);
                const sucursal = terminal ? sucursalesData.find(s => s.id === terminal.sucursalId) : null;
                const terminalLabel = terminal ? (sucursal ? `${sucursal.nombre} - ${terminal.nombre}` : terminal.nombre) : '-';

                // Generate formatted consecutive preview
                const codigoSucursal = (sucursal?.codigo || '001').toString().padStart(3, '0');
                const codigoTerminal = terminal ? terminal.codigo.toString().padStart(5, '0') : '00000';
                const siguienteNumero = (consecutivo.numeroActual + 1).toString().padStart(10, '0');
                const consecutivoFormateado = `${codigoSucursal}-${codigoTerminal}-${consecutivo.tipoDocumento}-${siguienteNumero}`;

                // Get ambiente info
                const amb = ambientes[consecutivo.ambiente];
                const ambienteBadge = amb ? `<span class="badge ${amb.badge}">${amb.nombre}</span>` : '-';

                const row = `
                    <tr>
                        <td>${terminalLabel}</td>
                        <td>${tiposDocumento[consecutivo.tipoDocumento] || consecutivo.tipoDocumento}</td>
                        <td>${ambienteBadge}</td>
                        <td><code class="text-primary">${consecutivoFormateado}</code></td>
                        <td>${consecutivo.numeroActual}</td>
                        <td>${consecutivo.activo ? '<span class="badge bg-success">Activo</span>' : '<span class="badge bg-secondary">Inactivo</span>'}</td>
                        <td>
                            <button type="button" class="btn btn-xs btn-info" onclick="editConsecutivo('${consecutivo.id}')" title="Editar">
