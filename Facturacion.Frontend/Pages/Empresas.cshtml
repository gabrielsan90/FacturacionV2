        function setupConsecutivoForm() {
            $('#formConsecutivo').on('submit', function(e) {
                e.preventDefault();
                saveConsecutivo();
            });

            // Filter consecutivos by terminal
            $('#filterTerminal').on('change', function() {
                renderConsecutivosTable();
            });

            // Update preview when terminal, tipo documento or numero changes
            $('#Consecutivo_TerminalIdSelect, #Consecutivo_TipoDocumento, #Consecutivo_NumeroActual').on('change keyup', function() {
                updateConsecutivoPreview();
            });
