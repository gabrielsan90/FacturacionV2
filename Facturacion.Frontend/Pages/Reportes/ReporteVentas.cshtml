@page
@model Facturacion.Frontend.Pages.Reportes.ReporteVentasModel
@{
    ViewData["Title"] = "Reporte: Ventas";
    ViewData["Breadcrumb"] = "Reporte: Ventas";
}

@Html.AntiForgeryToken()

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">
            <i class="fas fa-chart-line me-2"></i>Reporte: Ventas
        </h5>
    </div>
    <div class="card-body">
        <!-- Filters -->
        <div class="row mb-4">
            <div class="col-md-3">
                <label class="form-label">Fecha Inicio</label>
                <input type="date" class="form-control" id="fechaInicio" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Fecha Fin</label>
                <input type="date" class="form-control" id="fechaFin" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Agrupar Por</label>
                <select class="form-select" id="agruparPor">
                    <option value="dia">Día</option>
                    <option value="semana">Semana</option>
                    <option value="mes" selected>Mes</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-primary me-2" onclick="filtrar()">
                    <i class="fas fa-filter me-1"></i> Filtrar
                </button>
                <button class="btn btn-outline-secondary" onclick="limpiarFiltros()">
                    <i class="fas fa-eraser me-1"></i> Limpiar
                </button>
            </div>
        </div>

        <!-- Summary Cards -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card bg-primary text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-0">Total Ventas</h6>
                                <h4 class="mb-0" id="totalVentas">₡0.00</h4>
                            </div>
                            <i class="fas fa-dollar-sign fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-success text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-0">Documentos</h6>
                                <h4 class="mb-0" id="totalDocumentos">0</h4>
                            </div>
                            <i class="fas fa-file-invoice fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-warning text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-0">Promedio</h6>
                                <h4 class="mb-0" id="promedioVenta">₡0.00</h4>
                            </div>
                            <i class="fas fa-chart-bar fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-info text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-0">Clientes Únicos</h6>
                                <h4 class="mb-0" id="clientesUnicos">0</h4>
                            </div>
                            <i class="fas fa-users fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts Row -->
        <div class="row mb-4">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h6 class="mb-0">Ventas en el Tiempo</h6>
                    </div>
                    <div class="card-body">
                        <canvas id="chartVentasTiempo" height="100"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h6 class="mb-0">Top 5 Productos</h6>
                    </div>
                    <div class="card-body">
                        <canvas id="chartTopProductos" height="200"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Top Clients and Products -->
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h6 class="mb-0">Top 10 Clientes</h6>
                    </div>
                    <div class="card-body">
                        <table id="tableTopClientes" class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Cliente</th>
                                    <th>Ventas</th>
                                    <th>Monto</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h6 class="mb-0">Top 10 Productos</h6>
                    </div>
                    <div class="card-body">
                        <table id="tableTopProductos" class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th>Cantidad</th>
                                    <th>Monto</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Export Buttons -->
        <div class="mb-3">
            <button class="btn btn-success btn-sm" onclick="exportarExcel()">
                <i class="fas fa-file-excel me-1"></i> Exportar a Excel
            </button>
            <button class="btn btn-danger btn-sm" onclick="exportarPDF()">
                <i class="fas fa-file-pdf me-1"></i> Exportar a PDF
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let chartVentasTiempo;
    let chartTopProductos;

    $(document).ready(function() {
        // Set default dates (last 365 days to ensure we get data)
        const hoy = new Date();
        const hace365Dias = new Date();
        hace365Dias.setDate(hace365Dias.getDate() - 365);

        $('#fechaFin').val(hoy.toISOString().split('T')[0]);
        $('#fechaInicio').val(hace365Dias.toISOString().split('T')[0]);

        cargarReporte();
    });

    function cargarReporte() {
        cargarResumen();
        cargarGraficos();
        cargarTopClientes();
        cargarTopProductos();
    }

    function cargarResumen() {
        const fechaInicio = $('#fechaInicio').val();
        const fechaFin = $('#fechaFin').val();

        console.log('Cargando resumen con fechas:', fechaInicio, fechaFin);

        $.ajax({
            url: `?handler=Resumen&fechaInicio=${fechaInicio}&fechaFin=${fechaFin}`,
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                console.log('Resumen response:', response);
                // Handle wrapped response - check multiple property names
                const data = response.data || response.result || response || {};
                console.log('Resumen data:', data);

                const totalVentas = data.totalVentas ?? data.TotalVentas ?? 0;
                const totalDocumentos = data.totalDocumentos ?? data.TotalDocumentos ?? 0;
                const promedioVenta = data.promedioVenta ?? data.PromedioVenta ?? 0;
                const clientesUnicos = data.clientesUnicos ?? data.ClientesUnicos ?? 0;

                $('#totalVentas').text(formatCurrency(totalVentas));
                $('#totalDocumentos').text(totalDocumentos);
                $('#promedioVenta').text(formatCurrency(promedioVenta));
                $('#clientesUnicos').text(clientesUnicos);
            },
            error: function(xhr, status, error) {
                console.error('Error loading resumen:', error, xhr.responseText);
                $('#totalVentas').text('₡0.00');
                $('#totalDocumentos').text('0');
                $('#promedioVenta').text('₡0.00');
                $('#clientesUnicos').text('0');
            }
        });
    }

    function cargarGraficos() {
        const fechaInicio = $('#fechaInicio').val();
        const fechaFin = $('#fechaFin').val();
        const agruparPor = $('#agruparPor').val();

        console.log('Cargando gráficos con fechas:', fechaInicio, fechaFin, 'agruparPor:', agruparPor);

        $.ajax({
            url: `?handler=GraficoVentas&fechaInicio=${fechaInicio}&fechaFin=${fechaFin}&agruparPor=${agruparPor}`,
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                console.log('Graficos response:', response);
                // Handle wrapped response
                const data = response.data || response.result || response || {};
                console.log('Graficos data:', data);

                // Chart Ventas en el Tiempo
                if (chartVentasTiempo) {
                    chartVentasTiempo.destroy();
                }

                const labels = data.labels || data.Labels || [];
                const valores = data.valores || data.Valores || [];

                console.log('Chart labels:', labels, 'valores:', valores);

                const ctx1 = document.getElementById('chartVentasTiempo').getContext('2d');
                chartVentasTiempo = new Chart(ctx1, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Ventas',
                            data: valores,
                            borderColor: 'rgb(75, 192, 192)',
                            backgroundColor: 'rgba(75, 192, 192, 0.2)',
                            tension: 0.1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true
                    }
                });

                // Chart Top Productos
                if (chartTopProductos) {
                    chartTopProductos.destroy();
                }

                const topProductos = data.topProductos || data.TopProductos || [];
                console.log('Top productos para chart:', topProductos);

                const ctx2 = document.getElementById('chartTopProductos').getContext('2d');
                chartTopProductos = new Chart(ctx2, {
                    type: 'doughnut',
                    data: {
                        labels: topProductos.map(p => p.nombre || p.Nombre || 'Sin nombre'),
                        datasets: [{
                            data: topProductos.map(p => p.monto || p.Monto || 0),
                            backgroundColor: [
                                '#FF6384',
                                '#36A2EB',
                                '#FFCE56',
                                '#4BC0C0',
                                '#9966FF'
                            ]
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true
                    }
                });
            },
            error: function(xhr, status, error) {
                console.error('Error loading graficos:', error, xhr.responseText);
            }
        });
    }

    function cargarTopClientes() {
        const fechaInicio = $('#fechaInicio').val();
        const fechaFin = $('#fechaFin').val();

        console.log('Cargando top clientes...');

        $.ajax({
            url: `?handler=TopClientes&fechaInicio=${fechaInicio}&fechaFin=${fechaFin}`,
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                console.log('Top clientes response:', response);
                // Handle wrapped response
                let data = response.data || response.result || response || [];

                // If data is not an array, try to convert it
                if (!Array.isArray(data)) {
                    try {
                        data = Object.values(data);
                    } catch (e) {
                        data = [];
                    }
                }

                console.log('Top clientes data:', data);
                const tbody = $('#tableTopClientes tbody');
                tbody.empty();

                if (!Array.isArray(data) || data.length === 0) {
                    tbody.append('<tr><td colspan="3" class="text-center text-muted">No hay datos para mostrar</td></tr>');
                    return;
                }

                data.forEach(cliente => {
                    const nombre = cliente.nombre || cliente.Nombre || '-';
                    const cantidadVentas = cliente.cantidadVentas || cliente.CantidadVentas || 0;
                    const montoTotal = cliente.montoTotal || cliente.MontoTotal || 0;
                    tbody.append(`
                        <tr>
                            <td>${nombre}</td>
                            <td>${cantidadVentas}</td>
                            <td>${formatCurrency(montoTotal)}</td>
                        </tr>
                    `);
                });
            },
            error: function(xhr, status, error) {
                console.error('Error loading top clientes:', error, xhr.responseText);
                $('#tableTopClientes tbody').html('<tr><td colspan="3" class="text-center text-danger">Error al cargar datos</td></tr>');
            }
        });
    }

    function cargarTopProductos() {
        const fechaInicio = $('#fechaInicio').val();
        const fechaFin = $('#fechaFin').val();

        console.log('Cargando top productos...');

        $.ajax({
            url: `?handler=TopProductos&fechaInicio=${fechaInicio}&fechaFin=${fechaFin}`,
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                console.log('Top productos response:', response);
                // Handle wrapped response
                let data = response.data || response.result || response || [];

                // If data is not an array, try to convert it
                if (!Array.isArray(data)) {
                    try {
                        data = Object.values(data);
                    } catch (e) {
                        data = [];
                    }
                }

                console.log('Top productos data:', data);
                const tbody = $('#tableTopProductos tbody');
                tbody.empty();

                if (!Array.isArray(data) || data.length === 0) {
                    tbody.append('<tr><td colspan="3" class="text-center text-muted">No hay datos para mostrar</td></tr>');
                    return;
                }

                data.forEach(producto => {
                    const nombre = producto.nombre || producto.Nombre || '-';
                    const cantidad = producto.cantidad || producto.Cantidad || 0;
                    const montoTotal = producto.montoTotal || producto.MontoTotal || 0;
                    tbody.append(`
                        <tr>
                            <td>${nombre}</td>
                            <td>${cantidad}</td>
                            <td>${formatCurrency(montoTotal)}</td>
                        </tr>
                    `);
                });
            },
            error: function(xhr, status, error) {
                console.error('Error loading top productos:', error, xhr.responseText);
                $('#tableTopProductos tbody').html('<tr><td colspan="3" class="text-center text-danger">Error al cargar datos</td></tr>');
            }
        });
    }

    function filtrar() {
        cargarReporte();
    }

    function limpiarFiltros() {
        const hoy = new Date();
        const hace365Dias = new Date();
        hace365Dias.setDate(hace365Dias.getDate() - 365);

        $('#fechaFin').val(hoy.toISOString().split('T')[0]);
        $('#fechaInicio').val(hace365Dias.toISOString().split('T')[0]);
        $('#agruparPor').val('mes');
        filtrar();
    }

    function exportarExcel() {
        showInfo('La funcionalidad de exportación estará disponible próximamente');
    }

    function exportarPDF() {
        showInfo('La funcionalidad de exportación estará disponible próximamente');
    }

    // Expose functions to global scope for onclick handlers
    window.filtrar = filtrar;
    window.limpiarFiltros = limpiarFiltros;
    window.exportarExcel = exportarExcel;
    window.exportarPDF = exportarPDF;
</script>
}
