@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Breadcrumb"] = "Dashboard";
}

@Html.AntiForgeryToken()

<!-- Page Header -->
<div class="page-header mb-4">
    <h2><i class="fas fa-chart-line"></i> Dashboard</h2>
    <p>Resumen de operaciones del sistema de facturación electrónica</p>
</div>

<!-- Metric Cards Row - Modern Design -->
<div class="row g-4 mb-4">
    <!-- Total Ventas Hoy -->
    <div class="col-sm-6 col-lg-3">
        <a href="/Documentos" class="text-decoration-none">
            <div class="metric-card success card-hoverable">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="flex-grow-1">
                        <div class="metric-label">Ventas Hoy</div>
                        <div class="metric-value" id="ventasHoy">₡0.00</div>
                    </div>
                    <div class="metric-icon">
                        <i class="fas fa-dollar-sign"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- Documentos Pendientes -->
    <div class="col-sm-6 col-lg-3">
        <a href="/Documentos?estado=pendiente" class="text-decoration-none">
            <div class="metric-card warning card-hoverable">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="flex-grow-1">
                        <div class="metric-label">Docs Pendientes</div>
                        <div class="metric-value" id="docsPendientes">0</div>
                    </div>
                    <div class="metric-icon">
                        <i class="fas fa-file-invoice"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- Productos Bajo Stock -->
    <div class="col-sm-6 col-lg-3">
        <a href="/Inventario?filtro=bajo-stock" class="text-decoration-none">
            <div class="metric-card danger card-hoverable">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="flex-grow-1">
                        <div class="metric-label">Stock Bajo</div>
                        <div class="metric-value" id="stockBajo">0</div>
                    </div>
                    <div class="metric-icon">
                        <i class="fas fa-box"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- Pagos Pendientes -->
    <div class="col-sm-6 col-lg-3">
        <a href="/Gasto?estado=pendiente" class="text-decoration-none">
            <div class="metric-card info card-hoverable">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="flex-grow-1">
                        <div class="metric-label">Pagos Pendientes</div>
                        <div class="metric-value" id="pagosPendientes">₡0.00</div>
                    </div>
                    <div class="metric-icon">
                        <i class="fas fa-money-bill-wave"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Charts Row -->
<div class="row g-4 mb-4">
    <!-- Ventas últimos 7 días -->
    <div class="col-md-8">
        <div class="card shadow-custom">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <i class="fas fa-chart-line me-2 text-primary"></i>
                    <strong>Ventas Últimos 7 Días</strong>
                </div>
                <span class="badge bg-primary">Tendencia</span>
            </div>
            <div class="card-body">
                <div id="chartVentasLoader" class="text-center py-5">
                    <div class="spinner-modern mx-auto"></div>
                    <p class="text-muted mt-3">Cargando datos...</p>
                </div>
                <canvas id="chartVentas" height="80" style="display:none;"></canvas>
            </div>
        </div>
    </div>

    <!-- Documentos por Tipo -->
    <div class="col-md-4">
        <div class="card shadow-custom">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <i class="fas fa-chart-pie me-2 text-primary"></i>
                    <strong>Documentos por Tipo</strong>
                </div>
                <span class="badge bg-primary">Distribución</span>
            </div>
            <div class="card-body">
                <div id="chartDocumentosLoader" class="text-center py-5">
                    <div class="spinner-modern mx-auto"></div>
                    <p class="text-muted mt-3 small">Cargando...</p>
                </div>
                <canvas id="chartDocumentos" style="display:none;"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Recent Documents Table -->
<div class="row">
    <div class="col-12">
        <div class="card shadow-custom">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <i class="fas fa-file-alt me-2 text-primary"></i>
                    <strong>Documentos Recientes</strong>
                    <span class="badge bg-secondary ms-2" id="badgeTotal">0</span>
                </div>
                <a href="/Facturacion" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus me-1"></i> Nuevo Documento
                </a>
            </div>
            <div class="card-body">
                <!-- Loading State -->
                <div id="tableLoader" class="text-center py-5">
                    <div class="spinner-modern mx-auto"></div>
                    <p class="text-muted mt-3">Cargando documentos recientes...</p>
                </div>

                <!-- Table -->
                <div class="table-responsive" id="tableContainer" style="display:none;">
                    <table class="table table-hover" id="tableDocumentosRecientes">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Tipo</th>
                                <th>Consecutivo</th>
                                <th>Cliente</th>
                                <th>Total</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Data loaded via JavaScript -->
                        </tbody>
                    </table>
                </div>

                <!-- Empty State -->
                <div id="emptyState" class="empty-state" style="display:none;">
                    <div class="empty-state-icon">
                        <i class="fas fa-file-invoice"></i>
                    </div>
                    <h3 class="empty-state-title">No hay documentos recientes</h3>
                    <p class="empty-state-description">Comienza creando tu primer documento electrónico</p>
                    <a href="/Facturacion" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Crear Documento
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let chartVentas;
    let chartDocumentos;

    $(document).ready(function() {
        loadDashboardMetrics();
        loadVentasChartData();
        loadDocumentosPorTipoData();
        loadRecentDocuments();
    });

    function loadDashboardMetrics() {
        // Load dashboard metrics via PageModel handler
        $.ajax({
            url: '?handler=Resumen',
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                // Handle wrapped response (response.data, response.result, or direct)
                const data = response?.data || response?.result || response || {};

                // Update metric cards - use correct property names from DashboardResumenDTO
                $('#ventasHoy').text(formatCurrency(data.totalVentasHoy || data.TotalVentasHoy || 0));
                $('#docsPendientes').text(data.documentosPendientesEnvio || data.DocumentosPendientesEnvio || 0);
                $('#stockBajo').text(data.productosBajoStock || data.ProductosBajoStock || 0);
                $('#pagosPendientes').text(formatCurrency(data.pagosPendientes || data.PagosPendientes || 0));
            },
            error: function(xhr) {
                console.error('Error loading dashboard metrics:', xhr);
                // Show default values
                $('#ventasHoy').text('₡0.00');
                $('#docsPendientes').text('0');
                $('#stockBajo').text('0');
                $('#pagosPendientes').text('₡0.00');
            }
        });
    }

    function loadVentasChartData() {
        // Calculate last 7 days date range
        const fechaFin = new Date();
        const fechaInicio = new Date();
        fechaInicio.setDate(fechaInicio.getDate() - 6);

        $.ajax({
            url: '?handler=VentasPorDia&fechaInicio=' + fechaInicio.toISOString().split('T')[0] + '&fechaFin=' + fechaFin.toISOString().split('T')[0],
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                const data = response?.data || response?.result || response || [];
                loadVentasChart(Array.isArray(data) ? data : []);
            },
            error: function(xhr) {
                console.error('Error loading ventas chart:', xhr);
                loadVentasChart([]);
            }
        });
    }

    function loadDocumentosPorTipoData() {
        // Current month date range
        const hoy = new Date();
        const fechaInicio = new Date(hoy.getFullYear(), hoy.getMonth(), 1);
        const fechaFin = hoy;

        $.ajax({
            url: '?handler=DocumentosPorTipo&fechaInicio=' + fechaInicio.toISOString().split('T')[0] + '&fechaFin=' + fechaFin.toISOString().split('T')[0],
            type: 'GET',
            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                const data = response?.data || response?.result || response || [];
                loadDocumentosChart(Array.isArray(data) ? data : []);
            },
            error: function(xhr) {
                console.error('Error loading documentos chart:', xhr);
                loadDocumentosChart([]);
            }
        });
    }

    function loadVentasChart(data) {
        const ctx = document.getElementById('chartVentas');
        const loader = document.getElementById('chartVentasLoader');

        // Hide loader and show chart
        loader.style.display = 'none';
        ctx.style.display = 'block';

        // Destroy existing chart if it exists
        if (chartVentas) {
            chartVentas.destroy();
        }

        // VentasPorMesDTO has: mes, ano, totalVentas, cantidadDocumentos, promedioVenta
        // Also handle PascalCase variants
        const labels = data.map(d => {
            // Create date from mes (day number in ventas-dia context)
            const mes = d.mes || d.Mes || 0;
            const ano = d.ano || d.Ano || new Date().getFullYear();
            // Format as short date
            const fecha = new Date(ano, new Date().getMonth(), mes);
            return fecha.toLocaleDateString('es-CR', { weekday: 'short', day: 'numeric' });
        });
        const values = data.map(d => d.totalVentas || d.TotalVentas || 0);

        chartVentas = new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels.length > 0 ? labels : ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'],
                datasets: [{
                    label: 'Ventas (₡)',
                    data: values.length > 0 ? values : [0, 0, 0, 0, 0, 0, 0],
                    borderColor: '#0ea5e9',
                    backgroundColor: 'rgba(14, 165, 233, 0.1)',
                    borderWidth: 3,
                    tension: 0.4,
                    fill: true,
                    pointBackgroundColor: '#0ea5e9',
                    pointBorderColor: '#fff',
                    pointBorderWidth: 2,
                    pointRadius: 5,
                    pointHoverRadius: 7
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                        padding: 12,
                        titleFont: {
                            size: 14,
                            weight: 'bold'
                        },
                        bodyFont: {
                            size: 13
                        },
                        callbacks: {
                            label: function(context) {
                                return 'Ventas: ' + formatCurrency(context.parsed.y);
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return '₡' + value.toLocaleString('es-CR');
                            }
                        }
                    }
                }
            }
        });
    }

    function loadDocumentosChart(data) {
        const ctx = document.getElementById('chartDocumentos');
        const loader = document.getElementById('chartDocumentosLoader');

        // Hide loader and show chart
        loader.style.display = 'none';
        ctx.style.display = 'block';

        // Destroy existing chart if it exists
        if (chartDocumentos) {
            chartDocumentos.destroy();
        }

        // VentasPorTipoDocumentoDTO has: tipoDocumento, cantidad, total, porcentaje
        // Also handle PascalCase variants
        const labels = data.map(d => {
            const tipo = d.tipoDocumento || d.TipoDocumento || 'N/A';
            // Simplify the label (e.g., "FE - Factura Electrónica" -> "FE")
            return tipo.split(' - ')[0] || tipo;
        });
        const values = data.map(d => d.cantidad || d.Cantidad || 0);
        const colors = ['#0ea5e9', '#06b6d4', '#10b981', '#f59e0b', '#ef4444', '#3b82f6'];

        chartDocumentos = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: labels.length > 0 ? labels : ['FE', 'TE', 'NC', 'ND'],
                datasets: [{
                    data: values.length > 0 ? values : [10, 5, 2, 1],
                    backgroundColor: colors,
                    borderWidth: 2,
                    borderColor: '#fff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 15,
                            usePointStyle: true,
                            font: {
                                size: 12
                            }
                        }
                    },
                    tooltip: {
                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                        padding: 12,
                        titleFont: {
                            size: 14,
                            weight: 'bold'
                        },
                        bodyFont: {
                            size: 13
                        }
                    }
                }
            }
        });
    }

    function loadRecentDocuments() {
        const tableLoader = document.getElementById('tableLoader');
        const tableContainer = document.getElementById('tableContainer');
        const emptyState = document.getElementById('emptyState');

        // Helper to get document type abbreviation
        function getTipoDocAbrev(tipoDocumento) {
            // Handle both numeric enum values and string values
            const tipoMap = {
                0: 'FE', 1: 'ND', 2: 'NC', 3: 'TE', 4: 'FEE', 5: 'FEC',
                'FacturaElectronica': 'FE',
                'NotaDebitoElectronica': 'ND',
                'NotaCreditoElectronica': 'NC',
                'TiqueteElectronico': 'TE',
                'FacturaElectronicaExportacion': 'FEE',
                'FacturaElectronicaCompra': 'FEC',
                'ReciboElectronicoPago': 'REP'
            };
            return tipoMap[tipoDocumento] || String(tipoDocumento);
        }

        // Helper to get estado display
        function getEstadoDisplay(estado) {
            const estadoMap = {
                0: 'Borrador', 1: 'Pendiente', 2: 'Procesando', 3: 'Aceptado', 4: 'Rechazado', 5: 'Contingencia',
                'Borrador': 'Borrador', 'Pendiente': 'Pendiente', 'Procesando': 'Procesando',
                'Aceptado': 'Aceptado', 'Rechazado': 'Rechazado', 'Contingencia': 'Aceptado'
            };
            return estadoMap[estado] || String(estado);
        }

        $('#tableDocumentosRecientes').DataTable({
            ajax: {
                url: '?handler=DocumentosRecientes',
                type: 'GET',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                data: function(d) {
                    // Only get last 10 documents
                    return {
                        pageSize: 10,
                        pageNumber: 1
                    };
                },
                dataSrc: function(json) {
                    const rawData = json.data || json || [];

                    // Normalize property names (handle both camelCase and PascalCase)
                    const data = rawData.map(item => ({
                        id: item.id || item.Id,
                        fechaEmision: item.fechaEmision || item.FechaEmision,
                        tipoDocumento: getTipoDocAbrev(item.tipoDocumento ?? item.TipoDocumento),
                        consecutivo: item.numeroConsecutivo || item.NumeroConsecutivo || item.consecutivo || item.Consecutivo || 'N/A',
                        receptor: item.receptor || item.Receptor || item.cliente || item.Cliente,
                        total: item.totalVenta || item.TotalVenta || item.total || item.Total || 0,
                        estadoHacienda: getEstadoDisplay(item.estado ?? item.Estado ?? item.estadoHacienda ?? item.EstadoHacienda)
                    }));

                    // Update badge count
                    $('#badgeTotal').text(data.length);

                    // Hide loader
                    tableLoader.style.display = 'none';

                    // Show table or empty state
                    if (data.length > 0) {
                        tableContainer.style.display = 'block';
                        emptyState.style.display = 'none';
                    } else {
                        tableContainer.style.display = 'none';
                        emptyState.style.display = 'block';
                    }

                    return data;
                },
                error: function(xhr, error, code) {
                    console.error('Error loading documents:', error);
                    tableLoader.style.display = 'none';
                    emptyState.style.display = 'block';
                    return [];
                }
            },
            columns: [
                {
                    data: 'fechaEmision',
                    render: function(data) {
                        return formatDateTime(data);
                    }
                },
                {
                    data: 'tipoDocumento',
                    render: function(data) {
                        const badges = {
                            'FE': '<span class="badge" style="background: #0ea5e9; color: white;">FE</span>',
                            'TE': '<span class="badge" style="background: #06b6d4; color: white;">TE</span>',
                            'NC': '<span class="badge" style="background: #f59e0b; color: white;">NC</span>',
                            'ND': '<span class="badge" style="background: #ef4444; color: white;">ND</span>',
                            'FEE': '<span class="badge" style="background: #10b981; color: white;">FEE</span>',
                            'FEC': '<span class="badge" style="background: #8b5cf6; color: white;">FEC</span>',
                            'REP': '<span class="badge" style="background: #64748b; color: white;">REP</span>'
                        };
                        return badges[data] || '<span class="badge bg-secondary">' + data + '</span>';
                    }
                },
                {
                    data: 'consecutivo',
                    render: function(data) {
                        return '<code class="text-primary">' + (data || 'N/A') + '</code>';
                    }
                },
                {
                    data: 'receptor',
                    render: function(data) {
                        if (!data) return '<span class="text-muted">-</span>';
                        return data.nombre || data.Nombre || data.nombreReceptor || data.NombreReceptor || '-';
                    }
                },
                {
                    data: 'total',
                    render: function(data) {
                        return '<strong>' + formatCurrency(data || 0) + '</strong>';
                    },
                    className: 'text-end'
                },
                {
                    data: 'estadoHacienda',
                    render: function(data) {
                        const badges = {
                            'Aceptado': '<span class="badge" style="background: #10b981; color: white;"><i class="fas fa-check-circle me-1"></i>Aceptado</span>',
                            'Rechazado': '<span class="badge" style="background: #ef4444; color: white;"><i class="fas fa-times-circle me-1"></i>Rechazado</span>',
                            'Pendiente': '<span class="badge" style="background: #f59e0b; color: white;"><i class="fas fa-clock me-1"></i>Pendiente</span>',
                            'Procesando': '<span class="badge" style="background: #0ea5e9; color: white;"><i class="fas fa-spinner fa-spin me-1"></i>Procesando</span>',
                            'Borrador': '<span class="badge" style="background: #6b7280; color: white;"><i class="fas fa-edit me-1"></i>Borrador</span>',
                            'Contingencia': '<span class="badge" style="background: #10b981; color: white;"><i class="fas fa-check-circle me-1"></i>Contingencia</span>'
                        };
                        return badges[data] || '<span class="badge bg-secondary">' + (data || 'N/A') + '</span>';
                    }
                },
                {
                    data: 'id',
                    orderable: false,
                    render: function(data) {
                        return `
                            <div class="btn-group btn-group-sm" role="group">
                                <button class="btn btn-outline-primary" onclick="verDocumento('${data}')" title="Ver Detalle">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button class="btn btn-outline-success" onclick="descargarPDF('${data}')" title="Descargar PDF">
                                    <i class="fas fa-file-pdf"></i>
                                </button>
                            </div>
                        `;
                    }
                }
            ],
            pageLength: 10,
            ordering: true,
            searching: false,
            lengthChange: false,
            paging: false,
            info: false,
            order: [[0, 'desc']],
            language: {
                url: 'https://cdn.datatables.net/plug-ins/1.13.8/i18n/es-ES.json'
            }
        });
    }

    function verDocumento(id) {
        if (!id) return;
        window.location.href = '/DocumentoDetalle?id=' + id;
    }

    function descargarPDF(id) {
        if (!id) return;
        // Show loading indicator
        Swal.fire({
            title: 'Generando PDF...',
            allowOutsideClick: false,
            didOpen: () => Swal.showLoading()
        });
        // Use direct link for file download via PageModel handler
        window.location.href = '?handler=DocumentoPdf&id=' + id;
        // Close loading after a delay (download triggers navigation)
        setTimeout(() => Swal.close(), 2000);
    }
</script>
}
