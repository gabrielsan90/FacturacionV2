            headers: {
                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success) {
                    showSuccess(response.message);
                    $('#modalDarDeBaja').modal('hide');
                    table.ajax.reload();
                } else {
                    showError(response.message);
                }
            },
            error: function(xhr) {
                handleAjaxError(xhr);
            }
        });
    }

    function deleteRecord(id) {
        confirmDelete('Esta acción no se puede revertir', function() {
            $.ajax({
                url: '?handler=Delete&id=' + id,
                type: 'POST',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        showSuccess(response.message);
                        table.ajax.reload();
                    } else {
                        showError(response.message);
                    }
                },
                error: function(xhr) {
                    handleAjaxError(xhr);
                }
            });
        });
    }

    function aplicarFiltros() {
        table.ajax.reload();
    }

    function refrescarTabla() {
        $('#tableActivosFijosLoader').show();
        $('#tableActivosFijosContainer').hide();
        $('#emptyStateActivosFijos').hide();
        table.ajax.reload();
    }

    function exportarExcel() {
        showWarning('Función de exportación en desarrollo');
    }

    function descargarPlantilla() {
        window.location.href = '?handler=Plantilla';
    }

    function importarExcel(input) {
        if (input.files && input.files[0]) {
            const file = input.files[0];
            const formData = new FormData();
            formData.append('file', file);

            Swal.fire({
                title: 'Importando...',
                html: 'Por favor espere mientras se procesan los datos.',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            $.ajax({
                url: '?handler=Importar',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    Swal.close();
                    if (response.success) {
                        let message = response.message;
                        if (response.totalImportados > 0) {
                            message += `<br><br><strong>Importados:</strong> ${response.totalImportados}`;
                        }
                        if (response.totalErrores > 0) {
                            message += `<br><strong>Errores:</strong> ${response.totalErrores}`;
                            if (response.errores && response.errores.length > 0) {
                                message += '<br><br><strong>Detalle de errores:</strong><ul class="text-start small">';
                                response.errores.slice(0, 10).forEach(function(err) {
                                    message += `<li>${err}</li>`;
                                });
                                if (response.errores.length > 10) {
                                    message += `<li>... y ${response.errores.length - 10} errores más</li>`;
                                }
                                message += '</ul>';
                            }
                        }
                        Swal.fire({
                            icon: response.totalErrores > 0 ? 'warning' : 'success',
                            title: response.totalErrores > 0 ? 'Importación con advertencias' : 'Importación exitosa',
                            html: message
                        });
                        table.ajax.reload();
                    } else {
                        showError(response.message || 'Error al importar los datos');
                    }
                },
                error: function(xhr) {
                    Swal.close();
                    handleAjaxError(xhr);
                },
                complete: function() {
                    input.value = '';
                }
            });
        }
    }

    window.openCreateModal = openCreateModal;
    window.edit = edit;
    window.save = save;
    window.depreciar = depreciar;
    window.confirmarDepreciar = confirmarDepreciar;
    window.darDeBaja = darDeBaja;
    window.confirmarDarDeBaja = confirmarDarDeBaja;
    window.deleteRecord = deleteRecord;
    window.aplicarFiltros = aplicarFiltros;
    window.refrescarTabla = refrescarTabla;
    window.exportarExcel = exportarExcel;
</script>
}
